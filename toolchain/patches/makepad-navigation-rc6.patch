+                if delimiters.last().map(|v| v.0) != Some(expected) {
+                    let (line, col) = tokenizer.token_index_to_row_col(index as u32).unwrap_or((0, 0));
+                    return format!("fragment:{}:{}: unexpected closing {}", line + 1, col + 1, close);
+                }
+                delimiters.pop();
+            }
+        }
+        if tokenizer.state != State::Whitespace {
+            let what = match tokenizer.state {
+                State::String(_) | State::EscapeInString(_) | State::UnicodeHexInString(_)
+                | State::UnicodeCurlyInString(_) | State::AsciiHexInString(_) => "unterminated string",
+                State::BlockComment(_) | State::MaybeEndBlock(_) | State::BlockCommentStart
+                | State::BlockDocStart | State::BlockDoc | State::BlockDocMaybeEnd => "unterminated block comment",
+                _ => "unfinished lexical token",
+            };
+            let line = source.chars().filter(|c| *c == '\n').count() + 1;
+            let col = source.rsplit('\n').next().unwrap_or("").chars().count() + 1;
+            return format!("fragment:{}:{}: {}", line, col, what);
+        }
+        if let Some((open, index)) = delimiters.last() {
+            let (line, col) = tokenizer.token_index_to_row_col(*index).unwrap_or((0, 0));
+            return format!("fragment:{}:{}: unclosed {}", line + 1, col + 1, open);
+        }
