+    pub fn fragment_structure_diagnostic(source: &str, heap: &mut ScriptHeap) -> String {
+        let mut tokenizer = Self { fragment_checks: true, ..Self::default() };
+        tokenizer.tokenize(source, heap);
+        if let Some(position) = tokenizer.fragment_escape_error {
+            let prefix: String = source.chars().take(position).collect();
+            let line = prefix.chars().filter(|c| *c == '\n').count() + 1;
+            let col = prefix.rsplit('\n').next().unwrap_or("").chars().count() + 1;
+            return format!("fragment:{}:{}: unexpected escaped quote outside string", line, col);
+        }
+        // Finish identifiers/numbers/operators and line comments, without
+        // closing strings or block comments on behalf of the caller.
+        tokenizer.tokenize("\n", heap);
+        let mut delimiters: Vec<(char, u32)> = Vec::new();
+        for (index, token) in tokenizer.tokens.iter().enumerate() {
+            let opening = match token.token {
+                ScriptToken::OpenCurly => Some('{'),
+                ScriptToken::OpenRound => Some('('),
+                ScriptToken::OpenSquare => Some('['),
+                _ => None,
+            };
+            if let Some(opening) = opening { delimiters.push((opening, index as u32)); continue; }
+            let closing = match token.token {
+                ScriptToken::CloseCurly => Some(('}', '{')),
+                ScriptToken::CloseRound => Some((')', '(')),
+                ScriptToken::CloseSquare => Some((']', '[')),
+                _ => None,
+            };
