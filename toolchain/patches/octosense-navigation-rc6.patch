+//! Navigation's narrow script entry to the official shared Notes tool relay.
+//! Identity comes from the host request; the relay retains grants, consent,
+//! schemas, budgets and audit. No Notes storage or executor is opened here.
+use crate::ai_host::app_peers::{host_tools::{CallOrigin, CallerKind, HostToolCall, ToolReply}, TurnTrigger};
+use octosense_appstore::services::{self, AgentAccess, HostApiMethod, HostService, Replier, ServiceCall, ServiceHost};
+use serde_json::{json, Value};
+use std::{collections::HashMap, sync::{atomic::{AtomicU64, Ordering}, Mutex, OnceLock}, time::Duration};
+
+const FAMILY: &str = "shared_tools";
+pub const NAVIGATION_APP: &str = "os.agentic26-navigation";
+pub const NOTES_READ_TOOLS: &[&str] = &["notes.search", "notes.read"];
+const TIMEOUT_MS: u64 = 60_000;
+static NEXT: AtomicU64 = AtomicU64::new(1);
+
+#[derive(Clone, Debug, PartialEq, Eq, Hash)]
+struct Key { app: String, account: String, isolate: usize, request: String }
+struct Pending { call: ServiceCall, reply: Replier, tool_reply: ToolReply, account: String }
+static PENDING: OnceLock<Mutex<HashMap<Key, Pending>>> = OnceLock::new();
+fn pending() -> &'static Mutex<HashMap<Key, Pending>> { PENDING.get_or_init(|| Mutex::new(HashMap::new())) }
+
+fn request_id(args: &Value, fields: &[&str]) -> Result<String, String> {
+    let object = args.as_object().ok_or("invalid_args: Expected an object")?;
+    if object.keys().any(|key| !fields.contains(&key.as_str())) { return Err("invalid_args: Unknown bridge field".into()); }
+    let id = args["request_id"].as_str().filter(|id| !id.is_empty() && id.len() <= 64 && !id.chars().any(char::is_control))
+        .ok_or("invalid_args: request_id must be a nonempty string of at most 64 bytes")?;
+    Ok(id.into())
+}
+fn request(args: &Value) -> Result<(String, String, Value), String> {
+    let id = request_id(args, &["request_id", "tool", "args"])?;
+    let tool = args["tool"].as_str().filter(|tool| matches!(*tool, "notes.search" | "notes.read"))
+        .ok_or("unsupported_tool: Only notes.search and notes.read are exposed")?;
+    let arguments = args["args"].as_object().ok_or("invalid_args: Tool args must be an object")?;
+    Ok((id, tool.into(), Value::Object(arguments.clone())))
+}
+fn account(call: &ServiceCall) -> Result<String, String> {
+    let loaded = crate::host_tools::script_apps::admitted_host(&call.app_id, &call.host_dir)
+        .map_err(|_| "permission_denied: Calling app is not admitted in this host")?;
+    if !loaded.manifest["requires"].as_array().is_some_and(|list| list.iter().any(|v| v == "host-api-v1")) {
+        return Err("permission_denied: host-api-v1 is required".into());
+    }
+    crate::app_storage::lifecycle::contained_account(&call.app_id)
+        .ok_or_else(|| "account_unavailable: Calling app has no active account".into())
+}
+fn valid(context: &Pending) -> bool {
+    context.reply.is_pending() && account(&context.call).is_ok_and(|a| a == context.account)
+}
+fn stop(context: Pending, reason: &str) {
+    context.tool_reply.cancel();
+    crate::host_tools::submit(crate::host_tools::Event::Cancel { call_id: context.tool_reply.call_id().into(), reason: reason.into() });
+    context.reply.send(Err(format!("cancelled: {reason}")));
+}
+fn cancel_where(matches: impl Fn(&Key, &Pending) -> bool, reason: &str) -> usize {
+    let removed = {
+        let mut map = pending().lock().unwrap_or_else(|e| e.into_inner());
+        let keys: Vec<_> = map.iter().filter(|(key, context)| matches(key, context)).map(|(key, _)| key.clone()).collect();
+        keys.into_iter().filter_map(|key| map.remove(&key).map(|context| (key, context))).collect::<Vec<_>>()
+    };
+    let count = removed.len();
+    for (_, context) in removed { stop(context, reason); }
+    count
+}
+// A cancelled request id may be reused while its old callback is in flight.
+// Match the host call generation before taking the current pending request.
+fn take_reply(key: &Key, call_id: &str) -> Option<Pending> {
+    let mut map = pending().lock().unwrap_or_else(|e| e.into_inner());
+    if map.get(key).is_some_and(|context| context.tool_reply.call_id() == call_id) { map.remove(key) } else { None }
+}
+fn closed(isolate: usize) { cancel_where(|key, _| key.isolate == isolate, "Originating isolate closed"); }
+/// Called before the relay pump so expired or withdrawn callers cannot execute.
+pub fn poll() { cancel_where(|_, context| !valid(context), "Request expired or app account/admission changed"); }
+
+pub fn register() {
+    // Admission offer is scoped to this shipped project; the manifest must
+    // still request these tools and the official relay retains its grants.
+    octosense_appstore::system::set_agent_tool_offer(NAVIGATION_APP, NOTES_READ_TOOLS);
+    services::on_isolate_closed(closed);
+    services::register_host_service(Box::new(SharedTools));
+}
+struct SharedTools;
+impl HostService for SharedTools {
+    fn family(&self) -> &'static str { FAMILY }
+    fn timeout(&self, _: &ServiceCall) -> Duration { Duration::from_millis(TIMEOUT_MS) }
+    fn api_methods(&self) -> Vec<HostApiMethod> {
+        let id = json!({"type":"string","minLength":1,"maxLength":64});
+        vec![
+            HostApiMethod::new("shared_tools.call", 1, "runtime", "Project extension: call an installed, granted Notes read tool through the official relay",
+                json!({"type":"object","additionalProperties":false,"required":["request_id","tool","args"],"properties":{"request_id":id,"tool":{"type":"string","enum":["notes.search","notes.read"]},"args":{"type":"object"}}}),
+                json!({"type":"object"})).with_platforms(&["macos"]).with_agent_access(AgentAccess::Allowed),
+            HostApiMethod::new("shared_tools.cancel", 1, "runtime", "Project extension: cancel this isolate's matching Notes request",
+                json!({"type":"object","additionalProperties":false,"required":["request_id"],"properties":{"request_id":id}}),
+                json!({"type":"object","required":["cancelled"],"properties":{"cancelled":{"type":"integer"}}})).with_platforms(&["macos"]).with_agent_access(AgentAccess::Allowed)
+        ]
+    }
+    fn call(&mut self, call: ServiceCall, reply: Replier, _: &mut dyn ServiceHost) {
+        if let Err(error) = begin(call, reply.clone()) { reply.send(Err(error)); }
+    }
+}
+fn begin(call: ServiceCall, reply: Replier) -> Result<(), String> {
+    let account = account(&call)?;
+    if call.from_sheet { return Err("permission_denied: Script call required".into()); }
+    match call.method() {
+        "cancel" => {
+            let id = request_id(&call.args, &["request_id"])?;
+            let key = Key { app: call.app_id, account, isolate: reply.isolate_key(), request: id };
+            let count = cancel_where(|candidate, _| candidate == &key, "Cancelled by originating app");
+            reply.send(Ok(json!({"cancelled":count})));
+            return Ok(());
+        }
+        "call" => (),
+        _ => return Err("unknown_method: Unknown shared_tools method".into()),
+    }
+    let (id, tool, args) = request(&call.args)?;
+    // This loader installs only the grants admitted in manifest.agent.tools.
+    crate::host_tools::ensure_loaded(&format!("card.{}", call.app_id));
+    let owner = crate::host_tools::owner_of(&tool).ok_or("unavailable: Notes tool has no owner")?;
+    let declaration = crate::host_tools::declaration(&owner, &tool).ok_or("unavailable: Notes tool is not linked")?;
+    if declaration["risk"] != "read" { return Err("unsupported_tool: Only declared read tools are exposed".into()); }
+    let key = Key { app: call.app_id.clone(), account: account.clone(), isolate: reply.isolate_key(), request: id };
+    let call_id = format!("script-notes-{}", NEXT.fetch_add(1, Ordering::Relaxed));
+    let response_key = key.clone();
+    let response_call_id = call_id.clone();
+    let tool_reply = ToolReply::new(call_id.clone(), move |fields| {
+        if fields.get("status").is_some() { return; }
+        let context = take_reply(&response_key, &response_call_id);
+        let Some(context) = context else { return };
+        if !valid(&context) { stop(context, "App account/admission changed before result"); return; }
+        let result = if fields["ok"] == true {
+            Ok(fields["data"].clone())
+        } else {
+            Err(format!("{}: {}", fields["error"]["kind"].as_str().unwrap_or("tool_error"), fields["error"]["message"].as_str().unwrap_or("Shared tool refused")))
+        };
+        context.reply.send(result);
+    });
+    let mut map = pending().lock().unwrap_or_else(|e| e.into_inner());
+    if map.contains_key(&key) { return Err("busy: request_id already pending in this app isolate".into()); }
+    // App Hub already bounds requests per isolate and globally.
+    map.insert(key, Pending { call: call.clone(), reply, tool_reply: tool_reply.clone(), account: account.clone() });
+    drop(map);
+    let mut stamped = HostToolCall::parse(&json!({"call_id":call_id,"name":tool,"args":args}))?;
+    stamped.app = owner;
+    stamped.risk = declaration["risk"].as_str().unwrap().into();
+    stamped.confirm_required = declaration["confirm"] == "app";
+    stamped.timeout_ms = TIMEOUT_MS;
+    stamped.caller_kind = CallerKind::AppPeer;
+    stamped.calling_app = format!("card.{}", call.app_id);
+    stamped.peer = Some(stamped.calling_app.clone());
+    stamped.account = Some(account);
+    stamped.origin = CallOrigin::Context;
+    stamped.trigger = TurnTrigger::App;
+    crate::host_tools::submit(crate::host_tools::Event::Call { call: stamped, reply: tool_reply });
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    static TEST_STATE: Mutex<()> = Mutex::new(());
+    #[test]
+    fn cancelling_and_closing_stop_only_originating_calls_and_late_results() {
+        let _state = TEST_STATE.lock().unwrap();
+        struct Hold(std::sync::Arc<Mutex<Option<Replier>>>);
+        impl HostService for Hold {
+            fn family(&self) -> &'static str { "shared_bridge_test" }
+            fn call(&mut self, _: ServiceCall, reply: Replier, _: &mut dyn ServiceHost) { *self.0.lock().unwrap() = Some(reply); }
+        }
+        struct Host;
+        impl ServiceHost for Host { fn open_sheet(&mut self, _: String) {} fn close_sheet(&mut self) {} }
+        let held = std::sync::Arc::new(Mutex::new(None));
+        services::register_host_service(Box::new(Hold(held.clone())));
+        let sent = std::sync::Arc::new(Mutex::new(Vec::new()));
+        let mut replies = Vec::new();
+        for isolate in [991001, 991002] {
+            let call = ServiceCall { app_id:"os.fixture".into(), service:"shared_bridge_test.hold".into(), args:json!({}), from_sheet:false, may_prompt:true, host_dir:"/nonexistent-test-host".into() };
+            services::dispatch(call.clone(), isolate, 1, &mut Host);
+            let reply = held.lock().unwrap().take().unwrap();
+            let out = sent.clone();
+            let tool_reply = ToolReply::new(format!("test-{isolate}"), move |value| out.lock().unwrap().push(value));
+            let key = Key { app:call.app_id.clone(), account:"device".into(), isolate, request:"same".into() };
+            pending().lock().unwrap().insert(key.clone(), Pending {call, reply, tool_reply:tool_reply.clone(), account:"device".into()});
+            replies.push((key, tool_reply));
+        }
+        assert!(take_reply(&replies[0].0, "old-generation").is_none(), "a late callback cannot remove a reused request id");
+        assert!(pending().lock().unwrap().contains_key(&replies[0].0));
+        assert_eq!(cancel_where(|key, _| key == &replies[0].0, "Test cancellation"), 1);
+        assert!(replies[0].1.is_cancelled());
+        assert!(replies[1].1.is_open(), "another isolate with the same request id remains live");
+        assert!(!replies[0].1.finish(crate::ai_host::app_peers::host_tools::ToolOutcome::Ok(json!({"late":true}))));
+        closed(991002);
+        assert!(replies[1].1.is_cancelled());
+        assert!(sent.lock().unwrap().is_empty(), "late tool data is suppressed");
+        assert_eq!(services::take_replies_for(&[991001,991002]).len(), 2);
+    }
+    #[test]
+    fn expired_host_request_cancels_its_tool_before_relay_work() {
+        let _state = TEST_STATE.lock().unwrap();
+        struct Expired(std::sync::Arc<Mutex<Option<Replier>>>);
+        impl HostService for Expired {
+            fn family(&self) -> &'static str { "shared_bridge_expired_test" }
+            fn timeout(&self, _: &ServiceCall) -> Duration { Duration::ZERO }
+            fn call(&mut self, _: ServiceCall, reply: Replier, _: &mut dyn ServiceHost) { *self.0.lock().unwrap() = Some(reply); }
+        }
+        struct Host;
+        impl ServiceHost for Host { fn open_sheet(&mut self, _: String) {} fn close_sheet(&mut self) {} }
+        let held = std::sync::Arc::new(Mutex::new(None));
+        services::register_host_service(Box::new(Expired(held.clone())));
+        let call = ServiceCall { app_id:"os.expired-fixture".into(), service:"shared_bridge_expired_test.hold".into(), args:json!({}), from_sheet:false, may_prompt:true, host_dir:"/nonexistent-test-host".into() };
+        services::dispatch(call.clone(), 991003, 1, &mut Host);
+        let reply = held.lock().unwrap().take().unwrap();
+        assert!(!reply.is_pending());
+        let tool_reply = ToolReply::new("test-expired", |_| panic!("expired tool answered"));
+        let key = Key { app:call.app_id.clone(), account:"device".into(), isolate:991003, request:"expired".into() };
+        pending().lock().unwrap().insert(key.clone(), Pending {call, reply, tool_reply:tool_reply.clone(), account:"device".into()});
+        poll();
+        assert!(tool_reply.is_cancelled());
+        assert!(!pending().lock().unwrap().contains_key(&key));
+        services::cancel_heap(991003);
+    }
+    #[test]
+    fn discovery_accepts_both_implemented_methods() {
+        let methods = SharedTools.api_methods();
+        assert_eq!(methods.len(), 2);
+        for method in methods { method.validate().unwrap(); assert!(method.supports("macos")); }
+    }
+    #[test]
+    fn request_cannot_select_identity_or_other_tools() {
+        for field in ["caller", "app_id", "account", "grant", "risk", "owner"] {
+            let mut args = json!({"request_id":"n1","tool":"notes.search","args":{"query":"trip"}});
+            args[field] = json!("forged");
+            assert!(request(&args).is_err(), "{field}");
+        }
+        assert!(request(&json!({"request_id":"n1","tool":"notes.write","args":{}})).is_err());
+        assert!(request(&json!({"request_id":"","tool":"notes.read","args":{}})).is_err());
+        assert!(request(&json!({"request_id":"n1","tool":"notes.read","args":{"id":"n000001"}})).is_ok());
+    }
+    #[test]
+    fn cancellation_identity_includes_account_app_and_isolate() {
+        let key = Key { app:"os.navigation".into(), account:"device".into(), isolate:1, request:"same".into() };
+        for other in [Key{app:"os.other".into(),..key.clone()}, Key{account:"signed-in-other".into(),..key.clone()}, Key{isolate:2,..key.clone()}] {
+            assert_ne!(key, other);
+        }
+    }
+}
