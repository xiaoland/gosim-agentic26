+#[test]
+fn thinking_options_and_reasoning_history_are_transparent(){
+ let fake=Arc::new(Fake::default());
+ let host=complete::ModelHost::new(&complete::Options::default().providers(Arc::new(Fixed)).transport(fake.clone()));
+ let assistant=json!({"role":"assistant","content":null,"reasoning_content":"provider reasoning", "reasoning_details":[{"type":"reasoning.text","text":"preserved","format":"MiniMax-response-v1","id":"reasoning-1"}],"tool_calls":[{"id":"nonce-1","type":"function","function":{"name":"nonce","arguments":"{}"}}]});
+ let history=json!([{"role":"user","content":"Use nonce"},assistant,{"role":"tool","tool_call_id":"nonce-1","content":"value"}]);
+ for (index,(thinking,split)) in [(None,None),(Some("adaptive"),Some(true)),(Some("disabled"),Some(false))].into_iter().enumerate(){
+  let mut request=args(history.clone());request.as_object_mut().unwrap().remove("thinking");
+  if let Some(mode)=thinking{request["thinking"]=json!({"type":mode});}
+  if let Some(split)=split{request["reasoning_split"]=json!(split);}
+  fake.answers.lock().unwrap().push_back(json!({"choices":[{"message":assistant,"finish_reason":"tool_calls"}],"usage":{"prompt_tokens":1,"completion_tokens":1}}));
+  let response=host.chat("allowed",&request).unwrap();
+  assert_eq!(response["response"]["choices"][0]["message"],assistant);
+  let seen=fake.seen.lock().unwrap();let sent=&seen[index];assert_eq!(sent["messages"],history);
+  assert_eq!(sent.get("thinking"),request.get("thinking"));assert_eq!(sent.get("reasoning_split"),request.get("reasoning_split"));
+ }
+ for (field,value) in [("thinking",json!({"type":"enabled"})),("thinking",json!(null)),("reasoning_split",json!("true")),("reasoning_split",json!(null))]{
+  let mut request=args(history.clone());request[field]=value;
+  assert_eq!(host.chat("allowed",&request).unwrap_err().code,complete::Code::BadRequest);
+ }
+ assert_eq!(fake.seen.lock().unwrap().len(),3);assert_eq!(host.budget("allowed").calls_today,3);
+}
