@@ -0,0 +1,37 @@
+//! Package preflight for Navigation's matching host; never a store gate.
+use octosense_app_hub::{check_bundle, PublisherKeys};
+use octosense_app_policy::{AppManifest, HostLimits};
+use std::path::Path;
+
+/// Run the official package gate, retaining its normal resource and signing
+/// rules and adding only the two tools this host offers Navigation.
+pub fn run(args: &[String]) -> Result<(), String> {
+    let bundle = Path::new(args.first().ok_or("--navigation-check <bundle> [--allow-unsigned] [--publisher-key id=hex] [--json]")?);
+    let manifest = AppManifest::parse(&octosense_app_hub::admission::read_text(&bundle.join("manifest.json"), octosense_app_hub::admission::MAX_MANIFEST_BYTES)?)?;
+    let runtime_id = if manifest.id.starts_with("os.") { manifest.id.clone() } else { format!("os.{}", manifest.id) };
+    if runtime_id != crate::shared_tools::NAVIGATION_APP { return Err("project preflight accepts only Navigation".into()); }
+    let mut allow_unsigned = false;
+    let mut json = false;
+    let mut keys = PublisherKeys::new();
+    let mut index = 1;
+    while index < args.len() {
+        match args[index].as_str() {
+            "--allow-unsigned" => allow_unsigned = true,
+            "--json" => json = true,
+            "--publisher-key" => {
+                index += 1;
+                let (id, public) = args.get(index).ok_or("--publisher-key requires id=hex")?.split_once('=').ok_or("--publisher-key requires id=hex")?;
+                keys = keys.with(id, public);
+            }
+            flag => return Err(format!("unsupported project preflight argument: {flag}")),
+        }
+        index += 1;
+    }
+    let limits = HostLimits::default().with_require_signature(!allow_unsigned);
+    let mut offered = limits.offered_tools.clone();
+    offered.extend(crate::shared_tools::NOTES_READ_TOOLS.iter().map(|tool| tool.to_string()));
+    let limits = limits.with_offered_tools(offered);
+    let report = check_bundle(bundle, &limits, &keys, None)?;
+    if json { println!("{}", report.json()); } else { print!("{}", report.render()); }
+    if report.passed() { Ok(()) } else { Err("project package preflight refused the bundle".into()) }
+}
