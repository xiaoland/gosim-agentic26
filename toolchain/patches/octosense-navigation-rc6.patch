+#[test]
+fn chat_uses_its_own_wait_without_changing_complete_or_retrying() {
+ struct Timed { seen: Mutex<Vec<(Option<Duration>,Value)>> }
+ impl Timed {
+  fn respond(&self, timeout:Option<Duration>,body:&str)->Result<(u16,Vec<u8>),String>{
+   self.seen.lock().unwrap().push((timeout,serde_json::from_str(body).unwrap()));
+   Ok((200,json!({"choices":[{"message":{"role":"assistant","content":"{\"ok\":true}"},"finish_reason":"stop"}]}).to_string().into_bytes()))
+  }
+ }
+ impl Transport for Timed {
+  fn post(&self,_:&str,_:&[(String,String)],body:&str)->Result<(u16,Vec<u8>),String>{self.respond(None,body)}
+  fn post_with_timeout(&self,_:&str,_:&[(String,String)],body:&str,timeout:Duration)->Result<(u16,Vec<u8>),String>{self.respond(Some(timeout),body)}
+ }
+ let transport=Arc::new(Timed{seen:Mutex::new(Vec::new())});
+ let host=complete::ModelHost::new(&complete::Options::default().providers(Arc::new(Fixed)).transport(transport.clone()));
+ let request=args(json!([{"role":"user","content":"One request."}]));
+ host.chat("allowed",&request).unwrap();
+ host.complete("allowed",complete::Request{class:complete::Class::Fast,task:"Return ok.".into(),input:Value::Null,schema:json!({"type":"object","required":["ok"],"properties":{"ok":{"type":"boolean"}}}),allow_urls:false,system:None}).unwrap();
+ let seen=transport.seen.lock().unwrap();
+ assert_eq!(seen.len(),2,"one post per call, without retries");
+ assert_eq!(seen[0].0,Some(Duration::from_secs(300)));
+ assert_eq!(seen[0].1["messages"],request["messages"]);
+ assert_eq!(seen[0].1["tools"],request["tools"]);
+ assert_eq!(seen[0].1["stream"],false);
+ assert_eq!(seen[0].1["model"],"MiniMax-M3");
+ assert_eq!(seen[1].0,None,"complete keeps the ordinary post path");
+ assert_eq!(complete::TIMEOUT,Duration::from_secs(120));
+}
