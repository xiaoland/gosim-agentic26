+#[test]
+fn chat_failure_detail_is_logged_privately_without_changing_public_refusal() {
+ const CHILD: &str = "NAV_CHAT_DIAGNOSTIC_FIXTURE";
+ if let Ok(mode) = std::env::var(CHILD) {
+  struct Failing(String);
+  impl Transport for Failing {
+   fn post(&self,_:&str,_:&[(String,String)],_:&str)->Result<(u16,Vec<u8>),String> {
+    if self.0 == "http" { Ok((503, br#"{"error":{"message":"upstream unavailable fixture-key","code":"synthetic"}}"#.to_vec())) }
+    else { Ok((200, br#"{"choices":[],"usage":{"prompt_tokens":1,"completion_tokens":1}}"#.to_vec())) }
+   }
+  }
+  let dir=std::env::temp_dir().join(format!("chat-diagnostic-{}",std::process::id()));
+  complete::register_with(complete::Options::default().providers(Arc::new(Fixed)).transport(Arc::new(Failing(mode))).grants(|app,_|app=="allowed"));
+  let refusal=call(&dir,"allowed","chat",args(json!([{"role":"user","content":"fixture"}])),92838).unwrap_err();
+  assert_eq!(refusal,"provider: The primary AI provider did not complete the request.");
+  let _=std::fs::remove_dir_all(dir);
+  return;
+ }
+ for (mode,expected) in [("http","HTTP 503"),("nochoice","The provider returned no choice.")] {
+  let out=std::process::Command::new(std::env::current_exe().unwrap()).args(["--exact","chat_failure_detail_is_logged_privately_without_changing_public_refusal","--nocapture"]).env(CHILD,mode).output().unwrap();
+  assert!(out.status.success(),"{}",String::from_utf8_lossy(&out.stderr));
+  let log=String::from_utf8_lossy(&out.stderr);
+  assert!(log.contains("model.chat diagnostic"));assert!(log.contains(expected));assert!(log.contains("\"call_id\":1"));assert!(log.contains("\"phase\":\"chat_result\""));assert!(!log.contains("fixture-key"));
+ }
+}
