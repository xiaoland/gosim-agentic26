+            fn family(&self) -> &'static str { "model" }
+            fn call(&mut self, call: ServiceCall, reply: Replier, _: &mut dyn ServiceHost) {
+                self.0.lock().unwrap().push((call.service, call.args["value"].as_str().unwrap().len(), reply.request_id()));
+                reply.send(Ok(serde_json::json!({})));
+            }
+        }
+        let seen = Arc::new(Mutex::new(Vec::new()));
+        register_host_service(Box::new(Capture(seen.clone())));
+        let mut cx = Cx::new(Box::new(|_, _| {}));
