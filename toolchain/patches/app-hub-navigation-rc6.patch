+        assert!(request_args("mail.list", &encoded).unwrap_err().contains("1 MiB"));
+        assert!(request_args("model.chat", &format!("\"{}\"", "x".repeat(2*MAX_ARGS_BYTES))).unwrap_err().contains("2 MiB"));
+        cancel_heap(card.isolate_heap_key(&mut cx).unwrap());
+    }
