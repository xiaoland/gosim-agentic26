+        let mut vm = ScriptVm {host: &mut host, bx: Box::new(ScriptVmBase::new())};
+        for (text, size) in [("abcdefg", 4), ("中文测试", 4), ("a😀中🙂b", 5), ("", 4)] {
+            let input = vm.bx.heap.new_string_from_str(text);
+            vm.set_injected_global(id!(chunk_input), input);
+            vm.set_injected_global(id!(chunk_size), (size as f64).into());
+            let result = vm.eval(ScriptMod {file:"utf8-chunks.octoscript".into(), code:format!("chunk_input.utf8_chunks({size})\n;"), ..Default::default()});
+            let array = result.as_array().unwrap();
+            let mut restored = String::new();
+            for index in 0..vm.bx.heap.array_len(array) {
+                let value = vm.bx.heap.array_index_unchecked(array, index);
+                vm.bx.heap.string_with(value, |_, piece| {
+                    assert!(!piece.is_empty() && piece.len() <= size);
+                    restored.push_str(piece);
+                });
+            }
+            assert_eq!(restored, text);
+            if text.is_empty() {assert_eq!(vm.bx.heap.array_len(array), 0);}
+        }
+        for invalid in [0.0, -1.0, 3.0, 4.5, f64::NAN, f64::INFINITY, usize::MAX as f64] {
+            assert!(utf8_chunk_size(invalid).is_none());
+        }
+        vm.set_injected_global(id!(chunk_size), NIL);
+        assert!(vm.eval(ScriptMod {file:"invalid-chunks.octoscript".into(), code:"\"text\".utf8_chunks(chunk_size)\n;".into(), ..Default::default()}).is_err());
+    }
+}
