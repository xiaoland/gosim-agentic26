+fn utf8_chunk_size(value: f64) -> Option<usize> {
+    if !value.is_finite() || value < 4.0 || value.fract() != 0.0 || value >= usize::MAX as f64 {
+        return None;
+    }
+    Some(value as usize)
+}
+
+fn utf8_chunk_end(text: &str, start: usize, size: usize) -> usize {
+    let mut end = start.saturating_add(size).min(text.len());
+    while !text.is_char_boundary(end) {
+        end -= 1;
+    }
+    end
+}
+
