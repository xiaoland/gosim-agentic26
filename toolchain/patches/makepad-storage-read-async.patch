+fn read_worker() -> &'static std::sync::mpsc::Sender<ReadRequest> {
+    READ_WORKER.get_or_init(|| {
+        let (sender, receiver) = std::sync::mpsc::channel::<ReadRequest>();
+        std::thread::spawn(move || {
+            for (heap_key, id, root, path_text) in receiver {
+                let result = match (root, path_text) {
+                    (Some(root), Some(path)) => {
+                        // Debug-only deterministic slow storage for native lifecycle regression tests.
+                        #[cfg(debug_assertions)]
+                        if path.trim_start_matches('/').starts_with("skills/") {
+                            if let Some(ms) = std::env::var("MAKEPAD_TEST_ASYNC_READ_DELAY_MS").ok()
+                                .and_then(|s| s.parse::<u64>().ok()).filter(|ms| *ms <= 1000) {
+                                std::thread::sleep(std::time::Duration::from_millis(ms));
+                            }
+                        }
+                        read_jailed_text(&root, &path)
+                    }
+                    (None, _) => Err("storage not available in this context".to_string()),
+                    (_, None) => Err("path must be a string".to_string()),
+                };
+                READ_RESULTS.lock().unwrap().push((heap_key, id, result));
+                SignalToUI::set_ui_signal();
+            }
+        });
+        sender
+    })
+}
+
+fn read_jailed_text(root: &Path, path: &str) -> Result<String, String> {
+    let real = resolve_jailed(root, path)?;
+    verify_no_symlinks(root, &real)?;
+    let file = std::fs::File::open(real).map_err(|_| "file not found".to_string())?;
+    if !file.metadata().map_err(|_| "read failed")?.is_file() {
+        return Err("not a file".to_string());
+    }
+    let mut bytes = Vec::new();
+    file.take(MAX_FILE_BYTES + 1).read_to_end(&mut bytes).map_err(|_| "read failed")?;
+    if bytes.len() as u64 > MAX_FILE_BYTES {
+        return Err("file too large".to_string());
+    }
+    String::from_utf8(bytes).map_err(|_| "invalid UTF-8".to_string())
+}
+
+pub(crate) fn pump_read_results(cx: &mut Cx) -> bool {
+    crate::widget_async::gc_dead_splash_isolates(cx);
+    let results = std::mem::take(&mut *READ_RESULTS.lock().unwrap());
+    let progressed = !results.is_empty();
+    for (heap_key, id, result) in results {
+        let callback = READ_CALLBACKS.with(|c| c.borrow_mut().remove(&(heap_key, id)));
+        let Some(callback) = callback else { continue };
+        let Some(vm_id) = crate::widget_async::vm_for_heap(cx, heap_key) else { continue };
+        crate::widget_async::contain_isolate_panic("storage read callback", || {
+            cx.with_script_vm_id(vm_id, |vm| {
+                if vm.bx.heap.heap_key() != heap_key || !crate::splash_policy::may_run(heap_key) {
+                    return;
+                }
+                let (success, text, error) = match result {
+                    Ok(text) => (true, vm.bx.heap.new_string_from_str(&text), NIL),
+                    Err(error) => (false, NIL, vm.bx.heap.new_string_from_str(&error)),
+                };
+                let obj = vm.bx.heap.new_object();
+                let trap = vm.bx.threads.cur().trap.pass();
+                vm.bx.heap.set_value(obj, id!(success).into(), success.into(), trap);
+                vm.bx.heap.set_value(obj, id!(text).into(), text, trap);
+                vm.bx.heap.set_value(obj, id!(error).into(), error, trap);
+                vm.with_instruction_limit(WIDGET_SCRIPT_INSTRUCTION_LIMIT, |vm| {
+                    vm.call(callback.as_object().into(), &[obj.into()]);
+                });
+                crate::splash_policy::charge(heap_key, vm.last_limit_consumed() as u64);
+                for err in vm.take_errors() {
+                    crate::makepad_draw::error!("splash storage callback error: {err}");
+                }
+            });
+        });
+    }
+    progressed
+}
