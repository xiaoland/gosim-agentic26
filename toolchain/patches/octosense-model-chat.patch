+//! Native function-calling transport. The app owns its transient conversation
+//! and tool execution; the host owns the primary provider, key and shared budget.
+use super::{Code, ModelHost, Refusal, Refused, Usage};
+use crate::model::{effective_api_type, effective_base_url, effective_model};
+use octosense_llm_config::ApiType;
+use serde_json::{json, Value};
+
+fn bad(message: &str) -> Refusal { Refusal::new(Code::BadRequest, message) }
+
+fn function(call: &Value) -> bool {
+    call["id"].as_str().is_some_and(|s| !s.is_empty())
+        && call["type"] == "function"
+        && call["function"]["name"].as_str().is_some_and(|s| !s.is_empty())
+        && call["function"]["arguments"].is_string()
+}
+
+fn check(args: &Value) -> Result<(), Refusal> {
+    let object = args.as_object().ok_or_else(|| bad("chat arguments must be an object"))?;
+    if object.keys().any(|k| !["messages", "tools", "tool_choice", "thinking"].contains(&k.as_str())) {
+        return Err(bad("chat takes only messages, tools, tool_choice and thinking"));
+    }
+    let messages = args["messages"].as_array().filter(|m| !m.is_empty()).ok_or_else(|| bad("messages must be a nonempty array"))?;
+    for message in messages {
+        let role = message["role"].as_str().unwrap_or("");
+        if !["system", "user", "assistant", "tool"].contains(&role)
+            || !(message["content"].is_string() || (role == "assistant" && message["content"].is_null())) {
+            return Err(bad("each message needs a supported role and text content"));
+        }
+        if role == "tool" && !message["tool_call_id"].as_str().is_some_and(|s| !s.is_empty()) {
+            return Err(bad("a tool result needs its tool_call_id"));
+        }
+        if let Some(calls) = message.get("tool_calls") {
+            if role != "assistant" || !calls.as_array().is_some_and(|c| c.iter().all(function)) {
+                return Err(bad("assistant tool_calls must contain native function calls"));
+            }
+        }
+    }
+    let tools = args["tools"].as_array().ok_or_else(|| bad("tools must be an array"))?;
+    for tool in tools {
+        let f = &tool["function"];
+        if tool["type"] != "function" || !f["name"].as_str().is_some_and(|s| !s.is_empty()) || !f["parameters"].is_object() {
+            return Err(bad("each tool needs a function name and parameter schema"));
+        }
+    }
+    if args["tool_choice"] != "auto" || args["thinking"] != json!({"type":"disabled"}) {
+        return Err(bad("chat requires tool_choice auto and thinking disabled"));
+    }
+    Ok(())
+}
+
+impl ModelHost {
+    /// One native OpenAI-compatible function-call step, without JSON-output
+    /// prompting, fallback, retries or conversation persistence.
+    pub fn chat(&self, app: &str, args: &Value) -> Result<Value, Refusal> {
+        check(args)?;
+        let candidate = self.providers.as_ref()
+            .ok_or_else(|| Refusal::new(Code::NoProvider, "No primary AI provider is set up."))?
+            .primary().map_err(|e| Refusal { detail: Some(e), ..Refusal::new(Code::NoProvider, "The primary AI provider could not be read.") })?
+            .ok_or_else(|| Refusal::new(Code::NoProvider, "No primary AI provider is set up."))?;
+        let provider = &candidate.provider;
+        if crate::model::key_required(&provider.family) && candidate.key.is_none() {
+            return Err(Refusal::new(Code::NoProvider, "The primary AI provider has no usable key."));
+        }
+        if effective_api_type(provider) != ApiType::OpenAi {
+            return Err(bad("chat requires an OpenAI-compatible primary provider"));
+        }
+        let base = effective_base_url(provider).ok_or_else(|| bad("the primary provider needs an endpoint"))?;
+        if !base.starts_with("https://") { return Err(bad("chat requires an HTTPS provider endpoint")); }
+        let model = effective_model(provider).ok_or_else(|| bad("the primary provider needs a model"))?;
+        let mut body = args.clone();
+        body["model"] = json!(model);
+        body["stream"] = json!(false);
+        let serialized = body.to_string();
+        let admitted = self.ledger.lock().unwrap().admit(app, (self.clock)(), (serialized.len() / 3) as u64);
+        if let Err(refused) = admitted {
+            let budget = self.budget(app);
+            return Err(match refused {
+                Refused::Rate { retry_after_s } => Refusal::new(Code::Rate, format!("This app may make {} model calls a minute; try again in {retry_after_s} s.", budget.per_minute)),
+                Refused::Calls => Refusal::new(Code::Budget, format!("This app used its {} model calls for today.", budget.calls_per_day)),
+                Refused::Tokens => Refusal::new(Code::Budget, "This call would pass the app's daily token budget."),
+            });
+        }
+        let failure = |detail: String| Refusal { detail: Some(detail), ..Refusal::new(Code::Provider, "The primary AI provider did not complete the request.") };
+        let key = candidate.key.as_deref();
+        let prepared = super::wire::prepare(provider, key, "", "").map_err(|e| bad(&e))?;
+        let (status, raw) = self.transport.post(&prepared.url, &prepared.headers, &serialized)
+            .map_err(|e| failure(crate::probe::describe_error(&e, key)))?;
+        if let Some(error) = crate::probe::describe_response(status, &raw, key) { return Err(failure(error)); }
+        let response: Value = serde_json::from_slice(&raw).map_err(|_| failure("The provider's answer was not JSON.".into()))?;
+        let usage = &response["usage"];
+        let reported = usage["prompt_tokens"].as_u64().zip(usage["completion_tokens"].as_u64());
+        let used = match reported {
+            Some((input_tokens, output_tokens)) => Usage { input_tokens, output_tokens, estimated: false },
+            None => Usage { input_tokens: (serialized.len() / 3) as u64, output_tokens: (raw.len() / 3) as u64, estimated: true },
+        };
+        self.ledger.lock().unwrap().charge(app, (self.clock)(), used.total());
+        let choice = response["choices"].as_array().and_then(|c| c.first()).ok_or_else(|| failure("The provider returned no choice.".into()))?;
+        let message = &choice["message"];
+        if message["role"] != "assistant" || !(message["content"].is_string() || message["content"].is_null())
+            || message.get("tool_calls").is_some_and(|v| !v.as_array().is_some_and(|c| c.iter().all(function))) {
+            return Err(failure("The provider returned an invalid assistant message.".into()));
+        }
+        Ok(json!({"response": response, "meta": {"usage": {"input_tokens": used.input_tokens, "output_tokens": used.output_tokens, "estimated": used.estimated}, "budget": self.budget(app).to_json()}}))
+    }
+}
