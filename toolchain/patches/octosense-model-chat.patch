index 0000000..3dfd283
--- /dev/null
+++ b/apps/ai-providers/host-service/tests/chat.rs
@@ -0,0 +1,61 @@
+//! Native tool history and host policy via actual dispatch, with no network.
+use octosense_appstore::services::{dispatch,take_replies_for,ServiceCall,ServiceHost};
+use octosense_llm_config::Provider;
+use octosense_llm_service::complete::{self,ledger::Limits,Candidate,Providers,Transport};
+use octosense_llm_service::{model::ProfileStore,vault::MemoryVault};
+use serde_json::{json,Value};
+use std::{collections::{BTreeMap,VecDeque},sync::{Arc,Mutex},time::{Duration,Instant}};
+#[derive(Default)]
+struct Fake { answers:Mutex<VecDeque<Value>>, seen:Mutex<Vec<Value>> }
+impl Transport for Fake {
+ fn post(&self,_:&str,_:&[(String,String)],body:&str)->Result<(u16,Vec<u8>),String>{
+  self.seen.lock().unwrap().push(serde_json::from_str(body).unwrap());
+  Ok((200,self.answers.lock().unwrap().pop_front().expect("unexpected network dispatch").to_string().into_bytes()))
+ }
+}
+struct Fixed;
+impl Providers for Fixed {
+ fn candidates(&self)->Result<Vec<Candidate>,String>{
+  let mut p=Provider::new("minimax-cn",Some("MiniMax-M3".into()));
+  p.base_url=Some("https://api.minimax.cn/v1".into());p.api_type=Some(octosense_llm_config::ApiType::OpenAi);
+  Ok(vec![Candidate{provider:p,key:Some("fixture-key".into())}])
+ }
+}
+struct NoSheets;
+impl ServiceHost for NoSheets {fn open_sheet(&mut self,_:String){} fn close_sheet(&mut self){}}
+fn call(dir:&std::path::Path,app:&str,method:&str,args:Value,id:usize)->Result<Value,String>{
+ dispatch(ServiceCall{app_id:app.into(),service:format!("model.{method}"),args,from_sheet:false,may_prompt:true,host_dir:dir.join(".host")},id,1,&mut NoSheets);
+ let deadline=Instant::now()+Duration::from_secs(5);
+ loop {if let Some((_,_,r))=take_replies_for(&[id]).pop(){return r.map(|r|serde_json::from_str(&r).unwrap())} assert!(Instant::now()<deadline);std::thread::sleep(Duration::from_millis(5));}
+}
+fn args(messages:Value)->Value{json!({"messages":messages,"tools":[{"type":"function","function":{"name":"nonce","parameters":{"type":"object","properties":{}}}}],"tool_choice":"auto","thinking":{"type":"disabled"}})}
+#[test]
+fn native_history_and_shared_policy(){
+ let dir=std::env::temp_dir().join(format!("model-chat-{}",std::process::id()));std::fs::create_dir_all(&dir).unwrap();
+ let fake=Arc::new(Fake::default());
+ let assistant=json!({"role":"assistant","content":null,"reasoning_content":"preserved".repeat(5000),"tool_calls":[{"id":"call_nonce","type":"function","function":{"name":"nonce","arguments":"{}"}}]});
+ fake.answers.lock().unwrap().extend([
+  json!({"model":"MiniMax-M3","choices":[{"message":assistant,"finish_reason":"tool_calls"}],"usage":{"prompt_tokens":10,"completion_tokens":5}}),
+  json!({"choices":[{"message":{"role":"assistant","content":"nonce-returned"},"finish_reason":"stop"}],"usage":{"prompt_tokens":20,"completion_tokens":6}}),
+  json!({"choices":[{"message":{"content":"{\"ok\":true}"}}],"usage":{"prompt_tokens":3,"completion_tokens":2}})]);
+ let host=complete::register_with(complete::Options::default().providers(Arc::new(Fixed)).transport(fake.clone()).grants(|app,_|app=="allowed").limits(Limits{per_minute:6,calls_per_day:3,tokens_per_day:100000}).clock(||1_790_000_000_000));
+ let initial=json!([{"role":"system","content":"Use nonce."},{"role":"user","content":"Read it."}]);
+ assert!(call(&dir,"denied","chat",args(initial.clone()),91001).unwrap_err().starts_with("capability:"));assert!(fake.seen.lock().unwrap().is_empty());
+ let first=call(&dir,"allowed","chat",args(initial.clone()),91002).unwrap();assert_eq!(first["response"]["choices"][0]["message"],assistant);
+ let mut history=initial.as_array().unwrap().clone();history.push(first["response"]["choices"][0]["message"].clone());history.push(json!({"role":"tool","tool_call_id":"call_nonce","content":"{\"nonce\":\"nonce-returned\"}"}));
+ let second=call(&dir,"allowed","chat",args(json!(history)),91003).unwrap();assert_eq!(second["response"]["choices"][0]["message"]["content"],"nonce-returned");
+ let seen=fake.seen.lock().unwrap();assert_eq!(seen[1]["messages"],json!(history));assert_eq!(seen[1]["model"],"MiniMax-M3");assert!(seen[1].get("max_tokens").is_none());assert!(seen[1].get("response_format").is_none());drop(seen);
+ call(&dir,"allowed","complete",json!({"task":"Return ok.","input":null,"schema":{"type":"object","required":["ok"],"properties":{"ok":{"type":"boolean"}}}}),91004).unwrap();
+ assert_eq!(host.budget("allowed").calls_today,3);assert_eq!(host.budget("allowed").tokens_today,46);
+ assert!(call(&dir,"allowed","chat",args(initial),91005).unwrap_err().starts_with("budget:"));assert_eq!(fake.seen.lock().unwrap().len(),3);
+ let persisted:Value=serde_json::from_slice(&std::fs::read(dir.join(".host/model/ledger.json")).unwrap()).unwrap();assert_eq!(persisted["apps"]["allowed"]["tokens"],46);std::fs::remove_dir_all(dir).unwrap();
+}
+#[test]
+fn missing_primary_key_does_not_select_fallback(){
+ let dir=std::env::temp_dir().join(format!("model-chat-primary-{}",std::process::id()));let vault=Arc::new(MemoryVault::default());
+ let mut store=ProfileStore::open(dir.join("profile.json"),vault.clone()).unwrap();
+ store.save(vec![Provider::new("minimax-cn",Some("MiniMax-M3".into())),Provider::new("openai",Some("gpt-4.1".into()))],&BTreeMap::from([("OPENAI_API_KEY".into(),"fallback-fixture-key".into())])).unwrap();
+ let providers=complete::ProfileProviders{path:dir.join("profile.json"),vault};assert_eq!(providers.candidates().unwrap().len(),1);assert!(providers.primary().unwrap().unwrap().key.is_none());
+ let fake=Arc::new(Fake::default());let host=complete::ModelHost::new(&complete::Options::default().providers(Arc::new(providers)).transport(fake.clone()));
+ assert_eq!(host.chat("allowed",&args(json!([{"role":"user","content":"Go"}]))).unwrap_err().code,complete::Code::NoProvider);assert!(fake.seen.lock().unwrap().is_empty());assert_eq!(host.budget("allowed").calls_today,0);std::fs::remove_dir_all(dir).unwrap();
+}
