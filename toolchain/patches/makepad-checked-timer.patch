+/// Deliver only this timer's actual execution failure in a separate script entry.
+/// The callback captures its business identity; ordinary timers never create one.
+pub fn queue_script_timer_error(vm: &mut ScriptVm, timer: &CxScriptTimer, result: ScriptValue) {
+    let Some(on_error) = timer.on_error.as_ref().filter(|_| result.is_err()) else { return };
+    let object = vm.bx.heap.new_object();
+    let kind = if result.value_type() == ScriptValueType::ERR_LIMIT { "execution_limit" } else { "execution_error" };
+    let kind = vm.bx.heap.new_string_from_str(kind);
+    let error = vm.bx.heap.new_string_from_str("脚本入口未完整执行");
+    let trap = vm.bx.threads.cur().trap.pass();
+    vm.bx.heap.set_value(object, id!(success).into(), false.into(), trap);
+    vm.bx.heap.set_value(object, id!(error_kind).into(), kind, trap);
+    vm.bx.heap.set_value(object, id!(error).into(), error, trap);
+    let failure = vm.bx.heap.new_object_ref(object);
+    let cx = vm.cx_mut();
+    let pending = cx.start_timeout(0.01);
+    cx.script_data.timers.timers.push(CxScriptTimer {
+        id: LiveId::unique(), repeat: false, timer: pending,
+        callback: on_error.clone(), on_error: None, failure: Some(failure),
+    });
+}
