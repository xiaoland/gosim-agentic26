+/// Only plain font sidecars qualify. Local {{assets}} examples remain valid.
+fn font_document(file: &Path, text: &str) -> bool {
+    if file.parent() != Some(Path::new("assets/fonts"))
+        || !matches!(file.file_name().and_then(|s| s.to_str()), Some("OFL.txt" | "LICENSE.txt" | "LICENSE.md" | "README.md")) { return false; }
+    let compact: String = text.chars().filter(|c| !c.is_whitespace()).flat_map(char::to_lowercase).collect();
+    if compact.contains('<') || ["![", "url(", "@import"].iter().any(|s| compact.contains(s)) { return false; }
+    !compact.split("http_resource(").skip(1).any(|part| {
+        let call = part.split(')').next().unwrap_or("");
+        ["http://", "https://", "file://", "../"].iter().any(|s| call.contains(s))
+    })
+}
