+    #[test]
+    fn font_sidecar_links_are_documents_but_embedded_resources_still_refuse() {
+        let dir = std::env::temp_dir().join(format!("gate-font-doc-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(dir.join("assets/fonts")).unwrap();
+        let manifest = AppManifest::parse(&serde_json::json!({
+            "schema":1,"id":"dev.example.font","version":"1.0.0","name":"Font",
+            "integrity":{"bundle_blake3":""},"capabilities":[]
+        }).to_string()).unwrap();
+        let readme = dir.join("assets/fonts/README.md");
+        std::fs::write(dir.join("assets/fonts/OFL.txt"), "Copyright https://author.example; license http://license.example").unwrap();
+        std::fs::write(&readme, "Source https://source.example\nhttp_resource(\"{{assets}}/assets/fonts/local.otf\")").unwrap();
+        assert!(!external_references(&dir, &manifest).unwrap().is_empty(), "no adjacent font");
+        std::fs::write(dir.join("assets/fonts/local.otf"), b"font fixture").unwrap();
+        assert!(external_references(&dir, &manifest).unwrap().is_empty());
+        std::fs::write(dir.join("main.splash"), "Label{text_style: http_resource(\"https://undeclared.example/font.otf\")}").unwrap();
+        assert!(external_references(&dir, &manifest).unwrap().iter().any(|s| s.contains("undeclared.example")));
+        std::fs::remove_file(dir.join("main.splash")).unwrap();
+        for resource in ["![remote](https://undeclared.example/a.png)", "<IMG SRC=\"https://undeclared.example/a.png\">",
+            "<script src=\"https://undeclared.example/code.js\"></script>", "url (https://undeclared.example/a.png)",
+            "http_resource ( \"https://undeclared.example/font.otf\" )"] {
+            std::fs::write(&readme, resource).unwrap();
+            assert!(!external_references(&dir, &manifest).unwrap().is_empty(), "{resource}");
+        }
+        std::fs::write(&readme, "Source https://source.example").unwrap();
+        std::fs::write(dir.join("README.md"), "Source https://unrelated.example").unwrap();
+        assert!(external_references(&dir, &manifest).unwrap().iter().any(|s| s.contains("unrelated.example")));
+        let _ = std::fs::remove_dir_all(&dir);
+    }
