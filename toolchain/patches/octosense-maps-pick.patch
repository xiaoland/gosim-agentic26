+let picker_id = 0
+let picker_polling = false
+fn picker_ui(){
+    ui.cancel_picker.set_visible(picker_id > 0)
+    ui.choose_box.set_visible(picker_id > 0)
+    ui.directions.set_visible(picker_id == 0)
+}
+fn poll_picker(){
+    if picker_polling { return }
+    picker_polling = true
+    host.request("maps.pending", {}, fn(r){
+        picker_polling = false
+        if !r.is_ok { return }
+        if r.data.active == true {
+            if picker_id != r.data.selection_id {
+                picker_id = r.data.selection_id
+                place = nil
+                // The native setter ignores empty strings; an incomplete polyline decodes to no route.
+                ui.plan_map.set_nav_polyline("?")
+                ui.plan_map.set_route_markers("")
+                finding = ""
+                ui.search.set_text(r.data.search_hint)
+                search_for(r.data.search_hint)
+                show("search")
+                ui.search_hint.set_text("Choose a destination to return to Navigation")
+                picker_ui()
+            }
+        } elif picker_id > 0 {
+            picker_id = 0
+            show("search")
+            picker_ui()
+        }
+    })
+}
+fn accept_picker(){
+    if picker_id == 0 || place == nil { return }
+    let token = picker_id
+    host.request("maps.select", {selection_id: token name: place.name label: place.label lat: place.lat lon: place.lon}, fn(r){
+        if picker_id != token { return }
+        if r.is_ok && r.data.success { picker_id = 0; picker_ui() }
+        else { ui.picker_note.set_text("This selection could not be returned. Choose again or cancel.") }
+    })
+}
+fn dismiss_picker(){
+    if picker_id == 0 { return }
+    let token = picker_id
+    host.request("maps.dismiss", {selection_id: token}, fn(r){
+        if picker_id != token { return }
+        if r.is_ok && r.data.success { picker_id = 0; picker_ui() }
+    })
+}
