diff --git a/crates/shell/src/maps_pick.rs b/crates/shell/src/maps_pick.rs
new file mode 100644
index 0000000..426c457
--- /dev/null
+++ b/crates/shell/src/maps_pick.rs
@@ -0,0 +1,168 @@
+//! Foreground Maps search selection, returned to the exact requesting isolate.
+//! No app chooses its caller identity, window, source label or selection time.
+use makepad_widgets::{Cx, Timer};
+use makepad_widgets::makepad_platform::SignalToUI;
+use octosense_appstore::services::{HostService, Replier, ServiceCall, ServiceHost};
+use serde_json::{json, Value};
+use std::sync::{Mutex, atomic::{AtomicU64, Ordering}};
+use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+pub struct Instance { pub client: u64, pub app: String, pub heap: usize }
+pub enum Action { Open, Return(u64) }
+struct Request {
+    token: u64, app: String, reply: Replier, hint: String, deadline: Instant,
+    caller: Option<u64>, map_client: Option<u64>, maps: Option<(u64, usize)>, opened: bool,
+}
+struct State { request: Option<Request>, returns: Vec<u64>, timer: Option<Timer> }
+static STATE: Mutex<State> = Mutex::new(State { request: None, returns: Vec::new(), timer: None });
+static NEXT: AtomicU64 = AtomicU64::new(1);
+fn finish(state: &mut State, mut value: Value) {
+    if let Some(request) = state.request.take() {
+        value["request_id"] = json!(request.reply.request_id());
+        request.reply.send(Ok(value));
+        if let Some(client) = request.caller { state.returns.push(client); }
+        SignalToUI::set_ui_signal();
+    }
+}
+fn failure(state: &mut State, code: &str) { finish(state, json!({"success":false,"code":code})); }
+fn text(value: &Value, name: &str, max: usize) -> Option<String> {
+    value.get(name)?.as_str().filter(|v| v.len() <= max && !v.chars().any(char::is_control)).map(str::to_string)
+}
+fn fields(value: &Value, keys: &[&str]) -> bool {
+    value.as_object().is_some_and(|o| o.len() == keys.len() && keys.iter().all(|k| o.contains_key(*k)))
+}
+struct MapsService;
+impl HostService for MapsService {
+    fn family(&self) -> &'static str { "maps" }
+    fn timeout(&self, call: &ServiceCall) -> Duration {
+        Duration::from_secs(if call.method() == "pick" { 305 } else { 60 })
+    }
+    fn call(&mut self, call: ServiceCall, reply: Replier, _host: &mut dyn ServiceHost) {
+        let request_id = reply.request_id();
+        let refuse = |code: &str| reply.clone().send(Ok(json!({"success":false,"request_id":request_id,"code":code})));
+        if call.from_sheet { refuse("invalid_caller"); return; }
+        let mut state = STATE.lock().unwrap();
+        match call.method() {
+            "pick" => {
+                if !call.may_prompt || call.app_id == "os.maps" { refuse("background_not_allowed"); return; }
+                let Some(hint) = text(&call.args, "search_hint", 256).filter(|_| fields(&call.args, &["search_hint"])) else { refuse("invalid_arguments"); return; };
+                if let Some(current) = state.request.as_ref() {
+                    if current.reply.is_pending() && current.reply.isolate_key() != reply.isolate_key() { refuse("picker_busy"); return; }
+                    failure(&mut state, "superseded");
+                }
+                let token = NEXT.fetch_add(1, Ordering::Relaxed);
+                if token == 0 { refuse("unavailable"); return; }
+                state.request = Some(Request { token, app: call.app_id, reply, hint,
+                    deadline: Instant::now()+Duration::from_secs(300), caller: None, map_client: None, maps: None, opened: false });
+                SignalToUI::set_ui_signal();
+            }
+            "cancel" => {
+                let Some(id) = call.args.get("request_id").and_then(Value::as_u64).filter(|id| *id>0 && fields(&call.args, &["request_id"])) else { refuse("invalid_arguments"); return; };
+                let matches = state.request.as_ref().is_some_and(|r| r.app == call.app_id && r.reply.isolate_key() == reply.isolate_key() && r.reply.request_id() == id);
+                if matches { failure(&mut state, "cancelled"); }
+                reply.send(Ok(json!({"success":true,"cancelled":matches})));
+            }
+            "pending" | "select" | "dismiss" => {
+                if call.app_id != "os.maps" { refuse("invalid_caller"); return; }
+                let Some(request) = state.request.as_ref() else { reply.send(Ok(json!({"active":false,"success":false,"code":"stale_request"}))); return; };
+                if !request.reply.is_pending() || !request.maps.is_some_and(|(_, heap)| heap == reply.isolate_key()) { refuse("invalid_caller"); return; }
+                if call.method() == "pending" {
+                    if !fields(&call.args, &[]) { refuse("invalid_arguments"); return; }
+                    reply.send(Ok(json!({"active":true,"selection_id":request.token,"search_hint":request.hint})));
+                    return;
+                }
+                if call.args.get("selection_id").and_then(Value::as_u64) != Some(request.token) { refuse("stale_request"); return; }
+                if call.method() == "dismiss" {
+                    if !fields(&call.args, &["selection_id"]) { refuse("invalid_arguments"); return; }
+                    failure(&mut state, "cancelled"); reply.send(Ok(json!({"success":true}))); return;
+                }
+                if !fields(&call.args, &["selection_id","name","label","lat","lon"]) { refuse("invalid_arguments"); return; }
+                let (Some(name), Some(label), Some(lat), Some(lon)) = (text(&call.args,"name",256).filter(|n| !n.trim().is_empty()),text(&call.args,"label",1024),call.args.get("lat").and_then(Value::as_f64),call.args.get("lon").and_then(Value::as_f64)) else { refuse("invalid_arguments"); return; };
+                if !lat.is_finite() || !lon.is_finite() || !(-90.0..=90.0).contains(&lat) || !(-180.0..=180.0).contains(&lon) { refuse("invalid_arguments"); return; }
+                let Ok(now) = SystemTime::now().duration_since(UNIX_EPOCH) else { refuse("unavailable"); return; };
+                finish(&mut state, json!({"success":true,"name":name,"label":label,"lat":lat,"lon":lon,"coordinate_system":"WGS84","source":"octosense.maps.search","selected_at":now.as_secs()}));
+                reply.send(Ok(json!({"success":true})));
+            }
+            _ => refuse("invalid_arguments"),
+        }
+    }
+}
+pub fn register() { octosense_appstore::services::register_host_service(Box::new(MapsService)); }
+
+/// The shell supplies live card heaps and client ids, never script arguments.
+pub fn tick(cx: &mut Cx, instances: &[Instance], live: &[u64], focused: Option<u64>) -> Vec<Action> {
+    let mut state = STATE.lock().unwrap();
+    let mut actions: Vec<Action> = state.returns.drain(..).map(Action::Return).collect();
+    if state.request.is_some() && state.timer.is_none() { state.timer = Some(cx.start_interval(0.2)); }
+    if let Some(r) = state.request.as_ref() {
+        let caller = instances.iter().find(|i| i.heap == r.reply.isolate_key() && i.app == r.app);
+        let code = if !r.reply.is_pending() || caller.is_none() { Some("caller_closed") }
+            else if Instant::now() >= r.deadline { Some("timeout") }
+            else if r.map_client.is_some_and(|client| !live.contains(&client)) { Some("closed") }
+            else if r.maps.is_some_and(|(client,heap)| !instances.iter().any(|i| i.client==client && i.heap==heap && i.app=="os.maps")) { Some("closed") }
+            else { None };
+        if let Some(code) = code {
+            if code=="caller_closed" { state.request.take(); } else { failure(&mut state, code); }
+        } else {
+            let caller = caller.unwrap().client;
+            let r = state.request.as_mut().unwrap();
+            if !r.opened {
+                if focused != Some(caller) { failure(&mut state,"background_not_allowed"); }
+                else { r.caller=Some(caller); r.opened=true; actions.push(Action::Open); }
+            } else if r.maps.is_none() {
+                if let Some(maps) = instances.iter().find(|i| i.app=="os.maps" && r.map_client==Some(i.client)) { r.maps=Some((maps.client,maps.heap)); }
+            }
+        }
+    }
+    actions.extend(state.returns.drain(..).map(Action::Return));
+    if state.request.is_none() { if let Some(timer)=state.timer.take() { cx.stop_timer(timer); } }
+    actions
+}
+pub fn window_opened(client: u64) {
+    if let Some(request) = STATE.lock().unwrap().request.as_mut() { request.map_client=Some(client); }
+}
+pub fn unavailable() { failure(&mut STATE.lock().unwrap(),"unavailable"); }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use octosense_appstore::services::{dispatch,take_replies_for,cancel_heap};
+    struct Host;
+    impl ServiceHost for Host { fn open_sheet(&mut self,_:String){} fn close_sheet(&mut self){} }
+    fn send(app:&str,heap:usize,id:u64,method:&str,args:Value) {
+        dispatch(ServiceCall { app_id:app.into(),service:format!("maps.{method}"),args,from_sheet:false,may_prompt:true,host_dir:std::env::temp_dir() },heap,id,&mut Host);
+    }
+    fn answer(heap:usize)->Value {
+        let r=take_replies_for(&[heap]);assert_eq!(r.len(),1);serde_json::from_str(r[0].2.as_ref().unwrap()).unwrap()
+    }
+    #[test]
+    fn selection_is_once_only_and_bound_to_both_real_isolates() {
+        register();
+        send("os.nav",91001,1,"pick",json!({"search_hint":"机场"}));
+        let token=STATE.lock().unwrap().request.as_ref().unwrap().token;
+        { let mut s=STATE.lock().unwrap();let r=s.request.as_mut().unwrap();r.caller=Some(41);r.map_client=Some(42);r.maps=Some((42,91002)); }
+        send("os.nav",91001,2,"select",json!({"selection_id":token,"name":"forged","label":"","lat":1,"lon":1}));
+        assert_eq!(answer(91001)["code"],"invalid_caller");
+        send("os.maps",91003,1,"dismiss",json!({"selection_id":token}));
+        assert_eq!(answer(91003)["code"],"invalid_caller");
+        send("os.maps",91002,1,"select",json!({"selection_id":token+1,"name":"old","label":"","lat":1,"lon":1}));
+        assert_eq!(answer(91002)["code"],"stale_request");
+        send("os.nav",91004,1,"cancel",json!({"request_id":1}));
+        assert_eq!(answer(91004)["cancelled"],false);
+        send("os.maps",91002,2,"select",json!({"selection_id":token,"name":"Public test place","label":"Fixture only","lat":39.96491,"lon":116.31604}));
+        assert_eq!(answer(91002)["success"],true);
+        let selected=answer(91001);assert_eq!(selected["request_id"],1);assert_eq!(selected["coordinate_system"],"WGS84");assert!(selected["selected_at"].as_u64().unwrap()>0);
+        send("os.maps",91002,3,"select",json!({"selection_id":token,"name":"duplicate","label":"","lat":1,"lon":1}));
+        assert_eq!(answer(91002)["code"],"stale_request");assert!(take_replies_for(&[91001]).is_empty());
+        send("os.nav",91001,3,"pick",json!({"search_hint":""}));
+        send("os.nav",91001,4,"pick",json!({"search_hint":"new"}));
+        assert_eq!(answer(91001)["code"],"superseded");
+        send("os.nav",91001,5,"cancel",json!({"request_id":3}));
+        assert_eq!(answer(91001)["cancelled"],false);
+        send("os.nav",91001,6,"cancel",json!({"request_id":4}));
+        let replies=take_replies_for(&[91001]);assert_eq!(replies.len(),2);
+        assert!(replies.iter().any(|(_,id,r)|*id==4 && serde_json::from_str::<Value>(r.as_ref().unwrap()).unwrap()["code"]=="cancelled"));
+        assert!(STATE.lock().unwrap().request.is_none());
+        for heap in [91001,91002,91003,91004] {cancel_heap(heap);}
+    }
+}
