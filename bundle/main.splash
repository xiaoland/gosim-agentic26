fn viewed_route(){ for candidate in candidates { if candidate.id == viewed_route_id { return candidate } } return nil }
fn representative_routes(){
    if expanded_routes { return candidates }
    let result = [] let fastest = nil let cheapest = nil
    for candidate in candidates {
        if candidate.duration_seconds != nil && (fastest == nil || candidate.duration_seconds < fastest.duration_seconds) { fastest = candidate }
        if candidate.price_cents != nil && (cheapest == nil || candidate.price_cents < cheapest.price_cents) { cheapest = candidate }
    }
    if chosen != nil { result.push(chosen) }
    for candidate in [fastest cheapest viewed_route()] {
        if candidate != nil { let exists = false for item in result { if item.id == candidate.id { exists = true } } if !exists { result.push(candidate) } }
    }
    return result
}
fn map_polyline(value){
    if value.is_object() { value = route_get(value, "polyline") }
    if !value.is_string() { return nil }
    let points = value.split(";")
    if points.len() < 2 { return nil }
    for point in points { if route_point(point) == nil { return nil } }
    return value
}
// 候选几何创建后不再改写；报价和查看状态变化不使折线失效。
fn map_geometry(candidate){
    if candidate==nil {return {paths:[] omitted:0}}
    let owner=route_get(candidate,"geometry_owner_id")
    if owner!=nil {return map_geometry(ui_route(owner))}
    let cached=route_get(candidate,"map_geometry_cache")
    if cached!=nil {return cached}
    let geometry=map_geometry_uncached(candidate)
    candidate.map_geometry_cache=geometry
    return geometry
}
fn map_geometry_uncached(candidate){
    let paths = [] let omitted = 0
    if candidate == nil || !candidate.segments.is_array() { return {paths: paths omitted: omitted} }
    for segment in candidate.segments {
        let geometries = []
        let direct = map_polyline(route_get(segment, "polyline"))
        if direct != nil { geometries.push(direct) } elif route_get(segment, "polyline") != nil { omitted += 1 }
        for part in [route_get(segment, "walking") route_get(segment, "taxi")] {
            let line = map_polyline(route_get(part, "polyline"))
            if line != nil { geometries.push(line) } elif route_get(part, "polyline") != nil { omitted += 1 }
            let steps = route_get(part, "steps")
            if steps.is_array() { for step in steps {
                let line = map_polyline(route_get(step, "polyline"))
                if line != nil { geometries.push(line) } elif route_get(step, "polyline") != nil { omitted += 1 }
            } }
        }
        let lines = route_get(route_get(segment, "bus"), "buslines")
        if lines.is_array() { for line in lines {
            let polyline = map_polyline(route_get(line, "polyline"))
            if polyline != nil { geometries.push(polyline) } elif route_get(line, "polyline") != nil { omitted += 1 }
        } }
        if geometries.len() == 0 { omitted += 1 }
        for line in geometries {
            // 仅去掉相邻分段共有的端点；不跨缺口补线，保留供应商全部折线。
            let points = line.split(";")
            let last = if paths.len() > 0 { paths[paths.len()-1].split(";") } else { [] }
            if last.len() > 0 && last[last.len()-1] == points[0] {
                let tail = [] for index point in points { if index > 0 { tail.push(point) } }
                paths[paths.len()-1] += ";" + text_join(tail, ";")
            } else { paths.push(line) }
        }
    }
    return {paths: paths omitted: omitted}
}
fn text_join(values, separator){ let text = "" for value in values { if text != "" { text += separator } text += value } return text }
// 索引对应最终相接合并后的真实折线，不能拿原segments下标代替。
fn map_geometry_owner(candidate){
 let owner=route_get(candidate,"geometry_owner_id")
 if owner!=nil {return map_geometry_owner(ui_route(owner))}
 return candidate
}
fn route_map_metadata(candidate){
 let owner=map_geometry_owner(candidate) let catalog=route_get(owner,"map_paths_cache")
 let groups=[] let group=[] if catalog.is_array(){for entry in catalog {group.push(entry.index) if group.len()==4 {groups.push({path_indices:group selection_scope:"所选真实折线；不是全程独立路线"}) group=[]}} if group.len()>0 {groups.push({path_indices:group selection_scope:"所选真实折线；不是全程独立路线"})}}
 return {catalog_status:if route_get(owner,"map_geometry_error")!=nil {"error"} elif catalog==nil {"not_loaded"} else {"ready"} catalog_error:route_get(owner,"map_geometry_error") path_count:if catalog==nil {nil} else {catalog.len()} max_paths_per_image:4 selection_groups:groups selection_basis:"分组按目录索引完整覆盖；仅供选择，不自动注册或发图。几何缺口不补线"}
}
fn map_path_catalog(candidate){
 let owner=map_geometry_owner(candidate) let cached=route_get(owner,"map_paths_cache")
 if cached!=nil {return cached}
 let result=[]
 for index line in map_geometry(owner).paths {let points=line.split(";") result.push({index:index point_count:points.len() start:points[0] end:points[points.len()-1]})}
 owner.map_paths_cache=result ui_facts_revision+=1
 return result
}
// 大跨城折线按点分批核验；所有调用者共用完整缓存，不截断供应商几何。
let map_geometry_jobs={}
fn map_bounds_add(bounds,point){
 if bounds==nil {return {west:point.lon east:point.lon south:point.lat north:point.lat}}
 if point.lon<bounds.west {bounds.west=point.lon} if point.lon>bounds.east {bounds.east=point.lon}
 if point.lat<bounds.south {bounds.south=point.lat} if point.lat>bounds.north {bounds.north=point.lat}
 return bounds
}
fn map_segment_lines(segment){
 let values=[] let value=route_get(segment,"polyline") if value!=nil {values.push(value)}
 for part in [route_get(segment,"walking") route_get(segment,"taxi")] {
  value=route_get(part,"polyline") if value!=nil {values.push(value)}
  let steps=route_get(part,"steps") if steps.is_array(){for step in steps {value=route_get(step,"polyline") if value!=nil {values.push(value)}}}
 }
 let lines=route_get(route_get(segment,"bus"),"buslines")
 if lines.is_array(){for line in lines {value=route_get(line,"polyline") if value!=nil {values.push(value)}}}
 return values
}
fn map_geometry_current(job){return job.token==run_id && map_geometry_jobs[job.owner.id]==job}
fn map_geometry_notify(job,done,result){start_timeout(0.01,||{if job.token==run_id {done(result)}})}
fn map_geometry_finish(job,result){
 if !map_geometry_current(job){return}
 map_geometry_jobs[job.owner.id]=nil ui_facts_revision+=1
 for done in job.waiters {map_geometry_notify(job,done,result)}
}
fn map_geometry_fail(job){
 if !map_geometry_current(job){return}
 let message="地图几何目录构建未完成（"+job.stage+"）；Route与原始几何保留，未发送地图请求"
 job.owner.map_geometry_error=message
 trace_emit("map_geometry_error",{route_id:job.owner.id stage:job.stage segment_index:job.segment_index value_index:job.value_index byte_offset:job.byte_offset point_count:job.line_point_count},nil)
 map_geometry_finish(job,{success:false error:message})
}
fn map_geometry_schedule(job){
 start_timeout_checked(0.01,||{if map_geometry_current(job){map_geometry_batch(job)}},fn(error){map_geometry_fail(job)})
}
fn ensure_map_catalog(candidate,done){
 let owner=map_geometry_owner(candidate)
 let error=route_get(owner,"map_geometry_error") if error!=nil {done({success:false error:error}) return}
 if route_get(owner,"map_paths_cache")!=nil {done({success:true}) return}
 if route_get(owner,"map_geometry_cache")!=nil {map_path_catalog(owner) done({success:true}) return}
 let job=map_geometry_jobs[owner.id]
 if job!=nil {job.waiters.push(done) return}
 let segments=route_get(owner,"segments") if !segments.is_array(){segments=[]}
 job={owner:owner token:run_id waiters:[done] segments:segments segment_index:0 values:[] value_index:0 segment_valid:0 points:nil point_index:0 line:nil line_bounds:nil line_first:nil line_last:nil line_point_count:0 byte_offset:0 carry:"" line_done:false paths:[] catalog:[] omitted:0 stage:"prepare"}
 map_geometry_jobs[owner.id]=job map_geometry_schedule(job)
}
// 只拆当前UTF8片，原折线仍完整保留；不先制造整行数万个临时String。
fn map_geometry_chunk(job){
 let chunk=job.line.utf8_chunk(job.byte_offset,2048) job.byte_offset+=chunk.len()
 let values=(job.carry+chunk).split(";") let points=[]
 job.line_done=job.byte_offset==job.line.len() job.carry=""
 for index value in values {if index==values.len()-1 && !job.line_done {job.carry=value} else {points.push(value)}}
 job.points=points job.point_index=0
}
fn map_geometry_accept_line(job){
 let size=job.paths.len() let first=job.line_first let last=job.line_last
 if size>0 && job.catalog[size-1].end==first {
  job.paths[size-1]+=";"+job.line.replace(regex("^[^;]*;",""),"")
  let entry=job.catalog[size-1] entry.end=last entry.point_count+=job.line_point_count-1
  entry.bounds=map_bounds_add(entry.bounds,{lon:job.line_bounds.west lat:job.line_bounds.south})
  entry.bounds=map_bounds_add(entry.bounds,{lon:job.line_bounds.east lat:job.line_bounds.north})
 } else {job.paths.push(job.line) job.catalog.push({index:size point_count:job.line_point_count start:first end:last bounds:job.line_bounds})}
 job.segment_valid+=1 job.line=nil job.points=nil job.value_index+=1
}
fn map_geometry_batch(job){
 if !map_geometry_current(job) {return}
 let work=0
 while work<100 {
  if job.points!=nil && job.point_index<job.points.len() {
   job.stage="points" let value=job.points[job.point_index] let point=route_point(value) work+=1
   if point==nil {job.omitted+=1 job.points=nil job.line=nil job.value_index+=1}
   else {
    if job.line_first==nil {job.line_first=value} job.line_last=value job.line_point_count+=1
    job.line_bounds=map_bounds_add(job.line_bounds,point) job.point_index+=1
   }
  } elif job.line!=nil {
   if job.line_done {job.stage="join_line" map_geometry_accept_line(job)}
   else {job.stage="utf8_chunk" map_geometry_chunk(job) work+=1}
  } elif job.value_index<job.values.len() {
   job.stage="line" let line=job.values[job.value_index] if line.is_object(){line=route_get(line,"polyline")}
   if !line.is_string() || line.search(";")<0 {job.omitted+=1 job.value_index+=1 work+=1}
   else {job.line=line job.points=nil job.point_index=0 job.line_bounds=nil job.line_first=nil job.line_last=nil job.line_point_count=0 job.byte_offset=0 job.carry="" job.line_done=false}
  } elif job.segment_index<job.segments.len() {
   job.stage="segment" if job.segment_index>0 && job.segment_valid==0 {job.omitted+=1}
   job.values=map_segment_lines(job.segments[job.segment_index]) job.segment_index+=1 job.value_index=0 job.segment_valid=0 work+=1
  } else {
   job.stage="complete" if job.segments.len()>0 && job.segment_valid==0 {job.omitted+=1}
   job.owner.map_geometry_cache={paths:job.paths omitted:job.omitted}
   job.owner.map_paths_cache=job.catalog map_geometry_finish(job,{success:true}) return
  }
 }
 map_geometry_schedule(job)
}
fn selected_map_geometry(candidate, indices){
 let geometry=map_geometry(candidate)
 map_path_catalog(candidate)
 if indices==nil {return {paths:geometry.paths omitted:geometry.omitted total:geometry.paths.len() selected:false error:nil}}
 if !indices.is_array() {return {paths:[] omitted:geometry.omitted total:geometry.paths.len() selected:true error:"path_indices需要实际折线索引数组"}}
 let paths=[]
 for index in indices {
  if !index.is_number() || index%1!=0 || index<0 || index>=geometry.paths.len() {return {paths:[] omitted:geometry.omitted total:geometry.paths.len() selected:true error:"本次路线不存在所选折线索引；请按当前map_paths目录选择"}}
  paths.push(geometry.paths[index])
 }
 return {paths:paths omitted:geometry.omitted total:geometry.paths.len() selected:true error:nil}
}
fn static_map_params(candidate, camera){return static_map_params_selected(candidate,camera,nil)}
fn static_map_params_selected(candidate, camera, indices){return static_map_params_rendered(candidate,camera,indices,nil)}
fn static_map_params_rendered(candidate, camera, indices, rendered){
    let markers = [] let paths = [] let omitted = 0
    if candidate != nil {
        if route_point(route_get(candidate, "requested_origin")) != nil { markers.push(route_get(candidate, "requested_origin")) }
        if route_point(route_get(candidate, "requested_destination")) != nil { markers.push(route_get(candidate, "requested_destination")) }
        let geometry = selected_map_geometry(candidate,indices)
        if geometry.error!=nil {return {params:"" markers:[] paths:[] omitted:geometry.omitted error:geometry.error selected:true total:geometry.total}}
        paths = if rendered==nil {geometry.paths} else {rendered} omitted = geometry.omitted
        if paths.len()>4 {let available=[] for entry in map_path_catalog(candidate) {available.push(entry.index)} return {params:"" markers:[] paths:[] omitted:omitted error:"高德每图最多4条独立折线；本次未发请求，请按map_paths目录选择path_indices分图；可用索引 "+available.to_json() selected:indices!=nil total:geometry.total}}
        if geometry.selected {markers=[] if paths.len()>0 {let first=paths[0].split(";") let last=paths[paths.len()-1].split(";") markers=[first[0] last[last.len()-1]]}}
    }
    let params = "&size=640*320&scale=1"
    if camera != nil {
        params = "&size=" + camera.source_width + "*" + camera.source_height + "&scale=1&location=" + (coordinate_six(camera.center_lon) + "," + coordinate_six(camera.center_lat)).url_encode() + "&zoom=" + camera.zoom
    }
    if markers.len() > 0 { let styles = [] for index marker in markers { let label = "A" if index == 1 || indices==nil && route_point(route_get(candidate, "requested_origin")) == nil { label = "B" } let point=route_point(marker) styles.push("mid,0x345D4A," + label + ":" + coordinate_six(point.lon)+","+coordinate_six(point.lat)) } params += "&markers=" + text_join(styles, "|").url_encode() }
    if paths.len() > 0 { let encoded = [] for path in paths { encoded.push("4,0x345D4A,1,,:" + path) } params += "&paths=" + text_join(encoded, "|").url_encode() }
    return {params: params markers: markers paths: paths omitted: omitted error:nil selected:indices!=nil}
}
// 仅生成相机的显示折线：保留每条真实路径端点，不改变原几何、目录或端点核验。
fn map_pixel_scale(zoom){let scale=256/360 for step in zoom {scale*=2} return scale}
fn map_pixel_distance_squared(a,b,scale){
 let latitude=abs(a.lat) if abs(b.lat)>latitude {latitude=abs(b.lat)}
 let cos_lat=cos(latitude*0.017453292519943295)
 let dx=(a.lon-b.lon)*scale let dy=(a.lat-b.lat)*scale/cos_lat
 return dx*dx+dy*dy
}
fn map_pixel_rounding_margin(a,b,scale){
 let latitude=abs(a.lat) if abs(b.lat)>latitude {latitude=abs(b.lat)}
 let cosine=cos(latitude*0.017453292519943295)
 return scale*0.0000005*sqrt(1+1/(cosine*cosine))*1.001
}
fn map_render_camera(candidate,geometry,camera){
 if camera!=nil {return camera}
 let bounds=nil for entry in map_path_catalog(candidate) {
  if geometry.selected {let include=false for path in geometry.paths {if path==map_geometry(candidate).paths[entry.index] {include=true}} if !include {continue}}
  let b=route_get(entry,"bounds") if b!=nil {bounds=map_bounds_add(bounds,{lon:b.west lat:b.south}) bounds=map_bounds_add(bounds,{lon:b.east lat:b.north})}
 }
 for value in [route_get(candidate,"requested_origin") route_get(candidate,"requested_destination")] {let point=route_point(value) if point!=nil {bounds=map_bounds_add(bounds,point)}}
 if bounds==nil {return nil}
 let zoom=1 let latitude=abs(bounds.south) if abs(bounds.north)>latitude {latitude=abs(bounds.north)}
 while zoom<18 {let scale=map_pixel_scale(zoom+1) if (bounds.east-bounds.west)*scale>576 || (bounds.north-bounds.south)*scale/cos(latitude*0.017453292519943295)>288 {break} zoom+=1}
 return {source_width:640 source_height:320 center_lon:(bounds.east+bounds.west)/2 center_lat:(bounds.south+bounds.north)/2 zoom:zoom}
}
fn prepare_map_render(slot,candidate,token,request,target_id){
 let geometry=selected_map_geometry(candidate,slot.path_indices)
 if geometry.error!=nil {map_slot_fail(slot,geometry.error) return}
 if geometry.paths.len()>4 {let rejected=static_map_params_selected(candidate,slot.camera,slot.path_indices) map_slot_fail(slot,rejected.error) return}
 let camera=map_render_camera(candidate,geometry,slot.camera)
 if camera==nil {map_slot_fail(slot,"没有可核实地图视口") return}
 let job={slot:slot candidate:candidate token:token request:request target_id:target_id geometry:geometry camera:camera scale:map_pixel_scale(camera.zoom) path_index:0 points:nil point_index:0 last:nil kept:[] paths:[]}
 start_timeout(0.01,||map_render_batch(job))
}
fn map_render_batch(job){
 if !map_slot_current(job.slot,job.token,job.request,job.target_id) {return}
 let work=0
 while work<100 {
  if job.points==nil {
   if job.path_index>=job.geometry.paths.len() {let geometry=static_map_params_rendered(job.candidate,job.camera,job.slot.path_indices,job.paths) dispatch_map_render(job.slot,job.candidate,job.token,job.request,job.target_id,geometry) return}
   job.points=job.geometry.paths[job.path_index].split(";") job.point_index=0 job.kept=[] job.last=nil
  }
  let point=route_point(job.points[job.point_index])
  if abs(point.lat)>=85 {map_slot_fail(job.slot,"静态地图当前投影不支持此纬度；原路线几何保留") return}
  // 最大纬度的Mercator导数给出距离上界，同时扣除六位坐标的像素舍入误差。
  let margin=map_pixel_rounding_margin(if job.last==nil {point} else {job.last},point,job.scale)
  if margin>=1 {map_slot_fail(job.slot,"当前缩放下六位坐标无法满足1像素显示误差；原几何保留") return}
  let tolerance=0.999-margin
  if job.last==nil || job.point_index==job.points.len()-1 || map_pixel_distance_squared(job.last,point,job.scale)>tolerance*tolerance {
   job.kept.push(coordinate_six(point.lon)+","+coordinate_six(point.lat)) job.last=point
  }
  job.point_index+=1 work+=1
  if job.point_index>=job.points.len() {job.paths.push(text_join(job.kept,";")) job.path_index+=1 job.points=nil}
 }
 start_timeout(0.01,||map_render_batch(job))
}
// 每幅地图持有独立目标、请求和代际；供应商字节不由模型提供。
let map_slots = {}
let map_generation = 0
let ui_render_generation = 0
fn invalidate_map(){ map_generation += 1 for id slot in map_slots { slot.request += 1 slot.bytes = nil slot.state = "stale" slot.status = "地图数据已过期" trace_map("map_stale",slot) } }
fn map_candidate(target){
    if trip_replay {let historical=trip_history_route(target) if historical!=nil {return historical}}
    if target == "saved_goal_route" && guardian_goal!=nil {return guardian_goal.selected_route}
    if target == "destination" && destination_record != nil { return {id: "destination:" + destination_record.id segments: [] requested_origin: nil requested_destination: destination_coord(destination_record)} }
    if target == "preview" && picker_preview_poi != nil { return {id: "preview:" + picker_preview_poi.id segments: [] requested_origin: nil requested_destination: coord_text(picker_preview_poi)} }
    return ui_route(target)
}
fn map_slot_current(slot, token, request, target_id){
    return token == run_id && slot.generation == map_generation && map_slots[slot.id] == slot && slot.request == request && route_get(map_candidate(slot.target), "id") == target_id
}
fn register_map(widget, target, status_widget, interactive){register_map_paths(widget,target,status_widget,interactive,nil)}
fn register_map_paths(widget,target,status_widget,interactive,indices){register_map_block(widget,target,status_widget,interactive,indices,"__document")}
fn register_map_block(widget,target,status_widget,interactive,indices,block_id){
    let key=block_map_key(block_id,widget)
    let slot = map_slots[key]
    if slot == nil || slot.target != target || slot.interactive != (interactive == true) || route_get(slot,"path_indices").to_json()!=indices.to_json() {
        slot = {id:key widget:widget block_id:block_id target: target path_indices:indices interactive: interactive == true camera: nil generation: map_generation request: 0 state: "new" status: "地图待加载" http_requested:false bytes: nil target_id: "" caption: "" handle: nil handle_generation: -1 loaded_generation: -1 loaded_request: -1 status_widget: status_widget}
        map_slots[key] = slot
    }
    slot.status_widget = status_widget
    trace_map("map_registered",slot)
    load_interface_map()
    update_map_widget(slot)
}
fn load_route_map(candidate){ load_interface_map() }
fn load_interface_map(){
    for id slot in map_slots {
        let candidate = map_candidate(slot.target)
        if candidate == nil { slot.request += 1 slot.bytes = nil slot.target_id = "" slot.state = "stale" slot.status = "地图引用已过期" trace_map("map_stale",slot) }
        elif slot.target_id != candidate.id || slot.generation != map_generation || slot.state == "new" || slot.state == "stale" {
            slot.request += 1 slot.generation = map_generation slot.target_id = candidate.id slot.bytes = nil
            slot.caption = if slot.target == "viewed" { "跟随查看：" } else { "绑定目标：" }
            if slot.path_indices!=nil {slot.caption += "所选折线 " + slot.path_indices.to_json() + "；"}
            slot.caption += if slot.target == "destination" { destination_record.name } elif slot.target == "preview" { picker_preview_poi.name } else { route_kind_label(candidate) + " · " + duration_text(candidate.duration_seconds) + " · " + route_cost_label(route_cost_facts(candidate)) }
            slot.state = "loading" slot.status = "地图加载中" slot.http_requested=false
            trace_map("map_loading",slot)
            let current = slot let route = candidate
            start_timeout(0.01, || { if current.interactive {fit_map_slot(current, route)} else {load_map_slot(current, route)} })
        }
    }
}
fn fit_map_slot(slot, candidate){
    if map_slots[slot.id] != slot || slot.generation != map_generation || slot.target_id != candidate.id {return}
    if route_get(map_geometry_owner(candidate),"map_paths_cache")==nil {ensure_map_catalog(candidate,fn(result){if map_slots[slot.id]==slot && slot.generation==map_generation && slot.target_id==candidate.id {if result.success {fit_map_slot(slot,candidate)} else {map_slot_fail(slot,result.error)}}}) return}
    let points = []
    let geometry=selected_map_geometry(candidate,slot.path_indices)
    if geometry.error!=nil {map_slot_fail(slot,geometry.error) return}
    if !geometry.selected {for value in [route_get(candidate, "requested_origin") route_get(candidate, "requested_destination")] {
        let point = route_point(value) if point != nil {points.push(point)}
    }}
    let catalog=map_path_catalog(candidate)
    let selected=slot.path_indices if selected==nil {selected=[] for entry in catalog {selected.push(entry.index)}}
    for index in selected {let entry=catalog[index] let bounds=route_get(entry,"bounds")
      if bounds!=nil {points.push({lon:bounds.west lat:bounds.south}) points.push({lon:bounds.east lat:bounds.north})}
      else {for value in map_geometry(candidate).paths[index].split(";") {let point=route_point(value) if point!=nil {points.push(point)}}}
    }
    if points.len()==0 {map_slot_fail(slot,"没有可核实几何或端点；此图不可用") return}
    let bounds={west:points[0].lon east:points[0].lon south:points[0].lat north:points[0].lat}
    for point in points {
        if point.lon<bounds.west {bounds.west=point.lon} if point.lon>bounds.east {bounds.east=point.lon}
        if point.lat<bounds.south {bounds.south=point.lat} if point.lat>bounds.north {bounds.north=point.lat}
    }
    try {map_widget(slot).set_visible(true) map_widget(slot).fit_bounds(bounds.west,bounds.south,bounds.east,bounds.north)}
    {map_slot_fail(slot,"交互地图控件初始化失败")}
}
fn map_camera_changed(event){
    let slot=map_slots[event.widget]
    if slot==nil || !slot.interactive {return}
    let candidate=map_candidate(slot.target) if candidate==nil {return}
    // camera/request由原生控件产生；父应用只绑定本次路线与网络响应。
    if slot.camera!=nil && event.request<=slot.camera.request {return}
    let width=event.width let height=event.height
    let scale=1.0 if width>1024 {scale=1024/width} if height*scale>1024 {scale=1024/height}
    let camera={center_lon:event.center_lon center_lat:event.center_lat zoom:event.zoom width:width height:height source_width:floor(width*scale) source_height:floor(height*scale) request:event.request}
    slot.camera=camera slot.request+=1 slot.bytes=nil slot.state="loading" slot.status="地图视口更新中"
    trace_map("map_camera",slot)
    update_map_widget(slot)
    let current=slot let route=candidate let request=slot.request
    start_timeout(0.01,||{if current.request==request {load_map_slot(current,route)}})
}
fn map_slot_fail(slot, text){ slot.state = "error" slot.status = text slot.bytes = nil trace_map("map_error",slot) update_map_widget(slot) }
fn load_map_slot(slot, candidate){
    let token = run_id let request = slot.request let target_id = candidate.id
    if !map_slot_current(slot, token, request, target_id) { return }
    if route_get(map_geometry_owner(candidate),"map_paths_cache")==nil {ensure_map_catalog(candidate,fn(result){if map_slot_current(slot,token,request,target_id) {if result.success {load_map_slot(slot,candidate)} else {map_slot_fail(slot,result.error)}}}) return}
    prepare_map_render(slot,candidate,token,request,target_id)
}
fn dispatch_map_render(slot,candidate,token,request,target_id,geometry){
    if !map_slot_current(slot,token,request,target_id) {return}
    if geometry.error!=nil {map_slot_fail(slot,geometry.error) return}
    if geometry.markers.len() == 0 { map_slot_fail(slot, "没有可核实端点；此图不可用") return }
    let detail = if geometry.selected {"本图分段端点，非全行程起终点；仅所选真实折线，缺口不补直线"} else {"路线概览；缺失几何不补直线"}
    if geometry.paths.len() == 0 { detail = "仅端点：供应商未提供可展示几何" }
    elif geometry.omitted > 0 { detail += "；供应商另有缺失几何未展示" }
    let private = nil try { let config = read_text("private-config.json") if config != nil { private = config.parse_json() } } { map_slot_fail(slot, "地图配置无效") return }
    let key = route_get(private, "amap_api_key")
    if !key.is_string() || key.trim() == "" { map_slot_fail(slot, "尚未配置地图服务") return }
    trace_emit("map_request",{widget:slot.id target_id:target_id request:request params:geometry.params},nil)
    let waiting = {settled: false}
    try {
        slot.http_requested=true
        net.http_request(net.HttpRequest{url: "https://restapi.amap.com/v3/staticmap?key=" + key.url_encode() + geometry.params method: net.HttpMethod.GET}) do net.HttpEvents{
            on_response: |res| {
                if waiting.settled { return } waiting.settled = true
                if !map_slot_current(slot, token, request, target_id) { return }
                if res.status_code != 200 { map_slot_fail(slot, "此图服务HTTP " + res.status_code + "；其它图和行程保留") return }
                let bytes = res.body
                trace_emit("map_response",{widget:slot.id request:request status:res.status_code bytes:bytes.len()},nil)
                start_timeout(0.01, || accept_map_slot(slot, bytes, token, request, target_id, detail))
            }
            on_error: |err| { if waiting.settled { return } waiting.settled = true  if map_slot_current(slot, token, request, target_id) { trace_emit("map_transport_error",{widget:slot.id target_id:target_id request:request error:""+err},nil) map_slot_fail(slot, "此图网络失败；其它图和行程保留") } }
        }
    } { waiting.settled = true  if map_slot_current(slot, token, request, target_id) { map_slot_fail(slot, "此图派发未完成；其它图和行程保留") } }
}
fn accept_map_slot(slot, bytes, token, request, target_id, detail){
    if !map_slot_current(slot, token, request, target_id) { return false }
    // 静态地图也会以 HTTP 200 返回业务错误 JSON，不能把它标为图片成功。
    let error = nil try { error = bytes.to_string().parse_json() } {}
    if error != nil && route_get(error, "status") != nil {
        map_slot_fail(slot, "地图服务未返回图片（" + route_get(error, "infocode") + "）：" + route_get(error, "info")) return false
    }
    slot.bytes = bytes slot.state = "ready" slot.status = "高德地图 © AutoNavi；" + detail trace_map("map_ready",slot) update_map_widget(slot)
    return true
}


fn view_route(id){
 let candidate=ui_route(id)
 if candidate==nil {
  viewed_route_id="" ui_facts_revision+=1
  for block in ui_blocks {if route_get(block,"route_detail")==true {block.visible=false block.detail_open_pending=false set_block_visibility(block)}}
  render_content() show_status("该内容不是本次可查看的路线；报价需要先关联到路线") return
 }
 // 选定事实不依赖可失败的地图目录；合法Route仍可先查看文本与真实步骤。
 id=candidate.id let token=run_id viewed_route_id=id ui_facts_revision+=1
 for block in ui_blocks {if route_get(block,"route_detail")==true && route_get(block,"detail_open_pending")==true {block.visible=true block.detail_open_pending=false set_block_visibility(block)}}
 render_content() guardian_refresh()
 ensure_map_catalog(candidate,fn(result){
  if token!=run_id || viewed_route_id!=id {return}
  ui_facts_revision+=1
  if result.success {load_interface_map()} else {show_status(result.error)}
  render_content()
 })
}

fn open_destination_picker(){
    if user_limits == nil { show_status("请先提供行程分钟数与预算") return }
    picker_preview_poi = nil
    picker_open = true picker_status = "输入地点名称；可跨城市搜索" picker_pois = []
    render_content()
}
fn close_destination_picker(){ picker_request += 1 picker_open = false picker_preview_poi = nil load_route_map(viewed_route()) render_content() }
fn preview_user_place(id){
    for poi in picker_pois { if poi.id == id { picker_preview_poi = poi load_route_map({id: "preview:" + poi.id segments: [] requested_origin: nil requested_destination: coord_text(poi)}) render_content() return } }
}
fn search_user_places(){ search_places_text(ui.place_query.text()) }
fn search_places_text(text){
    if !text.is_string() { picker_status = "地点查询需要文字" render_content() return }
    let query = text.trim()
    if query == "" { picker_status = "请输入地点名称" render_content() return }
    picker_request += 1 let request = picker_request let token = run_id let at = time_now()
    picker_status = "正在搜索地点" picker_pois = [] picker_preview_poi = nil invalidate_map() render_content()
    let city = ""
    if position_record != nil && route_get(position_record, "citycode").is_string() { city = "&city=" + position_record.citycode.url_encode() }
    // 用户搜索独立于自动机场发现，不删150104业务校验。
    user_place_request("&citylimit=false&extensions=all&children=1" + city + "&keywords=" + query.url_encode(), token, request, fn(data){
        if token != run_id || request != picker_request || !picker_open { return }
        picker_pois = parse_pois(data, at, false)
        picker_status = "请选择名称、地址与城市吻合的地点；航站楼入口仍需核验"
        if picker_pois.len() == 0 { picker_status = "没有可核实的地点结果，请换关键词" }
        render_content()
    })
}
fn user_place_request(params, token, request, done){
    let config = read_text("private-config.json") let private = nil
    try { if config != nil { private = config.parse_json() } } { picker_status = "本机地图配置无效" render_content() return }
    let key = route_get(private, "amap_api_key")
    if !key.is_string() || key.trim() == "" { picker_status = "本机尚未配置地点服务" render_content() return }
    let settled = {value: false}
    start_timeout(0.01, || {
        if token != run_id || request != picker_request {  return }
        try {
            net.http_request(net.HttpRequest{url: "https://restapi.amap.com/v3/place/text?key=" + key.url_encode() + params method: net.HttpMethod.GET}) do net.HttpEvents{
                on_response: |res| {
                    if settled.value { return } settled.value = true
                    if token != run_id || request != picker_request { return }
                    try { if res.status_code != 200 { picker_status = "地点服务暂不可用" render_content() return } let data = res.body.to_string().parse_json() if "" + route_get(data, "status") != "1" { picker_status = "地点服务未返回有效结果" render_content() return } done(data) } { picker_status = "地点响应无效，行程未改动" render_content() }
                }
                on_error: |err| { settled.value = true  if token == run_id && request == picker_request { picker_status = "地点网络失败，行程未改动" render_content() } }
            }
        } { settled.value = true  picker_status = "地点请求未能启动" render_content() }
    })
}
fn apply_user_poi(){
    if pending_user_poi == nil || !position_current(position_record) { return false }
    let poi = pending_user_poi
    if time_now() - poi.queried_at > 300 || poi.city_metadata == nil || position_record.currency != "CNY" { fail_task("所选地点已过期或城市计价依据不足，请重新选择") return true }
    if user_limits == nil { fail_task("本次缺少可识别的数字分钟数或小时数与预算") return true }
    if user_limits.currency != "unspecified" && user_limits.currency != "CNY" { fail_task("用户预算币种尚未核实为人民币") return true }
    poi.city = poi.city_metadata.city poi.citycode = poi.city_metadata.citycode poi.adcode = poi.city_metadata.adcode poi.currency = poi.city_metadata.currency
    if !(user_limits.minutes >= 1 && user_limits.minutes <= (9007199254740991 - received_at) / 60 && user_limits.minutes % 1 == 0 && user_limits.budget_cents >= 0 && user_limits.budget_cents <= 9007199254740991 && user_limits.budget_cents % 1 == 0) { fail_task("用户时限或预算无法安全计算，未采用地点") return true }
    arrive_by = received_at + user_limits.minutes * 60
    constraints = {airport: poi.name terminal: "" minutes: user_limits.minutes budget_cents: user_limits.budget_cents currency: "CNY" destination_query: poi.name objective: "min_cost" departure_scene: "" inferred: false user_selected: true currency_basis: "起终点城市已核实，按高德人民币计价"}
    destination_record = bind_destination_poi(poi)
    source_records.push({id: "user-poi-" + poi.id kind: "user" source: "user-poi-selection" mock: false raw: poi.to_json() source_time: "" + poi.queried_at read_at: time_now()})
    observe("user_destination", {destination: destination_record source: "explicit-user-poi" terminal_verified: false})
    return true
}


// Maps取消未改变业务对象；新渲染事件使用当前标识，旧已排队事件仍被拒绝。





fn destination_label(){
    if destination_record == nil { return "选择或纠正目的地" }
    let basis = "根据来源核实"
    if route_get(constraints, "user_selected") == true { basis = "你选择的地点；航站楼未核实" }
    elif route_get(constraints, "inferred") == true { basis = "根据位置推断；航站楼未知" }
    return destination_record.name + " · " + basis
}



fn candidate_text(candidate){
    let selected = "查看"
    if candidate.id == viewed_route_id { selected = "当前查看" }
    return selected + " · " + route_kind_label(candidate) + " · " + route_cost_label(route_cost_facts(candidate)) + " · " + duration_text(candidate.duration_seconds)
}
fn candidate_details(candidate){
    let check = route_recheck(candidate, time_now(), arrive_by, route_get(constraints, "budget_cents"))
    let text = check.reason + "。"
    if candidate.duration_seconds != nil { text += "预计到达 " + beijing_clock(check.estimated_arrival_ts) + "。" }
    text += route_description(candidate)
    return text
}

fn field_present(obj, key){
    for k v in obj { if "" + k == key { return true } }
    return false
}
fn note_value(raw, key){
    let prefix = key + ": "
    for line in raw.split("\n") { if line.search(prefix) == 0 { return line.strip_prefix(prefix).trim() } }
    return ""
}
fn show_status(text){ if runtime_status!=text {ui_facts_revision+=1} runtime_status = text render_content() }

fn remember_source(path, raw){
    source_snapshots.push({path: path raw: raw kind: "file"})
}
fn sources_current(){
    // 来源工具负责读取与校验；UI投影使用本轮已取得资料，不后台重读文件。
    return position_current(position_record)
}
fn render_content(){
    ui.feedback.render() ui.control.render() ui.answer_area.render() ui.trip_context.render()
    ui.composer.set_visible(composer_open || shell_composer_default())
    ui.control.set_visible(shell_control_visible())
    ui.trip_context.set_visible(!shell_composer_default())
    // 原版宿主不支持动态子控件寻址；其兼容页只使用静态外壳。
    if native_ui_available && !shell_composer_default() {
      ui.shell_state.set_text(shell_history_line()) ui.shell_state.set_visible(!trip_replay)
      ui.history_info.set_text(shell_history_line()) ui.history_info.set_visible(trip_replay)
    }
    if !generated_area_ready {ui.generated_area.render() generated_area_ready = true}
    ui.generated_area.set_visible(generated_active && (answer_text == "" || generated_render_complete))
    let overlay_open=false for block in overlay_blocks {if block_actual_visible(block) && block.installed {overlay_open=true}}
    ui.content.set_visible(!overlay_open)
    for block in ui_blocks {set_block_visibility(block)}
    start_timeout(0.01, || {refresh_generated_facts() return true})
    return true
}
fn fail_task(text){
 show_status(text)
 if active_tool != nil { agent_tool_result({success:false error:text}) }
 else { agent_active = false phase = "failed" render_content() }
}
fn observe(tool, data){
    ui_facts_revision+=1
    observations.push({tool: tool observed_at: time_now() data: data})
}
fn mark_tool_used(name){
    for item in used_tools { if item == name { return true } }
    used_tools.push(name)
    return true
}

fn current_task(token){ return token == run_id && agent_active }
// 同一查询复用私有配置，避免每次供应商请求在关键入口同步重读；不进入事实或记录。
let private_config_cached=false
let private_config_text=nil
fn reset_private_config(){private_config_cached=false private_config_text=nil}
fn read_text(path){
 if path=="private-config.json" && private_config_cached {return private_config_text}
 let io=trace_io_begin("read",if path=="private-config.json" {"private_config"} elif path.search("skills/")==0 {"skill_resource"} else {"application_file"})
 let started=time_now() let value=read_text_unmeasured(path)
 trace_io_end(io)
 if path=="private-config.json" {private_config_text=value private_config_cached=true}
 if render_probe!=nil && render_probe.active {render_probe.reads+=1 render_probe.read_seconds+=time_now()-started}
 return value
}
fn read_text_unmeasured(path){
    if !fs.exists(path) { return nil }
    let text = fs.read(path)
    if !text.is_string() { return nil }
    return text
}
fn leap_year(year){ return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0) }
// 中国交通数据使用固定UTC+8；宿主local_time已经应用设备时区，不能再叠加八小时。
fn china_time(epoch){
 let seconds=epoch+28800 let second=seconds%60
 let minute_seconds=seconds-second let minute=(minute_seconds/60)%60
 let hour=(minute_seconds-minute*60)/3600%24
 let days=(minute_seconds-minute*60-hour*3600)/86400
 let year=1970
 while days>=if leap_year(year) {366} else {365} {days-=if leap_year(year) {366} else {365} year+=1}
 let months=[31 28 31 30 31 30 31 31 30 31 30 31] if leap_year(year) {months[1]=29}
 let month=0 while days>=months[month] {days-=months[month] month+=1}
 return {year:year month:month+1 day:days+1 hour:hour minute:minute second:second}
}
fn calendar_epoch(line){
    let value = ""
    let offset = 0
    if line.search("DTSTART;TZID=Asia/Shanghai:") == 0 {
        value = line.strip_prefix("DTSTART;TZID=Asia/Shanghai:") offset = 28800
        if regex("Z$", "").test(value) { return nil }
        value += "Z"
    } elif line.search("DTSTART:") == 0 {
        value = line.strip_prefix("DTSTART:")
        if !regex("Z$", "").test(value) { return nil }
    } else { return nil }
    let matched = regex("^([0-9]{4})([0-9]{2})([0-9]{2})T([0-9]{2})([0-9]{2})([0-9]{2})Z$", "").exec(value)
    if matched == nil { return nil }
    let c = matched.captures
    let year = c[1].to_f64() let month = c[2].to_f64() let day = c[3].to_f64()
    let hour = c[4].to_f64() let minute = c[5].to_f64() let second = c[6].to_f64()
    if !(year >= 1970 && year <= 2100 && month >= 1 && month <= 12 && hour <= 23 && minute <= 59 && second <= 59) { return nil }
    let month_days = [31 28 31 30 31 30 31 31 30 31 30 31]
    if leap_year(year) { month_days[1] = 29 }
    if !(day >= 1 && day <= month_days[month - 1]) { return nil }
    let days = day - 1
    for i in year - 1970 { if leap_year(1970 + i) { days += 366 } else { days += 365 } }
    for i in month - 1 { days += month_days[i] }
    return days * 86400 + hour * 3600 + minute * 60 + second - offset
}
fn calendar_tool(){
    let raw = read_text("demo/calendar.ics")
    if raw == nil { return false }
    remember_source("demo/calendar.ics", raw)
    calendar_events = []
    let event = nil
    let normalized = raw.replace(regex("\r", "g"), "").replace(regex("\n[ \t]", "g"), "")
    for line in normalized.split("\n") {
        if line == "BEGIN:VEVENT" { event = {id: "" starts_at: "" starts_at_unix: 0 updated_at: "" summary: "" location: "" raw: "" mock: true source: "simulated-calendar"} }
        if event != nil {
            event.raw += line + "\n"
            if line.search("UID:") == 0 { event.id = line.strip_prefix("UID:") }
            if line.search("DTSTART") == 0 { event.starts_at = line event.starts_at_unix = calendar_epoch(line) }
            if line.search("DTSTAMP:") == 0 { event.updated_at = line.strip_prefix("DTSTAMP:") }
            if line.search("SUMMARY:") == 0 { event.summary = line.strip_prefix("SUMMARY:") }
            if line.search("LOCATION:") == 0 { event.location = line.strip_prefix("LOCATION:") }
            if line == "END:VEVENT" {
                if event.id == "" || event.starts_at == "" || !event.starts_at_unix.is_number() { return false }
                calendar_events.push(event)
                source_records.push({id: event.id kind: "calendar" source: event.source mock: true source_time: event.updated_at raw: event.raw read_at: time_now()})
                event = nil
            }
        }
    }
    if calendar_events.len() == 0 || event != nil { return false }
    observe("read_calendar", calendar_events)
    return true
}
fn notes_tool(){
    if !fs.exists("demo/notes") { return false }
    note_records = []
    let names = fs.list("demo/notes")
    if !names.is_array() { return false }
    source_snapshots.push({path: "demo/notes" raw: names.to_json() kind: "directory"})
    for name in names {
        if regex("[.]md$", "").test(name) {
            let raw = read_text("demo/notes/" + name)
            if raw == nil { return false }
            remember_source("demo/notes/" + name, raw)
            let entry = {id: note_value(raw, "id") event_id: note_value(raw, "event_id") source: note_value(raw, "source") record_status: note_value(raw, "record_status") updated_at: note_value(raw, "updated_at") updated_at_unix: note_value(raw, "updated_at_unix").to_f64() airport: note_value(raw, "airport") terminal: note_value(raw, "terminal") raw: raw mock: true}
            if entry.id == "" || entry.updated_at == "" { return false }
            note_records.push(entry)
            source_records.push({id: entry.id kind: "note" source: entry.source mock: true source_time: entry.updated_at raw: raw read_at: time_now()})
        }
    }
    if note_records.len() == 0 { return false }
    observe("read_notes", note_records)
    return true
}
fn position_tool(){
    let raw = read_text("demo/location.json")
    if raw == nil { return false }
    let v = raw.parse_json()
    if !v.is_object() || !v.id.is_string() || !v.source.is_string() || v.mock != true || v.coordinate_system != "GCJ-02" { return false }
    if !(v.latitude >= -90 && v.latitude <= 90 && v.longitude >= -180 && v.longitude <= 180) { return false }
    if !(v.sampled_at_unix <= time_now() + 30 && time_now() - v.sampled_at_unix <= 900) { return false }
    remember_source("demo/location.json", raw)
    position_record = {id: v.id source: v.source mock: true sampled_at: v.sampled_at sampled_at_unix: v.sampled_at_unix name: v.name longitude: v.longitude latitude: v.latitude coordinate_system: v.coordinate_system}
    source_records.push({id: v.id kind: "location" source: v.source mock: true source_time: v.sampled_at raw: raw read_at: time_now()})
    return true
}
fn position_current(position){
    if position == nil || !position.sampled_at_unix.is_number() { return false }
    let max_age = 60
    if position.mock == true { max_age = 900 }
    elif position.mock != false || !position.accuracy_m.is_number() || !(position.accuracy_m > 0 && position.accuracy_m <= 100) { return false }
    return position.sampled_at_unix <= time_now() + 30 && time_now() - position.sampled_at_unix <= max_age
}
fn location_mode(){
    let config = read_text("private-config.json")
    if config == nil { return "live" }
    let private = config.parse_json()
    if !private.is_object() { return "invalid" }
    let mode = route_get(private, "location_mode")
    if mode == nil { return "live" }
    if mode == "live" || mode == "demo" { return mode }
    return "invalid"
}
// 高德只接收最多六位小数；保留来源的原始坐标，避免shader的f32舍入。
fn coordinate_six(value){
    let sign = ""
    if value < 0 { sign = "-" value = -value }
    let scaled = value * 1000000 + 0.5
    scaled -= scaled % 1
    let fraction = scaled % 1000000
    let whole = (scaled - fraction) / 1000000
    let fraction_text = "" + fraction
    while fraction_text.len() < 6 { fraction_text = "0" + fraction_text }
    return sign + whole + "." + fraction_text
}
fn location_failure(code){
    if code == "permission_denied" { return "定位权限被拒绝，请在系统设置中允许宿主使用位置后重新规划" }
    if code == "timeout" { return "设备定位超时，请稍后重新规划" }
    if code == "accuracy_insufficient" { return "定位精度不足，需要100米以内的设备定位" }
    if code == "stale_fix" { return "设备位置采样已过期，请重新规划获取位置" }
    if code == "background_not_allowed" { return "请在前台窗口中发起定位" }
    if code == "busy" { return "宿主正在定位，请稍后重新规划" }
    return "设备定位不可用，请检查系统定位服务和宿主授权"
}
let context_settings_open=false let context_settings_status="权限只在你点击后请求；未连接背景不会阻止明确地点规划。" let context_calendar_choices_cache=[]
fn context_settings_result(result){
 context_settings_status=if route_get(result,"error")!=nil {result.error} else {"日历状态："+result.status}
 let choices=route_get(result,"calendars") let calendar=route_get(result,"calendar")
 if choices.is_array(){
  context_calendar_choices_cache=choices
  context_settings_status=if choices.len()==0 {"宿主未返回可选择的日历；尚未选择日历。"} else {"找到"+choices.len()+"个日历，请选择要读取的日历。"}
 } elif route_get(result,"status")=="ready" && calendar.is_object() && route_get(calendar,"name").is_string(){
  context_calendar_choices_cache=[] context_settings_status="已选择日历："+calendar.name+"；尚未读取事件。"
 } elif route_get(result,"status")!="ready" && route_get(result,"status")!="selection_needed" {context_calendar_choices_cache=[]}
 ui.context_settings.render()
}
fn context_request_location(){
 host.request("location.permission.request",{},fn(reply){
  context_settings_status=if !reply.is_ok {"位置授权失败："+reply.error} else {"位置授权："+route_get(reply.data,"os_permission")+"；只有已授权前台位置会用于查询。"}
  ui.context_settings.render()
 })
}
fn location_dispatch(args, done){ return host.request("location.sample", args, done) }
fn location_cancel_dispatch(args){ host.request("location.sample.cancel", {}, fn(r){}) }
fn cancel_pending_location(){
    if pending_location == nil { return }
    let waiting = pending_location
    pending_location = nil waiting.settled = true
    if waiting.timer != nil { stop_timer(waiting.timer) }
    try { location_cancel_dispatch({}) } {}
}
fn live_position(token, done){
    show_status("正在获取设备位置；位置会发送给高德核对坐标与城市")
    let waiting = {settled: false request_id: nil timer: nil}
    pending_location = waiting
    try {
        waiting.request_id = location_dispatch({timeout_ms:10000 max_age_ms:60000 max_accuracy_m:100}, fn(r){
            if waiting.settled { return }
            waiting.settled = true
            pending_location = nil
            if !current_task(token) { return }
            try {
                if !r.is_ok { fail_task("设备定位失败："+r.error+"；请在背景与权限中授权位置后重新规划") return }
                let fix = r.data
                if !fix.is_object() {fail_task("宿主定位数据格式无效") return}
                let lat = route_get(fix, "latitude") let lon = route_get(fix, "longitude")
                let sampled_at = route_get(fix, "timestamp") let accuracy = route_get(fix, "accuracy_m")
                if route_get(fix, "source") != "platform" || route_get(fix,"freshness")!="fresh" || !sampled_at.is_number() || !lat.is_number() || !lon.is_number() || !(lat >= -90 && lat <= 90 && lon >= -180 && lon <= 180) { fail_task("宿主定位数据格式无效") return }
                let record = {id: "device-location-live" source: "platform" mock: false sampled_at: "" + sampled_at sampled_at_unix: sampled_at accuracy_m: accuracy
                    original_longitude: lon original_latitude: lat original_coordinate_system: "WGS84" coordinate_system: "GCJ-02" conversion_source: "amap-coordinate-convert"}
                if !position_current(record) { fail_task("设备位置已过期或定位精度不足，请重新规划") return }
                let input = coordinate_six(lon) + "," + coordinate_six(lat)
                amap_request("/v3/assistant/coordinate/convert", "&locations=" + input + "&coordsys=gps&output=JSON", token, fn(data){
                    let point = route_point(route_get(data, "locations"))
                    if point == nil { fail_task("位置坐标转换失败，不能查询交通路线") return }
                    record.longitude = point.lon record.latitude = point.lat record.converted_at = time_now()
                    verify_position_city(record, token, done)
                })
            } { fail_task("宿主定位响应缺少必要字段") }
        })
    } {
        waiting.settled = true
        pending_location = nil
        if current_task(token) { fail_task("宿主定位请求未能启动，请检查定位能力授权") }
    }
}
// 高德大陆服务使用人民币；行政区元数据不证明供应商一定返回可行路线。
fn amap_city(city, code, adcode, province){
    let metadata = nil
    if code.is_string() && regex("^[0-9]{3,4}$", "").test(code) && adcode.is_string() && regex("^(11|12|13|14|15|21|22|23|31|32|33|34|35|36|37|41|42|43|44|45|46|50|51|52|53|54|61|62|63|64|65)[0-9]{4}$", "").test(adcode) {
        if city.is_string() && city.trim() != "" { metadata = {city: city citycode: code adcode: adcode currency: "CNY"} }
        elif province == "北京市" || province == "上海市" || province == "天津市" || province == "重庆市" { metadata = {city: province citycode: code adcode: adcode currency: "CNY"} }
    }
    return metadata
}
fn verify_position_city(record, token, done){
    amap_request("/v3/geocode/regeo", "&location=" + coordinate_six(record.longitude) + "," + coordinate_six(record.latitude) + "&extensions=base&radius=0&output=JSON", token, fn(city_data){
        let address = route_get(route_get(city_data, "regeocode"), "addressComponent")
        let city = amap_city(route_get(address, "city"), route_get(address, "citycode"), route_get(address, "adcode"), route_get(address, "province"))
        if route_get(address, "country") != "中国" || city == nil { fail_task("位置城市元数据缺失或不在当前高德大陆计价覆盖内，不能确定交通城市与币种") return }
        if !position_current(record) { fail_task("核对城市期间位置已过期，请重新规划") return }
        record.city = city.city record.citycode = city.citycode record.adcode = city.adcode record.currency = city.currency
        record.city_source = "amap-regeo" record.city_checked_at = time_now()
        if record.mock == false { record.name = "设备当前位置（" + city.city + "）" }
        position_record = record
        let raw = record.to_json()
        if record.mock == false { source_snapshots.push({kind: "location" raw: raw}) }
        for source in source_records { if source.kind == "location" && source.id == record.id { source.raw = raw } }
        if record.mock == false { source_records.push({id: record.id kind: "location" source: record.source mock: false source_time: record.sampled_at raw: raw read_at: time_now()}) }
        observe("read_location", record)
        done()
    })
}
fn validate_citations(items){
    if !items.is_array() || items.len() < 2 { return reject_constraints("来源引用至少需要所选日历事件和关联机票笔记各一条") }
    let calendar_cited = false let note_cited = false
    for index citation in items {
        if !citation.is_object() || !route_get(citation,"source_id").is_string() { return reject_constraints("来源引用第"+(index+1)+"项缺少source_id；使用读取结果的记录id") }
        let id=citation.source_id
        if !route_get(citation,"quote").is_string() || citation.quote.trim()=="" {return reject_constraints("来源引用 "+id+" 缺少非空quote；逐字引用该记录raw中的单行原文")}
        if citation.quote.search("\n") >= 0 || citation.quote.search("\r") >= 0 || citation.quote.search("\\n") >= 0 || citation.quote.search("\\r") >= 0 {return reject_constraints("来源引用 "+id+" 的quote跨行；仅使用该记录raw中的单行原文")}
        let found = false let matched = false
        for source in source_records {
            if source.id == id {
                found=true
                if source.raw.search(citation.quote) >= 0 {
                    matched=true
                    if source.kind == "calendar" {calendar_cited=true}
                    if source.kind == "note" {note_cited=true}
                }
            }
        }
        if !found {return reject_constraints("来源引用source_id未知："+id+"；使用read_calendar/read_notes返回的记录id，本次用户原文ID为current-input")}
        if !matched {return reject_constraints("来源引用 "+id+" 的quote不匹配该记录raw；不要将用户指令或其它记录的文字归到此ID")}
    }
    if !calendar_cited {return reject_constraints("来源引用缺少calendar日历记录；引用所选event_id对应raw的单行原文")}
    if !note_cited {return reject_constraints("来源引用缺少note机票笔记；引用所选note_id对应raw的单行原文")}
    return true
}
fn declared_currency(text){
    let value = ""
    let currency_at = text.search("币种") let money_at = text.search("货币")
    let key = "币种"
    if money_at >= 0 && (currency_at < 0 || money_at < currency_at) { key = "货币" }
    let statements = text.split(key)
    if statements.len() >= 2 {
        let tail = statements[1]
        if tail.search("是") == 0 { tail = tail.strip_prefix("是") }
        elif tail.search("为") == 0 { tail = tail.strip_prefix("为") }
        elif tail.search(":") == 0 { tail = tail.strip_prefix(":") }
        elif tail.search("：") == 0 { tail = tail.strip_prefix("：") }
        let ended = false
        for ch in tail.split("") {
            if ch == "，" || ch == "," || ch == "。" || ch == "；" || ch == ";" || ch == "!" || ch == "?" || ch == "！" || ch == "？" { ended = true }
            if !ended { value += ch }
        }
        value = value.trim()
    }
    let settlements = text.split("结算")
    if settlements.len() >= 2 {
        let prefixes = settlements[0].split("用")
        if prefixes.len() >= 2 {
            let settlement = "" let valid = true
            for ch in prefixes[prefixes.len() - 1].split("") {
                if ch == "，" || ch == "," || ch == "。" || ch == "；" || ch == ";" || ch == "!" || ch == "?" || ch == "！" || ch == "？" { valid = false }
                settlement += ch
            }
            if valid && settlement != "" { value = settlement.trim() }
        }
    }
    let currency = "unspecified"
    if value != "" {
        currency = "unsupported"
        if regex("^(人民币|CNY|RMB)$", "i").test(value) { currency = "CNY" }
        if value == "元" || value == "¥" || value == "￥" { currency = "unspecified" }
    }
    return currency
}
// 明确数字分钟或小时转为整数分钟；混合单位与无法识别的硬约束仍返回缺失。
fn explicit_limits(text){
    let compact = text.replace(regex("[ \t]", "g"), "")
    let time_parts = compact.split("分钟")
    let time_multiplier = 1
    let hours = compact.split("小时")
    if hours.len() == 2 {
        if time_parts.len() != 1 { return nil }
        time_parts = hours time_multiplier = 60
    }
    if time_parts.len() != 2 { return nil }
    let minute_text = ""
    for ch in time_parts[0].split("") {
        if ch != "" { if regex("^[0-9.]$", "").test(ch) { minute_text += ch } else { minute_text = "" } }
    }
    let minutes = route_seconds(minute_text)
    if minutes != nil { minutes *= time_multiplier }
    if minutes == nil || minutes < 1 || minutes > 9007199254740991 / 60 { return nil }
    let cents=nil let currency="unspecified" let currency_marker=nil
    for index statement in compact.split("预算") {
        if index==0 {continue}
        let amount_text="" let ended=false
        let budget_text=statement.strip_prefix("人民币").strip_prefix("CNY").strip_prefix("RMB").strip_prefix("¥").strip_prefix("￥")
        for ch in budget_text.split("") {
            if ch!="" && !ended {if regex("^[0-9.]$", "").test(ch) {amount_text+=ch} else {ended=true}}
        }
        // “守护预算”等非数字提及不构成第二声明；无法识别的数字声明不能被跳过。
        if amount_text=="" {if regex("^[^，,。；;!?！？]*[0-9]", "").test(statement) {return nil} continue}
        let amount=route_cents(amount_text) if amount==nil || (cents!=nil && cents!=amount) {return nil}
        let incoming_currency="unspecified"
        let tail = budget_text.strip_prefix(amount_text)
        let suffix = "" let suffix_ended = false
        for ch in tail.split("") {
            if ch == "，" || ch == "," || ch == "。" || ch == "；" || ch == ";" || ch == "!" || ch == "?" || ch == "！" || ch == "？" { suffix_ended = true }
            if !suffix_ended { suffix += ch }
        }
        if suffix != "" && suffix != "元" && suffix != "块" && suffix != "块钱" && suffix != "以内" && suffix != "以下" && suffix != "元以内" && suffix != "元以下" { incoming_currency = "unsupported" }
        if statement.search("人民币") == 0 || statement.search("CNY") == 0 || statement.search("RMB") == 0 || suffix == "人民币" || suffix == "元人民币" || suffix == "CNY" || suffix == "RMB" { incoming_currency = "CNY" }
        if incoming_currency == "CNY" && suffix != "" && suffix != "元" && suffix != "人民币" && suffix != "元人民币" && suffix != "CNY" && suffix != "RMB" && suffix != "以内" && suffix != "以下" && suffix != "元以内" && suffix != "元以下" { incoming_currency = "unsupported" }

        let marker=if incoming_currency=="unspecified" {nil} elif incoming_currency=="CNY" {"CNY"} else {suffix}
        if marker!=nil && currency_marker!=nil && marker!=currency_marker {return nil}
        if marker!=nil {currency_marker=marker currency=incoming_currency}
        cents=amount
    }
    if cents==nil {return nil}
    let declaration=declared_currency(text)
    if declaration!="unspecified" {if currency!="unspecified" && currency!=declaration {return nil} currency=declaration}
    return {minutes:minutes budget_cents:cents currency:currency}
}
fn reject_constraints(reason){ constraint_error = reason + "；尚未查询路线" return false }
fn set_constraints(p){
    constraint_error = ""
    if !p.is_object() { return reject_constraints("模型约束参数格式无效") }
    if !p.event_id.is_string() || !p.note_id.is_string() { return reject_constraints("模型缺少日历事件或机票笔记引用") }
    if !p.minutes.is_number() || !p.budget_cents.is_number() { return reject_constraints("模型的分钟数或预算格式无效，未改动用户原值") }
    if calendar_events.len() == 0 || note_records.len() == 0 || position_record == nil { return reject_constraints("日历、机票笔记或位置来源缺失") }
    if !position_current(position_record) { return reject_constraints("位置来源已过期或无效，请重新规划") }
    if user_limits == nil {
        return reject_constraints("本次缺少明确的数字分钟数与预算，例如：40分钟内到机场，预算50元。")
    }
    if user_limits.currency != "CNY" && user_limits.currency != "unspecified" { return reject_constraints("高德本次提供人民币估价，不能直接与其它币种预算比较。本次缺少明确的人民币预算和分钟数。") }
    if p.minutes != user_limits.minutes || p.budget_cents != user_limits.budget_cents { return reject_constraints("模型的分钟数或预算与用户明确指令不符，未改动用户原值") }
    if !(p.minutes >= 1 && p.minutes <= (9007199254740991 - received_at) / 60 && p.minutes % 1 == 0) { return reject_constraints("分钟数无法安全计算到达期限") }
    if !(p.budget_cents >= 0 && p.budget_cents <= 9007199254740991 && p.budget_cents % 1 == 0) { return reject_constraints("预算必须为可精确表示的非负整数分") }
    if position_record.currency != "CNY" { return reject_constraints("位置尚未核实人民币计价依据，无法确定预算币种。") }
    if p.currency != "CNY" { return reject_constraints("模型预算币种不是人民币，无法与本次报价比较") }
    if !p.destination_query.is_string() || p.destination_query.trim() == "" { return reject_constraints("模型缺少目的地查询文字") }
    if !validate_citations(p.citations) { return false }
    let event_cited = false
    let note_cited = false
    for citation in p.citations { if citation.source_id == p.event_id { event_cited = true } if citation.source_id == p.note_id { note_cited = true } }
    if !event_cited { return reject_constraints("来源引用未覆盖所选日历event_id："+p.event_id) }
    if !note_cited { return reject_constraints("来源引用未覆盖所选机票note_id："+p.note_id) }
    let event_found = false
    for event in calendar_events {
        if event.id == p.event_id && event.starts_at_unix >= received_at { event_found = true }
    }
    if !event_found { return reject_constraints("所选日历事件不存在或出发时间已过") }
    let associated = []
    for note in note_records { if note.event_id == p.event_id && note.record_status == "current" { associated.push(note) } }
    if associated.len() == 0 { return reject_constraints("所选日历事件没有有效的关联机票笔记") }
    let selected_note = nil
    for note in associated { if note.id == p.note_id { selected_note = note } }
    if location_mode() != "demo" { return reject_constraints("模拟日历与机票笔记不能确定真实机场，请查询机场候选") }
    if selected_note == nil || selected_note.airport == "" || selected_note.terminal == "" { return reject_constraints("所选有效机票笔记尚未明确机场及航站楼") }
    if p.destination_query.search(selected_note.airport) < 0 || p.destination_query.search(selected_note.terminal) < 0 { return reject_constraints("模型目的地与已引用的机场或航站楼不符") }
    let scene_conflict = false
    let selected_scene = ""
    if selected_note.raw.search("国内出发") >= 0 { selected_scene = "国内出发" }
    if selected_note.raw.search("国际出发") >= 0 { selected_scene = "国际出发" }
    for note in associated {
        if (note.raw.search("国内出发") >= 0) != (selected_note.raw.search("国内出发") >= 0) || (note.raw.search("国际出发") >= 0) != (selected_note.raw.search("国际出发") >= 0) { scene_conflict = true }
    }
    let user_resolution = false
    let resolved_scene = ""
    for citation in p.citations {
        for source in source_records {
            if source.id == citation.source_id && source.kind == "user" && source.source == "explicit-current-input" && !source.mock && source.raw.search(citation.quote) >= 0 && source.raw.search(selected_note.airport) >= 0 && source.raw.search(selected_note.terminal) >= 0 {
                let source_scene = ""
                if source.raw.search("国内出发") >= 0 && source.raw.search("国际出发") < 0 { source_scene = "国内出发" }
                if source.raw.search("国际出发") >= 0 && source.raw.search("国内出发") < 0 { source_scene = "国际出发" }
                let selected_both = selected_note.raw.search("国内出发") >= 0 && selected_note.raw.search("国际出发") >= 0
                if !scene_conflict || (source_scene != "" && source_scene == selected_scene) || (selected_both && source_scene != "") { user_resolution = true }
                if source_scene != "" && (source_scene == selected_scene || selected_both) { resolved_scene = source_scene }
            }
        }
    }
    for note in associated {
        if note.airport == "" || note.terminal == "" { return reject_constraints("关联机票笔记缺少机场或航站楼，尚不能确定目的地") }
        if !user_resolution && (note.airport != selected_note.airport || note.terminal != selected_note.terminal || (note.raw.search("国内出发") >= 0) != (selected_note.raw.search("国内出发") >= 0) || (note.raw.search("国际出发") >= 0) != (selected_note.raw.search("国际出发") >= 0)) {
            return reject_constraints("日历对应的有效机票笔记存在机场、航站楼或出发区域冲突，尚未确定本次出发地点。")
        }
    }
    let departure_scene = ""
    if selected_note.raw.search("国内出发") >= 0 { departure_scene = "国内出发" }
    if selected_note.raw.search("国际出发") >= 0 { if departure_scene != "" { if resolved_scene == "" { return reject_constraints("机票笔记的国内与国际出发场景冲突，尚未确定出发区域。") } departure_scene = resolved_scene } else { departure_scene = "国际出发" } }
    // 出发区域已由引用笔记核实，模型遗漏时由执行器构造完整查询。
    if departure_scene != "国内出发" && p.destination_query.search("国内出发") >= 0 || departure_scene != "国际出发" && p.destination_query.search("国际出发") >= 0 { return reject_constraints("模型出发区域与有效机票来源矛盾") }
    let destination_query = selected_note.airport + " " + selected_note.terminal
    if departure_scene != "" { destination_query += " " + departure_scene }
    let currency_basis = position_record.city + "已核实为大陆城市；高德人民币计价；未明确币种的预算按地域推断为CNY"
    if user_limits.currency == "CNY" { currency_basis = "用户明确人民币预算；" + position_record.city + "已核实为大陆城市；按高德人民币计价比较" }
    constraints = {airport: selected_note.airport terminal: selected_note.terminal note_id: p.note_id minutes: p.minutes budget_cents: p.budget_cents currency: "CNY" destination_query: destination_query event_id: p.event_id citations: p.citations objective: "min_cost" departure_scene: departure_scene currency_basis: currency_basis inferred: false}
    arrive_by = received_at + p.minutes * 60
    observe("set_constraints", {constraints: constraints received_at: received_at arrive_by: arrive_by})
    return true
}
fn amap_request(path, params, token, done){
    if path != "/v3/place/text" && path != "/v5/direction/transit/integrated" && path != "/v5/direction/driving" && path != "/v5/direction/walking" && path != "/v3/assistant/coordinate/convert" && path != "/v3/geocode/regeo" { fail_task("地图工具路径无效") return }
    let config = read_text("private-config.json")
    if config == nil { fail_task("本机尚未配置地图服务") return }
    let private = config.parse_json()
    if !private.is_object() || !private.amap_api_key.is_string() || private.amap_api_key.trim() == "" { fail_task("本机地图配置无效") return }
    let url = "https://restapi.amap.com" + path + "?key=" + private.amap_api_key.url_encode() + params
    let response_state = {settled: false owner:current_tool_job()}
    try {
        net.http_request(net.HttpRequest{url: url method: net.HttpMethod.GET}) do net.HttpEvents{
            on_response: |res| {
                if response_state.settled { return }
                response_state.settled = true
                if !current_task(token) || (response_state.owner!=nil && !tool_job_current(response_state.owner)) {return}
                try {
                    if res.status_code != 200 { fail_task("地图服务暂时不可用") return }
                    let raw=res.body.to_string() let owner=response_state.owner
                    if owner!=nil {agent_provider_diagnostic={job_id:owner.id run:owner.token call_id:owner.call.id provider:"amap" response_text:raw received_at:time_now()}}
                    tool_timeout(0.01,owner,"provider_response",||{
                     let data=raw.parse_json()
                     if !data.is_object() || ""+data.status!="1" {fail_task("地图服务未能返回有效结果，请检查本机配置") return}
                     done(data)
                    })
                } { fail_task("地图响应缺少必要字段") }
            }
            on_error: |err| {
                if response_state.settled { return }
                response_state.settled = true
                if current_task(token) && (response_state.owner==nil || tool_job_current(response_state.owner)) {fail_task("网络请求失败，请稍后重新规划")}
            }
        }
    } {
        response_state.settled = true
        if current_task(token) { fail_task("地图请求未能启动") }
    }
}
fn parse_pois(data, at, airports_only){
    let result = []
    let pois = route_get(data, "pois")
    if !pois.is_array() { return result }
    for poi in pois {
        let typecode = route_get(poi, "typecode")
        let location = route_get(poi, "location")
        let entrance = route_get(poi, "entr_location")
        let point = route_point(location) let coordinate_basis = "location"
        if point != nil && route_get(poi, "id").is_string() && route_get(poi, "name").is_string() && poi.id != "" && poi.name != "" && (!airports_only || typecode == "150104") {
            let city = amap_city(route_get(poi, "cityname"), route_get(poi, "citycode"), route_get(poi, "adcode"), route_get(poi, "pname"))
            let entry_point=route_point(entrance) let entry=nil
            if entry_point!=nil {entry={ref:"entrance:"+poi.id name:poi.name+"（高德标注入口）" canonical_poi_ref:"poi:"+poi.id parent_facility_id:poi.id parent:route_get(poi,"parent") longitude:entry_point.lon latitude:entry_point.lat coordinate_system:"GCJ-02" coordinate_basis:"entr_location" source:"amap-poi-entrance" queried_at:at city_metadata:city}}
            result.push({id: poi.id node_ref:"poi:"+poi.id name: poi.name typecode: typecode type: route_get(poi, "type") parent: route_get(poi, "parent") longitude: point.lon latitude: point.lat coordinate_system: "GCJ-02" coordinate_basis: coordinate_basis entrance:entry source: "amap-poi" address: route_get(poi, "address") queried_at: at returned_at: time_now() city_metadata: city})
        }
    }
    return result
}

fn find_destination(token){
    if constraints == nil { fail_task("目的地约束尚未形成") return }
    if route_get(constraints, "inferred") == true { fail_task("推断机场应选择本次机场查询候选") return }
    let at = time_now()
    if position_record == nil || position_record.currency != "CNY" { fail_task("地点查询缺少已核实的出发城市与币种") return }
    amap_request("/v3/place/text", "&city=" + position_record.citycode.url_encode() + "&citylimit=false&extensions=all&keywords=" + constraints.destination_query.url_encode(), token, fn(data){
        poi_records = parse_pois(data, at, false) register_route_pois(poi_records)
        if poi_records.len() == 0 { fail_task("地点服务未返回可选目的地") return }
        observe("find_destination", poi_records)
        finish_tool_from_state(token)
    })
}
fn reject_destination(reason){ destination_error = reason return false }
fn select_destination(p, reason){
    destination_error = ""
    if constraints == nil { return reject_destination("目的地约束尚未形成，不能选择机场") }
    if destination_record != nil { return reject_destination("本次目的地已选定，输入修正信息后才能重新选择") }
    if !p.is_object() || !route_get(p, "poi_id").is_string() { return reject_destination("目的地选择缺少有效POI标识") }
    let poi=route_poi(p.poi_id)
    if poi!=nil {
        if poi.id == p.poi_id {
            if route_get(constraints, "inferred") == true {
                if route_get(poi, "typecode") != "150104" { return reject_destination("该地点不是机场类别，不能作为机场推断目标") }
                if regex("暂停营业|停止营业|已关闭|停用", "").test(poi.name) { return reject_destination("该机场地点明确标注暂停营业或已关闭，不能作为本次规划目标") }
                if !reason.is_string() || reason.trim() == "" { return reject_destination("机场推断缺少选择理由，不能说明目的地依据") }
                if !position_current(position_record) { fail_task("机场选择时位置已过期，请重新查询") return true }
                if !poi.queried_at.is_number() || time_now() - poi.queried_at > 300 { fail_task("机场查询结果已过期，请重新查询") return true }
            } else {
                if poi.name.search(constraints.airport) < 0 && (!poi.address.is_string() || poi.address.search(constraints.airport) < 0) { let address=if poi.address.is_string() {poi.address} else {"未提供"} return reject_destination("机票机场身份未匹配；来源note_id="+constraints.note_id+"，期望airport="+constraints.airport+"；POI id="+poi.id+"，name="+poi.name+"，address="+address+"。名称或地址须含完整机票机场名；本次目的地未采用") }
                if regex("停车|酒店|宾馆|货运|到达", "").test(poi.name) { return reject_destination("所选地点是停车、住宿、货运或到达区域，不是所需出发地点") }
                if poi.name.search(constraints.terminal) < 0 { return reject_destination("所选地点航站楼与机票来源不符") }
                if constraints.departure_scene != "" && poi.name.search(constraints.departure_scene) < 0 { return reject_destination("所选地点的国内或国际出发区域与机票来源不符") }
            }
            if poi.city_metadata == nil { fail_task("目的地城市元数据缺失或不在当前高德大陆计价覆盖内，不能查询交通或确定币种") return true }
            poi.city = poi.city_metadata.city poi.citycode = poi.city_metadata.citycode poi.adcode = poi.city_metadata.adcode poi.currency = poi.city_metadata.currency
            constraints.currency_basis += "；终点" + poi.city + "已核实为大陆城市"
            if route_get(constraints, "inferred") == true {
                constraints.airport = poi.name constraints.destination_query = poi.name
                constraints.inference = {kind: "location_and_airport_query" reason: reason location_source: position_record.id location_sampled_at: position_record.sampled_at_unix origin_city: position_record.city poi_id: poi.id poi_source: poi.source poi_queried_at: poi.queried_at terminal_verified: false}
            }
            destination_record = bind_destination_poi(poi) observe("select_destination", {destination: destination_record inferred: route_get(constraints, "inferred") inference: route_get(constraints, "inference")}) return true
        }
    }
    return reject_destination("目的地ID不属于本次可选地点查询结果")
}

fn coord_text(position){ return "" + position.longitude + "," + position.latitude }
fn destination_coord(record){let point=route_get(record,"routing_point") return coord_text(if point!=nil {point} else {record})}
fn bind_destination_poi(poi){
 let result={} for key value in poi {result[key]=value}
 let entry=route_get(poi,"entrance")
 // 只对明确航站楼设施采用其入口，不把具体门、区域或用户坐标改成别处。
 if entry!=nil && route_get(poi,"typecode")=="150104" && regex("T[0-9]+","").test(poi.name) && poi.name.search("航站楼")>=0 && !regex("门|入口|出口|到达|出发|楼层","").test(poi.name) {
  result.routing_point=entry
  result.destination_access={canonical_poi_ref:"poi:"+poi.id routing_point:entry target_kind:"amap_poi_entrance" interior_status:"unknown" floor_status:"unknown" security_status:"unknown" basis:"采用明确航站楼设施，默认路由到该POI的高德entr_location；不是用户指定具体入口"}
 }
 return result
}
fn attach_destination_access(candidate){candidate.destination_access=route_get(destination_record,"destination_access")}
fn route_target_node(ref){
 if destination_record!=nil && route_get(destination_record,"routing_point")!=nil && (ref=="poi:"+destination_record.id || ref==destination_record.routing_point.ref) {return route_node("destination")}
 return route_node(ref)
}
fn assign_candidate_ref(candidate){
 candidate_sequence+=1 candidate.id="route_"+run_id+"_"+candidate_sequence candidate.geometry_ref="polyline_"+run_id+"_"+candidate_sequence
}
fn add_candidates(data, driving, at, departure_at, tool){
    let normalized = route_candidates(data, driving, at, arrive_by, constraints.budget_cents, route_later(time_now(), departure_at))
    let response_route = route_get(data, "route")
    if data == nil { response_route = route_get(driving, "route") }
    let requested_origin = coord_text(position_record)
    let requested_destination = destination_coord(destination_record)
    let echoed_origin_gap = route_endpoint_gap(route_get(response_route, "origin"), requested_origin)
    let echoed_destination_gap = route_endpoint_gap(route_get(response_route, "destination"), requested_destination)
    let request_bound = echoed_origin_gap != nil && echoed_origin_gap <= 25 && echoed_destination_gap != nil && echoed_destination_gap <= 25
    for candidate in normalized {
        assign_candidate_ref(candidate)
        register_route_stations(candidate.segments)
        candidate.stations_registered_generation=route_node_generation
        candidate.planned_departure_at = departure_at
        candidate.departure_ts = departure_at
        candidate.requested_origin = requested_origin
        candidate.requested_destination = requested_destination
        candidate.request_bound = request_bound
        candidate.actual_origin = route_leg_endpoint(candidate.segments,true)
        candidate.origin_gap_m = route_endpoint_gap(candidate.actual_origin, requested_origin)
        candidate.origin_complete = candidate.origin_gap_m != nil && candidate.origin_gap_m <= 25
        candidate.endpoint_gap_m = route_endpoint_gap(candidate.actual_endpoint, requested_destination)
        candidate.endpoint_complete = candidate.endpoint_gap_m != nil && candidate.endpoint_gap_m <= 25
        attach_destination_access(candidate)
        let checked = route_recheck(candidate, time_now(), arrive_by, route_get(constraints, "budget_cents"))
        candidate.reason = checked.reason candidate.feasible = checked.passed
        candidates.push(candidate)
        normalize_queried_route(candidate)
    }
    let summarized = []
    // 旧候选已在前次查询观察中；本次只记录新增候选，避免多策略重复放大模型输入。
    for candidate in normalized {
        summarized.push({id: candidate.id kind: candidate.kind duration_seconds: candidate.duration_seconds price_cents: candidate.price_cents currency: candidate.currency feasible: candidate.feasible reason: candidate.reason request_bound: candidate.request_bound origin_complete: candidate.origin_complete endpoint_complete: candidate.endpoint_complete waiting_included: candidate.waiting_included source_ts: candidate.source_ts expires_at: candidate.expires_at waiting_basis: candidate.waiting_basis taxi_wait_verified: candidate.taxi_wait_verified warnings: candidate.warnings})
    }
    observe(tool, summarized)
}
fn minute_boundary(epoch){
    let remaining_seconds = epoch % 60
    if remaining_seconds > 0 { return epoch + 60 - remaining_seconds }
    return epoch
}
// 每条边是一笔完整供应商查询，不截摊原公交票价或全程出租车估价。
fn route_empty_segment(segment){
    if !segment.is_object() {return false}
    for key value in segment {return false}
    return true
}
fn route_leg_endpoint(segments, first){
    if !segments.is_array() || segments.len()==0 {return nil}
    let index=if first {0} else {segments.len()-1}
    // 供应商空占位没有行程，不能抹掉相邻真实端点；非空但未定位的末段仍未知。
    while index>=0 && index<segments.len() && route_empty_segment(segments[index]) {index+=if first {1} else {-1}}
    if index<0 || index>=segments.len() {return nil}
    let segment=segments[index]
    let walking=route_get(segment,"walking")
    let steps=route_get(walking,"steps")
    if !steps.is_array() {steps=[segment]}
    if steps.len()>0 {
        let step=if first {steps[0]} else {steps[steps.len()-1]}
        let line=route_get(step,"polyline") if line.is_object(){line=route_get(line,"polyline")}
        if line.is_string() && line!="" {let points=line.split(";") return if first {points[0]} else {points[points.len()-1]}}
    }
    let lines=route_get(route_get(segment,"bus"),"buslines")
    if lines.is_array() && lines.len()>0 {let line=if first {lines[0]} else {lines[lines.len()-1]} return route_get(route_get(line,if first {"departure_stop"} else {"arrival_stop"}),"location")}
    let taxi=route_get(segment,"taxi")
    return route_get(taxi,if first {"startpoint"} else {"endpoint"})
}
// 一次供应商完整方案是一条可收费leg；steps只展示，不拆摊公交票价。
fn normalize_queried_route(candidate){
    prepare_route_graph_base()
    let to_ref=if candidate.actual_endpoint!=nil {"destination"} else {nil}
    if !candidate.endpoint_complete && candidate.actual_endpoint!=nil {to_ref="arrival:"+candidate.id register_route_node(to_ref,"供应商路径终点",candidate.actual_endpoint,"amap-route-geometry",nil)}
    let leg={id:"leg:"+candidate.id from_ref:"origin" to_ref:to_ref requested_to_ref:"destination" mode:if candidate.kind=="taxi" {"taxi"} else {"transit"} departure_ts:candidate.departure_ts duration_seconds:candidate.duration_seconds price_cents:candidate.price_cents price_basis:candidate.price_basis waiting_included:candidate.waiting_included source_ts:candidate.source_ts requested_origin:candidate.requested_origin requested_destination:candidate.requested_destination actual_origin:candidate.actual_origin actual_endpoint:candidate.actual_endpoint request_bound:candidate.request_bound origin_complete:candidate.origin_complete endpoint_complete:candidate.actual_endpoint!=nil segments:candidate.segments warnings:candidate.warnings}
    candidate.legs=[leg] candidate.node_ref=to_ref candidate.completion_status=if candidate.actual_endpoint==nil {"unknown"} elif candidate.endpoint_complete {"reached_requested_destination"} else {"incomplete"}
    candidate.known_cost_cents=if candidate.price_cents!=nil {candidate.price_cents} else {0}
    candidate.cost_complete=candidate.price_cents!=nil candidate.duration_complete=candidate.duration_seconds!=nil
    candidate.connection_verified=candidate.origin_complete && candidate.endpoint_complete
    candidate.earliest_arrival_ts=if candidate.duration_seconds!=nil {candidate.departure_ts+candidate.duration_seconds} else {candidate.departure_ts}
}
fn route_as_prefix(candidate){
    return {id:candidate.id node_ref:candidate.node_ref actual_endpoint:candidate.actual_endpoint legs:candidate.legs segments:candidate.segments departure_ts:candidate.departure_ts earliest_arrival_ts:candidate.earliest_arrival_ts known_cost_cents:candidate.known_cost_cents price_cents:candidate.price_cents cost_complete:candidate.cost_complete duration_complete:candidate.duration_complete duration_seconds:candidate.duration_seconds waiting_included:candidate.waiting_included request_bound:candidate.request_bound origin_complete:candidate.origin_complete endpoint_complete:candidate.endpoint_complete connection_verified:route_get(candidate,"connection_verified") source_ts:candidate.source_ts provider_connection_status:route_get(candidate,"provider_connection_status")}
}
fn route_prefix_origin(node, at){
    return {id:"origin" node_ref:node.ref actual_endpoint:coord_text(node) legs:[] segments:[] departure_ts:at earliest_arrival_ts:at known_cost_cents:0 price_cents:0 cost_complete:true duration_complete:true waiting_included:true request_bound:true origin_complete:true endpoint_complete:true source_ts:nil duration_seconds:0 connection_verified:true}
}
fn route_prefix_extend(prefix, leg, id, deadline, budget){
    let from=route_nodes[prefix.node_ref] let conditional=false
    if prefix.legs.len()>0 && from!=nil && from.source=="amap-poi" && leg.from_ref==from.ref {
        let last=prefix.legs[prefix.legs.len()-1]
        let service=route_get(last,"rail_service")
        conditional=last.mode=="rail" && last.request_bound && last.to_ref==from.ref && service!=nil && rail_place_name(from.name)==service.to_station.name && leg.request_bound && route_endpoint_gap(prefix.actual_endpoint,coord_text(from))!=nil && route_endpoint_gap(prefix.actual_endpoint,coord_text(from))<=25 && route_endpoint_gap(leg.requested_origin,coord_text(from))!=nil && route_endpoint_gap(leg.requested_origin,coord_text(from))<=25
    }
    let gap=route_endpoint_gap(prefix.actual_endpoint,leg.actual_origin)
    let unknown_origin=conditional && gap!=nil && gap>25
    // 已核铁路下车站的供应商接驳可保留出站缺口；不把POI当已抵达上车点。
    if unknown_origin {
        leg.connection_gap_m=gap leg.connection_actual_endpoint=prefix.actual_endpoint
        leg.station_access_status="unknown" leg.connection_verified=false leg.provider_connection_status="unknown"
    }
    return route_prefix_join(prefix,leg,id,deadline,budget,conditional,unknown_origin)
}
// 铁路站目标的查询溯源允许条件接入；几何缺口仍保留，不增加虚构路段。
fn route_prefix_extend_rail(prefix,leg,from,id,deadline,budget){
    let conditional=false
    if prefix.legs.len()>0 && from.source=="amap-poi" && rail_place_name(from.name)==leg.rail_service.from_station.name {
        let last=prefix.legs[prefix.legs.len()-1]
        conditional=last.request_bound && route_get(last,"requested_to_ref")==from.ref
    }
    let gap=route_endpoint_gap(prefix.actual_endpoint,leg.actual_origin)
    if conditional && gap!=nil && gap>25 {
        leg.connection_gap_m=gap leg.connection_actual_endpoint=prefix.actual_endpoint
        leg.station_access_status="unknown" leg.boarding_status="unknown" leg.connection_verified=false
    }
    return route_prefix_join(prefix,leg,id,deadline,budget,conditional,false)
}
fn route_prefix_join(prefix, leg, id, deadline, budget, conditional, unknown_origin){
    let gap=route_endpoint_gap(prefix.actual_endpoint,leg.actual_origin)
    if gap==nil || (gap>25 && !conditional) || !leg.request_bound || (!leg.origin_complete && !unknown_origin) || !leg.endpoint_complete {return {success:false reason:"供应商路段起终点或前后接驳未核实" connection_gap_m:gap leg:leg}}
    let legs=[] let segments=[]
    for item in prefix.legs {legs.push(item)} legs.push(leg)
    for item in prefix.segments {segments.push(item)} for item in leg.segments {segments.push(item)}
    let known=prefix.known_cost_cents if leg.price_cents!=nil {known+=leg.price_cents}
    let complete=prefix.cost_complete && leg.price_cents!=nil
    let duration_complete=prefix.duration_complete && leg.duration_seconds!=nil
    let arrival=leg.departure_ts if leg.duration_seconds!=nil {arrival+=leg.duration_seconds}
    let duration=nil if duration_complete {duration=arrival-prefix.departure_ts}
    let source=leg.source_ts if prefix.source_ts!=nil && prefix.source_ts<source {source=prefix.source_ts}
    let waiting=prefix.waiting_included && leg.waiting_included
    let budget_status=if known>budget {"over_budget"} elif complete {"within_estimate"} else {"unknown"}
    let deadline_status=if arrival>deadline {"over_deadline"} elif !duration_complete || !waiting {"unknown"} else {"within_estimate"}
    return {success:true prefix:{id:id node_ref:leg.to_ref actual_endpoint:leg.actual_endpoint legs:legs segments:segments departure_ts:prefix.departure_ts earliest_arrival_ts:arrival known_cost_cents:known price_cents:if complete {known} else {nil} cost_complete:complete duration_complete:duration_complete duration_seconds:duration waiting_included:waiting request_bound:prefix.request_bound && leg.request_bound origin_complete:prefix.origin_complete endpoint_complete:leg.endpoint_complete connection_verified:route_get(prefix,"connection_verified")!=false && route_get(leg,"connection_verified")!=false provider_connection_status:if route_get(prefix,"provider_connection_status")=="unknown" || route_get(leg,"provider_connection_status")=="unknown" {"unknown"} else {nil} source_ts:source budget_status:budget_status deadline_status:deadline_status waiting_slack_seconds:deadline-arrival scenario:if waiting && duration_complete {"供应商时刻与耗时估计"} else {"最早到达场景；缺失候车/耗时尚未计入，不能保证后续公交班次"}}}
}
let route_nodes={}
let route_node_generation=0
let route_prefixes={}
let route_extension_count=0
fn route_node(ref){if ref==nil {return nil} return route_nodes[ref]}
fn register_route_node(ref,name,point,source,city){
    let p=route_point(point) if p==nil {return nil}
    let node=route_nodes[ref]
    if node==nil {node={ref:ref name:name longitude:p.lon latitude:p.lat coordinate_system:"GCJ-02" source:source city_metadata:city} route_nodes[ref]=node}
    return node
}
// POI身份、来源与查询时间保存在本轮节点中，后续地点搜索不废弃已返回的引用。
fn route_poi(id){let node=route_nodes["poi:"+id] if node!=nil && route_get(node,"id")==id && node.source=="amap-poi" {return node} return nil}
fn register_route_pois(pois){
    for poi in pois {
     let node=register_route_node("poi:"+poi.id,poi.name,coord_text(poi),poi.source,route_get(poi,"city_metadata")) if node!=nil {for key value in poi {node[key]=value}}
     let entry=route_get(poi,"entrance") if entry!=nil {let access=register_route_node(entry.ref,entry.name,coord_text(entry),entry.source,entry.city_metadata) if access!=nil {for key value in entry {access[key]=value}}}
    }
}
fn register_route_stations(segments){
    if !segments.is_array(){return}
    for segment in segments {
        let lines=route_get(route_get(segment,"bus"),"buslines")
        if lines.is_array(){for line in lines {
            let stops=[route_get(line,"departure_stop")]
            let via=route_get(line,"via_stops") if via.is_array(){for stop in via {stops.push(stop)}}
            stops.push(route_get(line,"arrival_stop"))
            for stop in stops {let id=route_get(stop,"id") if id.is_string() && id!="" {register_route_node("stop:"+id,route_get(stop,"name"),route_get(stop,"location"),"amap-transit-stop",nil)}}
        }}
    }
}
fn register_candidate_stations(candidate){
 if route_get(candidate,"stations_registered_generation")==route_node_generation {return}
 register_route_stations(candidate.segments) candidate.stations_registered_generation=route_node_generation
}
fn prepare_route_graph_base(){
    if position_record==nil || destination_record==nil || constraints==nil {return false}
    let origin=register_route_node("origin",position_record.name,coord_text(position_record),position_record.source,{city:position_record.city citycode:position_record.citycode adcode:position_record.adcode currency:position_record.currency})
    let target=register_route_node("destination",destination_record.name,destination_coord(destination_record),destination_record.source,{city:destination_record.city citycode:destination_record.citycode adcode:destination_record.adcode currency:destination_record.currency})
    target.destination_access=route_get(destination_record,"destination_access") target.routing_point=route_get(destination_record,"routing_point") target.canonical_poi_ref="poi:"+destination_record.id target.coordinate_basis=if target.routing_point!=nil {"entr_location"} else {route_get(destination_record,"coordinate_basis")}
    // POI与停站在真实资料进入本轮时登记；查询只使用当前registry，完整图另按候选分入口读取。
    if route_prefixes["origin"]==nil {route_prefixes["origin"]=route_prefix_origin(origin,time_now())}
    return true
}
fn route_prefix_facts(prefix){
    let legs=[]
    for leg in prefix.legs {legs.push({id:leg.id from_ref:leg.from_ref to_ref:leg.to_ref mode:leg.mode departure_ts:leg.departure_ts duration_seconds:leg.duration_seconds price_cents:leg.price_cents price_basis:leg.price_basis waiting_included:leg.waiting_included source_ts:leg.source_ts requested_origin:leg.requested_origin requested_destination:leg.requested_destination warnings:leg.warnings rail_service:rail_service_labels(route_get(leg,"rail_service")) rail_seat:route_get(leg,"rail_seat") quote_ref:route_get(leg,"quote_ref") place_match_basis:route_get(leg,"place_match_basis") provider_connection_status:route_get(leg,"provider_connection_status") connection_gap_m:route_get(leg,"connection_gap_m") connection_actual_endpoint:route_get(leg,"connection_actual_endpoint") actual_origin:route_get(leg,"actual_origin") actual_endpoint:route_get(leg,"actual_endpoint") origin_complete:route_get(leg,"origin_complete") endpoint_complete:route_get(leg,"endpoint_complete") request_bound:route_get(leg,"request_bound") station_access_status:route_get(leg,"station_access_status") boarding_status:route_get(leg,"boarding_status") connection_verified:route_get(leg,"connection_verified")})}
    return {id:prefix.id destination_access:route_get(destination_record,"destination_access") node_ref:prefix.node_ref completion_status:if prefix.node_ref=="destination" {"reached_requested_destination"} else {"incomplete"} requested_destination_ref:"destination" remaining_endpoint_gap_m:if route_nodes["destination"]!=nil {route_endpoint_gap(prefix.actual_endpoint,coord_text(route_nodes["destination"]))} else {nil} full_journey_price_cents:if prefix.node_ref=="destination" && route_get(prefix,"connection_verified")!=false && route_get(prefix,"provider_connection_status")!="unknown" && route_get(destination_record,"destination_access")==nil {prefix.price_cents} else {nil} incomplete_reason:if prefix.node_ref!="destination" {"仅到真实中间/路径终点；后续连接尚未取得，不能把当前小计当到目的地总价"} else {nil} departure_ts:prefix.departure_ts earliest_arrival_ts:prefix.earliest_arrival_ts known_cost_cents:prefix.known_cost_cents price_cents:prefix.price_cents duration_seconds:prefix.duration_seconds waiting_included:prefix.waiting_included connection_verified:route_get(prefix,"connection_verified") provider_connection_status:route_get(prefix,"provider_connection_status") budget_status:if prefix.node_ref=="destination" && route_get(destination_record,"destination_access")!=nil && route_get(prefix,"budget_status")!="over_budget" {"unknown"} else {route_get(prefix,"budget_status")} deadline_status:if prefix.node_ref=="destination" && route_get(destination_record,"destination_access")!=nil && route_get(prefix,"deadline_status")!="over_deadline" {"unknown"} else {route_get(prefix,"deadline_status")} waiting_slack_seconds:route_get(prefix,"waiting_slack_seconds") scenario:route_get(prefix,"scenario") legs:legs}
}
fn route_model_graph_index(summary){
 let modes=[] let from_ref=nil
 for index leg in summary.legs {if index==0 {from_ref=route_get(leg,"from_ref")} modes.push(leg.mode)}
 let check=summary.assessment
 return {id:summary.id ref:summary.id from_ref:from_ref to_ref:summary.node_ref modes:modes duration_seconds:summary.duration_seconds estimated_arrival_ts:summary.estimated_arrival_ts estimated_arrival_label:summary.estimated_arrival_label queried_endpoint_arrival_ts:summary.queried_endpoint_arrival_ts queried_endpoint_arrival_label:summary.queried_endpoint_arrival_label arrival_scope:summary.arrival_scope arrival_label:summary.arrival_label cost:summary.cost completion_status:summary.completion_status incomplete_reason:summary.incomplete_reason
  status:{passed:check.passed origin_complete:check.origin_complete endpoint_complete:check.endpoint_complete connection_status:check.connection_status budget_status:check.budget_status deadline_status:check.deadline_status waiting_included:check.waiting_included} detail_tool:"get_route"}
}
fn route_model_node_index(node){
 return {ref:node.ref name:node.name longitude:node.longitude latitude:node.latitude coordinate_system:node.coordinate_system kind:if route_get(node,"type")!=nil {node.type} else {node.source} detail_ref:node.ref}
}
fn route_model_relation_index(relation,from_ref,to_ref,duration){
 let result={} for key value in relation {result[key]=value}
 let stops=[] for stop in relation.stops {stops.push({node_ref:stop.node_ref role:stop.role index:stop.index name:if stop.node_ref==nil {stop.name} else {nil}})}
 result.stops=stops result.duration_seconds=duration result.direction={from_ref:from_ref to_ref:to_ref}
 return result
}
fn route_graph_add_candidate(state,candidate){
 register_candidate_stations(candidate)
 let compact=route_get(state,"model_projection")==true let relevant=route_get(state,"selected_refs")==nil
 if route_get(state,"selected_refs")!=nil {
  let endpoint=route_get(candidate,"node_ref") if endpoint!=nil && state.selected_refs[endpoint]==true {relevant=true}
  let legs=route_get(candidate,"legs") if legs.is_array(){for leg in legs {for key in ["from_ref" "to_ref" "requested_to_ref"] {let ref=route_get(leg,key) if ref!=nil && state.selected_refs[ref]==true {relevant=true}}}}
 }
 let relations=[]
 for segment in route_segment_facts(candidate,true) {for line_index line in segment.buslines {
  let relation={route_id:candidate.id leg_id:segment.leg_id segment_index:segment.index leg_segment_index:segment.leg_segment_index busline_index:line_index line_id:line.line_id name:line.name stops:line.stops}
  if compact {relation=route_model_relation_index(relation,line.departure_node_ref,line.arrival_node_ref,line.duration_seconds)}
  let matches=route_get(state,"selected_refs")==nil
  for stop in line.stops {if stop.node_ref!=nil {
   if state.memberships[stop.node_ref]==nil {state.memberships[stop.node_ref]=[]}
   state.memberships[stop.node_ref].push({route_id:candidate.id leg_id:segment.leg_id segment_index:segment.index busline_index:line_index line_id:line.line_id stop_index:stop.index role:stop.role})
   if route_get(state,"selected_refs")!=nil && state.selected_refs[stop.node_ref]==true {matches=true}
  }}
  if matches {relations.push(relation) relevant=true}
 }}
 if relevant {let summary=query_route_summary(candidate) state.routes.push(if compact {route_model_graph_index(summary)} else {summary})}
 for relation in relations {state.relations.push(relation)}
}

fn route_graph_node_fact(state,node){
 let fact={} for key value in node {fact[key]=value}
 fact.memberships=if state.memberships[node.ref]!=nil {state.memberships[node.ref]} else {[]}
 return fact
}
fn route_graph_result(state){
 let result={nodes:state.nodes routes:state.routes transit_segments:state.relations initial_route_id:"origin" coverage:"本轮已取得地点、停靠站和完整查询边；并非完整交通网络"}
 if route_get(state,"model_projection")==true {result.projection=if route_get(state,"selected_refs")==nil {"index"} else {"node_details"} result.missing_refs=state.missing_refs result.details="完整Route用get_route(id)；完整节点与全部线路归属用get_route_graph(node_refs)。索引不含原始来源材料与路线步骤，站间时刻缺失仍未知。"}
 return result
}
fn route_graph_facts(){
 let state={nodes:[] routes:[] relations:[] memberships:{}}
 for candidate in candidates {route_graph_add_candidate(state,candidate)}
 for ref node in route_nodes {state.nodes.push(route_graph_node_fact(state,node))}
 return route_graph_result(state)
}
// 图投影按候选分入口，复用已解析段；候选和节点数量不受批大小限制。
fn read_route_graph(token,done){route_graph_start(token,done,false,nil)}
fn read_model_route_graph(p,token,done){
 let requested=route_get(p,"node_refs") let selected=nil
 if requested!=nil {
  if !requested.is_array() {done({error:"node_refs必须为本轮节点ref数组"}) return}
  selected={} for ref in requested {if !ref.is_string() {done({error:"node_refs必须为本轮节点ref字符串"}) return} selected[ref]=true}
 }
 route_graph_start(token,done,true,selected)
}
fn route_graph_start(token,done,compact,selected){
 if !prepare_route_graph_base(){done({nodes:[] routes:[] transit_segments:[] initial_route_id:"origin" coverage:"尚无本轮起终点与路线"}) return}
 let state={token:token owner:current_tool_job() done:done nodes:[] routes:[] relations:[] memberships:{} candidate_index:0 refs:nil node_index:0 model_projection:compact selected_refs:selected missing_refs:[]}
 tool_timeout(0.01,state.owner,"route_graph",||route_graph_batch(state))
}

fn route_graph_batch(state){
 if state.token!=run_id {return}
 if state.candidate_index<candidates.len() {
  route_graph_add_candidate(state,candidates[state.candidate_index]) state.candidate_index+=1
  tool_timeout(0.01,state.owner,"route_graph",||route_graph_batch(state)) return
 }
 if state.refs==nil {
  state.refs=[]
  if route_get(state,"selected_refs")!=nil {for ref selected in state.selected_refs {if route_node(ref)==nil {state.missing_refs.push(ref)} else {state.refs.push(ref)}}}
  else {for ref node in route_nodes {state.refs.push(ref)}}
 }
 let until=state.node_index+50 if until>state.refs.len(){until=state.refs.len()}
 while state.node_index<until {
  let node=route_nodes[state.refs[state.node_index]]
  state.nodes.push(if route_get(state,"model_projection")==true && route_get(state,"selected_refs")==nil {route_model_node_index(node)} else {route_graph_node_fact(state,node)}) state.node_index+=1
 }
 if state.node_index<state.refs.len(){tool_timeout(0.01,state.owner,"route_graph",||route_graph_batch(state)) return}
 state.done(route_graph_result(state))
}
fn verify_route_node_city(node,token,done){
    if node.city_metadata!=nil {done() return}
    amap_request("/v3/geocode/regeo","&location="+coord_text(node)+"&extensions=base&radius=0&output=JSON",token,fn(data){
        let a=route_get(route_get(data,"regeocode"),"addressComponent")
        node.city_metadata=amap_city(route_get(a,"city"),route_get(a,"citycode"),route_get(a,"adcode"),route_get(a,"province"))
        if node.city_metadata==nil {fail_task("接驳站城市资料缺失，不能查询公交") return}
        done()
    })
}
fn transit_leg_params(from,to,strategy,departure){
    let china=china_time(departure)
    let hh=""+china.hour let mm=""+china.minute let month=""+china.month let day=""+china.day
    if china.hour<10 {hh="0"+hh} if china.minute<10 {mm="0"+mm} if china.month<10 {month="0"+month} if china.day<10 {day="0"+day}
    return "&origin="+coord_text(from)+"&destination="+coord_text(to)+"&city1="+from.city_metadata.citycode.url_encode()+"&city2="+to.city_metadata.citycode.url_encode()+"&ad1="+from.city_metadata.adcode.url_encode()+"&ad2="+to.city_metadata.adcode.url_encode()+"&strategy="+strategy+"&show_fields=cost,polyline&date="+china.year+"-"+month+"-"+day+"&time="+hh+":"+mm
}
fn extension_leg(route,option,index,option_count,mode,from,to,at,departure,sequence){
    let origin_gap=route_endpoint_gap(route_get(route,"origin"),coord_text(from))
    let destination_gap=route_endpoint_gap(route_get(route,"destination"),coord_text(to))
    let bound=origin_gap!=nil && origin_gap<=25 && destination_gap!=nil && destination_gap<=25
        let cost=route_get(option,"cost") let segments=route_get(option,if mode=="transit" {"segments"} else {"steps"})
        if !segments.is_array(){segments=[]}
        let price=nil let basis="unknown"
        if mode=="walk" {price=0 basis="步行无交通票价"}
        elif mode=="taxi" && option_count==1 {price=route_cents(route_get(route,"taxi_cost")) basis="amap-route.taxi_cost；一次完整出租车行程估算，非滴滴实时报价"}
        elif mode=="transit" {
            let has_taxi=false for segment in segments {if route_get(segment,"taxi").is_object(){has_taxi=true}}
            if !has_taxi {price=route_cents(route_get(cost,"transit_fee")) basis="amap-option.cost.transit_fee；供应商本次查询区间报价；各交通分段票价及包含关系未知，无法据此确认是否包含城际车票；请求全程覆盖以cost.coverage为准"}
        }
        let actual_origin=route_leg_endpoint(segments,true) let actual_end=route_leg_endpoint(segments,false)
        let start_gap=route_endpoint_gap(actual_origin,coord_text(from)) let end_gap=route_endpoint_gap(actual_end,coord_text(to))
        let leg_id="leg-"+sequence+"-"+index
        let actual_to_ref=to.ref let pickup_ref=nil
        if actual_origin!=nil {pickup_ref="pickup:"+leg_id register_route_node(pickup_ref,"供应商路径起点（"+from.name+"）",actual_origin,"amap-route-geometry",nil)}
        if actual_end!=nil && (end_gap==nil || end_gap>25) {actual_to_ref="arrival:"+leg_id register_route_node(actual_to_ref,"供应商路径终点（"+to.name+"）",actual_end,"amap-route-geometry",nil)}
        let leg={id:leg_id pickup_ref:pickup_ref requested_to_ref:to.ref requested_endpoint_gap_m:end_gap from_ref:from.ref to_ref:actual_to_ref mode:mode departure_ts:departure source_ts:at requested_origin:coord_text(from) requested_destination:coord_text(to) request_bound:bound actual_origin:actual_origin actual_endpoint:actual_end origin_complete:start_gap!=nil && start_gap<=25 endpoint_complete:actual_end!=nil && (actual_to_ref!=to.ref || end_gap!=nil && end_gap<=25) duration_seconds:route_seconds(route_get(cost,"duration")) price_cents:price price_basis:basis waiting_included:mode!="taxi" segments:segments warnings:if mode=="taxi" {"仅当前交通行驶估计，候车和上下车步行未知；未来出发交通未预测"} else {"按最早场景查询，前序未知等待可能错过本段公交；站点坐标不保证平台/入口衔接"}}
    register_route_stations(segments)
    return leg
}
fn extension_legs(data,mode,from,to,at,departure){
    let result=[] let route=route_get(data,"route")
    let options=if mode=="transit" {route_get(route,"transits")} else {route_get(route,"paths")}
    if !options.is_array(){return result}
    for index option in options {result.push(extension_leg(route,option,index,options.len(),mode,from,to,at,departure,route_extension_count))}
    return result
}
fn register_mixed_candidate(next,to,mode){
    let candidate=route_candidate("mixed-"+next.id,if next.legs.len()>1 {"mixed"} elif mode=="taxi" {"taxi"} elif mode=="walk" {"walking"} else {"public_transit"},next.duration_seconds,next.price_cents,next.source_ts,next.departure_ts,next.actual_endpoint,coord_text(to),next.waiting_included,next.segments)
    candidate.requested_origin=coord_text(route_nodes["origin"]) candidate.requested_destination=coord_text(to) candidate.request_bound=next.request_bound candidate.origin_complete=next.origin_complete
    candidate.node_ref=next.node_ref candidate.completion_status=if next.node_ref=="destination" {"reached_requested_destination"} else {"incomplete"}
    candidate.cost_complete=next.cost_complete candidate.duration_complete=next.duration_complete candidate.earliest_arrival_ts=next.earliest_arrival_ts candidate.connection_verified=next.connection_verified candidate.provider_connection_status=route_get(next,"provider_connection_status")
    candidate.price_basis="逐段完整供应商报价相加"
    candidate.known_cost_cents=next.known_cost_cents candidate.budget_status=next.budget_status candidate.deadline_status=next.deadline_status candidate.waiting_slack_seconds=next.waiting_slack_seconds candidate.legs=next.legs candidate.prefix_id=next.id
    candidate.warnings="逐段完整报价相加；"+next.scenario+"；未知候车不算零，不保证实际费用/准时到达。"
    attach_destination_access(candidate)
    let check=route_recheck(candidate,time_now(),arrive_by,constraints.budget_cents) candidate.reason=check.reason candidate.feasible=check.passed
    assign_candidate_ref(candidate)
    next.route_id=candidate.id
    // 新leg已登记其停站；前缀来自本轮已登记Route，不再遍历累计segments。
    candidate.stations_registered_generation=route_node_generation
    candidates.push(candidate) return candidate
}

// 一个供应商方案一个入口；完整结果保留，旧query的批次不能继续登记候选。
fn accept_route_extension(prefix,from,to,mode,data,at,departure,token){
    if !current_task(token){return}
    let route=route_get(data,"route") let options=route_get(route,if mode=="transit" {"transits"} else {"paths"})
    if !options.is_array(){options=[]}
    let state={prefix:prefix from:from to:to mode:mode route:route options:options at:at departure:departure token:token sequence:route_extension_count owner:current_tool_job() index:0 added:[] candidates:[] rejected:[] completed:[]}
    tool_timeout(0.01,state.owner,"provider_option",||accept_extension_option(state))
}
fn accept_extension_option(state){
    if !current_task(state.token){return}
    if state.index<state.options.len() {
        let leg=extension_leg(state.route,state.options[state.index],state.index,state.options.len(),state.mode,state.from,state.to,state.at,state.departure,state.sequence)
        let joined=route_prefix_extend(state.prefix,leg,"prefix-"+state.sequence+"-"+state.added.len(),arrive_by,constraints.budget_cents)
        if !joined.success {state.rejected.push({leg_id:leg.id reason:joined.reason connection_gap_m:joined.connection_gap_m pickup_ref:leg.pickup_ref actual_to_ref:leg.to_ref requested_to_ref:leg.requested_to_ref requested_endpoint_gap_m:leg.requested_endpoint_gap_m})}
        else {
            let next=joined.prefix route_prefixes[next.id]=next state.added.push(route_prefix_facts(next))
            let candidate=register_mixed_candidate(next,route_nodes["destination"],state.mode) state.candidates.push(candidate)
            if next.node_ref=="destination" {state.completed.push(candidate.id)}
        }
        state.index+=1 tool_timeout(0.01,state.owner,"provider_option",||accept_extension_option(state)) return
    }
    read_route_summaries(state.candidates,state.token,fn(routes){
        let call_id=if active_tool!=nil {active_tool.id} else {nil}
        start_timeout(0.01,||trace_emit_run("route_extension",{from_ref:state.from.ref to_ref:state.to.ref mode:state.mode requested_departure:state.departure prefixes:state.added rejected:state.rejected completed:state.completed},call_id,state.token))
        agent_tool_result({success:true routes:if active_tool!=nil && active_tool.function.name=="query_route" {query_route_result_summaries(routes)} else {routes} completed_candidate_ids:state.completed rejected:state.rejected new_nodes:if active_tool!=nil && active_tool.function.name=="query_route" {model_node_references(tool_new_nodes())} else {tool_new_nodes()} combination_status:if routes.len()==0 {"no_registered_connection"} else {"registered_routes_only"} combination_basis:"只引用成功注册Route的累计费用与时间；rejected路段未接入，不能手算为完整行程。未知连接仍为已查段小计和最早时间下界。"})
    })
}
fn extend_route(p,token){
    if !prepare_route_graph_base(){fail_task("接驳查询缺少本次起点、目的地或时间预算") return}
    let id=route_get(p,"route_id") let prefix=nil
    if id=="origin" {prefix=route_prefixes["origin"]}
    elif id!=nil {let candidate=ui_route(id) if candidate!=nil {prefix=route_as_prefix(candidate)}}
    else {prefix=route_prefixes[route_get(p,"prefix_id")]}
    let to=route_target_node(p.to_ref)
    if prefix==nil || to==nil {agent_tool_result({success:false error:"route_id/to_ref不属于本轮真实图；可get_route_graph读取当前节点与前缀"}) return}
    let from=route_node(prefix.node_ref) let mode=p.mode
    if from==nil || prefix.actual_endpoint==nil {agent_tool_result({success:false error:"Route实际终点未知，不能据请求终点继续扩展"}) return}
    if mode!="walk" && mode!="taxi" && mode!="transit" {agent_tool_result({success:false error:"支持walk/taxi/transit完整路段"}) return}
    if from.ref==to.ref {agent_tool_result({success:false error:"起终节点相同，没有新增路段"}) return}
    let strategy=route_get(p,"strategy") if strategy==nil {strategy=0}
    if mode=="transit" {let found=false for value in transit_strategies(){if value==strategy {found=true}} if !found {agent_tool_result({success:false error:"该公交策略需要其它专用输入"}) return}}
    route_extension_count+=1
    let departure=route_later(time_now(),prefix.earliest_arrival_ts) if mode=="transit" {departure=minute_boundary(departure)}
    let at=time_now()
    let query=fn(){
        if !current_task(token){return}
        let params="&origin="+coord_text(from)+"&destination="+coord_text(to)+"&show_fields=cost,polyline"
        let path=if mode=="walk" {"/v5/direction/walking"} elif mode=="taxi" {"/v5/direction/driving"} else {"/v5/direction/transit/integrated"}
        if mode=="taxi" {params+="&strategy=0"} elif mode=="transit" {params=transit_leg_params(from,to,strategy,departure)}
        trace_emit("route_leg_query",{from_ref:from.ref to_ref:to.ref mode:mode departure_at:departure scenario:route_get(prefix,"scenario") path:path params:params},if active_tool!=nil {active_tool.id} else {nil})
        let owner=agent_tool_job
        amap_request(path,params,token,fn(data){tool_timeout(0.01,owner,"provider_accept",||accept_route_extension(prefix,from,to,mode,data,at,departure,token))})
    }
    if mode=="transit" {verify_route_node_city(from,token,fn(){verify_route_node_city(to,token,query)})} else {query()}
}

let rail_services={} let rail_stations={} let rail_service_sequence=0 let rail_station_text=nil let rail_cookie=""
fn rail_http(path,params,token,done){
    net.http_request(net.HttpRequest{url:"https://kyfw.12306.cn"+path+params method:net.HttpMethod.GET headers:{"Accept":["application/json, text/javascript, */*"] "Referer":["https://kyfw.12306.cn/otn/leftTicket/init"] "Cookie":[rail_cookie]}}) do net.HttpEvents{
        on_response:|res|{if !current_task(token){return} if res.status_code!=200 {agent_tool_result({success:false error:"12306匿名查询未返回成功响应；可继续其它交通查询" http_status:res.status_code}) return} try {done(res)} {agent_tool_result({success:false error:"12306匿名网页响应格式变化或资料缺失"})}}
        on_error:|err|{if current_task(token){agent_tool_result({success:false error:"12306匿名网页查询网络失败；不自动重试"})}}
    }
}
fn rail_station_code(name){
    if !name.is_string() || name=="" || rail_station_text==nil {return nil}
    let known=rail_stations[name] if known!=nil {return known.code}
    let parts=rail_station_text.split("|"+name+"|")
    let found=nil
    for index part in parts {if index>0 {let code=part.split("|")[0] if regex("^[A-Z]{3}$","").test(code) {if found!=nil && found!=code {return nil} found=code}}}
    return found
}
fn rail_find_stations(state,token){
    if !current_task(token){return}
    let until=state.index+80 if until>state.rows.len() {until=state.rows.len()}
    while state.index<until {
        let row=state.rows[state.index].split("|") state.index+=1
        if row.len()>=3 && row[1].search(state.query)>=0 && regex("^[A-Z]{3}$","").test(row[2]) {
            let station={ref:"rail-station:"+row[2] name:row[1] code:row[2] source:"12306公开车站表" source_url:"https://kyfw.12306.cn/otn/resources/js/framework/station_name.js" coordinate_status:"unknown；需高德搜索实际站POI"}
            rail_stations[station.ref]=station state.result.push(station)
        }
    }
    if state.index<state.rows.len() {start_timeout(0.01,||rail_find_stations(state,token)) return}
    agent_tool_result({success:true stations:state.result query:state.query queried_at:time_now()})
}
fn search_rail_stations(p,token){
    if !p.query.is_string() || p.query.trim()=="" {agent_tool_result({success:false error:"需要非空铁路站名关键词"}) return}
    let find=fn(){rail_find_stations({rows:rail_station_text.split("@") index:0 query:p.query result:[]},token)}
    if rail_station_text!=nil {find()} else {rail_http("/otn/resources/js/framework/station_name.js","",token,fn(res){rail_station_text=res.body.to_string() find()})}
}
fn rail_time(date,clock){
    if !date.is_string() || !regex("^[0-9]{4}-[0-9]{2}-[0-9]{2}$","").test(date) || !clock.is_string() || !regex("^[0-9]{2}:[0-9]{2}$","").test(clock) {return nil}
    return calendar_epoch("DTSTART;TZID=Asia/Shanghai:"+date.replace(regex("-","g"),"")+"T"+clock.replace(regex(":","g"),"")+"00")
}
fn rail_date(at){
    let china=china_time(at) let month=""+china.month let day=""+china.day
    if china.month<10 {month="0"+month} if china.day<10 {day="0"+day}
    return china.year+"-"+month+"-"+day
}
fn rail_seat_definitions(){return [{code:"9" name:"商务座" index:32} {code:"M" name:"一等座" index:31} {code:"O" name:"二等座" index:30} {code:"P" name:"特等座" index:25} {code:"1" name:"硬座" index:29} {code:"3" name:"硬卧" index:28} {code:"4" name:"软卧" index:23} {code:"2" name:"软座" index:24} {code:"6" name:"高级软卧" index:21} {code:"W" name:"无座" index:26}]}
fn rail_parse_service(raw,names,date,at){
    if !raw.is_string(){return nil} let row=raw.split("|") if row.len()<40 {return nil}
    let departure=rail_time(date,row[8]) let elapsed=row[10].split(":")
    if departure==nil || elapsed.len()!=2 {return nil}
    let hours=route_uint(elapsed[0]) let minutes=route_uint(elapsed[1])
    if hours==nil || minutes==nil || minutes>=60 {return nil}
    let arrival=departure+hours*3600+minutes*60 let clock=china_time(arrival)
    let reported=row[9].split(":") if reported.len()!=2 || route_uint(reported[0])!=clock.hour || route_uint(reported[1])!=clock.minute {return nil}
    let from=names[row[6]] let to=names[row[7]]
    if !from.is_string() || !to.is_string() || !regex("^[A-Z]{3}$","").test(row[6]) || !regex("^[A-Z]{3}$","").test(row[7]) || row[2]=="" || row[3]=="" {return nil}
    let chars=[] for char in row[39].split("") {if char!="" {chars.push(char)}}
    let prices={}
    if chars.len()%10==0 {let block=0 while block<chars.len() {
        let amount="" let category="" for index in 5 {amount+=chars[block+1+index]} for index in 4 {category+=chars[block+6+index]}
        let value=route_uint(amount) let flag=route_uint(category)
        if value!=nil && flag!=nil {let code=if flag>=3000 {"W"} else {chars[block]} prices[code]=value*10}
        block+=10
    }}
    let seats=[] for seat in rail_seat_definitions() {
        let available=row[seat.index]
        if available!="" && available!="--" {seats.push({code:seat.code name:seat.name price_cents:prices[seat.code] availability:available availability_status:if available=="无" || available=="0" {"unavailable"} elif available=="有" || route_uint(available)!=nil && route_uint(available)>0 {"available"} else {"unknown"}})}
    }
    return {train_id:row[2] trip:row[3] train_start_date:row[13] boarding_date:date from_station:{code:row[6] name:from} to_station:{code:row[7] name:to} departure_ts:departure arrival_ts:arrival duration_seconds:arrival-departure timezone:"Asia/Shanghai" seats:seats booking_open:row[11]=="Y" source:"12306匿名网页查询" source_url:"https://kyfw.12306.cn/otn/leftTicket/init" source_ts:at ticket_status:"not_purchased" warnings:"网页查询非开放API或席位预留；余票为查询时观察，入站/安检/检票截止及站台连接未核实"}
}
fn rail_observed_station(station){
 let ref="rail-station:"+station.code
 if rail_stations[ref]==nil {rail_stations[ref]={ref:ref name:station.name code:station.code source:"12306班次站名映射" coordinate_status:"unknown；需高德搜索实际站POI"}}
 return {ref:ref name:station.name code:station.code}
}
fn rail_service_labels(service){
 if service==nil {return nil}
 let result={} for key value in service {result[key]=value}
 result.departure_label=if route_get(service,"departure_ts")!=nil {guardian_deadline(service.departure_ts)} else {nil}
 result.arrival_label=if route_get(service,"arrival_ts")!=nil {guardian_deadline(service.arrival_ts)} else {nil}
 result.duration_label=duration_text(route_get(service,"duration_seconds"))
 return result
}
fn rail_accept_service(state,service){
 let from=rail_observed_station(service.from_station) let to=rail_observed_station(service.to_station)
 if from.code!=state.from_code || to.code!=state.to_code {
  let key=from.code+":"+to.code let pair=state.other_pairs[key]
  if pair==nil {pair={from_station:from to_station:to observed_service_count:0} state.other_pairs[key]=pair}
  pair.observed_service_count+=1 return
 }
 if service.departure_ts<state.earliest || service.departure_ts>arrive_by {return}
 service=rail_service_labels(service)
 rail_service_sequence+=1 service.ref="rail-service:"+run_id+":"+rail_service_sequence rail_services[service.ref]=service
 state.services.push({ref:service.ref train_id:service.train_id trip:service.trip train_start_date:service.train_start_date from_station:from to_station:to departure_ts:service.departure_ts arrival_ts:service.arrival_ts duration_seconds:service.duration_seconds departure_label:service.departure_label arrival_label:service.arrival_label duration_label:service.duration_label seats:service.seats booking_open:service.booking_open})
}
// 同城扩展不冒充请求站对；只保其它实际站对的发现入口，不套原站接驳时刻。
fn rail_collect_services(state,token){
 if !current_task(token){return}
 let until=state.index+8 if until>state.records.len() {until=state.records.len()}
 while state.index<until {
  let service=rail_parse_service(state.records[state.index],state.names,state.date,state.at) state.index+=1
  if service==nil {state.rejected+=1} else {rail_accept_service(state,service)}
 }
 if state.index<state.records.len() {start_timeout(0.01,||rail_collect_services(state,token)) return}
 let other=[] for key pair in state.other_pairs {other.push(pair)}
 agent_tool_result({success:true services:state.services searched_from:state.p.from_station searched_to:state.p.to_station requested_station_pair:{from_station:{ref:"rail-station:"+state.from_code code:state.from_code name:state.names[state.from_code]} to_station:{ref:"rail-station:"+state.to_code code:state.to_code name:state.names[state.to_code]}} other_observed_station_pairs:other other_pairs_scope:"供应商同城扩展实际站对及原始观察条数；未套用当前Route到原站时刻、未核替代站接驳或余票；可用这些站ref重新查询" empty_reason:if state.services.len()==0 {"本次精确站对在出发时间至到达期限窗口没有返回班次"} else {nil} boarding_date:state.date timezone:"Asia/Shanghai" source:"12306匿名网页查询" source_url:"https://kyfw.12306.cn/otn/leftTicket/init" source_ts:state.at ticket_status:"not_purchased" warnings:"网页查询非开放API或席位预留；余票为查询时观察，入站/安检/检票截止及站台连接未核实" earliest_departure_ts:state.earliest latest_departure_ts:arrive_by total_returned:state.records.len() rejected_records:state.rejected coverage:"仅实际上下车站码与请求站对相同的班次，按本次时间窗筛选；同城其它站对只作发现入口，需重新核接驳并查询。余票不代表已购票或可登乘"})
}
fn rail_query_services(p,token){
    let from=rail_station_code(p.from_station) let to=rail_station_code(p.to_station)
    if from==nil || to==nil {agent_tool_result({success:false error:"铁路站名须精确匹配12306车站名称；不把城市或地图POI当铁路站码"}) return}
    let date=route_get(p,"date") if date==nil {date=rail_date(time_now())}
    if rail_time(date,"00:00")==nil {agent_tool_result({success:false error:"date须有效YYYY-MM-DD北京时间乘车日期"}) return}
    let earliest=time_now() let id=route_get(p,"route_id")
    if id!=nil && id!="origin" {let candidate=ui_route(id) if candidate==nil {agent_tool_result({success:false error:"route_id须本轮已查Route"}) return} let arrival=route_timing(candidate,time_now()).arrival_ts if arrival!=nil {earliest=route_later(earliest,arrival)}}
    rail_cookie=""
    rail_http("/otn/leftTicket/init","",token,fn(res){
        for name values in res.headers {if name=="Set-Cookie" || name=="set-cookie" || name=="SET-COOKIE" {for value in values {if rail_cookie!="" {rail_cookie+="; "} rail_cookie+=value.split(";")[0]}}}
        let matched=regex("CLeftTicketUrl\\s*=\\s*['\"](leftTicket/query[A-Za-z]*)['\"]","").exec(res.body.to_string())
        if matched==nil || rail_cookie=="" {agent_tool_result({success:false error:"12306匿名会话或动态查询路径未取得；未绕过服务限制"}) return}
        let params="?leftTicketDTO.train_date="+date+"&leftTicketDTO.from_station="+from+"&leftTicketDTO.to_station="+to+"&purpose_codes=ADULT"
        let at=time_now()
        rail_http("/otn/"+matched.captures[1],params,token,fn(reply){
            let data=reply.body.to_string().parse_json() let records=route_get(route_get(data,"data"),"result") let names=route_get(route_get(data,"data"),"map")
            if route_get(data,"status")!=true || !records.is_array() || !names.is_object() {agent_tool_result({success:false error:"12306未返回班次数据；可能受访问限制或格式变化"}) return}
            rail_collect_services({records:records names:names date:date at:at earliest:earliest index:0 services:[] rejected:0 p:p from_code:from to_code:to other_pairs:{}},token)

        })
    })
}
fn search_rail_services(p,token){
    if rail_station_text!=nil {rail_query_services(p,token) return}
    rail_http("/otn/resources/js/framework/station_name.js","",token,fn(res){rail_station_text=res.body.to_string() rail_query_services(p,token)})
}
fn rail_place_name(name){
    // 仅已识别的末端设施标签用于基础站名匹配；原始POI名称仍保留。
    let changed=true
    while changed {
        let base=name.strip_suffix("(城际站)").strip_suffix("（城际站）")
        for closing in [")" "）"] {
            let opening=if closing==")" {"("} else {"（"}
            let parts=base.split(opening) let tail=parts[parts.len()-1]
            if tail.strip_suffix(closing)!=tail {
                let tag=tail.strip_suffix(closing)
                if regex("^T[0-9]+$","").test(tag) {base=base.strip_suffix(opening+tag+closing)}
            }
        }
        changed=base!=name name=base
    }
    return name.strip_suffix("站")
}
fn extend_route_with_rail(p,token){
    if !prepare_route_graph_base(){agent_tool_result({success:false error:"本次起终点与约束未取得"}) return}
    let prefix=nil if p.route_id=="origin" {prefix=route_prefixes["origin"]} else {let candidate=ui_route(p.route_id) if candidate!=nil {prefix=route_as_prefix(candidate)}}
    let service=rail_services[p.service_ref] let from=route_node(p.from_ref) let to=route_node(p.to_ref)
    if prefix==nil || service==nil || from==nil || to==nil {agent_tool_result({success:false error:"引用须来自本轮Route、铁路查询及真实地图节点"}) return}
    if !p.place_basis.is_string() || p.place_basis.trim()=="" || rail_place_name(from.name)!=service.from_station.name || rail_place_name(to.name)!=service.to_station.name {agent_tool_result({success:false error:"地图节点必须对应班次实际上下车站名，并说明关联依据；不采用同城另一站" service_ref:service.ref service_from_station:rail_observed_station(service.from_station) service_to_station:rail_observed_station(service.to_station) supplied_from:{ref:from.ref name:from.name source:from.source} supplied_to:{ref:to.ref name:to.name source:to.source}}) return}
    let seat=nil for option in service.seats {if option.code==p.seat_code {seat=option}}
    if seat==nil || seat.availability_status=="unavailable" {agent_tool_result({success:false error:"席别不存在或查询时已无票；请选择实际可用席别"}) return}
    let timing=route_timing(prefix,time_now())
    if timing.missed.len()>0 {agent_tool_result({success:false error:"前序Route已经错过固定班次，请重新查询接驳"}) return}
    let arrival=if timing.arrival_ts!=nil {timing.arrival_ts} else {route_later(time_now(),prefix.earliest_arrival_ts)}
    if arrival>service.departure_ts {agent_tool_result({success:false error:"前序最早到站已错过该固定班次；不能平移列车" departure_ts:service.departure_ts earliest_station_arrival_ts:arrival}) return}
    let point=coord_text(from) let end=coord_text(to)
    let segment={railway:{id:service.train_id trip:service.trip name:service.trip time:""+service.duration_seconds departure_stop:{id:service.from_station.code name:service.from_station.name location:point time:service.departure_ts} arrival_stop:{id:service.to_station.code name:service.to_station.name location:end time:service.arrival_ts} service:service seat:seat} duration:""+service.duration_seconds}
    route_extension_count+=1
    let leg={id:"rail-leg:"+route_extension_count+":"+service.ref from_ref:from.ref to_ref:to.ref requested_to_ref:to.ref mode:"rail" departure_ts:service.departure_ts duration_seconds:service.duration_seconds price_cents:seat.price_cents price_basis:"12306网页当前选定区间席别价；不含前后接驳，不保证最终支付价" source_ts:service.source_ts waiting_included:false request_bound:true origin_complete:true endpoint_complete:true actual_origin:point actual_endpoint:end requested_origin:point requested_destination:end segments:[segment] rail_service:service rail_seat:seat place_match_basis:p.place_basis provider_connection_status:"unknown" station_access_status:"unknown" boarding_status:"unknown" warnings:service.warnings}
    let joined=route_prefix_extend_rail(prefix,leg,from,"rail-prefix:"+route_extension_count+":"+service.ref,arrive_by,constraints.budget_cents)
    if !joined.success {agent_tool_result({success:false error:joined.reason connection_gap_m:joined.connection_gap_m}) return}
    let next=joined.prefix route_prefixes[next.id]=next
    let candidate=register_mixed_candidate(next,route_nodes["destination"],"rail") candidate.source="逐段供应商查询（含12306）"
    agent_tool_result({success:true route:query_route_summary(candidate) connection_status:"地图到站关联；站内与登乘条件未知，未购票" new_nodes:tool_new_nodes()})
}

let didi_places={}
let didi_quotes={}
let didi_record_count=0
fn didi_request(name,arguments,token,done){
    let config=read_text("private-config.json") let key=nil
    if config!=nil {key=route_get(config.parse_json(),"didi_mcp_key")}
    if !key.is_string() || key.trim()=="" {agent_tool_result({success:false error:"滴滴估价服务未配置；其它路线查询仍可继续"}) return}
    let body={jsonrpc:"2.0" id:token method:"tools/call" params:{name:name arguments:arguments}}.to_json()
    trace_emit("didi_request",{name:name body:body},if active_tool!=nil {active_tool.id} else {nil})
    net.http_request(net.HttpRequest{url:"https://mcp.didichuxing.com/mcp-servers?key="+key.url_encode() method:net.HttpMethod.POST headers:{"Content-Type":["application/json; charset=utf-8"] "Accept":["application/json"]} body:body.to_bytes()}) do net.HttpEvents{
        on_response:|res|{
            if !current_task(token){return}
            try {
                if res.status_code!=200 {agent_tool_result({success:false error:"滴滴询价请求失败" http_status:res.status_code}) return}
                let raw=res.body.to_string() trace_emit_run("didi_response",{status:res.status_code body:raw},if active_tool!=nil {active_tool.id} else {nil},token)
                let data=raw.parse_json()
                if route_get(data,"error")!=nil {agent_tool_result({success:false error:"滴滴工具返回错误" code:route_get(data.error,"code")}) return}
                let result=route_get(data,"result")
                if result==nil || route_get(result,"isError")==true {agent_tool_result({success:false error:"滴滴未返回有效工具结果"}) return}
                done(result)
            } {agent_tool_result({success:false error:"滴滴响应格式无法解析"})}
        }
        on_error:|err|{if current_task(token){agent_tool_result({success:false error:"滴滴询价网络请求失败"})}}
    }
}
fn search_didi_places(p,token){
    didi_request("maps_textsearch",{keywords:p.query city:p.city},token,fn(result){
        let content=route_get(result,"content") let records=[]
        if content.is_array() && content.len()>0 {
            let items=content[0].text.parse_json()
            if items.is_array(){for item in items {
                let location=route_get(item,"location")
                if location.is_object() && route_get(location,"lng").is_number() && route_get(location,"lat").is_number() {
                    didi_record_count+=1 let ref="didi-place:"+didi_record_count
                    let record={ref:ref name:route_get(item,"display_name") address:route_get(item,"address_all") city:route_get(item,"city") longitude:location.lng latitude:location.lat coordinate_system:"provider-unspecified" source:"didi-maps_textsearch" queried_at:time_now()}
                    didi_places[ref]=record records.push(record)
                }
            }}
        }
        agent_tool_result({success:true places:records coordinate_warning:"滴滴未声明坐标系；这些点不能冒充高德端点，报价关联须另核连接"})
    })
}
fn quote_didi(p,token){
    let from=didi_places[p.from_ref] let to=didi_places[p.to_ref]
    if from==nil || to==nil {agent_tool_result({success:false error:"起终点必须来自本轮滴滴地点查询ref"}) return}
    let at=time_now()
    didi_request("taxi_estimate",{from_lng:""+from.longitude from_lat:""+from.latitude from_name:from.name to_lng:""+to.longitude to_lat:""+to.latitude to_name:to.name},token,fn(result){
        let structured=route_get(result,"structuredContent") let items=route_get(structured,"items") let quotes=[]
        if items.is_array(){for item in items {
            didi_record_count+=1 let ref="didi-quote:"+didi_record_count let base=route_get(item,"priceText") let discounted=route_get(item,"priceDiscounted")
            let display=if discounted!=nil {discounted} else {base}
            let quote={ref:ref product_name:route_get(item,"productName") product_category:route_get(item,"productCategory") price_text:display price_cents:route_cents(display) base_price_text:base base_price_cents:route_cents(base) discounted_price_text:discounted currency:"CNY" source:"didi-taxi_estimate" quoted_at:at from:from to:to provider_from:route_get(structured,"from") provider_to:route_get(structured,"to") distance_km:route_get(structured,"distanceKm") eta:route_get(structured,"eta") basis:(if discounted!=nil {"平台当前可用优惠后估价；原价仅供对照"} else {"平台当前普通估价"})+"；不保证未来接驳上车价格或落地实付；未下单"}
            didi_quotes[ref]=quote quotes.push(quote)
        }}
        agent_tool_result({success:true quotes:quotes route_attachment:"quote.ref是报价引用，不是Route id，不能用于view_route/get_route/地图。attach_quote成功返回的新Route id才可用于查看；不同供应商上下车连接仍未知，不能改写高德几何"})
    })
}

// 派生只替换指定leg的估价；共享的供应商几何不改，原Route保持不变。
fn route_quote_variant(candidate,quote,leg_id,basis){
    let next={} for key value in candidate {next[key]=value}
    let legs=[] let found=false let known=0 let complete=true let waiting=true
    for original in candidate.legs {
        let leg=original
        if original.id==leg_id {
            if original.mode!="taxi" {return {success:false error:"报价只能替换明确taxi leg，不能覆盖公交/步行费用"}}
            found=true leg={} for key value in original {leg[key]=value}
            leg.price_cents=quote.price_cents leg.price_basis="didi-taxi_estimate；指定车型当前估价替换原价，不叠加"
            leg.quote_ref=quote.ref leg.place_match_basis=basis leg.provider_connection_status="unknown" leg.waiting_included=false
            leg.warnings="保留高德几何与耗时；滴滴上下车连接未知；当前价不保证未来接驳价"
        }
        if leg.price_cents==nil {complete=false} else {known+=leg.price_cents}
        waiting=waiting && leg.waiting_included legs.push(leg)
    }
    if !found {return {success:false error:"leg_id不在指定Route中"}}
    assign_candidate_ref(next)
    next.legs=legs next.known_cost_cents=known next.cost_complete=complete next.price_cents=if complete {known} else {nil}
    next.price_basis="逐leg采用当前关联估价；指定滴滴价替换原价" next.waiting_included=waiting next.waiting_basis="driving_only"
    next.derived_from_route_id=candidate.id next.geometry_owner_id=candidate.id next.prefix_id=nil
    next.provider_connection_status="unknown" next.connection_verified=false
    next.warnings=candidate.warnings+"；滴滴价为语义关联估计，上下车连接未知，未下单。"
    next.budget_status=if known>constraints.budget_cents {"over_budget"} elif complete {"within_estimate"} else {"unknown"}
    next.deadline_status=if next.earliest_arrival_ts>arrive_by {"over_deadline"} else {"unknown"}
    let checked=route_recheck(next,time_now(),arrive_by,constraints.budget_cents) next.reason=checked.reason next.feasible=checked.passed
    candidates.push(next)
    return {success:true candidate:next}
}
fn attach_quote(p,token){
    let candidate=ui_route(p.route_id) let quote=didi_quotes[p.quote_ref]
    if candidate==nil || quote==nil {agent_tool_result({success:false error:"route_id/quote_ref必须属于本轮实际记录"}) return}
    if quote.price_cents==nil {agent_tool_result({success:false error:"报价文本无法精确解析为费用，不能当零" quote:quote}) return}
    if !p.place_basis.is_string() || p.place_basis.trim()=="" {agent_tool_result({success:false error:"需要两端名称、城市、地址/入口对应依据；语义关联不是坐标认证"}) return}
    for leg in candidate.legs {if leg.id==p.leg_id {
        let from_node=route_nodes[leg.from_ref] let to_node=route_nodes[leg.to_ref]
        let from_city=route_get(route_get(from_node,"city_metadata"),"city") let to_city=route_get(route_get(to_node,"city_metadata"),"city")
        if from_city!=nil && quote.from.city!=nil && from_city!=quote.from.city || to_city!=nil && quote.to.city!=nil && to_city!=quote.to.city {agent_tool_result({success:false error:"报价与路线节点实际城市不同，不能关联此leg"}) return}
    }}
    let result=route_quote_variant(candidate,quote,p.leg_id,p.place_basis)
    if !result.success {agent_tool_result(result) return}
    let next=result.candidate
    agent_tool_result({success:true route:query_route_summary(next) derived_from_route_id:candidate.id quote_ref:quote.ref original_route_unchanged:true connection_status:"unknown；没有认证滴滴上下车连接"})
}

fn query_route(p,token){
 if p.mode!="transit" && p.mode!="taxi" {agent_tool_result({success:false error:"mode支持transit或taxi"}) return}
 if route_get(p,"to_ref")!=nil {extend_route({route_id:"origin" to_ref:p.to_ref mode:p.mode strategy:route_get(p,"strategy")},token) return}
 if p.mode=="transit" {let strategy=route_get(p,"strategy") if strategy==nil {strategy=0} query_transit({strategy:strategy},token)}
 elif p.mode=="taxi" {query_driving(token)}
 else {agent_tool_result({success:false error:"mode支持transit或taxi"})}
}
fn transit_strategies(){ return [0 1 2 3 4 5 7 8] }
fn query_transit(p, token){
    if constraints == nil || position_record == nil || destination_record == nil { fail_task("交通查询缺少起终点") return }
    if !position_current(position_record) { fail_task("出发位置已过期，请重新规划") return }
    if position_record.currency != "CNY" || destination_record.currency != "CNY" || !position_record.citycode.is_string() || !destination_record.citycode.is_string() { fail_task("交通起终点城市或计价依据尚未核实") return }
    let strategy = route_get(p, "strategy")
    if strategy == 6 { fail_task("地铁图模式需要起终点地铁站POI，目前尚未取得") return }
    let valid_strategy = false
    for value in transit_strategies() { if strategy == value { valid_strategy = true } }
    if !strategy.is_number() || !valid_strategy { fail_task("公交策略参数无效，请使用工具列出的普通公交策略") return }
    mark_tool_used("transit:" + strategy)
    transit_count += 1
    let at = time_now()
    // 高德按分钟查询；等待到下一分钟的时间同样计入最初期限。
    let departure_at = minute_boundary(at)
    let china = china_time(departure_at )
    let hh = "" + china.hour
    let mm = "" + china.minute
    if china.hour < 10 { hh = "0" + hh }
    if china.minute < 10 { mm = "0" + mm }
    let month_text = "" + china.month
    let day_text = "" + china.day
    if china.month < 10 { month_text = "0" + month_text }
    if china.day < 10 { day_text = "0" + day_text }
    let day = "" + china.year + "-" + month_text + "-" + day_text
    let params = "&origin=" + coord_text(position_record) + "&destination=" + destination_coord(destination_record) + "&city1=" + position_record.citycode.url_encode() + "&city2=" + destination_record.citycode.url_encode() + "&ad1=" + position_record.adcode.url_encode() + "&ad2=" + destination_record.adcode.url_encode() + "&strategy=" + strategy + "&AlternativeRoute=5&show_fields=cost,polyline&date=" + day + "&time=" + hh + ":" + mm
    amap_request("/v5/direction/transit/integrated", params, token, fn(data){
        add_candidates(data, nil, at, departure_at, "query_transit")
        transit_completed += 1
        finish_tool_from_state(token)
    })
}
fn query_driving(token){
    if constraints == nil || position_record == nil || destination_record == nil { fail_task("驾车查询缺少起终点") return }
    if !position_current(position_record) { fail_task("出发位置已过期，请重新规划") return }
    if position_record.currency != "CNY" || destination_record.currency != "CNY" || !position_record.citycode.is_string() || !destination_record.citycode.is_string() { fail_task("交通起终点城市或计价依据尚未核实") return }
    driving_done = true
    let at = time_now()
    let params = "&origin=" + coord_text(position_record) + "&destination=" + destination_coord(destination_record) + "&show_fields=cost,polyline&strategy=0"
    amap_request("/v5/direction/driving", params, token, fn(data){
        add_candidates(nil, data, at, at, "query_driving")
        driving_completed = true
        finish_tool_from_state(token)
    })
}
fn comparison_complete(){ return transit_completed > 0 && transit_completed == transit_count && driving_completed }
// 比较只投影身份、显示范围和当前判断；同一Route的完整事实由get_route读取。
fn comparison_route_index(route){
 let cost=route.cost let assessment=route.assessment
 return {id:route.id mode:route.mode kind:route.kind completion_status:route.completion_status arrival_scope:route.arrival_scope price_label:route.price_label duration_label:route.duration_label arrival_label:route.arrival_label
  cost:{amount_cents:cost.amount_cents known_subtotal_cents:cost.known_subtotal_cents currency:cost.currency coverage:cost.coverage unknown_reasons:cost.unknown_reasons}
  assessment:{evaluated_at:assessment.evaluated_at passed:assessment.passed reasons:assessment.reasons waiting_included:assessment.waiting_included waiting_basis:assessment.waiting_basis origin_complete:assessment.origin_complete endpoint_complete:assessment.endpoint_complete connection_status:assessment.connection_status budget_status:assessment.budget_status deadline_status:assessment.deadline_status}}
}
fn present_results(reason){
 let token=run_id let call=active_tool
 let state=read_route_summaries(candidates,token,fn(routes){
  if !current_task(token) || active_tool!=call {return}
  phase="proposal" show_status("已计算当前候选；已查范围不代表所有可能路线")
  refresh_generated_facts()
  if call!=nil {let index=[] for route in routes {index.push(comparison_route_index(route))} agent_tool_result({success:true guardian_current_check:guardian_current_check() fresh_route_count:routes.len() comparison:comparison_summary(routes) routes:index detail_tool:"get_route" queried_transit_count:transit_count queried_driving:driving_done})}
 })
 state.update_assessment=true
}
fn read_source_tool(name, token, done){
    if (name == "read_calendar" || name == "read_notes") && location_mode() != "demo" { fail_task("当前真实模式未接通日历和笔记来源") return }
    mark_tool_used(name)
    if name == "read_calendar" { if !calendar_tool() { fail_task("日历来源无法读取") return } }
    elif name == "read_notes" { if !notes_tool() { fail_task("笔记来源无法读取") return } }
    elif name == "read_location" {
        let mode = location_mode()
        if mode == "live" { live_position(token, done) return }
        if mode != "demo" { fail_task("定位模式配置无效") return }
        if !position_tool() { fail_task("模拟位置缺失、格式错误或已过期，请重新初始化演示位置") return }
        verify_position_city(position_record, token, done) return
    } else { fail_task("未知来源工具") return }
    done()
}





fn model_protocol(data){
    let count = nil let call_count = nil let choice = nil let message = nil let call = nil
    let choices = route_get(data, "choices")
    if choices.is_array() { count = choices.len() if count > 0 { choice = choices[0] message = route_get(choice, "message") } }
    let calls = route_get(message, "tool_calls")
    if calls.is_array() { call_count = calls.len() if call_count > 0 { call = calls[0] } }
    let function = route_get(call, "function")
    let content = route_get(message, "content")
    let content_bytes = nil
    if content.is_string() { content_bytes = content.len() }
    return {expected_model: route_get(data, "model") == "MiniMax-M3" truncated: route_get(choice, "finish_reason") == "length" choice_count: count tool_count: call_count
        has_content: content.is_string() content_bytes: content_bytes expected_tool: route_get(function, "name").is_string()
        arguments_string: route_get(function, "arguments").is_string()}
}
// 开发记录不进入业务上下文；每个实际入口先固定数据，再在独立入口写文件。
let trace_state = nil

// Development-only first-render evidence: record in memory, export in independent entries.
// Captured objects are references after the attempt, not a frozen pre-render heap.
let render_probe=nil
fn render_probe_mark(stage){if render_probe!=nil && render_probe.active {render_probe.stage=stage render_probe.marks.push({stage:stage at:time_now()})}}
fn render_probe_begin(call,entry_at){
 if trace_state==nil || render_probe!=nil {return}
 let refs=[] let caches=[]
 for candidate in candidates {refs.push(candidate) caches.push({id:candidate.id steps_cached:route_get(candidate,"steps_cache")!=nil geometry_cached:route_get(candidate,"map_geometry_cache")!=nil catalog_cached:route_get(candidate,"map_paths_cache")!=nil})}
 render_probe={active:true run:run_id call_id:call.id entry_at:entry_at stage:"tool_entry" marks:[] candidates:refs cache_before:caches facts_revision:ui_facts_revision cached_revision:ui_facts_cached_revision reads:0 read_seconds:0 reasons:0 current_route:nil dump_complete:false dump_error:false
  context:{origin:position_record destination:destination_record constraints:constraints limits:user_limits received_at:received_at arrive_by:arrive_by source_snapshots:source_snapshots source_records:source_records route_nodes:route_nodes route_prefixes:route_prefixes taxi_quotes:didi_quotes taxi_places:didi_places}}
 let saved=render_probe let directory=trace_state.directory let prefix="first-render-"+run_id
 start_timeout(0.8,||render_probe_export(saved,directory,prefix))
 render_probe_mark("tool_entry")
}
fn render_probe_report(saved){return {run:saved.run call_id:saved.call_id entry_at:saved.entry_at stage:saved.stage marks:saved.marks current_route:saved.current_route reads:saved.reads read_seconds:saved.read_seconds reasons:saved.reasons route_count:saved.candidates.len() cache_before:saved.cache_before facts_revision:saved.facts_revision cached_revision:saved.cached_revision dump_complete:saved.dump_complete dump_error:saved.dump_error heap_basis:"references exported after render attempt; original geometry retained privately" native_budget_age:"not_observed"}}
fn render_probe_export(saved,directory,prefix){
 saved.active=false
 try {fs.write(directory+"/"+prefix+"-stage.json",render_probe_report(saved).to_json())} {saved.dump_error=true}
 start_timeout(0.1,||{
  try {fs.write(directory+"/"+prefix+"-context.json",saved.context.to_json())} {saved.dump_error=true}
  start_timeout(0.1,||render_probe_export_route(saved,directory,prefix,0))
 })
}
fn render_probe_export_route(saved,directory,prefix,index){
 if index>=saved.candidates.len() {saved.dump_complete=!saved.dump_error try {fs.write(directory+"/"+prefix+"-stage.json",render_probe_report(saved).to_json())} {} return}
 try {fs.write(directory+"/"+prefix+"-route-"+index+".json",saved.candidates[index].to_json())} {saved.dump_error=true}
 start_timeout(0.1,||render_probe_export_route(saved,directory,prefix,index+1))
}

let trace_initialized = false
let trace_last_diagnostic = ""
let trace_initialization_error = ""
let trace_io=nil
let trace_enabled = false
let trace_session = ""
// 仅开发观测；入口中止时隐藏标记保留未返回阶段，不记录内容、凭据或任意文件路径。
fn trace_io_begin(op,category){
 if !trace_enabled {return nil}
 let row={op:op path_kind:category started_at:time_now() returned:false}
 trace_io=row return row
}
fn trace_io_end(row){
 if row==nil {return}
 row.completed_at=time_now() row.elapsed_seconds=row.completed_at-row.started_at row.returned=true
}
fn trace_append_file(path,text){let row=trace_io_begin("append","trace_segment") fs.append(path,text) trace_io_end(row)}
fn trace_write_status(path,text){let row=trace_io_begin("write","trace_status") fs.write(path,text) trace_io_end(row)}
fn trace_scrub(text, keys){
    for key in keys {
        if key.is_string() && key != "" && text.search(key)>=0 {
            let parts = text.split(key) let replaced = ""
            for index part in parts { if index > 0 { replaced += "[REDACTED]" } replaced += part }
            text = replaced
        }
    }
    return text
}
fn trace_status(state){
    return {v:1 format:"jsonl-segments" segments:state.segment session:state.session instance:state.instance run:state.run last_seq:state.written_seq state:if state.incomplete {"incomplete"} else {"recording"} error:if state.incomplete {"记录写入未完成；事件可能缺失"} else {""} failure_phase:route_get(state,"failure_phase") failure_kind:route_get(state,"failure_kind")}
}
fn trace_identity_json(){
    return {session:trace_session instance:if trace_state!=nil {trace_state.instance} else {nil} run:run_id state:if trace_initialization_error!="" {"incomplete"} elif trace_state!=nil && trace_state.incomplete {"incomplete"} else {"recording"} error:trace_initialization_error io:trace_io tool_job:tool_job_identity() model_request:model_request_identity()}.to_json()
}
fn trace_marker(){
    if !trace_enabled {return}
    try {
        let current=ui.trace_identity.text().parse_json()
        if current.session!=trace_session || current.instance!=if trace_state!=nil {trace_state.instance} else {nil} {return}
        ui.trace_identity.set_text(trace_identity_json())
    } {}
}
fn trace_emit(event, data, call_id){trace_emit_run(event,data,call_id,run_id)}
fn trace_record_failure(state,stage,kind){state.incomplete=true state.failure_phase=stage state.failure_kind=kind}
fn trace_schedule_status(state){
 start_timeout_checked(0.01,||{
  try {trace_write_status(state.directory+"/status.json",trace_status(state).to_json())} {trace_record_failure(state,"status_write","io") return}
  trace_marker()
 },fn(error){trace_record_failure(state,"status_commit",route_get(error,"error_kind"))})
}
fn trace_failed_status(state,stage,kind){
 trace_record_failure(state,stage,kind)
 trace_schedule_status(state)
}
fn trace_commit_line(state,line,seq,run){
 try {
  let bytes=line.len()
  if state.segment==0 || state.segment_bytes+bytes>1048576 {state.segment+=1 state.segment_bytes=0}
  let number=""+state.segment while number.len()<6 {number="0"+number}
  trace_append_file(state.directory+"/segment-"+number+".jsonl",line)
  state.segment_bytes+=bytes
  if seq>state.written_seq {state.written_seq=seq} state.run=run
 } {trace_record_failure(state,"segment_append","io")}
 trace_schedule_status(state)
}
// 大body/source本来就是序列化文本；私有字段文件避免再次整体JSON转义。
fn trace_write_field(job){
 if job.index>=job.fields.len() {
  let line={v:1 session:job.state.session instance:job.state.instance run:job.run seq:job.seq event:job.event at:job.at call_id:job.call_id data:job.small.to_json() trace_fields:job.references}.to_json()+"\n"
  trace_commit_line(job.state,trace_scrub(line,job.state.keys),job.seq,job.run) return
 }
 let field=job.fields[job.index]
 if route_get(field,"offset")==nil {field.text=trace_scrub(field.text,job.state.keys) field.offset=0 field.parts=[]}
 let text=field.text
 // 一次仅复制一个UTF8片；不先构造全文片数组或二次转义大字段。
 let piece=if text.len()<=1048576 {text} else {text.utf8_chunk(field.offset,262144)}
 let name="event-"+job.seq+"-field-"+field.name+"-part-"+field.parts.len()+".txt"
 try {fs.write(job.state.directory+"/"+name,piece)} {trace_failed_status(job.state,"field_write","io") return}
 field.parts.push({name:name bytes:piece.len()}) field.offset+=piece.len()
 if field.offset>=text.len() {
  job.references.push({field:field.name encoding:"UTF-8" bytes:text.len() parts:field.parts}) job.index+=1
 }
 // 下一闭包不保留已写片的局部String引用；原字段仍由job持有至提交。
 piece=nil
 start_timeout_checked(0.01,||trace_write_field(job),fn(error){trace_failed_status(job.state,"field_commit",route_get(error,"error_kind"))})
}

fn trace_write_small(job){
 let envelope={v:1 session:job.state.session instance:job.state.instance run:job.run seq:job.seq event:job.event at:job.at call_id:job.call_id data:job.small.to_json()}.to_json()
 let line=trace_scrub(envelope,job.state.keys)+"\n"
 if line.len()>1048576 {
  // 未知大对象不进入分片前再制造全文副本；留下明确诊断缺口。
  trace_failed_status(job.state,"event_size","file_limit") return
 }
 trace_commit_line(job.state,line,job.seq,job.run)
}
fn trace_emit_run(event, data, call_id, run){
 if trace_state==nil {return}
 let state=trace_state state.seq+=1 let seq=state.seq
 let small={} let fields=[]
 for key value in data {
  let name=""+key
  if (name=="body" || name=="source") && value.is_string() && value.len()>65536 {
   fields.push({name:name text:value})
  } else {
   if value.is_string() && value.len()>1048576 {trace_failed_status(state,"field_size","file_limit") return}
   small[key]=value
  }
 }
 let job={state:state seq:seq run:run event:event at:time_now() call_id:call_id small:small fields:fields references:[] index:0}
 if fields.len()>0 {start_timeout_checked(0.01,||trace_write_field(job),fn(error){trace_failed_status(state,"field_commit",route_get(error,"error_kind"))})}
 else {start_timeout_checked(0.01,||trace_write_small(job),fn(error){trace_failed_status(state,"event_commit",route_get(error,"error_kind"))})}
}
fn trace_initialize(){
    if trace_initialized {return}
    trace_initialized=true
    let config = nil
    try {let text=read_text("private-config.json") if text!=nil {config=text.parse_json()}} {return}
    if route_get(config,"development_trace") != true {return}
    trace_enabled=true
    let session=route_get(config,"development_trace_session")
    if !session.is_string() || session=="" {trace_initialization_error="开发记录会话标识缺失" trace_marker() return}
    trace_session=session
    // 同一宿主UI线程同步分配；旧/新VM各有独立目录，不竞争current文件。
    let counter_path="dev-trace/"+session+"/instance-counter.json"
    let ordinal=nil
    try {let old=read_text(counter_path) if old!=nil {ordinal=old.parse_json().next}} {trace_initialization_error="实例标识读取失败；开发记录不完整" trace_marker() return}
    if !ordinal.is_number() || ordinal<1 || ordinal%1!=0 {trace_initialization_error="实例标识计数缺失或无效；开发记录不完整" trace_marker() return}
    try {fs.write(counter_path,{next:ordinal+1}.to_json())} {trace_initialization_error="实例标识写入失败；开发记录不完整" trace_marker() return}
    let keys=[]
    for name in ["amap_api_key" "didi_mcp_key"] {let key=route_get(config,name) if key.is_string() && key!="" {keys.push(key) keys.push(key.url_encode())}}
    trace_state={session:session instance:"vm-"+ordinal directory:"dev-trace/"+session+"/vm-"+ordinal seq:0 written_seq:0 segment:0 segment_bytes:0 run:run_id incomplete:false keys:keys}
    try {fs.write(trace_state.directory+"/status.json",trace_status(trace_state).to_json())} {trace_state.incomplete=true}
    trace_emit("instance_started",{metadata:route_get(config,"development_trace_metadata")},nil)
}
fn trace_map(event,slot){
    trace_emit(event,{widget:slot.id target:slot.target target_id:slot.target_id state:slot.state status:slot.status request:slot.request generation:slot.generation camera:slot.camera path_indices:route_get(slot,"path_indices")},nil)
}
// 请求业务与诊断分入口；诊断失败不能夹断已返回模型的处理。
let model_request_owner=nil
let model_response_diagnostic=nil
fn model_request_identity(){
 let record=model_request_owner
 if record==nil {return nil}
 return {run:route_get(record,"run") step:record.step request_id:route_get(record,"host_request_id") phase:route_get(record,"processing_stage") state:record.state action_started:route_get(record,"action_started") action_completed:route_get(record,"action_completed") execution_failure_reported:route_get(record,"execution_failure_reported") response_cached:model_response_diagnostic!=nil && model_response_diagnostic.record==record request_body_bytes:route_get(record,"request_body_bytes") dispatch_rejection:route_get(record,"dispatch_rejection")}
}
fn model_timeout(delay,token,record,stage,work){
 start_timeout_checked(delay,||{
  if !request_current(token,record){return}
  record.processing_stage=stage work()
 },fn(error){model_execution_failed(token,record,error)})
}
fn model_execution_failed(token,record,error){
 if !request_current(token,record) || route_get(record,"execution_failure_reported")==true {return}
 record.execution_failure_reported=true record.state="model_execution_failed"
 let failure={run:token step:record.step request_id:route_get(record,"host_request_id") phase:record.processing_stage error_kind:route_get(error,"error_kind") occurred_at:time_now()}
 start_timeout(0.01,||trace_emit_run("model_processing_error",failure,nil,token))
 request_failed(record,"模型处理入口未完整执行；本轮已停止，已有完整路线保留，不自动重试")
}
fn request_finished(record, state){
 record.state=state record.completed_at=time_now() record.wall_seconds=record.completed_at-record.started_at
 let token=if route_get(record,"run")!=nil {record.run} else {run_id}
 let event={step:record.step state:state wall_seconds:record.wall_seconds http_status:route_get(record,"http_status") occurred_at:record.completed_at}
 start_timeout(0.01,||trace_emit_run("transport_finished",event,nil,token))
}
fn request_stage(record, stage){
 record.transport_stage=stage record.stage_at=time_now()
 let token=if route_get(record,"run")!=nil {record.run} else {run_id}
 let event={step:record.step stage:stage occurred_at:record.stage_at}
 start_timeout(0.01,||trace_emit_run("transport_stage",event,nil,token))
}
fn model_response_received(waiting,record,reply,token,done){
 if waiting.settled {return}
 waiting.settled=true record.response_received_at=time_now()
 if request_current(token,record) {model_response_diagnostic={run:token step:record.step record:record reply:reply}}
 // 先排业务处理；完整响应记录另入口写，不继承宿主回调或诊断成本。
 if request_current(token,record) {model_timeout(0.01,token,record,"response_action",||model_accept_response(record,reply,token,done))}
 request_finished(record,if reply.is_ok {"returned"} else {"host_error"})
 let current=request_current(token,record)
 start_timeout(0.01,||trace_emit_run("model_response",{step:record.step service:"model.chat" is_ok:reply.is_ok body:if reply.is_ok {reply.data.to_json()} else {reply.error} current:current},nil,token))
}
fn model_accept_response(record,reply,token,done){
 if !request_current(token,record) || route_get(record,"action_started")==true {return}
                if !reply.is_ok {
                    record.host_error=reply.error
                    let error=if reply.error.is_string() {reply.error} else {""}
                    let message=if error.search("no service answers")>=0 || error.search("there is no model.chat")>=0 {"当前宿主未提供 Navigation 所需的 model.chat 服务"}
                        elif error.search("no_provider:")>=0 {"宿主尚未配置可用的主模型，请在 AI providers 中配置"}
                        elif error.search("rate:")>=0 {"宿主模型调用过于频繁，请稍后重新查询"}
                        elif error.search("budget:")>=0 {"本应用已达到宿主模型额度，请检查宿主配置"}
                        elif error.search("capability:")>=0 {"宿主尚未授权本应用使用模型服务"}
                        else {"模型服务未完成请求，已保留本次结果，可继续规划"}
                    request_failed(record,message) return
                }
                    try {
                        let data=route_get(reply.data,"response")
                        if !data.is_object() {record.state="invalid_response" request_failed(record,"宿主模型响应格式无效，请重新查询") return}
                        let usage=route_get(data,"usage")
                        record.meta={prompt_tokens:route_get(usage,"prompt_tokens") completion_tokens:route_get(usage,"completion_tokens") total_tokens:route_get(usage,"total_tokens")}
                        record.host_meta=route_get(reply.data,"meta") record.protocol=model_protocol(data)
                        request_stage(record,"model_action") record.action_started=true done(data) record.action_completed=true
                    } {record.state="invalid_response" request_failed(record,"宿主模型响应格式无效，请重新查询")}
}
fn minimax_request(task,input,schema,token,record,done){
 request_stage(record,"entry")
 let body={messages:input tools:schema tool_choice:"auto" reasoning_split:true}
 let recorded_body=body.to_json()
 record.request_body_bytes=recorded_body.len()
 start_timeout(0.01,||trace_emit_run("model_request",{step:record.step service:"model.chat" body:recorded_body},nil,token))
 let waiting={settled:false}
 record.dispatch_started_at=nil record.dispatch_returned_at=nil record.dispatch_returned=false record.http_status=nil
 model_timeout(0.01,token,record,"host_dispatch",||{
  if waiting.settled {return}
  record.dispatch_started_at=time_now()
  start_timeout(0.01,||trace_emit_run("model_dispatch",{step:record.step service:"model.chat" started_at:record.dispatch_started_at},nil,token))
  request_stage(record,"before_host")
  try {
   record.host_request_id=host.request("model.chat",body,fn(reply){model_response_received(waiting,record,reply,token,done)})
   record.dispatch_returned=true record.dispatch_returned_at=time_now() request_stage(record,"after_host")
  } {
   waiting.settled=true record.dispatch_rejection={stage:"host_dispatch" request_body_bytes:record.request_body_bytes detail:"host.request抛出异常；当前try接口不提供异常值，未观测服务端响应"}
   start_timeout(0.01,||trace_emit_run("model_dispatch_rejected",{step:record.step rejection:record.dispatch_rejection},nil,token))
   request_finished(record,"request_rejected")
   if request_current(token,record) {request_failed(record,"宿主模型请求未能派发，请重新查询")}
  }
 })
}


// 业务列表只保存详情输入、成功原稿与事实；不保存模型会话或运行实例。
fn trip_by_id(id){for trip in trip_records {if trip.id==id {return trip}} return nil}
fn trip_state(){return {schema:1 selected_id:trip_selected_id next_id:trip_next_id generation:trip_generation trips:trip_records}}
// 不复制未变化的大事实/几何；提交前只修改独立记录头，snapshot与goal替换而不原地改写。
fn trip_edit_state(){
 let records=[] for old in trip_records {records.push({id:old.id title:old.title input:old.input created_at:old.created_at updated_at:old.updated_at status:old.status goal:old.goal snapshot:old.snapshot _record_file:route_get(old,"_record_file") _dirty:false})}
 return {schema:1 selected_id:trip_selected_id next_id:trip_next_id generation:trip_generation trips:records}
}
fn trip_save_before_navigation(done){
 let trip=trip_by_id(trip_selected_id)
 if trip_replay || (trip!=nil && trip.snapshot!=nil && !agent_active && trip_saved_run==run_id) {done(true) return true}
 return trip_save_current(if agent_active {"interrupted"} else {phase},done)
}

fn trip_encode(data){return "{\"schema\":1,\"saved_at\":"+time_now().to_json()+",\"data\":"+data.to_json()+",\"complete\":\"navigation-trips-v1\"}"}
fn trip_valid(data){
 if !data.is_object() || data.schema!=1 || !data.trips.is_array() || !data.next_id.is_number() || data.next_id<1 || data.next_id%1!=0 {return false}
 let seen={} let selected=data.selected_id==nil
 for trip in data.trips {
  if !trip.is_object() || !trip.id.is_string() || trip.id=="" || seen[trip.id]==true || !trip.input.is_string() || !trip.title.is_string() || !trip.status.is_string() || !trip.created_at.is_number() || !trip.updated_at.is_number() {return false}
  if trip.goal!=nil && !guardian_valid_goal(trip.goal) {return false}
  if trip.snapshot!=nil && (!trip.snapshot.is_object() || !trip.snapshot.facts.is_object() || !trip.snapshot.blocks.is_array() || !trip.snapshot.route_data.is_array() || !trip.snapshot.captured_at.is_number()) {return false}
  seen[trip.id]=true if trip.id==data.selected_id {selected=true}
 }
 return selected
}
fn trip_disk_index(data){let entries=[] for trip in data.trips {entries.push({id:trip.id file:trip._record_file})} return {schema:1 selected_id:data.selected_id next_id:data.next_id generation:data.generation trips:entries}}
let trip_pending_commit=nil
let trip_capture_pending=nil
let trip_loading=false
fn trip_part_name(file,index){return file.strip_suffix(".json")+"-part-"+index+".text"}
fn trip_parse_text(text,marker){
 if !text.is_string() || text.strip_suffix(",\"complete\":\""+marker+"\"}")==text {return nil}
 let parsed=nil try {parsed=text.parse_json()} {return nil}
 if !parsed.is_object() || parsed.complete!=marker || !parsed.saved_at.is_number() {return nil}
 return parsed
}
fn trip_read_json(path,marker,done){fs.read_async(path,fn(reply){done(if reply.success {trip_parse_text(reply.text,marker)} else {nil})})}
fn trip_read_record(file,id,done){
 fs.read_async(file,fn(reply){
  if !reply.success {done(nil) return}
  let legacy=trip_parse_text(reply.text,"navigation-trip-v1")
  if legacy!=nil {done(legacy) return}
  let manifest=trip_parse_text(reply.text,"navigation-trip-parts-v1")
  if manifest==nil || manifest.schema!=1 || manifest.id!=id || manifest.file!=file || !manifest.revision.is_number() || manifest.revision<1 || manifest.revision%1!=0 || file!="navigation-trip-"+id+"-"+manifest.revision+".json" || !manifest.parts.is_array() || manifest.parts.len()==0 || !manifest.total_bytes.is_number() {done(nil) return}
  let expected=0
  for index part in manifest.parts {
   if !part.is_object() || part.file!=trip_part_name(file,index) || !part.bytes.is_number() || part.bytes<1 || part.bytes>1048576 || part.bytes%1!=0 {done(nil) return}
   expected+=part.bytes
  }
  if expected!=manifest.total_bytes {done(nil) return}
  trip_read_part({manifest:manifest index:0 text:"" done:done})
 })
}
fn trip_read_part(reading){
 if reading.index>=reading.manifest.parts.len() {reading.done(trip_parse_text(reading.text,"navigation-trip-v1")) return}
 let part=reading.manifest.parts[reading.index]
 fs.read_async(part.file,fn(reply){
  if !reply.success || !reply.text.is_string() || reply.text.len()!=part.bytes {reading.done(nil) return}
  reading.text+=reply.text reading.index+=1
  start_timeout(0.01,||trip_read_part(reading))
 })
}
fn trip_read(path,done){
 trip_read_json(path,"navigation-trips-v1",fn(parsed){
  if parsed==nil {done(nil) return}
  let index=parsed.data
  if !index.is_object() || !index.trips.is_array() || !index.generation.is_number() || index.generation<1 {guardian_error="出行索引格式无效" done(nil) return}
  trip_read_entry({parsed:parsed index:0 records:[] done:done})
 })
}
fn trip_read_entry(reading){
 let index=reading.parsed.data
 if reading.index>=index.trips.len() {
  let data={schema:1 selected_id:index.selected_id next_id:index.next_id generation:index.generation trips:reading.records}
  if !trip_valid(data) {guardian_error="出行列表格式无效" reading.done(nil) return}
  reading.parsed.data=data reading.done(reading.parsed) return
 }
 let entry=index.trips[reading.index]
 if !entry.is_object() || !entry.id.is_string() || !entry.file.is_string() || !regex("^navigation-trip-trip-[0-9]+-[0-9]+[.]json$","").test(entry.file) {guardian_error="出行记录引用无效" reading.done(nil) return}
 trip_read_record(entry.file,entry.id,fn(record){
  if record==nil || !record.data.is_object() || record.data.id!=entry.id {guardian_error="出行详情缺失或损坏" reading.done(nil) return}
  record.data._record_file=entry.file record.data._dirty=false reading.records.push(record.data) reading.index+=1
  start_timeout(0.01,||trip_read_entry(reading))
 })
}
fn trip_commit_current(tx){return trip_pending_commit==tx && !tx.cancelled && tx.base_generation==trip_generation && tx.run==run_id && tx.selected_id==trip_selected_id}
fn trip_cancel_commit(){if trip_pending_commit!=nil {trip_pending_commit.cancelled=true} if trip_capture_pending!=nil {trip_capture_pending.cancelled=true}}
fn trip_commit(data,done){
 if trip_loading || trip_capture_pending!=nil || trip_pending_commit!=nil {guardian_error="完整出行记录正在保存或恢复，请稍候" done(false) return false}
 if !trip_valid(data) {guardian_error="出行记录格式无效，未保存" done(false) return false}
 let tx={data:data base_generation:trip_generation generation:trip_generation+1 selected_id:trip_selected_id run:run_id cancelled:false written:[] index:0 done:done previous_index:trip_disk_index(trip_state()) old_previous:nil parts:nil part_index:0 file:nil total:0 stage:"prepare"}
 if route_get(data,"deleted_id")!=nil {
  let kept=[] for entry in tx.previous_index.trips {if entry.id!=data.deleted_id {kept.push(entry)}} tx.previous_index.trips=kept
  if tx.previous_index.selected_id==data.deleted_id {tx.previous_index.selected_id=data.selected_id}
 }
 trip_pending_commit=tx
 trip_read_json("navigation-trips.previous.json","navigation-trips-v1",fn(previous){
  tx.old_previous=previous start_timeout(0.01,||trip_commit_record(tx))
 })
 return true
}
fn trip_commit_fail(tx){
 if trip_pending_commit!=tx {return}
 guardian_error=if tx.cancelled {"保存已取消；现有记录仍保留"} else {"保存出行失败；现有记录仍保留（阶段："+tx.stage+"），没有截断详情"}
 trip_commit_cleanup(tx,0)
}
fn trip_commit_cleanup(tx,index){
 if index>=tx.written.len() {trip_pending_commit=nil tx.done(false) return}
 try {if fs.exists(tx.written[index]) {fs.remove(tx.written[index])}} {}
 start_timeout(0.01,||trip_commit_cleanup(tx,index+1))
}
fn trip_commit_record(tx){
 if !trip_commit_current(tx) {trip_commit_fail(tx) return}
 if tx.index>=tx.data.trips.len() {start_timeout(0.01,||trip_commit_index(tx,false)) return}
 let trip=tx.data.trips[tx.index] let old=trip_by_id(trip.id)
 if old!=nil && route_get(trip,"_dirty")!=true {trip._record_file=old._record_file tx.index+=1 start_timeout(0.01,||trip_commit_record(tx)) return}
 tx.file="navigation-trip-"+trip.id+"-"+tx.generation+".json" trip._record_file=tx.file
 // 一次冻结完整JSON；原生分片保UTF8码点边界，不截断路线或详情。
 tx.stage="freeze_record"
 let text=nil
 try {text="{\"schema\":1,\"saved_at\":"+time_now().to_json()+",\"data\":"+trip.to_json()+",\"complete\":\"navigation-trip-v1\"}" tx.parts=text.utf8_chunks(262144)} {trip_commit_fail(tx) return}
 if !tx.parts.is_array() || tx.parts.len()==0 {trip_commit_fail(tx) return}
 tx.total=text.len() tx.part_index=0 tx.part_facts=[]
 start_timeout(0.01,||trip_commit_part(tx))
}
fn trip_commit_part(tx){
 if !trip_commit_current(tx) {trip_commit_fail(tx) return}
 if tx.part_index>=tx.parts.len() {
  tx.stage="write_manifest"
  let manifest={schema:1 saved_at:time_now() id:tx.data.trips[tx.index].id revision:tx.generation file:tx.file parts:tx.part_facts total_bytes:tx.total}
  tx.written.push(tx.file)
  try {fs.write(tx.file,manifest.to_json().strip_suffix("}")+",\"complete\":\"navigation-trip-parts-v1\"}")} {trip_commit_fail(tx) return}
  tx.index+=1 tx.parts=nil start_timeout(0.01,||trip_commit_record(tx)) return
 }
 tx.stage="write_part"
 let part=tx.parts[tx.part_index] let file=trip_part_name(tx.file,tx.part_index)
 if part.len()>1048576 {trip_commit_fail(tx) return}
 tx.written.push(file)
 try {fs.write(file,part)} {trip_commit_fail(tx) return}
 tx.part_facts.push({file:file bytes:part.len()}) tx.part_index+=1
 start_timeout(0.01,||trip_commit_part(tx))
}
fn trip_commit_index(tx,primary){
 if !trip_commit_current(tx) {trip_commit_fail(tx) return}
 tx.data.generation=tx.generation
 if !primary && trip_generation>0 {
  tx.stage="write_previous_index"
  try {fs.write("navigation-trips.previous.json",trip_encode(tx.previous_index))} {trip_commit_fail(tx) return}
  start_timeout(0.01,||trip_commit_index(tx,true)) return
 }
 tx.stage="write_primary_index"
 try {fs.write("navigation-trips.json",trip_encode(trip_disk_index(tx.data)))} {trip_commit_fail(tx) return}
 trip_records=tx.data.trips trip_selected_id=tx.data.selected_id trip_next_id=tx.data.next_id trip_generation=tx.generation guardian_error=""
 for trip in trip_records {trip._dirty=false}
 trip_pending_commit=nil tx.done(true)
 // 只回收两份已提交索引均不再引用的不可变revision，连同其全部分片。
 if tx.old_previous!=nil && route_get(tx.old_previous.data,"trips").is_array() {trip_reclaim_entries(tx.old_previous.data.trips,trip_disk_index(tx.data).trips,tx.previous_index.trips,0)}
}
fn trip_reclaim_entries(entries,primary,previous,index){
 if index>=entries.len() {return}
 let entry=entries[index] let keep=false
 for item in primary {if item.file==entry.file {keep=true}} for item in previous {if item.file==entry.file {keep=true}}
 if keep {start_timeout(0.01,||trip_reclaim_entries(entries,primary,previous,index+1)) return}
 trip_remove_record(entry.file,fn(){start_timeout(0.01,||trip_reclaim_entries(entries,primary,previous,index+1))})
}
fn trip_remove_record(file,done){
 trip_read_json(file,"navigation-trip-parts-v1",fn(manifest){
  let files=[]
  if manifest!=nil && manifest.file==file && manifest.parts.is_array() {for index part in manifest.parts {if part.file==trip_part_name(file,index) {files.push(part.file)}}}
  files.push(file) trip_remove_files(files,0,done)
 })
}
fn trip_remove_files(files,index,done){
 if index>=files.len() {done() return}
 try {if fs.exists(files[index]) {fs.remove(files[index])}} {}
 start_timeout(0.01,||trip_remove_files(files,index+1,done))
}
fn trip_apply_goal(){
 let trip=trip_by_id(trip_selected_id)
 guardian_goal=if trip!=nil {trip.goal} else {nil}
 guardian_check=if guardian_goal!=nil {route_get(guardian_goal,"last_check")} else {nil}
 guardian_pending=nil guardian_open_proposal=nil guardian_mode=false guardian_reported_run=-1 guardian_progress_open=false
}
fn trip_adopt_loaded(parsed){trip_records=parsed.data.trips trip_selected_id=parsed.data.selected_id trip_next_id=parsed.data.next_id trip_generation=parsed.data.generation trip_apply_goal()}
fn trip_load(done){
 trip_loading=true
 trip_read("navigation-trips.json",fn(primary){
  if primary!=nil {trip_adopt_loaded(primary) trip_loading=false done() return}
  trip_read("navigation-trips.previous.json",fn(previous){
   if previous!=nil {trip_adopt_loaded(previous) guardian_error="主列表损坏，恢复较早备份（"+guardian_deadline(previous.saved_at)+"）；请核对是否最新" trip_loading=false done() return}
   trip_loading=false
   if fs.exists("navigation-trips.json") || fs.exists("navigation-trips.previous.json") {if guardian_error=="" {guardian_error="出行索引无法读取或详情不完整，未采用损坏记录"} done() return}
   guardian_load_legacy()
   if guardian_goal==nil {done() return}
   let goal=guardian_goal let created=goal.confirmed_at
   let trip={id:"trip-1" title:goal.destination.name input:"已确认的出行目标" created_at:created updated_at:time_now() status:if goal.state=="ended" {"ended"} else {"confirmed"} goal:goal snapshot:nil _dirty:true}
   trip_commit({schema:1 selected_id:trip.id next_id:2 trips:[trip]},fn(committed){if committed {trip_apply_goal()} done()})
  })
 })
}
fn trip_capture(){
 let routes=[] for candidate in candidates {let saved=guardian_materialize(candidate) saved.history_geometry_ref=route_get(candidate,"geometry_ref") routes.push(saved)}
 let blocks=[] for block in ui_blocks {if block.installed && block.error=="" && route_get(block,"raw_source").is_string() {blocks.push({id:block.id source:block.raw_source overlay:block.overlay height:block.height visible:block.visible content_sizing:route_get(block,"content_sizing") render_status:if block.complete {"rendered"} else {"installed_pending_render"} document:block.document route_detail:route_get(block,"route_detail")})}}
 let facts={} for key value in interface_facts() {facts[key]=value} if facts.guardian!=nil {let guardian={} for key value in facts.guardian {guardian[key]=value} guardian.proposal=nil facts.guardian=guardian}
 return {captured_at:time_now() answer:answer_text facts:facts route_data:routes blocks:blocks}
}
fn trip_save_current(status,done){
 let old=trip_by_id(trip_selected_id) if old==nil || trip_replay {if done!=nil {done(true)} return true}
 if trip_capture_pending!=nil {guardian_error="完整出行事实正在准备，请稍候" if done!=nil {done(false)} return false}
 let capture={run:run_id selected:trip_selected_id generation:trip_generation cancelled:false}
 trip_capture_pending=capture
 ensure_interface_facts(capture.run,fn(facts){
  if trip_capture_pending!=capture {return}
  trip_capture_pending=nil
  if facts==nil || capture.cancelled || capture.run!=run_id || capture.selected!=trip_selected_id || capture.generation!=trip_generation {if done!=nil {done(false)} return}
  let data=trip_edit_state()
  for trip in data.trips {if trip.id==trip_selected_id {trip.updated_at=time_now() trip.status=status trip.snapshot=trip_capture() trip._dirty=true}}
  trip_commit(data,fn(success){
   if success {trip_saved_run=capture.run}
   if native_ui_available && capture.run==run_id && capture.selected==trip_selected_id {trip_refresh_shell()}
   if done!=nil {done(success)}
  })
 })
 return true
}
fn trip_reset_runtime(){
 clear_model_resume()
 agent_active=false active_tool=nil run_id+=1 cancel_pending_location() context_notes_cancel_all() invalidate_interface() invalidate_map()
 if task_timer!=nil {stop_timer(task_timer) task_timer=nil}
 picker_request+=1 picker_open=false
 agent_active=false active_tool=nil agent_messages=[] agent_calls=[]
 candidates=[] chosen=nil viewed_route_id="" map_geometry_jobs={} route_node_generation+=1 route_nodes={} route_prefixes={} rail_services={} rail_service_sequence=0 rail_cookie="" didi_places={} didi_quotes={}
 position_record=nil destination_record=nil constraints=nil user_limits=nil source_records=[] source_snapshots=[]
 answer_text="" request_text="" request_form_input="" phase="idle" runtime_status="" interface_error=""
 trip_replay=false trip_history=nil guardian_pending=nil guardian_open_proposal=nil guardian_mode=false guardian_reported_run=-1
 composer_open=false history_details_open=false trip_manage_open=false shell_delete_target=nil shell_delete_kind=""
 ui_facts_revision+=1
}
fn trip_refresh_shell(){
 ui.trip_header.render() ui.trip_rows.render() ui.trip_context.render() ui.trip_management.render()
 ui.trip_sidebar.set_visible(trip_sidebar_open) ui.trip_scrim.set_visible(trip_sidebar_open)
 guardian_refresh() render_content()
}
fn trip_new(done){
 return trip_save_before_navigation(fn(saved){
  if !saved {trip_refresh_shell() if done!=nil {done(false)} return}
  let data=trip_edit_state() let now=time_now() let id="trip-"+data.next_id
  data.next_id+=1 data.selected_id=id
  data.trips.push({id:id title:"新出行" input:"" created_at:now updated_at:now status:"draft" goal:nil snapshot:nil _dirty:true})
  trip_commit(data,fn(committed){
   if committed {trip_reset_runtime() trip_apply_goal() trip_sidebar_open=false ui.sentence.set_text("")}
   trip_refresh_shell() if done!=nil {done(committed)}
  })
 })
}
fn trip_restore(){
 let trip=trip_by_id(trip_selected_id)
 if trip==nil {return}
 ui.sentence.set_text(trip.input)
 trip_apply_goal()
 if trip.snapshot==nil {trip_refresh_shell() return}
 trip_replay=true trip_history=trip.snapshot
 answer_text=if trip_history.answer.is_string() {trip_history.answer} else {""}
 phase="history" request_text=trip.input viewed_route_id=route_get(trip_history.facts,"viewed_route_id")
 if !viewed_route_id.is_string() {viewed_route_id=""}
 ui_facts_revision+=1
 let params={blocks:[] legacy_content_sizing:true} let document=nil
 for block in trip_history.blocks {if block.document {document={source:block.source content_sizing:route_get(block,"content_sizing") legacy_content_sizing:true}} else {params.blocks.push({id:block.id source:block.source overlay:block.overlay height:block.height visible:false content_sizing:route_get(block,"content_sizing") route_detail:if route_get(block,"route_detail")!=nil {block.route_detail} else {block.id=="route_detail"}})}}
 if native_ui_available && (params.blocks.len()>0 || document!=nil) {
  let revision=interface_revision let changed=[] let failed=false
  // 单文档安装会替换整稿；其后追加的命名块必须按相同顺序恢复，不能同传source和blocks。
  if document!=nil {let installed=mount_ui_blocks(document,run_id,revision) if installed==nil {failed=true} else {for block in installed {changed.push(block)}}}
  if !failed && params.blocks.len()>0 {let installed=mount_ui_blocks(params,run_id,revision) if installed==nil {failed=true} else {for block in installed {changed.push(block)}}}
  if failed {runtime_status="历史界面恢复失败："+interface_error}
  else {for block in changed {for saved in trip_history.blocks {if saved.id==block.id {block.visible=if block.overlay {false} else {saved.visible}}}}}
 }
 trip_refresh_shell()
}
fn trip_select(id){
 shell_delete_target=nil shell_delete_kind="" trip_manage_open=false
 if id==trip_selected_id {trip_sidebar_open=false trip_refresh_shell() return true}
 if trip_by_id(id)==nil {return false}
 return trip_save_before_navigation(fn(saved){
  if !saved {trip_refresh_shell() return}
  let data=trip_edit_state() data.selected_id=id
  trip_commit(data,fn(committed){if committed {trip_reset_runtime() trip_sidebar_open=false trip_restore()} else {trip_refresh_shell()}})
 })
}
fn trip_delete(id){
 let removed=trip_by_id(id) if removed==nil {return false}
 let data=trip_edit_state() let kept=[]
 for trip in data.trips {if trip.id!=id {kept.push(trip)}} data.trips=kept
 let deleting_current=id==trip_selected_id
 if deleting_current {data.selected_id=if kept.len()>0 {kept[kept.len()-1].id} else {nil}}
 data.deleted_id=id
 return trip_commit(data,fn(committed){
  if committed {
   trip_remove_record(removed._record_file,||{})
   if deleting_current {trip_reset_runtime() trip_apply_goal() ui.sentence.set_text("") trip_restore()}
  }
  trip_refresh_shell()
 })
}
fn trip_begin(text,done){
 let trip=trip_by_id(trip_selected_id)
 if trip==nil || trip.goal!=nil || trip.input!="" {return trip_new(fn(committed){if committed {trip_begin(text,done)} else {done(false)}})}
 let data=trip_edit_state()
 for item in data.trips {if item.id==trip_selected_id {item.input=text item.title=text item.status="running" item.updated_at=time_now() item.snapshot=nil item._dirty=true}}
 return trip_commit(data,fn(committed){
  if committed {trip_replay=false trip_history=nil ui.sentence.set_text(text)}
  trip_refresh_shell() done(committed)
 })
}
fn shell_composer_default(){let trip=trip_by_id(trip_selected_id) return trip==nil || (trip.input=="" && trip.goal==nil)}
fn shell_trip_name(trip){
 if trip==nil {return "新出行"}
 if trip.goal!=nil {return trip.goal.destination.name}
 if trip.snapshot!=nil {let destination=route_get(trip.snapshot.facts,"destination") if destination!=nil && route_get(destination,"name").is_string() {return destination.name}}
 return trip.title
}
fn shell_title(){
 if guardian_goal!=nil {return guardian_goal.destination.name}
 if trip_history!=nil {let destination=route_get(trip_history.facts,"destination") if destination!=nil && route_get(destination,"name").is_string() {return destination.name}}
 return if shell_composer_default() {"新出行"} else {"出行详情"}
}
fn shell_clock(epoch){return beijing_clock(epoch).strip_suffix("（北京时间）")}
fn shell_short_time(epoch){let v=china_time(epoch) return ""+v.month+"月"+v.day+"日 "+shell_clock(epoch)}
fn shell_deadline(epoch){let v=china_time(epoch) let now=china_time(time_now()) return if v.year==now.year && v.month==now.month && v.day==now.day {shell_clock(epoch)} else {shell_short_time(epoch)}}
fn shell_history_line(){
 if trip_loading {return "正在恢复出行"}
 if trip_pending_commit!=nil {return "正在保存完整详情"}
 if trip_replay {return "历史 · "+shell_short_time(trip_history.captured_at)}
 if agent_active {return "正在规划"}
 let trip=trip_by_id(trip_selected_id)
 if trip!=nil && trip.status=="running" {return if shell_busy() {"正在规划"} else {"上次规划已中断"}}
 if trip!=nil && trip.status=="cancelled" {return "规划已停止"}
 if trip!=nil && trip.status=="failed" {return "规划未完成"}
 return "规划记录"
}
fn shell_goal_summary(){
 if guardian_goal==nil {return guardian_error}
 let status=if guardian_goal.state=="ended" {"目标已结束"} elif guardian_check==nil {"尚未核验"} elif guardian_check.status=="valid" {"估计成立"} elif guardian_check.status=="invalid" {"约束失效 · 查看原因"} else {"证据不足 · 查看原因"}
 return "截止 "+shell_deadline(guardian_goal.deadline_ts)+" · 剩余 "+money_text(guardian_goal.total_budget_cents-guardian_goal.spent_cents)+"\n"+status+if guardian_check!=nil {" · "+shell_clock(guardian_check.checked_at)} else {""}
}
fn shell_delete_request(kind){shell_delete_target=trip_selected_id shell_delete_kind=kind trip_manage_open=true trip_sidebar_open=true trip_refresh_shell()}
fn shell_delete_confirm(){
 let id=shell_delete_target let kind=shell_delete_kind
 shell_delete_target=nil shell_delete_kind=""
 if kind=="trip" {trip_delete(id)} elif id==trip_selected_id {guardian_delete()}
 trip_refresh_shell()
}
fn trip_label(){
 let trip=trip_by_id(trip_selected_id)
 if trip==nil {return "新建或输入一句话开始出行"}
 let text=trip.title
 if trip_replay {text+="\n历史详情 · "+guardian_deadline(trip_history.captured_at)+"；不是当前交通核验，需主动重新规划或核验"}
 elif trip.status=="running" && !agent_active {text+="\n上次查询已中断，未自动继续"}
 elif trip.snapshot==nil && trip.goal!=nil {text+="\n已恢复确认目标；请主动核验查看当前交通"}
 return text
}
fn trip_history_route(ref){
 if !trip_replay || trip_history==nil || !route_get(trip_history,"route_data").is_array() {return nil}
 let id=if ref=="viewed" {viewed_route_id} else {ref}
 for route in trip_history.route_data {if route.id==id || route_get(route,"history_geometry_ref")==id || (route.id.strip_prefix("route_")!=route.id && "polyline_"+route.id.strip_prefix("route_")==id) {return route}}
 return nil
}

// 仅本应用自写记录使用固定末尾标记，检测截断；不保证任意篡改完整性。
// 手工固定外封装顺序，避免宿主parse_json/to_json重排对象字段导致误拒。
fn guardian_encode(goal){return "{\"schema\":1,\"saved_at\":"+time_now().to_json()+",\"goal\":"+goal.to_json()+",\"complete\":\"navigation-goal-v1\"}"}
fn guardian_store(goal,done){
 let data=trip_edit_state() let found=false
 for trip in data.trips {if trip.id==trip_selected_id {trip.goal=goal trip._dirty=true trip.updated_at=time_now() trip.status=if goal==nil {"planned"} elif goal.state=="ended" {"ended"} else {"confirmed"} found=true}}
 if !found {guardian_error="请先新建或选择出行" guardian_refresh() done(false) return false}
 return trip_commit(data,fn(committed){
  if committed {guardian_goal=goal ui_facts_revision+=1}
  guardian_refresh() ui.trip_rows.render() done(committed)
 })
}
fn guardian_read(path){
 let saved=nil let data=nil
 try {saved=read_text(path)} {guardian_error="守护记录无法读取" return nil}
 if saved==nil {return nil}
 if saved.strip_suffix(",\"complete\":\"navigation-goal-v1\"}")==saved {guardian_error="守护记录不完整，未采用截断快照" return nil}
 // 宿主JSON解析器返回部分对象且不报告语法错误；读取和判断不能混在try末尾。
 try {data=saved.parse_json()} {guardian_error="守护记录无法解析" return nil}
 if !data.is_object() || data.schema!=1 || !data.saved_at.is_number() || data.complete!="navigation-goal-v1" || (data.goal!=nil && !guardian_valid_goal(data.goal)) {guardian_error="守护记录格式或版本无效" return nil}
 return data
}
fn guardian_load_legacy(){
 if guardian_loaded {return} guardian_loaded=true
 let data=guardian_read("guardian-goal.json")
 if data!=nil {guardian_goal=data.goal if data.goal!=nil {guardian_check=route_get(data.goal,"last_check")} return}
 let previous=guardian_read("guardian-goal.previous.json")
 if previous!=nil && previous.goal!=nil {guardian_goal=previous.goal guardian_check=route_get(previous.goal,"last_check") guardian_error="主记录损坏或缺失，已恢复较早确认备份（保存于"+guardian_deadline(previous.saved_at)+"）；这不保证是最新状态，请核对进度费用。"}
}
fn guardian_sync_layout(){
 guardian_layout_pending=false
 if !native_ui_available {return}
 let area=ui.content.rect()
 let anchor=ui.result_anchor.rect() let root=ui.index_page.rect()
 if anchor==nil || root==nil {return}
 let top=anchor.y+anchor.height-root.y
 let viewport_changed=area!=nil && area.width>0 && area.height>0 && (ui_viewport==nil || ui_viewport.height!=area.height || ui_viewport.width!=area.width)
 if viewport_changed || ui_overlay_top!=top {
   if area!=nil && area.width>0 && area.height>0 {ui_viewport=area}
   ui_overlay_top=top ui_facts_revision+=1
   ui.block_overlay.render_style() refresh_generated_facts()
 }
}
fn guardian_refresh(){
 if guardian_open_proposal!=guardian_pending {guardian_open_proposal=nil}
 ui.guardian_panel.render() ui.guardian_confirmation.render() ui.guardian_details.render()
 ui.guardian_panel.set_visible(guardian_goal!=nil || guardian_error!="")
 ui.guardian_confirmation.set_visible(guardian_pending!=nil)
 ui.guardian_details.set_visible(guardian_progress_open && guardian_goal!=nil)
 refresh_generated_facts()
 if !guardian_layout_pending {guardian_layout_pending=true start_timeout(0.05,||guardian_sync_layout())}
}
fn guardian_current_check(){
 if guardian_goal==nil || guardian_goal.state!="active" {return nil}
 if guardian_mode && guardian_reported_run==run_id && guardian_check!=nil && guardian_check.goal_version==guardian_goal.version {return guardian_check}
 let check=guardian_assess(nil,time_now(),guardian_goal.deadline_ts,guardian_goal.total_budget_cents-guardian_goal.spent_cents)
 check.goal_version=guardian_goal.version check.run=run_id check.evidence_scope="no_current_traffic_evidence" check.reasons.push("历史方案仅供识别和比较；尚未取得本轮原计划交通证据")
 return check
}
fn guardian_public_goal(goal,saved){return guardian_public_goal_assessed(goal,saved,nil)}
fn guardian_public_goal_assessed(goal,saved,assessment){
 if goal==nil {return nil}
 let route=goal.selected_route let cost=route_cost_facts(route) let duration=route_duration_facts(route) let arrival=if assessment!=nil {assessment} else {route_arrival_facts(route,nil)}
 return {schema:goal.schema state:goal.state version:goal.version deadline_ts:goal.deadline_ts total_budget_cents:goal.total_budget_cents currency:goal.currency spent_cents:goal.spent_cents progress:goal.progress preferences:goal.preferences risk_acceptance:goal.risk_acceptance destination:goal.destination confirmed_at:goal.confirmed_at selection_basis:goal.selection_basis
   selected_route:{id:if saved {"saved_goal_route"} else {route.id} original_route_id:route.id geometry_ref:if saved {"saved_goal_route"} else {route.id} map_target:if saved {"saved_goal_route"} else {route.id} evidence_scope:if saved {"saved_snapshot"} else {"current_query_proposal"} selected_legs:route_get(route,"selected_legs") kind:route.kind kind_label:route_kind_label(route) cost:cost price_cents:cost.full_journey_amount_cents price_label:route_cost_label(cost) duration_seconds:duration.duration_seconds duration_label:duration.duration_label duration_scope:duration.duration_scope duration_basis:duration.duration_basis estimated_arrival_ts:arrival.estimated_arrival_ts estimated_arrival_label:arrival.estimated_arrival_label queried_endpoint_arrival_ts:arrival.queried_endpoint_arrival_ts queried_endpoint_arrival_label:arrival.queried_endpoint_arrival_label arrival_scope:arrival.arrival_scope arrival_label:arrival.arrival_label source:route.source source_ts:route.source_ts expires_at:route.expires_at warnings:route.warnings completion_status:route.completion_status steps:route_summary_steps(route) map_metadata:route_map_metadata(route) map_paths:route_get(route,"map_paths_cache") original_plan_reexecution:if saved {guardian_reexecution(goal,time_now(),position_record)} else {nil}} confirmations:goal.confirmations}
}
fn guardian_snapshot(){
 let remaining=nil if guardian_goal!=nil {remaining=guardian_goal.total_budget_cents-guardian_goal.spent_cents}
 let proposal=nil
 if guardian_pending!=nil {let p=guardian_pending proposal={proposal_version:p.proposal_version base_version:p.base_version created_at:p.created_at goal:guardian_public_goal_assessed(p.goal,false,p.assessment) assessment:p.assessment cost_delta_cents:p.cost_delta_cents cost_comparison:route_get(p,"cost_comparison")}}
 return {goal:guardian_public_goal(guardian_goal,true) proposal:proposal last_check:guardian_check current_check:guardian_current_check() remaining_budget_cents:remaining original_plan_reexecution:guardian_reexecution(guardian_goal,time_now(),position_record) error:guardian_error monitoring:"打开只展示历史；仅主动重新核验，不会后台监控。上次核验不代表当前仍成立。"}
}
fn guardian_propose(p){
 let route=ui_route(route_get(p,"route_id"))
 if trip_replay || route==nil || destination_record==nil || constraints==nil {return {success:false error:"提案必须引用本轮真实Route和目的地；历史详情不能提出新提案"}}
 if !p.preferences.is_string() || !p.risk_acceptance.is_string() || !p.basis.is_string() || p.basis.trim()=="" {return {success:false error:"请明确偏好、风险与选定依据供用户确认"}}
 if guardian_goal!=nil && guardian_goal.state=="active" && !guardian_mode {return {success:false error:"已有活跃目标；请重新核验或结束/删除后再确认新目标"}}
 let deadline=arrive_by let total=constraints.budget_cents let spent=0 let progress="" let version=1
 if guardian_mode {deadline=guardian_goal.deadline_ts total=guardian_goal.total_budget_cents spent=guardian_goal.spent_cents progress=guardian_goal.progress version=guardian_goal.version+1}
 let assessment=guardian_assess(route,time_now(),deadline,total-spent)
 guardian_error="" guardian_sequence+=1
 guardian_pending={trip_id:trip_selected_id proposal_version:guardian_sequence run:run_id base_version:if guardian_mode {guardian_goal.version} else {nil} created_at:time_now() goal:{schema:1 state:"active" version:version deadline_ts:deadline total_budget_cents:total currency:constraints.currency spent_cents:spent progress:progress preferences:if guardian_mode {guardian_goal.preferences} else {p.preferences} risk_acceptance:if guardian_mode {guardian_goal.risk_acceptance} else {p.risk_acceptance} destination:destination_record selected_route:guardian_materialize(route) selection_basis:p.basis confirmed_at:nil confirmations:[]} assessment:assessment cost_delta_cents:if guardian_mode {guardian_cost_delta(route,guardian_goal).full_journey_delta_cents} else {nil} cost_comparison:if guardian_mode {guardian_cost_delta(route,guardian_goal)} else {nil}}
 ui_facts_revision+=1 guardian_refresh()
 return {success:true effect:"proposal_prepared_not_saved" proposal:guardian_snapshot().proposal confirmation:"仅父应用的真实确认按钮可保存/替换；生成DSL事件不是用户确认"}
}
fn guardian_selected_candidate(){
 if trip_replay || guardian_goal==nil || guardian_goal.state!="active" || !guardian_mode || viewed_route_id=="saved_goal_route" {return nil}
 return viewed_route()
}
fn guardian_prepare_selected(){
 let route=guardian_selected_candidate()
 if route==nil || shell_busy() {return {success:false error:"请先查看本轮核验候选，查询完成后再准备替代提案"}}
 return guardian_propose({route_id:route.id preferences:guardian_goal.preferences risk_acceptance:guardian_goal.risk_acceptance basis:"用户选择本轮当前查看方案；可行性与风险以提案评估为准"})
}
fn guardian_confirm(version){
 if trip_replay {guardian_error="历史详情不可确认旧提案，请先主动重新核验" guardian_refresh() return false}
 let pending=guardian_pending
 if pending==nil || pending.trip_id!=trip_selected_id || pending.proposal_version!=version || pending.run!=run_id {guardian_error="提案已失效，请重新提出并确认" guardian_refresh() return false}
 if pending.base_version!=nil && (guardian_goal==nil || guardian_goal.state!="active" || guardian_goal.version!=pending.base_version) {guardian_error="目标版本已变化，未替换路线" guardian_refresh() return false}
 let goal=pending.goal.to_json().parse_json() goal.confirmed_at=time_now()
 if pending.base_version!=nil {goal.confirmations=guardian_goal.confirmations.to_json().parse_json()}
 goal.confirmations.push({version:goal.version confirmed_at:goal.confirmed_at action:if pending.base_version==nil {"save_goal"} else {"replace_route"} route_id:goal.selected_route.id proposal_version:version basis:goal.selection_basis})
 if !guardian_valid_goal(goal) {guardian_error="提案格式无效，未保存" guardian_refresh() return false}
 return guardian_store(goal,fn(committed){if committed {guardian_pending=nil guardian_check=nil guardian_refresh()}})
}
fn guardian_reject(){guardian_pending=nil ui_facts_revision+=1 guardian_refresh()}
fn guardian_finish(){
 if guardian_goal==nil {return false}
 let goal=guardian_goal.to_json().parse_json() goal.state="ended" goal.ended_at=time_now()
 return guardian_store(goal,fn(committed){if committed {guardian_pending=nil if guardian_mode && agent_active {cancel_task()} guardian_mode=false guardian_refresh()}})
}
fn guardian_delete(){
 return guardian_store(nil,fn(committed){if committed {guardian_pending=nil guardian_check=nil if guardian_mode && agent_active {cancel_task()} guardian_mode=false guardian_refresh()}})
}
fn guardian_progress(){
 if guardian_goal==nil || guardian_goal.state!="active" {return false}
 let spent=route_cents(ui.guardian_spent.text().trim()) let progress=ui.guardian_progress_input.text().trim()
 if spent==nil {guardian_error="请输入累计已花人民币金额，保留最多两位小数" guardian_refresh() return false}
 let goal=guardian_goal.to_json().parse_json() goal.spent_cents=spent goal.progress=progress goal.version+=1
 goal.last_check=nil
 goal.confirmations.push({version:goal.version confirmed_at:time_now() action:"confirm_progress" spent_cents:spent progress:progress})
 return guardian_store(goal,fn(committed){if committed {guardian_pending=nil guardian_check=nil guardian_progress_open=false if guardian_mode && agent_active {cancel_task()} guardian_refresh()}})
}
fn guardian_report(p,done){
 if !guardian_mode || guardian_goal==nil || guardian_goal.state!="active" {done({success:false error:"当前不是活跃目标核验"}) return}
 let route=ui_route(route_get(p,"route_id"))
 let remaining=guardian_goal.total_budget_cents-guardian_goal.spent_cents
 let assessment=guardian_assess(nil,time_now(),guardian_goal.deadline_ts,remaining)
 let same=false
 if route!=nil && guardian_goal.progress=="" && guardian_goal.spent_cents==0 {let gap=route_endpoint_gap(route.actual_origin,guardian_goal.selected_route.actual_origin) let end_gap=route_endpoint_gap(route.actual_endpoint,guardian_goal.selected_route.actual_endpoint) same=gap!=nil && gap<=25 && end_gap!=nil && end_gap<=25 && guardian_plan_identified(route) && guardian_plan_identified(guardian_goal.selected_route) && guardian_plan_key(route)==guardian_goal.selected_route.plan_key}
 if same {assessment=guardian_assess(route,time_now(),guardian_goal.deadline_ts,remaining)}
 else {assessment.reasons.push("未取得原选定剩余路段的新证据；新路线仅为替代候选")}
 let check={run:run_id evidence_scope:"current_query_check" status:assessment.status reasons:assessment.reasons checked_at:time_now() goal_version:guardian_goal.version original_plan_verified:same comparison_scope:if guardian_goal.progress=="" && guardian_goal.spent_cents==0 {"same_full_journey_estimates"} else {"remaining_route_not_comparable_with_original_full_journey"} origin:position_record original_route_id:guardian_goal.selected_route.id candidate_route:if route!=nil {query_route_summary(route)} else {nil} original_plan_reexecution:guardian_reexecution(guardian_goal,time_now(),position_record) cost_delta_cents:guardian_cost_delta(route,guardian_goal).full_journey_delta_cents cost_comparison:guardian_cost_delta(route,guardian_goal) duration_delta_seconds:if route!=nil && guardian_goal.progress=="" && guardian_goal.spent_cents==0 && route.duration_seconds!=nil && guardian_goal.selected_route.duration_seconds!=nil {route.duration_seconds-guardian_goal.selected_route.duration_seconds} else {nil} remaining_budget_cents:remaining}
 let token=run_id let version=guardian_goal.version let selected=trip_selected_id let goal=guardian_goal let owner=current_tool_job()
 tool_timeout(0.01,owner,"guardian_report_commit",||{
 if token!=run_id || trip_selected_id!=selected || guardian_goal!=goal || guardian_goal.version!=version {return}
 let updated=goal.to_json().parse_json() updated.last_check=check
 guardian_store(updated,fn(committed){
 if token!=run_id || trip_selected_id!=selected {return}
 if !committed {done({success:false error:guardian_error}) return}
 guardian_check=check guardian_reported_run=run_id ui_facts_revision+=1 guardian_refresh()
 done({success:true check:check instruction:if check.status=="invalid" {"原目标失效；自主探索替代并呈现差额和风险，目标不放宽；用户确认才替换"} elif check.status=="unknown" {"缺证据保持未知；可探索替代并用propose_goal准备待确认提案（无需此前确认、不保存）；父应用真实确认才替换，不把新线路当旧路线成立"} else {"当前证据估计成立；不是到达保证或后台监控"}})
 })
 })
}
fn guardian_saved_route_facts(){
 let goal=guardian_goal let fact=guardian_public_goal(goal,true).selected_route
 fact.current_check=guardian_current_check()
 fact.snapshot=true fact.source_scope="已确认路线旧快照，不是当前交通证据" fact.currency=goal.currency
 fact.geometry_ref="saved_goal_route" fact.duration_label=duration_text(goal.selected_route.duration_seconds) fact.kind_label=route_kind_label(goal.selected_route)
 return fact
}
fn guardian_recheck(){
 if !native_ui_available || guardian_goal==nil || guardian_goal.state!="active" {return false}
 return trip_save_before_navigation(fn(committed){if committed {start_task_with("重新核验已确认的出行目标",true)}})
}
fn guardian_label(){
 if guardian_goal==nil {return guardian_error}
 let check=guardian_check let status="待重新核验"
 if check!=nil {status=if check.status=="valid" {"上次核验估计成立"} elif check.status=="invalid" {"上次核验约束失效"} else {"上次核验证据不足"}}
 let text=guardian_goal.destination.name+" · 到达期限 "+guardian_deadline(guardian_goal.deadline_ts)+" · 总预算 "+money_text(guardian_goal.total_budget_cents)+" · 已花 "+money_text(guardian_goal.spent_cents)+"\n"+if guardian_goal.state=="ended" {"目标已结束"} else {status}
 if check!=nil {
  text+=" · 上次核验 "+beijing_clock(check.checked_at)
  let reasons="" for reason in check.reasons {if reasons!="" {reasons+="；"} reasons+=reason}
  if reasons!="" {text+="\n上次核验依据："+reasons}
 } else {text+=" · 尚未核验"}
 return text+"\n打开只展示历史；仅主动核验，不会后台监控。"+if guardian_error!="" {"\n"+guardian_error} else {""}
}
fn guardian_deadline(epoch){let v=china_time(epoch) return ""+v.year+"-"+v.month+"-"+v.day+" "+beijing_clock(epoch)}
fn guardian_proposal_summary_label(){
 if guardian_pending==nil {return ""}
 let p=guardian_pending let route=p.goal.selected_route let duration=route_duration_facts(route)
 let status=if p.assessment.status=="valid" {"估计成立"} elif p.assessment.status=="invalid" {"已知约束失效"} else {"证据不足，状态未知"}
 let reasons="" for reason in p.assessment.reasons {if reasons!="" {reasons+="；"} reasons+=reason}
 return "待确认方案 · "+route_kind_label(route)+" · "+duration.duration_label+"\n费用："+route_cost_label(route_cost_facts(route))+"\n到达范围："+p.assessment.arrival_label+"\n"+status+if reasons!="" {"；"+reasons} else {""}
}
fn guardian_proposal_label(){
 if guardian_pending==nil {return ""}
 let p=guardian_pending let goal=p.goal let reasons="" let duration=route_duration_facts(goal.selected_route)
 for reason in p.assessment.reasons {if reasons!="" {reasons+="；"} reasons+=reason}
 let status=if p.assessment.status=="valid" {"估计成立"} elif p.assessment.status=="invalid" {"已知约束失效"} else {"证据不足，状态未知"}
 return if p.base_version==nil {"确认保存出行目标与选定路线"} else {"确认替换选定路线（目标不变）"}+"\n目的地："+goal.destination.name+"\n绝对期限："+guardian_deadline(goal.deadline_ts)+"；总预算："+money_text(goal.total_budget_cents)+"；已花："+money_text(goal.spent_cents)+"\n选定方案："+route_kind_label(goal.selected_route)+" · "+route_cost_label(route_cost_facts(goal.selected_route))+"\n耗时范围："+duration.duration_label+"\n到达范围："+p.assessment.arrival_label+"\n提案评估于 "+beijing_clock(p.created_at)+"："+status+"；"+reasons+if p.cost_delta_cents!=nil {"；整程估价差额 ¥"+(p.cost_delta_cents/100)} else {"；整程估价差额未知"}+"\n偏好："+goal.preferences+"\n风险接受："+goal.risk_acceptance+"\nAgent推荐理由（不是可行性认证）："+goal.selection_basis+"\n确认方案不保证到达，不会下单。"
}

fn start_task(){start_task_with(ui.sentence.text().trim(),false)}
fn start_task_with(text,recheck){
    render_probe=nil
    agent_tool_schema=nil
    if text == "" { show_status("请用一句话说明行程、时限与预算") return }
    if !recheck {
      let limits=explicit_limits(text)
      if limits==nil {let reason="本次指令无法唯一确定数字时限和预算，请明确分钟或小时及一致的预算金额与币种；尚未开始规划" composer_open=true ui.composer_help.set_text(reason) show_status(reason) return}
      if limits.currency!="CNY" && limits.currency!="unspecified" {let reason="本次报价为人民币，不能直接与其它币种预算比较；尚未开始规划" composer_open=true ui.composer_help.set_text(reason) show_status(reason) return}
    }
    ui.composer_help.set_text("提交会新建一条出行，原记录保留。")
    clear_model_resume()
    reset_private_config()
    if recheck {start_task_ready(text,recheck)} else {trip_begin(text,fn(committed){
      if committed {
        // 提交与外壳刷新已完成；新任务解析不继承此入口的同步写盘/UI耗时。
        let token=run_id let trip_id=trip_selected_id let generation=trip_generation
        start_timeout(0.01,||start_committed_task(text,token,trip_id,generation))
      }
    })}
}
fn start_committed_task(text,token,trip_id,generation){
    if token!=run_id || trip_id!=trip_selected_id || generation!=trip_generation {return}
    start_task_ready(text,false)
}
fn start_task_ready(text,recheck){
    invalidate_interface()
    trip_replay=false trip_history=nil
    guardian_mode=recheck guardian_pending=nil guardian_open_proposal=nil guardian_reported_run=-1
    if !recheck {guardian_check=nil}
    cancel_pending_location() context_notes_cancel_all()
    run_id += 1 ui_facts_revision+=1
    if task_timer != nil { stop_timer(task_timer) }
    let token = run_id
    received_at = time_now() arrive_by = 0 loop_started_at = received_at automatic_seconds = 0 step_count = 0 protocol_retry_count = 0
    map_geometry_jobs={} route_node_generation+=1 route_nodes={} route_prefixes={} route_extension_count=0 rail_services={} rail_service_sequence=0 rail_cookie="" didi_places={} didi_quotes={} didi_record_count=0
    pending_user_poi = nil condition_open = false invalidate_map() picker_request += 1 picker_open = false picker_pois = [] picker_preview_poi = nil picker_status = "" viewed_route_id = "" expanded_routes = false
    request_text = text request_form_input = ui.sentence.text().trim() user_limits = explicit_limits(text) observations = [] model_requests = [] model_request_owner=nil model_response_diagnostic=nil decisions = [] source_snapshots = [] source_records = [] calendar_events = [] note_records = []
    position_record = nil constraints = nil destination_record = nil poi_records = [] candidates = [] candidate_sequence = 0 chosen = nil used_tools = []
    transit_count = 0 transit_completed = 0 driving_done = false driving_completed = false progress_text = "" answer_text = "" phase = "running"
    if user_limits != nil {arrive_by=received_at+user_limits.minutes*60}
    if recheck {
      arrive_by=guardian_goal.deadline_ts
      user_limits={minutes:(arrive_by-received_at)/60 budget_cents:guardian_goal.total_budget_cents-guardian_goal.spent_cents currency:guardian_goal.currency}
      constraints={budget_cents:user_limits.budget_cents currency:guardian_goal.currency objective:"min_cost" destination_query:guardian_goal.destination.name guardian_locked:true}
      destination_record=guardian_goal.destination.to_json().parse_json()
      guardian_check=route_get(guardian_goal,"last_check")
    }
    agent_messages=[] agent_calls=[] agent_call_index=0 active_tool=nil agent_result_pending=nil agent_tool_job=nil agent_provider_diagnostic=nil tool_node_refs={} tool_candidate_start=0 agent_active=true
    trace_initialize()
    trace_emit("query_started",{trip_id:trip_selected_id input:text facts:interface_facts().to_json()},nil)
    trace_marker()
    source_records.push({id:"current-input" kind:"user" source:"explicit-current-input" mock:false raw:text read_at:received_at})
    render_content()
    guardian_refresh()
    refresh_generated_facts()
    start_timeout(0.01, || agent_begin())
}


fn cancel_task(){
    clear_model_resume() guardian_open_proposal=nil
    let stopped_run=run_id let stopped_at=time_now()
    agent_active=false active_tool=nil
    trip_cancel_commit()
    cancelled_input = ui.sentence.text().trim()
    stop_interface()
    cancel_pending_location() context_notes_cancel_all()
    agent_active=false active_tool=nil run_id += 1 map_geometry_jobs={} phase = "cancelled" picker_request += 1 invalidate_map()
    if task_timer != nil { stop_timer(task_timer) task_timer = nil }
    start_timeout(0.01,||trace_emit_run("query_stopped",{occurred_at:stopped_at},nil,stopped_run))
    if trip_pending_commit==nil {trip_save_current("cancelled")}
    ui.guardian_confirmation.render() show_status("本次查询已停止；下次查询开始新任务") render_content()
}


fn money_text(cents){ if cents == nil { return "费用未知" } return "¥" + (cents / 100) }
fn duration_text(seconds){ if seconds == nil { return "耗时未知" } let remainder = seconds % 60 let minutes = (seconds - remainder) / 60
    if remainder > 0 { minutes += 1 }
    return "约 " + minutes + " 分钟" }
fn kind_text(kind){
    if kind == "public_transit" { return "公共交通" }
    if kind == "mixed" { return "打车 + 公共交通" }
    if kind == "taxi" { return "全程打车估价" }
    return "" + kind
}
fn route_kind_label(candidate){
    let legs=route_get(candidate,"legs")
    if !legs.is_array() || legs.len()==0 {legs=route_get(candidate,"selected_legs")}
    if !legs.is_array() || legs.len()==0 {return kind_text(candidate.kind)}
    let labels=[] let seen={}
    for leg in legs {
        let mode=route_get(leg,"mode")
        let label=if mode=="transit" {"公共交通"} elif mode=="taxi" {"打车"} elif mode=="walk" {"步行"} elif mode=="rail" {"铁路"} else {""+mode}
        if seen[label]!=true {seen[label]=true labels.push(label)}
    }
    let text=""
    for label in labels {if text!="" {text+="＋"} text+=label}
    return text
}
fn beijing_clock(epoch){
    let v = china_time(epoch )
    let hour_text = "" + v.hour let minute_text = "" + v.minute
    if v.hour < 10 { hour_text = "0" + hour_text }
    if v.minute < 10 { minute_text = "0" + minute_text }
    return hour_text + ":" + minute_text + "（北京时间）"
}
fn segment_description(segment){
    let parts = []
    let walking = route_get(segment, "walking")
    if walking.is_object() {
        let distance = route_get(walking, "distance")
        if distance.is_string() && distance != "" { parts.push("步行 " + distance + " 米") }
    }
    let bus = route_get(segment, "bus")
    let lines = route_get(bus, "buslines")
    if lines.is_array() && lines.len() > 0 {
        let line = lines[0]
        let name = route_get(line, "name")
        let departure = route_get(route_get(line, "departure_stop"), "name")
        let arrival = route_get(route_get(line, "arrival_stop"), "name")
        parts.push("" + name + " · " + departure + " → " + arrival)
    }
    let railway=route_get(segment,"railway")
    if railway.is_object() && route_get(railway,"trip").is_string() {parts.push(railway.trip+" · "+route_get(route_get(railway,"departure_stop"),"name")+" → "+route_get(route_get(railway,"arrival_stop"),"name"))}
    if route_get(segment, "taxi").is_object() { parts.push("打车接续（供应商综合估价）") }
    let text = ""
    for part in parts { if text != "" { text += "；" } text += part }
    if text == "" {
        let road = route_get(segment, "road")
        if road.is_string() { return road }
    }
    return text
}
fn route_description(candidate){
    if !candidate.segments.is_array() { return "" }
    let text = ""
    for segment in candidate.segments {
        let description = segment_description(segment)
        if description != "" {
            if text != "" { text += "；" } text += description
        }
    }
    if text != "" { return "主要路段：" + text + "。" }
    return ""
}
fn comparison_summary(routes){
    let fastest = nil let cheapest = nil let unknown_prices = 0
    for candidate in routes {
        if candidate.cost.coverage!="requested_journey" {continue}
        if candidate.duration_seconds != nil { if fastest == nil || candidate.duration_seconds < fastest.duration_seconds { fastest = candidate } }
        if candidate.cost.amount_cents == nil { unknown_prices += 1 }
        elif cheapest == nil || candidate.cost.amount_cents < cheapest.cost.amount_cents { cheapest = candidate }
    }
    let text = "已取得 " + routes.len() + " 条候选。"
    if fastest != nil {
        text += "最短已知耗时 " + fastest.duration_seconds + " 秒（" + duration_text(fastest.duration_seconds) + "）。"
        if !fastest.assessment.waiting_included { text += "该驾车耗时不含候车与接驳。" }
    }
    if cheapest != nil { text += "最低已知估价 " + money_text(cheapest.cost.amount_cents) + "。" }
    if unknown_prices > 0 { text += unknown_prices + " 条候选费用未知。" }
    text += "这些数值可能来自不同方案，不代表存在可用路线。"
    return text
}
fn source_label(){
    let mock_context = false let mock_location = false
    for source in source_records {
        if source.mock == true && (source.kind == "calendar" || source.kind == "note") { mock_context = true }
        if source.mock == true && source.kind == "location" { mock_location = true }
    }
    if position_record != nil && position_record.mock == true { mock_location = true }
    let text = ""
    if mock_context { text = "日历与机票笔记为模拟来源。" }
    if mock_location { text += "出发位置为模拟位置，并非当前设备定位。" }
    return text
}
fn query_task(){ start_task() }


// M3生成原生Splash；业务与网络仍由父应用执行。

// 一个会话保存标准assistant/tool消息；各异步执行入口只完成当前工具。
let agent_messages = []
let agent_active = false
let agent_calls = []
let agent_call_index = 0
let active_tool = nil
let agent_result_pending = nil
let agent_tool_job = nil
let agent_tool_job_sequence = 0
let agent_provider_diagnostic = nil
let agent_tool_schema = nil
fn tool(name,description,properties,required){return {type:"function" function:{name:name description:description parameters:{type:"object" properties:properties required:required}}}}
fn is_render_tool(name){return name=="render_ui" || name=="render_summary" || name=="render_explanation" || name=="render_routes" || name=="render_suggestions" || name=="render_route_detail"}
fn render_block_tool(name,description){
 let source_description="当前宿主Makepad/Splash源码，不接受XML/HTML。语法、原生嵌入、事实更新、事件与地图桥接见read_skill native-ui。snapshot字段按实际契约读取，Route来源为source.provider，不存在provider_label；时间优先用arrive_by_label和estimated_arrival_label及明确timezone，不手工误标UTC为当地时间。新稿content_sizing默认natural，内容Fit增长并由wrapper滚动；有限视口内的长内容用稿内ScrollYView承载Fit内容并显式选择viewport；自然长内容根View使用height:Fit。height只约束外视口。"
 if name=="render_route_detail" {source_description+="详情默认overlay且初始隐藏；根内容应正常可见，按当前viewed_route_id更新。"}
 let default_id=name.strip_prefix("render_")
 return tool(name,description+"；省略id时实际区块ID为"+default_id+"；重复id只更新此块，其它块状态保留。",{source:{type:"string" description:source_description} id:{type:"string" description:"实际区块ID；默认"+default_id+"，用于show_block；hide_self()关闭发起块。"} overlay:{type:"boolean"} height:{type:"number" description:"外区块高度，逻辑像素"} content_sizing:{type:"string" enum:["natural" "viewport"] description:"默认natural：内容Fit自然增长并由父容器滚动；viewport：内容Fill铺满有限视口，长内容由稿内有限ScrollYView承载Fit内容"}},["source"])
}
fn render_tool_params(name,p){
 if name=="render_ui" {return p}
 let id=route_get(p,"id") if id==nil {id=name.strip_prefix("render_")}
 let block={id:id source:p.source}
 if name=="render_route_detail" {block.route_detail=true}
 let existing=block_by_id(id)
 if route_get(p,"overlay")!=nil {block.overlay=p.overlay} elif existing==nil {block.overlay=name=="render_route_detail"}
 if existing==nil && name=="render_route_detail" {block.visible=false}
 if route_get(p,"height")!=nil {block.height=p.height}
 if route_get(p,"content_sizing")!=nil {block.content_sizing=p.content_sizing}
 return {blocks:[block]}
}
fn agent_tools(){
 if agent_tool_schema!=nil {return agent_tool_schema}
 let mode=location_mode()
 let tools = [
 tool("propose_goal","准备本轮route_id的目标/替代提案，无需用户此前确认；只暂存待确认内容，不保存或替换目标。父应用真实确认按钮才保存/生效。已有目标约束锁定；preferences/risk_acceptance为待用户确认文字；basis解释取舍，不认证可行性，到达与预算范围以提案assessment和Route事实为准。可推荐conditional unknown，不能将其称为已满足预算/期限；新提案风险描述不是用户已接受，原risk_acceptance不被覆盖。",{route_id:{type:"string"} preferences:{type:"string"} risk_acceptance:{type:"string"} basis:{type:"string"}},["route_id" "preferences" "risk_acceptance" "basis"])
 tool("report_goal_check","以本轮新route_id计算并记录原计划valid/invalid/unknown；省略id检查已过期、已超支或缺证据。返回核验与替代差额，不替换路线。",{route_id:{type:"string"}},[])
 tool("read_skill","读取技能目录中的技能。省略path读取SKILL.md；path可读取该技能返回的files中的引用资料。",{name:{type:"string"} path:{type:"string"}},["name"])
 tool("read_location",if mode=="demo" {"读取显式模拟出发位置并核实城市。"} else {"读取当前设备定位并核实城市。"},{},[])
 tool("search_places","搜索高德真实地点，返回全部POI身份、名称、地址、类型、城市、来源与可extend的node_ref；不采用目的地。完整入口资料用get_route_graph(node_refs)按需读取。",{query:{type:"string"}},["query"])
 tool("adopt_destination","采用已有poi_id为本任务目标，返回已采用目的地、披露入口范围、constraints和原绝对期限。basis说明来自用户选择或明确推断；不伪造航站楼。",{poi_id:{type:"string"} basis:{type:"string"}},["poi_id" "basis"])
 tool("query_route","从当前起点查询，返回新增Route摘要和new_nodes，保留金额、时间范围、assessment及来源；完整legs/segments由get_route(id)按需读取，new_nodes保节点引用；坐标用get_route_graph(node_refs)读取。success仅表示查询完成，不保证目标可行；Route.id可供extend_route继续累计。transit公交策略默认0；taxi为本次供应商到所选路由点的驾车区间估价，候车未知。已采用航站楼的披露入口为路由点，内部通达仍未知。",{to_ref:{type:"string" description:"可选真实中转节点node_ref，省略则到destination。指定时只查origin到该节点，作为新的完整前缀；非滴滴询价地点ref。"} mode:{type:"string" enum:["transit" "taxi"]} strategy:{type:"number" description:"transit:0推荐/1经济/2少换乘/3少步行/4舒适/5无地铁/7地铁优先/8快；默认0"}},["mode"])
 tool("extend_route","查询本次供应商区间并返回累计的新Route，原Route不变；成功返回的Route.id可作下一次route_id。费用/时间只引用成功注册Route/get_route的累计结果，完整公交票价不可拆摊；routes[]表示未组合，不能手算拒绝接驳为完整行程。",{route_id:{type:"string" description:"要保留并累计的本轮完整前缀Route.id，从其实际终点继续。origin是零路段起点；从起点重组或替换首段用origin。公交Route.id保留其已查供应商区间的全部耗时费用，不会裁到内部站点。"} to_ref:{type:"string" description:"下一节点的真实node_ref；已采用航站楼的canonical POI/ref或其入口ref使用披露的destination入口绑定，其它节点不变。非滴滴询价地点ref。"} mode:{type:"string" enum:["walk" "taxi" "transit"]} strategy:{type:"number" description:"公交策略，含义同query_route；默认0，仅transit使用"}},["route_id" "to_ref" "mode"])
 tool("search_rail_stations","按关键词查询12306公开车站表，返回真实铁路站ref/name/code；不包含地图坐标，使用search_places核对应POI。",{query:{type:"string"}},["query"])
 tool("search_rail_services","查询12306匿名网页实际铁路班次；主services严格匹配实际上下车站码与请求站对，默认今日北京时间。同城其它站对仅返回可重新查询的发现refs，不套用当前前缀到原站时刻。精确空仅说明该实际站对与时间窗为空；最终目的地POI不必是铁路下车站，可发现其它主干再核前后接驳。时间下界采用当前时刻或route_id最早到站，上界为本次到达期限；返回service_ref、实际上下车站、固定发到时刻和逐席别价格/余票。余票不是已购票，网页访问失败可继续高德城际探索。",{from_station:{type:"string" description:"search_rail_stations返回的ref或精确站名，不是地图POI ID"} to_station:{type:"string"} date:{type:"string" description:"可选YYYY-MM-DD乘车日期，默认今日；不是列车始发日"} route_id:{type:"string" description:"可选本轮Route ID，工具据其最早到站筛选班次"}},["from_station" "to_station"])
 tool("extend_route_with_rail","将选中真实service_ref和席别接入本轮Route，保留固定班次时刻并累计费用；前序最早到站已晚于发车则拒绝。真实POI关联不证明站台、安检/停止检票或已购票，这些保持未知。",{route_id:{type:"string"} service_ref:{type:"string"} seat_code:{type:"string"} from_ref:{type:"string" description:"班次实际上车站的本轮地图node_ref，前序已查目标须为此车站POI；路网端点差距保留为未知站内接入，不证明赶上检票"} to_ref:{type:"string" description:"班次实际下车站的本轮地图node_ref"} place_basis:{type:"string" description:"铁路实际站名与两个地图POI对应的依据；同城不同站不可混用"}},["route_id" "service_ref" "seat_code" "from_ref" "to_ref" "place_basis"])
 tool("search_didi_places","搜索滴滴供应商真实地点，city完整城市名；报价坐标只用本工具ref。",{query:{type:"string"} city:{type:"string"}},["query" "city"])
 tool("attach_quote","将本轮quote_ref替换route_id指定taxi leg估价，返回新Route；原Route不变。place_basis说明两端地点对应依据，不认证连接。",{route_id:{type:"string"} leg_id:{type:"string"} quote_ref:{type:"string"} place_basis:{type:"string"}},["route_id" "leg_id" "quote_ref" "place_basis"])
 tool("quote_didi","使用本轮滴滴地点ref询价，返回多车型当前CNY估价及报价ref；报价ref不是Route id，attach_quote成功返回的新Route才能查看；不下单。",{from_ref:{type:"string"} to_ref:{type:"string"}},["from_ref" "to_ref"])
 tool("compare_routes","按当前时刻重算已查Route费用、截止与assessment，返回全部候选身份、范围与比较摘要；legs、详细segments、source与map_metadata用get_route(id)按需读取，不自动选定方案。",{},[])
 tool("get_route","读取本轮Route事实详情，无论覆盖全程或局部，以legs与详细segments呈现分段、按线路分开的有序stop refs和map_paths目录；不查询供应商。saved_goal_route仅为已确认历史快照。",{id:{type:"string"}},["id"])
 tool("get_route_graph","默认返回本轮全部节点与Route精简索引、有序线路关系；完整Route用get_route。node_refs仅返回指定节点完整事实与全部线路归属，并明确missing_refs；不查询供应商、不截候选。",{node_refs:{type:"array" items:{type:"string"} description:"可选本轮节点ref数组，按需读取完整坐标/来源/入口事实与全部多线路归属；省略取得全图索引。"}},[])
 render_block_tool("render_summary","呈现本次总结论")
 render_block_tool("render_explanation","呈现结论的简要解释")
 render_block_tool("render_routes","呈现已评估方案列表，用户可点击打开对应候选详情；不成立的候选也可查看")
 render_block_tool("render_suggestions","呈现改进建议")
 render_block_tool("render_route_detail","呈现已评估Route详情与实际地图，包括不成立方案；可按不同id保留详情")
 tool("render_ui","提交当前宿主Makepad/Splash源码，不接受XML/HTML；语法及Navigation事实/事件/地图桥接见read_skill native-ui。时间优先引用arrive_by_label、estimated_arrival_label及明确timezone。source整稿替换；blocks按id追加或替换指定区块，其余区块状态保留。新普通区块默认显示，新overlay默认隐藏；visible显式值优先，已有块未指定时保留显示状态。返回各块真实执行诊断；success不代表内容目标完成。",{source:{type:"string" description:"嵌入View.on_render中的Makepad/Splash脚本与控件表达式；非XML/HTML。实际语法与桥接可读取native-ui资料。"} content_sizing:{type:"string" enum:["natural" "viewport"] description:"source整稿内容尺寸；默认natural且根内容Fit；viewport显式铺满有限视口，长内容由稿内ScrollYView滚动"} blocks:{type:"array" items:{type:"object" properties:{id:{type:"string"} source:{type:"string" description:"Makepad/Splash脚本与控件表达式；非XML/HTML。"} overlay:{type:"boolean"} visible:{type:"boolean"} height:{type:"number"} content_sizing:{type:"string" enum:["natural" "viewport"]}} required:["id" "source"]}}},[])
 ]
 if mode=="demo" {
tools.push(tool("read_calendar","读取本应用明确标注的模拟日历；返回记录和来源。",{},[]))
tools.push(tool("read_notes","读取本应用模拟机票笔记；返回记录和来源。",{},[]))
tools.push(tool("set_constraints","仅用于从已读取日历事件及关联机票笔记推断机场目的地，用户时限和预算不变。用户明确地点时不需要日历或机票，读取设备位置并用adopt_destination采纳核实POI。",{event_id:{type:"string" description:"read_calendar返回的所选记录id"} note_id:{type:"string" description:"read_notes返回、关联event_id的有效机票记录id"} minutes:{type:"number" description:"用户到达时限，整数分钟"} budget_cents:{type:"number" description:"用户总预算，整数分"} currency:{type:"string"} destination_query:{type:"string"} citations:{type:"array" minItems:2 description:"必须至少覆盖所选event_id及note_id各一条；引用各自raw中的单行原文" items:{type:"object" required:["source_id" "quote"] properties:{source_id:{type:"string" description:"读取结果record.id；本次用户原文可用current-input，不编造ID"} quote:{type:"string" description:"该source_id的raw中逐字单行子串；非摘要、不跨行、不混用用户或其它记录文字"}}}}},["event_id" "note_id" "minutes" "budget_cents" "currency" "destination_query" "citations"]))
 }
 if mode=="live" {
  tools.push(tool("read_calendar","读取用户已授权并选择的系统日历；不会请求权限。可自主指定Unix毫秒时间窗和limit(1..200)，默认本次received_at至arrive_by、200条。返回原始事件、时区、来源与truncated；空/未授权/未选日历如实返回，不能视为机票或要求额外笔记。",{start_ms:{type:"number"} end_ms:{type:"number"} limit:{type:"integer" minimum:1 maximum:200}},[]))
  tools.push(tool("read_notes","按非空关键词查询官方Notes摘要；保total/truncated/id。需要全文时read_note，应用未运行或未连接如实返回。",{query:{type:"string"}},["query"]))
  tools.push(tool("read_note","读取Notes实际搜索id的原文及edited_ms；原文可作为目的地推断来源，不构成已买票证明。",{id:{type:"string"}},["id"]))
 }
 agent_tool_schema=tools
 return tools
}
let agent_skill_catalog_cache=nil
fn agent_skill_catalog(){return if agent_skill_catalog_cache!=nil {agent_skill_catalog_cache} else {[]}}
fn load_agent_skill_catalog(token,done,record){
 if agent_skill_catalog_cache!=nil {done({success:true}) return}
 fs.read_async("skills/catalog.json",fn(result){
  let finish=||{
  if !current_task(token){return}
  if !result.success {done({success:false error:"技能目录无法读取"}) return}
  let catalog=nil try {catalog=result.text.parse_json()} {}
  if !catalog.is_array() {done({success:false error:"技能目录格式无效"}) return}
  agent_skill_catalog_cache=catalog done({success:true})
  }
  if record!=nil {model_timeout(0.01,token,record,"catalog_parse",finish)} else {finish()}
 })
}
fn agent_skill_metadata(){
 let result=[] for skill in agent_skill_catalog() {result.push({name:skill.name description:skill.description})} return result
}
fn read_agent_skill(p,token,done){
 let name=p.name.replace("_","-")
 let resource=route_get(p,"path") let path=if resource==nil {"SKILL.md"} else {resource}
 load_agent_skill_catalog(token,fn(loaded){
  if !current_task(token){return}
  if !loaded.success {done(loaded) return}
  for skill in agent_skill_catalog() {if skill.name==name {
   for file in skill.files {if file==path {
    fs.read_async("skills/"+name+"/"+path,fn(result){
     if !current_task(token){return}
     if !result.success {done({success:false error:"技能资源无法读取" name:name path:path}) return}
     done({success:true name:name path:path content:result.text files:skill.files})
    }) return
   }}
   done({success:false error:"技能中没有该资源" name:name path:path files:skill.files}) return
  }}
  done({success:false error:"技能不在目录中" name:name catalog:agent_skill_metadata()})
 },nil)
}
fn agent_request_record(token){
 step_count+=1
 let record={kind:"agent" run:token step:step_count started_at:time_now() state:"pending"}
 model_requests.push(record) model_request_owner=record return record
}
fn agent_begin(){
 let token=run_id
 if !current_task(token){return}
 let record=agent_request_record(token)
 model_timeout(0.01,token,record,"private_config_load",||{
  show_status("Agent正在处理")
  fs.read_async("private-config.json",fn(reply){
   model_timeout(0.01,token,record,"catalog_load",||{
    if !reply.success && route_get(reply,"error")!="file not found" {request_failed(record,"私有配置无法读取；本轮未发起模型请求") return}
    private_config_text=if reply.success {reply.text} else {nil} private_config_cached=true
    if private_config_text!=nil {
     let config=nil try {config=private_config_text.parse_json()} {}
     if !config.is_object() {record.state="configuration_error" request_failed(record,"私有配置格式无效；本轮未发起模型请求") return}
    }
    load_agent_skill_catalog(token,fn(loaded){
     model_timeout(0.01,token,record,"initial_context",||{
      if !loaded.success {request_failed(record,loaded.error) return}
 agent_messages=[{role:"system" content:"你是Navigation出行Agent。围绕用户期限、预算和偏好，主动寻找值得替换的出行瓶颈与接驳组合；由你决定工具选择与探索顺序，代码计算时间、费用和连接。新输入独立规划，不恢复模型对话。守护约束不可放宽，提案仅用户真实确认后生效。向用户交付已查路线、依据和未知，不把估计或历史当保证，不下单。任务匹配下列技能description时，用read_skill(name)读取完整指令；引用资源按需用该技能的相对path读取：\n"+agent_skill_metadata().to_json()} {role:"user" content:({request:request_text facts:model_task_context()}).to_json()}]
      agent_prepare_request(token,record)
     })
    },record)
   })
  })
 })
}

fn agent_pump(token){
 if !current_task(token){return}
 let record=agent_request_record(token)
 agent_prepare_request(token,record)
}
// MiniMax控制序列不是OpenAI工具调用；只识别本接口已注册函数的泄漏，不执行正文。
fn model_leaked_tool_control(data,choice,message){
 if route_get(data,"model")!="MiniMax-M3" || route_get(choice,"finish_reason")!="stop" {return false}
 let calls=route_get(message,"tool_calls") if calls.is_array() && calls.len()>0 {return false}
 let content=route_get(message,"content")
 if !content.is_string() || content.search("]<]minimax[>[<tool_call>")<0 {return false}
 for schema in agent_tools() {
  let name=route_get(route_get(schema,"function"),"name")
  if name.is_string() && content.search("]<]minimax[>[<invoke name=\""+name+"\">")>=0 {return true}
 }
 return false
}
fn agent_prepare_request(token,record){
 model_timeout(0.01,token,record,"request_prepare",||{
 if !current_task(token){return}
 show_status("Agent正在处理")
 minimax_request("",agent_messages,agent_tools(),token,record,fn(data){
   if !current_task(token){return}
   let choice=route_get(data,"choices")[0] let message=route_get(choice,"message")
   if !message.is_object(){request_failed(record,"模型没有返回消息") return}
   let message_at=time_now()
   agent_messages.push(message)
   start_timeout(0.01,||trace_emit_run("assistant_message",{step:record.step message:message.to_json() occurred_at:message_at},nil,token))
   let calls=route_get(message,"tool_calls") let finish=route_get(choice,"finish_reason")
   if finish=="length" {record.state="truncated_response" request_failed(record,"模型输出已截断，这次响应中的工具未执行；已取得的路线与界面保留，请重新查询") return}
   if finish=="tool_calls" && (!calls.is_array() || calls.len()==0) {record.state="invalid_tool_response" request_failed(record,"模型声明工具调用但未提供调用，本轮未完成；已取得的路线与界面保留，请重新查询") return}
   if finish!="stop" && finish!="tool_calls" {record.state="invalid_finish_reason" request_failed(record,"模型未正常结束响应，本轮未完成；请重新查询") return}
   if model_leaked_tool_control(data,choice,message) {record.state="invalid_tool_protocol" request_failed(record,"模型响应泄露工具控制序列，未提供结构化调用；本轮未完成，已取得的路线保留，不执行正文或自动重试") return}
   if !calls.is_array() || calls.len()==0 {
      let content=route_get(message,"content")
      answer_text=if content.is_string() {content} else {""}
      ui_facts_revision+=1
      runtime_status=if answer_text.trim()=="" && !generated_render_complete {"Agent没有返回可展示内容，请重新查询"} else {""}
      agent_active=false active_tool=nil phase=if runtime_status=="" {"waiting"} else {"failed"}
      let ended={content:answer_text generated:generated_active rendered:generated_render_complete occurred_at:time_now()}
      start_timeout(0.01,||trace_emit_run("query_ended",ended,nil,token))
      trip_save_current(if runtime_status=="" {"completed"} else {"failed"}) trip_refresh_shell() return
   }
   agent_calls=calls agent_call_index=0 start_timeout(0.01,||agent_schedule_next(token))
 })
 })
}
// 仅业务入口显式携带归属；trace及生成子VM诊断不经过这个错误sink。
fn tool_job_identity(){
 let job=agent_tool_job
 if job==nil {return nil}
 return {job_id:job.id run:job.token call_id:job.call.id phase:job.phase settled:job.settled failure_seen:job.failure_seen provider_response_cached:agent_provider_diagnostic!=nil && agent_provider_diagnostic.job_id==job.id}
}
fn tool_job_current(job){
 return job!=nil && !job.settled && current_task(job.token) && agent_tool_job==job && active_tool==job.call
}
fn current_tool_job(){return if tool_job_current(agent_tool_job) {agent_tool_job} else {nil}}
fn tool_timeout(delay,job,stage,work){
 if job==nil {start_timeout(delay,work) return}
 start_timeout_checked(delay,||{if tool_job_current(job) {job.phase=stage work()}},fn(error){tool_execution_failed(job,error)})
}
fn agent_schedule_next(token){
 if !current_task(token){return}
 if agent_call_index>=agent_calls.len() {start_timeout(0.01,||agent_pump(token)) return}
 let call=agent_calls[agent_call_index]
 agent_tool_job_sequence+=1
 let job={id:agent_tool_job_sequence token:token call:call call_index:agent_call_index candidate_start:candidates.len() message_start:agent_messages.len() decision_start:decisions.len() continuation_queued:false next_dispatched:false phase:"dispatch" settled:false failure_seen:false}
 active_tool=call agent_tool_job=job
 tool_timeout(0.01,job,"dispatch",||agent_execute_next(token))
}
fn tool_published_message(job){
 if agent_messages.len()<=job.message_start {return nil}
 let message=agent_messages[job.message_start]
 if route_get(message,"role")=="tool" && route_get(message,"tool_call_id")==job.call.id {return message}
 return nil
}
fn export_tool_provider_failure(job){
 if !trace_enabled || trace_state==nil || agent_provider_diagnostic==nil || agent_provider_diagnostic.job_id!=job.id {return}
 let raw=agent_provider_diagnostic
 let diagnostic={directory:trace_state.directory job_id:job.id run:job.token call_id:job.call.id phase:job.phase provider:raw.provider received_at:raw.received_at text:raw.response_text parts:nil index:0}
 // 开发原件不进模型/事件正文；独立入口写，失败不改变业务结算。
 start_timeout(0.01,||{
  diagnostic.parts=diagnostic.text.utf8_chunks(262144) diagnostic.text=nil
  export_tool_provider_part(diagnostic)
 })
}
fn export_tool_provider_part(diagnostic){
 let prefix=diagnostic.directory+"/provider-job-"+diagnostic.job_id
 if diagnostic.index>=diagnostic.parts.len() {
  try {fs.write(prefix+"-metadata.json",{run:diagnostic.run call_id:diagnostic.call_id job_id:diagnostic.job_id phase:diagnostic.phase provider:diagnostic.provider received_at:diagnostic.received_at part_count:diagnostic.parts.len() encoding:"UTF-8"}.to_json())} {}
  return
 }
 try {fs.write(prefix+"-part-"+diagnostic.index+".txt",diagnostic.parts[diagnostic.index])} {return}
 diagnostic.index+=1 start_timeout(0.01,||export_tool_provider_part(diagnostic))
}
fn tool_execution_failed(job,error){
 if job==nil || !current_task(job.token) || agent_tool_job!=job || job.next_dispatched {return}
 let message=tool_published_message(job)
 if job.settled {
  if message!=nil && !job.continuation_queued {job.continuation_queued=true start_timeout(0.01,||{if current_task(job.token) && agent_tool_job==job && !job.next_dispatched {job.next_dispatched=true agent_schedule_next(job.token)}})}
  return
 }
 if active_tool!=job.call && message==nil {return}
 if job.failure_seen {fail_task("工具错误回执未能完整提交；本轮已停止，已有完整Route保留") return}
 job.failure_seen=true
 export_tool_provider_failure(job)
 // 完整Route在push之前已构造；保留已发布结果，不声称回滚局部节点登记。
 let published=[] for index candidate in candidates {if index>=job.candidate_start {published.push(candidate.id)}}
 let failure={success:false error:"本工具执行入口未完整完成；已有完整Route保留，未完成方案没有发布。不自动重试。" error_kind:route_get(error,"error_kind") execution:{run:job.token call_id:job.call.id job_id:job.id phase:job.phase} published_route_ids:published completion_status:"incomplete"}
 if message!=nil {agent_finish_tool_commit(job,message.content,time_now()) return}
 agent_result_pending=nil
 agent_tool_result(failure)
}
fn agent_tool_result(result){
 let owner=agent_tool_job
 if !tool_job_current(owner){return}
 if agent_result_pending!=nil && agent_result_pending.owner==owner {return}
 let pending={call:owner.call token:owner.token owner:owner result:result returned_at:time_now()}
 agent_result_pending=pending
 tool_timeout(0.01,owner,"result_commit",||agent_commit_tool_result(pending))
}
fn agent_commit_tool_result(pending){
 let owner=pending.owner
 if agent_result_pending!=pending || !tool_job_current(owner){return}
 let content=pending.result.to_json()
 if tool_published_message(owner)==nil {agent_messages.push({role:"tool" tool_call_id:owner.call.id content:content})}
 agent_finish_tool_commit(owner,content,pending.returned_at)
}
fn agent_finish_tool_commit(owner,content,returned_at){
 if owner==nil || !current_task(owner.token) || agent_tool_job!=owner || owner.next_dispatched {return}
 if active_tool!=owner.call && tool_published_message(owner)==nil {return}
 let call=owner.call let token=owner.token
 // 续轮先排队，入口在消息已提交后的任何失败都不会留下无续轮的pending。
 if !owner.continuation_queued {
  owner.continuation_queued=true
  start_timeout(0.01,||{
   if !current_task(token) || agent_tool_job!=owner {return}
   owner.continuation_queued=false
   if owner.settled && !owner.next_dispatched {owner.next_dispatched=true agent_schedule_next(token)}
  })
 }
 if decisions.len()==owner.decision_start {decisions.push({tool:call.function.name call_id:call.id returned_at:returned_at})}
 if call.function.name!="read_skill" && call.function.name!="get_route" && call.function.name!="get_route_graph" && !is_render_tool(call.function.name) {ui_facts_revision+=1}
 // index固定到捕获位置，消息检查保证入口失败后的收束不重复tool回执。
 agent_call_index=owner.call_index+1
 owner.settled=true active_tool=nil agent_result_pending=nil
 agent_result_effects(call,content,token,returned_at)
}
fn agent_result_effects(call,content,token,returned_at){
 start_timeout(0.01,||trace_emit_run("tool_result",{name:call.function.name result:content occurred_at:returned_at},call.id,token))
 start_timeout(0.01,||{if token==run_id {refresh_generated_facts()}})
}
// 原始业务记录只存一份；模型取得本次增量或按ID读取，UI保留自己的当前事实视图。
let tool_candidate_start=0
let tool_node_refs={}
fn tool_new_nodes(){
 let added=[]
 for ref node in route_nodes {if tool_node_refs[ref]!=true {added.push(node)}}
 return added
}
// 路段展示资料随Route几何保持不变；只重算当前assessment，不重复解析供应商步骤。
fn route_stop_fact(stop,role,index){
 let id=route_get(stop,"id") let ref=nil
 if id.is_string() && id!="" && route_node("stop:"+id)!=nil {ref="stop:"+id}
 return {node_ref:ref name:route_get(stop,"name") role:role index:index}
}
fn route_line_facts(line,detailed){
 let duration=route_seconds(route_get(route_get(line,"cost"),"duration"))
 if duration==nil {duration=route_seconds(route_get(line,"duration"))}
 let first=route_stop_fact(route_get(line,"departure_stop"),"departure",0)
 let last=route_stop_fact(route_get(line,"arrival_stop"),"arrival",0)
 let fact={line_id:route_get(line,"id") name:route_get(line,"name") departure_stop:first.name departure_node_ref:first.node_ref arrival_stop:last.name arrival_node_ref:last.node_ref duration_seconds:duration distance_m:route_seconds(route_get(line,"distance"))}
 if detailed {
  let stops=[first] let via=route_get(line,"via_stops")
  if via.is_array() {for stop in via {stops.push(route_stop_fact(stop,"via",stops.len()))}}
  last.index=stops.len() stops.push(last) fact.stops=stops
 }
 return fact
}
// 保留每条供应商线路的独立站序；不拼出替代线路的虚构共同停站顺序。
fn route_segment_facts(candidate,detailed){
 if detailed {let cached=route_get(candidate,"segments_cache") if cached!=nil {return cached}}
 let result=[] let offset=0 let legs=route_get(candidate,"legs")
 for index segment in candidate.segments {
  let leg_id=nil let leg_segment_index=index
  if legs.is_array() {offset=0 for leg in legs {let segments=route_get(leg,"segments") if segments.is_array() {if index>=offset && index<offset+segments.len() {leg_id=leg.id leg_segment_index=index-offset} offset+=segments.len()}}}
  let lines=[] let supplied=route_get(route_get(segment,"bus"),"buslines")
  if supplied.is_array() {for line in supplied {lines.push(route_line_facts(line,detailed))}}
  let walking=route_get(segment,"walking") let taxi=route_get(segment,"taxi")
  let duration=route_seconds(route_get(route_get(segment,"cost"),"duration"))
  if duration==nil {duration=route_seconds(route_get(segment,"duration"))}
  let taxi_duration=route_seconds(route_get(taxi,"drivetime")) if taxi_duration==nil {taxi_duration=route_seconds(route_get(taxi,"duration"))}
  result.push({index:index leg_id:leg_id leg_segment_index:leg_segment_index description:segment_description(segment) duration_seconds:duration distance_m:route_seconds(route_get(segment,"distance"))
    walking:if walking.is_object() {{duration_seconds:route_seconds(route_get(route_get(walking,"cost"),"duration")) distance_m:route_seconds(route_get(walking,"distance"))}} else {nil}
    taxi:if taxi.is_object() {{duration_seconds:taxi_duration distance_m:route_seconds(route_get(taxi,"distance")) price:route_get(taxi,"price")}} else {nil}
    road:route_get(segment,"road") buslines:lines railway:if route_get(segment,"railway").is_object() {{trip:route_get(segment.railway,"trip") service:route_get(segment.railway,"service") seat:route_get(segment.railway,"seat") departure_stop:route_get(segment.railway,"departure_stop") arrival_stop:route_get(segment.railway,"arrival_stop")}} else {nil}})
 }
 if detailed {candidate.segments_cache=result}
 return result
}
fn route_summary_steps(candidate){
 let cached=route_get(candidate,"steps_cache") if cached!=nil {return cached}
 let steps=route_segment_facts(candidate,false) candidate.steps_cache=steps return steps
}
fn query_route_summary(candidate){return query_route_summary_checked(candidate,route_recheck(candidate,time_now(),arrive_by,route_get(constraints,"budget_cents")))}
fn query_route_summary_checked(candidate,check){
    let cost=route_cost_facts(candidate) let arrival=route_arrival_facts(candidate,check.estimated_arrival_ts) let duration=route_duration_facts(candidate) let queried_to_ref=nil let leg_to_ref=nil let query_legs=route_get(candidate,"legs") if query_legs.is_array() && query_legs.len()>0 {let last=query_legs[query_legs.len()-1] leg_to_ref=route_get(last,"to_ref") queried_to_ref=route_get(last,"requested_to_ref") if queried_to_ref==nil {queried_to_ref=leg_to_ref}} let completion=route_completion(candidate) let steps=route_summary_steps(candidate) let budget=route_get(constraints,"budget_cents")
    return {id:candidate.id geometry_ref:candidate.geometry_ref derived_from_route_id:route_get(candidate,"derived_from_route_id") destination_access:route_get(candidate,"destination_access")
        mode:if candidate.kind=="taxi" {"taxi"} elif candidate.kind=="walking" {"walk"} elif candidate.kind=="mixed" {"mixed"} else {"transit"} kind:candidate.kind
        map_metadata:route_map_metadata(candidate) completion_status:completion node_ref:route_get(candidate,"node_ref") requested_destination_ref:"destination" overall_destination_ref:"destination" queried_to_ref:queried_to_ref leg_to_ref:leg_to_ref
        incomplete_reason:if completion!="reached_requested_destination" {"仅包含已取得路段，终点或后续连接尚未取得，小计不是到目的地总价"} else {nil}
        estimated_arrival_ts:arrival.estimated_arrival_ts estimated_arrival_label:arrival.estimated_arrival_label queried_endpoint_arrival_ts:arrival.queried_endpoint_arrival_ts queried_endpoint_arrival_label:arrival.queried_endpoint_arrival_label arrival_scope:arrival.arrival_scope arrival_label:arrival.arrival_label timezone:"Asia/Shanghai"
        duration_seconds:duration.duration_seconds duration_label:duration.duration_label duration_scope:duration.duration_scope duration_basis:duration.duration_basis distance_m:route_get(candidate,"distance_m")
        price_label:route_cost_label(cost) cost:cost legs:route_leg_facts(candidate) steps:steps
        assessment:{evaluated_at:time_now() passed:check.passed reasons:route_reasons(candidate,time_now(),arrive_by,route_get(constraints,"budget_cents")) waiting_included:candidate.waiting_included waiting_basis:candidate.waiting_basis origin_complete:candidate.origin_complete endpoint_complete:candidate.endpoint_complete connection_status:if route_get(candidate,"provider_connection_status")=="unknown" {"provider_connection_unknown"} elif candidate.origin_complete && candidate.endpoint_complete {"geometry_checked"} else {"unknown"}
            budget_status:if budget==nil {"unknown"} elif cost.known_subtotal_cents>budget {"over_budget"} elif cost.full_journey_amount_cents!=nil {"within_estimate"} else {"unknown"}
            deadline_status:if check.estimated_arrival_ts!=nil && check.estimated_arrival_ts>arrive_by {"over_deadline"} elif candidate.duration_seconds!=nil && candidate.waiting_included && candidate.request_bound && candidate.origin_complete && candidate.endpoint_complete && route_get(candidate,"provider_connection_status")!="unknown" && route_get(candidate,"destination_access")==nil {"within_estimate"} else {"unknown"}}
        source:{provider:candidate.source queried_at:candidate.source_ts expires_at:candidate.expires_at warnings:candidate.warnings}}
}
fn read_route_summaries(items,token,done){
 let state={items:items token:token owner:current_tool_job() done:done index:0 routes:[] update_assessment:false}
 tool_timeout(0.01,state.owner,"route_summary",||route_summary_batch(state))
 return state
}
fn route_summary_batch(state){
 if !current_task(state.token){return}
 if state.index>=state.items.len() {state.done(state.routes) return}
 let candidate=state.items[state.index]
 let check=route_recheck(candidate,time_now(),arrive_by,route_get(constraints,"budget_cents"))
 if state.update_assessment {candidate.feasible=check.passed candidate.reason=check.reason}
 state.routes.push(query_route_summary_checked(candidate,check)) state.index+=1
 tool_timeout(0.01,state.owner,"route_summary",||route_summary_batch(state))
}
// 产品默认交付目标，不伪装成用户偏好，也不规定工具顺序或布局。
fn navigation_presentation_task(){
 return {candidate_interaction:"手机列表先帮助比较候选的交通组合、费用及其覆盖、到达范围和关键未核事项，这些决策信息同等可见；用户可本地打开同一Route的完整分段、来源和地图，不需要再次请求模型" detail_content:"同一Route的真实步骤、来源、费用和到达覆盖范围，以及未核事项" maps:"用真实几何展示所选路段地图；按实际目录分图，缺数据或失败明确说明" current_state:"审批和选定状态来自当前facts；可不重复父应用权威状态，不能保留已过时的静态确认文案"}
}
fn model_task_context(){
 let facts=interface_viewport_facts()
 let configured=false let config=read_text("private-config.json")
 if config!=nil {let key=route_get(config.parse_json(),"didi_mcp_key") configured=key.is_string() && key!=""}
 return {presentation_task:navigation_presentation_task() guardian:guardian_snapshot() guardian_recheck:guardian_mode limits:user_limits received_at:received_at received_at_label:guardian_deadline(received_at) arrive_by:arrive_by arrive_by_label:if arrive_by!=nil {guardian_deadline(arrive_by)} else {nil} timezone:"Asia/Shanghai" viewport:facts.viewport rendering_environment:facts.rendering_environment providers:{didi:{configured:configured availability:"配置不等于服务可用；未调用或调用失败不能推断未配置"}} origin:position_record destination:destination_record source_label:source_label()}
}
// 模型回执删去可按引用恢复的重复表示；内部事实与UI使用原对象。
fn model_fields_without(value,omitted){
 let result={}
 for key field in value {
  // 原生枚举键是标识符，JSON回读键是字符串。
  let name=""+key let keep=true
  for excluded in omitted {if name==excluded {keep=false}}
  if keep {result[key]=field}
 }
 return result
}
fn model_place_results(places){let result=[] for poi in places {result.push(model_fields_without(poi,["entrance" "returned_at"]))} return result}
fn model_node_references(nodes){let result=[] for node in nodes {result.push(model_fields_without(node,["longitude" "latitude" "coordinate_system"]))} return result}
fn model_route_detail(fact){
 let segments=route_get(fact,"segments")
 if segments.is_array() && segments.len()>0 {return model_fields_without(fact,["steps"])}
 return fact
}
fn query_route_result_summaries(routes){let result=[] for route in routes {result.push(model_fields_without(route,["legs" "steps"]))} return result}
fn finish_tool_from_state(token){
 if !current_task(token) || active_tool==nil {return}
 let name=active_tool.function.name
 prepare_route_graph_base()
 if name=="read_location" {agent_tool_result({success:true origin:position_record guardian_current_check:guardian_current_check() fresh_route_count:candidates.len() location_scope:"当前位置，不是当前交通证据，也不证明乘车或付费" new_nodes:tool_new_nodes()})}
 elif name=="read_calendar" {agent_tool_result({success:true records:calendar_events})}
 elif name=="read_notes" {agent_tool_result({success:true records:note_records})}
 elif name=="query_route" || name=="query_transit" || name=="query_driving" {
    let added=[] for index candidate in candidates {if index>=tool_candidate_start {added.push(candidate)}}
    read_route_summaries(added,token,fn(routes){
     agent_tool_result({success:true routes:if name=="query_route" {query_route_result_summaries(routes)} else {routes} new_nodes:if name=="query_route" {model_node_references(tool_new_nodes())} else {tool_new_nodes()}})
    })
 } elif name=="adopt_destination" {agent_tool_result({success:true destination:model_fields_without(destination_record,["entrance" "routing_point"]) constraints:constraints arrive_by:arrive_by})}
 else {agent_tool_result({success:true origin:position_record destination:destination_record constraints:constraints limits:user_limits arrive_by:arrive_by new_nodes:tool_new_nodes()})}
}
fn agent_execute_next(token){
 let render_entry_at=time_now()
 if !current_task(token){return}
 if agent_call_index>=agent_calls.len(){start_timeout(0.01,||agent_pump(token)) return}
 let call=agent_calls[agent_call_index] active_tool=call
 let name=call.function.name let p=nil
 if is_render_tool(name) {render_probe_begin(call,render_entry_at)}
 tool_candidate_start=candidates.len() tool_node_refs={} for ref node in route_nodes {tool_node_refs[ref]=true}
 let call_at=time_now()
 start_timeout(0.01,||trace_emit_run("tool_call",{name:name arguments:call.function.arguments occurred_at:call_at},call.id,token))
 try {p=call.function.arguments.parse_json()} {agent_tool_result({success:false error:"工具参数JSON无法解析"}) return}
 try {
  if name=="propose_goal" {agent_tool_result(guardian_propose(p))}
  elif name=="report_goal_check" {guardian_report(p,fn(result){if current_task(token) && active_tool==call {agent_tool_result(result)}})}
  elif guardian_mode && (name=="set_constraints" || name=="adopt_destination") {agent_tool_result({success:false error:"已确认目的地和绝对期限/总预算锁定，不得更换或放宽"})}
  elif name=="read_skill" {read_agent_skill(p,token,fn(result){
    start_timeout(0.01,||{if current_task(token) && active_tool==call {agent_tool_result(result)}})
  })}
  elif location_mode()=="live" && name=="read_calendar" {
   let start=route_get(p,"start_ms") let end=route_get(p,"end_ms")
   if start==nil {start=received_at*1000 start-=start%1} if end==nil {end=if arrive_by!=nil {arrive_by*1000} else {start+86400000} end-=end%1}
   context_calendar_read(start,end,route_get(p,"limit"),fn(result){if !current_task(token) || active_tool!=call {return}
    if result.success {calendar_events=result.records for record in result.records {source_records.push(record)} observe("read_calendar",result)}
    agent_tool_result(result)
   })
  }
  elif location_mode()=="live" && (name=="read_notes" || name=="read_note") {
   let done=fn(result){if !current_task(token) || active_tool!=call {return}
    if result.success {for record in result.records {note_records.push(record) source_records.push(record)} observe(name,result)}
    agent_tool_result(result)
   }
   if name=="read_notes" {context_notes_search(route_get(p,"query"),done)} else {context_notes_read(route_get(p,"id"),done)}
  }
  elif name=="read_calendar" || name=="read_notes" || name=="read_location" {read_source_tool(name,token,fn(){finish_tool_from_state(token)})}
  elif name=="set_constraints" {if set_constraints(p){finish_tool_from_state(token)} else {agent_tool_result({success:false error:constraint_error})}}
  elif name=="search_places" {
    let at=time_now() let city="" if position_record!=nil {city="&city="+position_record.citycode.url_encode()}
    amap_request("/v3/place/text","&citylimit=false&extensions=all&children=1"+city+"&keywords="+p.query.url_encode(),token,fn(data){poi_records=parse_pois(data,at,false) register_route_pois(poi_records) picker_pois=poi_records observe("search_places",poi_records) agent_tool_result({success:true places:model_place_results(poi_records)})})
  }
  elif name=="adopt_destination" {
    let poi=route_poi(p.poi_id)
    if poi==nil {agent_tool_result({success:false error:"poi_id不在本次查询已核实地点中"})}
    elif constraints!=nil && route_get(constraints,"user_selected")!=true && route_get(constraints,"inferred")!=true {if select_destination({poi_id:p.poi_id},p.basis){finish_tool_from_state(token)} else {agent_tool_result({success:false error:destination_error})}}
    else {pending_user_poi=poi if !position_current(position_record){agent_tool_result({success:false error:"请取得当前起点后再采用地点"})} elif apply_user_poi(){constraints.inferred=true constraints.user_selected=false constraints.inference={reason:p.basis origin_city:position_record.city poi_source:poi.source} finish_tool_from_state(token)} else {agent_tool_result({success:false error:"缺少可计算的用户时间/预算或真实城市"})}}
  }
  elif name=="query_route" {query_route(p,token)}
  elif name=="extend_route" {extend_route(p,token)}
  elif name=="search_rail_stations" {search_rail_stations(p,token)}
  elif name=="search_rail_services" {search_rail_services(p,token)}
  elif name=="extend_route_with_rail" {extend_route_with_rail(p,token)}
  elif name=="search_didi_places" {search_didi_places(p,token)}
  elif name=="quote_didi" {quote_didi(p,token)}
  elif name=="attach_quote" {attach_quote(p,token)}
  elif name=="compare_routes" {present_results("")}
  elif name=="get_route" {
    if p.id=="saved_goal_route" && guardian_goal!=nil {ensure_map_catalog(guardian_goal.selected_route,||agent_tool_result({success:true route:model_route_detail(guardian_saved_route_facts())}))}
    else {let candidate=ui_route(p.id) if candidate==nil {agent_tool_result({success:false error:"路线ID不在本轮候选中"})} else {ensure_map_catalog(candidate,||{
     if trip_replay {let saved=nil for item in trip_history.facts.routes {if item.id==candidate.id {saved=item}}
      if saved==nil {agent_tool_result({success:false error:"历史路线缺少保存的公开事实；未重算旧时价"})} else {agent_tool_result({success:true route:model_route_detail(history_route_public_facts(saved,candidate))})}
     } else {agent_tool_result({success:true route:model_route_detail(interface_route_facts(candidate,route_recheck(candidate,time_now(),arrive_by,route_get(constraints,"budget_cents"))))})}
    })}}
  }
  elif name=="get_route_graph" {read_model_route_graph(p,token,fn(graph){if route_get(graph,"error")!=nil {agent_tool_result({success:false error:graph.error})} else {agent_tool_result({success:true graph:graph})}})}
  elif is_render_tool(name) {
    render_probe_mark("before_mount")
    interface_revision+=1 let revision=interface_revision
    prepare_render_tool(name,p,token,call,revision)
  }
  else {agent_tool_result({success:false error:"未知工具："+name})}
 } {agent_tool_result({success:false error:"工具参数或数据执行错误" status:runtime_status})}
}

let runtime_status = if native_ui_available {""} else {missing_runtime_message}
let generated_source = ""
let ui_blocks=[]
let inline_blocks=[]
let overlay_blocks=[]
let ui_facts_json=""
let ui_facts_cached_revision=-1
let ui_facts_object=nil
let ui_facts_object_revision=-1
let ui_facts_object_run=-1
let ui_facts_job=nil
let generated_area_ready = false
let generated_active = false
let generated_render_complete = false
let generated_render_notified = false
let cancelled_input = ""
let interface_revision = 0
let interface_run = 0
let interface_inflight = false
let interface_error = ""
let interface_requests = []
let ui_viewport = nil
let ui_overlay_top=0
// UI状态变化才复制大快照；轮询只读小修订号，避免每100ms重新分配整串。
let ui_facts_revision=0
let ui_facts_written_revision=-1
let mailbox_seen = ""
let mailbox_lines = 0
fn request_current(token,record){return token==run_id && agent_active && model_request_owner==record}
fn clear_model_resume(){if model_request_owner!=nil {model_request_owner.resume_eligible=false}}
fn model_resume_available(){
 let record=model_request_owner
 if record==nil || route_get(record,"resume_eligible")!=true || record.state!="host_error" || route_get(record,"action_started")==true {return false}
 if agent_active || trip_replay || phase!="failed" || shell_busy() || active_tool!=nil {return false}
 if agent_tool_job!=nil && !agent_tool_job.settled {return false}
 if agent_call_index<agent_calls.len() {return false}
 return record.run==run_id && route_get(record,"failed_trip_id")==trip_selected_id && route_get(record,"resume_generation")==trip_generation && route_get(record,"failure_message_count")==agent_messages.len() && route_get(record,"failed_request_text")==request_text && route_get(record,"failed_form_input")==request_form_input && ui.sentence.text().trim()==request_form_input
}
fn resume_model_request(){
 if !model_resume_available(){return false}
 let failed=model_request_owner let token=run_id let now=time_now()
 clear_model_resume()
 // 仅补本次执行时刻；原用户消息、已完成tool消息和绝对期限不变，资料未重新查询。
 agent_messages.push({role:"user" content:({runtime:{kind:"model_request_resume" current_at:now current_at_label:guardian_deadline(now) elapsed_seconds:now-received_at received_at:received_at arrive_by:arrive_by arrive_by_label:if arrive_by>0 {guardian_deadline(arrive_by)} else {"期限尚未确定"} prior_results_refreshed:false}}).to_json()})
 agent_active=true phase="running" runtime_status="" ui_facts_revision+=1
 start_timeout(0.01,||trace_emit_run("query_resumed",{failed_step:failed.step occurred_at:now received_at:received_at arrive_by:arrive_by},nil,token))
 render_content() ui.trip_context.render()
 start_timeout(0.01,||agent_pump(token))
 return true
}
fn model_input_changed(){
 ui.composer_help.set_text("提交会新建一条出行，原记录保留。")
 if ui.sentence.text().trim()!=request_form_input {clear_model_resume() if model_request_owner!=nil {model_request_owner.resume_input_changed=true}}
 ui.control.render()
}
fn request_failed(record,text){
 clear_model_resume()
 agent_active=false active_tool=nil phase="failed"
 let token=run_id let failed_at=time_now() let failed_trip=trip_selected_id let failed_request=request_text let failed_form=request_form_input
 record.failure_message_count=agent_messages.len()
 start_timeout(0.01,||trace_emit_run("transport_error",{step:record.step state:record.state error:text occurred_at:failed_at},nil,token))
 show_status(text)
 trip_save_current("failed",fn(saved){
  // 保存可能推进generation；资格只在同一失败轮次的提交收束后建立。
  if token!=run_id || record!=model_request_owner || failed_trip!=trip_selected_id || phase!="failed" || trip_replay || failed_request!=request_text || failed_form!=request_form_input || ui.sentence.text().trim()!=failed_form {return}
  record.failed_trip_id=failed_trip record.failed_request_text=failed_request record.failed_form_input=failed_form record.resume_generation=trip_generation
  record.resume_eligible=record.state=="host_error" && route_get(record,"action_started")!=true && route_get(record,"resume_input_changed")!=true
  render_content()
 })
}
fn block_content_height(block){
 let sizing=route_get(block,"content_sizing")
 if sizing=="natural" {return "Fit"} if sizing=="viewport" {return "Fill"}
 // 无字段的旧记录保持原height规则，不重新解释其布局。
 return if block.height!=nil {"Fill"} else {"Fit"}
}
fn block_inner_height(block){if block.height!=nil {return Fill} if block.document {return Fill} return Fit}
fn block_height(block){
 if block.overlay {
  // 浮层从结果锚点开始；给内部Fill的高度必须是父区域剩余可见高度。
  let root=ui.index_page.rect()
  if root!=nil && root.height>0 {
   let top=if ui_overlay_top>0 {ui_overlay_top} else {0}
   let available=root.height-top if available<1 {available=1}
   if block.height!=nil && block.height<available {return block.height}
   return available
  }
 }
 if block.height!=nil {return block.height}
 if block.overlay || block.document {if ui_viewport!=nil {return ui_viewport.height} return Fill}
 return Fit
}
fn block_actual_visible(block){return block.visible && block.complete}
fn block_current_handle(block){
 // WidgetRef绑定固定UID；父树重应用后只从当前命名容器解析，不复用旧子实例句柄。
 block.container=if block.overlay {ui.block_overlay.child(block.index)} else {ui.generated_area.child(block.index)}
 block.handle=block.container.child(0)
 return block.handle
}
fn set_block_visibility(block){
 if block.handle==nil {return true}
 // 主视图重新应用后动态浮层容器可换UID；显示当前容器，不重装已运行的详情VM。
 block_current_handle(block)
 let visible=block_actual_visible(block) if answer_text!="" && !generated_render_complete {visible=false}
 block.container.set_visible(visible) return true
}
fn block_by_id(id){for block in ui_blocks {if block.id==id {return block}} return nil}
fn sync_block_state(){
 generated_active=ui_blocks.len()>0 generated_render_complete=false generated_render_notified=false interface_error=""
 for block in ui_blocks {
  if block.complete {generated_render_complete=true}
  if block.notified {generated_render_notified=true}
  if block.error!="" {interface_error+=block.id+": "+block.error+"\n"}
 }
}
fn clear_generated(){
 for block in ui_blocks {try {block_current_handle(block).set_text("") block.container.set_visible(false)} {}}
 ui_blocks=[] inline_blocks=[] overlay_blocks=[] generated_source=""
 generated_active=false generated_render_complete=false generated_render_notified=false
 ui_render_generation+=1 invalidate_map() map_slots={} mailbox_seen="" mailbox_lines=0
 ui_facts_cached_revision=-1 ui_facts_written_revision=-1 ui_facts_object=nil ui_facts_object_revision=-1 ui_facts_object_run=-1 ui_facts_job=nil
 ui.generated_area.render() ui.block_overlay.render()
}
fn stop_interface(){interface_revision+=1 interface_inflight=false clear_generated() render_content()}
fn invalidate_interface(){ stop_interface() clear_generated() interface_error = "" }
fn shell_busy(){ return agent_active || trip_loading || trip_capture_pending!=nil || trip_pending_commit!=nil || phase == "picking" }
fn shell_control_visible(){return shell_busy() || model_resume_available() || composer_open || shell_composer_default()}
fn shell_action(){ if !native_ui_available {show_status(missing_runtime_message) return} if shell_busy(){cancel_task()} elif model_resume_available(){resume_model_request()} else {query_task()} }

fn ui_route(ref){ if trip_replay {return trip_history_route(ref)} if ref == "viewed" { return viewed_route() } for candidate in candidates { if candidate.id == ref || route_get(candidate,"geometry_ref")==ref { return candidate } } return nil }


fn route_leg_facts(candidate){
    let result=[] let legs=route_get(candidate,"legs")
    if legs.is_array() {for leg in legs {result.push({id:leg.id from_ref:leg.from_ref to_ref:leg.to_ref requested_to_ref:route_get(leg,"requested_to_ref") mode:leg.mode departure_ts:leg.departure_ts duration_seconds:leg.duration_seconds price_cents:leg.price_cents price_basis:leg.price_basis waiting_included:leg.waiting_included source_ts:leg.source_ts warnings:leg.warnings rail_service:rail_service_labels(route_get(leg,"rail_service")) rail_seat:route_get(leg,"rail_seat") quote_ref:route_get(leg,"quote_ref") place_match_basis:route_get(leg,"place_match_basis") provider_connection_status:route_get(leg,"provider_connection_status") connection_gap_m:route_get(leg,"connection_gap_m") connection_actual_endpoint:route_get(leg,"connection_actual_endpoint") actual_origin:route_get(leg,"actual_origin") actual_endpoint:route_get(leg,"actual_endpoint") origin_complete:route_get(leg,"origin_complete") endpoint_complete:route_get(leg,"endpoint_complete") request_bound:route_get(leg,"request_bound") station_access_status:route_get(leg,"station_access_status") boarding_status:route_get(leg,"boarding_status") connection_verified:route_get(leg,"connection_verified")})}}
    return result
}
fn route_completion(candidate){
    let completion=route_get(candidate,"completion_status")
    if completion!=nil {return completion}
    return if candidate.actual_endpoint==nil {"unknown"} elif candidate.endpoint_complete {"reached_requested_destination"} else {"incomplete"}
}
fn route_cost_facts(candidate){
    let known=route_get(candidate,"known_cost_cents") if known==nil {known=if candidate.price_cents!=nil {candidate.price_cents} else {0}}
    let covered=route_completion(candidate)=="reached_requested_destination" && candidate.request_bound && candidate.origin_complete && candidate.endpoint_complete && route_get(candidate,"connection_verified")!=false && route_get(candidate,"provider_connection_status")!="unknown" && route_get(candidate,"destination_access")==nil
    let full=if covered {candidate.price_cents} else {nil}
    let reached=route_completion(candidate)=="reached_requested_destination" && candidate.request_bound && candidate.origin_complete && candidate.endpoint_complete
    let access=route_get(candidate,"destination_access") let reasons=[]
    if candidate.price_cents==nil {reasons.push("至少一段报价未知；已知小计不包含未知报价")}
    if !reached {reasons.push("已查路线尚未覆盖请求终点")}
    if route_get(candidate,"connection_verified")==false || route_get(candidate,"provider_connection_status")=="unknown" {reasons.push("未核接入可能需要附加路段或费用")}
    if access!=nil {reasons.push(if reached {"仅到官方入口；设施内部通达未知，不表示必有收费"} else {"目的地采用官方入口；设施内部通达未知，不表示必有收费"})}
    let legs=route_get(candidate,"legs") if !legs.is_array(){legs=route_get(candidate,"selected_legs")}
    let count=if legs.is_array(){legs.len()} else {nil}
    let target=if access!=nil {route_get(route_get(access,"routing_point"),"name")} else {nil}
    return {amount_cents:full known_subtotal_cents:known full_journey_amount_cents:full complete:full!=nil queried_legs_amount_cents:candidate.price_cents queried_legs_complete:candidate.price_cents!=nil queried_leg_count:count queried_legs_scope:if reached {if access!=nil {"requested_routing_entry"} else {"requested_routing_point"}} else {"queried_legs_only"} queried_target_label:target unknown_reasons:reasons coverage:if covered {"requested_journey"} else {"queried_legs_only"} currency:candidate.currency basis:route_get(candidate,"price_basis") estimated:candidate.estimated}
}
fn route_arrival_facts(candidate,at){
 let reached=route_completion(candidate)=="reached_requested_destination" && route_get(candidate,"endpoint_complete")==true && route_get(candidate,"request_bound")==true
 let point=route_get(candidate,"actual_endpoint")
 // 无Route数据的历史公共事实仅使用已存端点核验，不猜测未知坐标。
 if point==nil && route_get(candidate,"assessment")==nil {reached=false}
 let arrival_scope=if at==nil {"unknown"} elif reached {if route_get(candidate,"destination_access")!=nil {"requested_routing_entry"} else {"requested_routing_point"}} else {"queried_endpoint_only"}
 let label=if at==nil {nil} else {guardian_deadline(at)}
 return {estimated_arrival_ts:if reached {at} else {nil} estimated_arrival_label:if reached {label} else {nil} queried_endpoint_arrival_ts:at queried_endpoint_arrival_label:label arrival_scope:arrival_scope arrival_label:if at==nil {"到达时间未知"} elif !reached {"已查路段终点预计 "+label+"；目的地到达未知"} elif arrival_scope=="requested_routing_entry" {"官方入口预计 "+label+"；设施内部通达未知"} else {"请求路由点预计 "+label}}
}
// 数值保留供应商/固定班次的最早场景，范围不由裸耗时推断。
fn route_duration_facts(candidate){
 let reached=route_completion(candidate)=="reached_requested_destination" && route_get(candidate,"endpoint_complete")==true && route_get(candidate,"request_bound")==true
 let fixed=false let legs=route_get(candidate,"legs") if !legs.is_array(){legs=route_get(candidate,"selected_legs")}
 if legs.is_array(){for leg in legs {if route_get(leg,"rail_service")!=nil {fixed=true}}}
 let label=if candidate.duration_seconds==nil {"已查耗时未知"} else {(if reached {"到请求路由点最早场景："} else {"已查路段最早场景："})+duration_text(candidate.duration_seconds)}
 return {duration_seconds:candidate.duration_seconds duration_scope:if reached {"requested_routing_point"} else {"queried_legs_only"} duration_basis:if fixed {"queried_legs_and_fixed_schedule_earliest_scenario"} else {"queried_provider_earliest_scenario"} duration_label:label}
}
// 已查路段的报价齐全，不等于到请求目的地的全程费用齐全。
fn route_cost_label(cost){
 if cost.full_journey_amount_cents!=nil {return "全程 "+money_text(cost.full_journey_amount_cents)}
 let queried=route_get(cost,"queried_legs_amount_cents") let queried_scope=route_get(cost,"queried_legs_scope")
 let text="已知小计 "+money_text(cost.known_subtotal_cents)
 if queried!=nil {
  let coverage=if queried_scope=="requested_routing_entry" {"已查至官方入口"} elif queried_scope=="requested_routing_point" {"已查至请求路由点"} else {"已查区间"}
  text=coverage+" "+money_text(queried)
 }
 return text+"；全程费用未知"
}
fn saved_route_cost_facts(saved){
 let previous=route_get(saved,"cost")
 let full=route_get(previous,"full_journey_amount_cents")
 let queried=route_get(previous,"queried_legs_amount_cents")
 if queried==nil {queried=route_get(previous,"amount_cents")}
 if queried==nil {queried=route_get(saved,"price_cents")}
 let known=route_get(previous,"known_subtotal_cents")
 if known==nil {known=route_get(saved,"known_cost_cents")}
 if known==nil {known=if queried!=nil {queried} else {0}}
 // 无原Route时仅采用已保存的整程coverage证据，不从小计猜测。
 if full==nil && route_get(previous,"coverage")=="requested_journey" && route_get(previous,"complete")==true {full=queried}
 return {amount_cents:full full_journey_amount_cents:full complete:full!=nil queried_legs_amount_cents:queried queried_legs_complete:queried!=nil queried_leg_count:route_get(previous,"queried_leg_count") queried_legs_scope:route_get(previous,"queried_legs_scope") queried_target_label:route_get(previous,"queried_target_label") unknown_reasons:route_get(previous,"unknown_reasons") known_subtotal_cents:known coverage:if full!=nil {"requested_journey"} else {"queried_legs_only"} currency:route_get(previous,"currency") basis:route_get(previous,"basis") estimated:route_get(previous,"estimated")}
}
fn history_route_public_facts(saved,restored){
 let cost=if restored!=nil {route_cost_facts(restored)} else {saved_route_cost_facts(saved)}
 let at=route_get(saved,"queried_endpoint_arrival_ts") if at==nil {at=route_get(saved,"estimated_arrival_ts")}
 let arrival=route_arrival_facts(if restored!=nil {restored} else {saved},at)
 let fact={cost:cost price_cents:cost.full_journey_amount_cents price_label:route_cost_label(cost) known_cost_cents:cost.known_subtotal_cents kind_label:if restored!=nil {route_kind_label(restored)} else {route_get(saved,"kind_label")} estimated_arrival_ts:arrival.estimated_arrival_ts estimated_arrival_label:arrival.estimated_arrival_label queried_endpoint_arrival_ts:arrival.queried_endpoint_arrival_ts queried_endpoint_arrival_label:arrival.queried_endpoint_arrival_label arrival_scope:arrival.arrival_scope arrival_label:arrival.arrival_label}
 let catalog=if restored==nil {nil} else {route_get(map_geometry_owner(restored),"map_paths_cache")}
 for key value in saved {if key!="cost" && key!="price_cents" && key!="price_label" && key!="known_cost_cents" && key!="kind_label" && key!="estimated_arrival_ts" && key!="estimated_arrival_label" && key!="queried_endpoint_arrival_ts" && key!="queried_endpoint_arrival_label" && key!="arrival_scope" && key!="arrival_label" && (catalog==nil || (key!="map_paths" && key!="map_metadata")) {fact[key]=value}}
 if catalog!=nil {fact.map_paths=catalog fact.map_metadata=route_map_metadata(restored)}
 return fact
}
fn interface_route_facts(candidate, check){
    let segments=route_segment_facts(candidate,true)
    for segment in segments {
      segment.walking_distance_m=route_get(segment.walking,"distance_m") segment.walking_duration_seconds=route_get(segment.walking,"duration_seconds")
      segment.taxi_distance_m=route_get(segment.taxi,"distance_m") segment.taxi_duration_seconds=route_get(segment.taxi,"duration_seconds") segment.taxi_price=route_get(segment.taxi,"price")
    }
    let fact=query_route_summary_checked(candidate,check)
    fact.kind_label=route_kind_label(candidate) fact.price_cents=fact.cost.full_journey_amount_cents fact.currency=candidate.currency
    fact.known_cost_cents=fact.cost.known_subtotal_cents fact.budget_status=fact.assessment.budget_status fact.deadline_status=fact.assessment.deadline_status
    fact.waiting_slack_seconds=if fact.estimated_arrival_ts!=nil {arrive_by-fact.estimated_arrival_ts} else {nil}
    fact.waiting_slack_scope=if fact.estimated_arrival_ts!=nil {"requested_routing_point_earliest_scenario"} else {"unknown"}
    fact.queried_endpoint_slack_seconds=if fact.queried_endpoint_arrival_ts!=nil {arrive_by-fact.queried_endpoint_arrival_ts} else {nil}
    fact.departure_ts=candidate.departure_ts
    fact.passed=check.passed fact.reason=check.reason fact.reasons=fact.assessment.reasons
    fact.source_ts=candidate.source_ts fact.expires_at=candidate.expires_at fact.estimated=candidate.estimated fact.warnings=candidate.warnings
    fact.waiting_included=candidate.waiting_included fact.waiting_basis=candidate.waiting_basis fact.taxi_wait_verified=candidate.taxi_wait_verified
    fact.request_bound=candidate.request_bound fact.origin_complete=candidate.origin_complete fact.endpoint_complete=candidate.endpoint_complete fact.endpoint_gap_m=candidate.endpoint_gap_m
    fact.map_paths=route_get(map_geometry_owner(candidate),"map_paths_cache") fact.segments=segments
    return fact
}
fn interface_viewport_facts(){
 if native_ui_available {let area=ui.content.rect() if area!=nil && area.width>0 && area.height>0 {ui_viewport=area let anchor=ui.result_anchor.rect() let root=ui.index_page.rect() if anchor!=nil && root!=nil {ui_overlay_top=anchor.y+anchor.height-root.y}}}
 return {viewport:ui_viewport rendering_environment:{scroll:"viewport表示可见区域，不是内容高度上限；普通区块按Fit自然增长并在父ScrollYView滚动，overlay和整稿source有独立有限视口" label_default:"宽度Fill、高度Fit、Flow.Right wrap:true；可显式覆盖原生属性"}}
}
fn interface_facts(){
 if ui_facts_object!=nil && ui_facts_object_run==run_id && ui_facts_object_revision==ui_facts_revision {return ui_facts_object}
 return interface_facts_with_routes(nil)
}
fn interface_facts_with_routes(prepared){
 if trip_replay && trip_history!=nil {
  // JSON动态键与静态字段可共存；排除覆盖键，避免编码后旧值遮住当前选择。
  let routes=[]
  for saved in trip_history.facts.routes {
   let restored=trip_history_route(saved.id)
   routes.push(history_route_public_facts(saved,restored))
  }
  let facts={history:{captured_at:trip_history.captured_at current:false} viewport:ui_viewport viewed_route_id:viewed_route_id routes:routes}
  for key value in trip_history.facts {if key!="history" && key!="viewport" && key!="viewed_route_id" && key!="routes" {facts[key]=value}}
  return facts
 }

    let viewport_facts=interface_viewport_facts()
    render_probe_mark("source_check_entered")
    let routes = [] let source_valid = sources_current() let sources = []
    render_probe_mark("source_check_returned")
    if prepared!=nil {routes=prepared} else {
      for candidate in candidates {
        if render_probe!=nil && render_probe.active {render_probe.current_route=candidate.id} render_probe_mark("route_entered")
        let check = route_recheck(candidate, time_now(), arrive_by, route_get(constraints, "budget_cents"))
        routes.push(interface_route_facts(candidate, check))
        render_probe_mark("route_returned")
      }
    }
    if render_probe!=nil && render_probe.active {render_probe.current_route=nil} render_probe_mark("facts_remainder_entered")
    for record in source_records { sources.push({id: route_get(record, "id") kind: route_get(record, "kind") source: route_get(record, "source") mock: route_get(record, "mock") source_time: route_get(record, "source_time") read_at: route_get(record, "read_at")}) }
    if position_record!=nil && destination_record!=nil && constraints!=nil {prepare_route_graph_base()}
    let graph_nodes=[] let route_ids=[]
    for ref node in route_nodes {graph_nodes.push(node)} for candidate in candidates {route_ids.push(candidate.id)}
    let result={background_context:context_calendar_snapshot() guardian:guardian_snapshot() guardian_recheck:guardian_mode route_graph:{nodes:graph_nodes route_ids:route_ids initial_route_id:"origin"} taxi_quotes:didi_quotes taxi_quote_places:didi_places phase: phase status: runtime_status error: interface_error now: time_now() received_at: received_at received_at_label:guardian_deadline(received_at) arrive_by: arrive_by arrive_by_label:if arrive_by!=nil {guardian_deadline(arrive_by)} else {nil} timezone:"Asia/Shanghai"
        origin_available: position_record != nil destination_available: destination_record != nil limits_available: user_limits != nil
        origin: position_record destination: destination_record limits: user_limits source_label: source_label() sources: sources sources_current: source_valid answer: answer_text
        comparison: if routes.len() > 0 { comparison_summary(routes) } else { "" } routes: routes viewed_route_id: viewed_route_id maps_available: user_limits != nil viewport: viewport_facts.viewport rendering_environment:viewport_facts.rendering_environment
        places: picker_pois preview_place: picker_preview_poi place_status: picker_status
        semantics: "点路线只查看；未知金额/等待不等于零。"}
    render_probe_mark("facts_returned")
    return result
}
// 一条Route一个入口准备完整显示事实；同run/revision的显示与保存共享结果。
fn ensure_interface_facts(token,done){ensure_interface_facts_owned(token,done,nil)}
fn ensure_interface_facts_owned(token,done,owner){
 if token!=run_id {done(nil) return}
 if ui_facts_object!=nil && ui_facts_object_run==run_id && ui_facts_object_revision==ui_facts_revision && ui_facts_cached_revision==ui_facts_revision {done(ui_facts_object) return}
 if ui_facts_job!=nil && ui_facts_job.token==token && ui_facts_job.revision==ui_facts_revision {ui_facts_job.waiters.push(done) if owner!=nil {ui_facts_job.tool_owner=owner} return}
 let state={token:token revision:ui_facts_revision items:candidates index:0 routes:[] waiters:[done] tool_owner:owner}
 ui_facts_job=state interface_facts_timeout(state)
}
fn interface_facts_timeout(state){
 // 同一facts准备可服务UI和显式业务订阅；不把UI/trace错误推测给active_tool。
 start_timeout_checked(0.01,||interface_facts_batch(state),fn(error){
  if state.token!=run_id || ui_facts_job!=state {return}
  ui_facts_job=nil
  if tool_job_current(state.tool_owner) {state.tool_owner.phase="render_facts" tool_execution_failed(state.tool_owner,error)}
  for done in state.waiters {done(nil)}
 })
}
fn interface_facts_batch(state){
 if state.token!=run_id {for done in state.waiters {done(nil)} return}
 if state.revision!=ui_facts_revision {
  for done in state.waiters {ensure_interface_facts_owned(state.token,done,state.tool_owner)} return
 }
 if ui_facts_job!=state {for done in state.waiters {ensure_interface_facts_owned(state.token,done,state.tool_owner)} return}
 if !trip_replay && state.index<state.items.len() {
  let candidate=state.items[state.index]
  register_candidate_stations(candidate)
  if render_probe!=nil && render_probe.active {render_probe.current_route=candidate.id} render_probe_mark("route_entered")
  state.routes.push(interface_route_facts(candidate,route_recheck(candidate,time_now(),arrive_by,route_get(constraints,"budget_cents"))))
  render_probe_mark("route_returned") state.index+=1
  interface_facts_timeout(state) return
 }
 let value=interface_facts_with_routes(state.routes)
 render_probe_mark("serialize_entered") let encoded=value.to_json() render_probe_mark("serialize_returned")
 if state.token!=run_id || state.revision!=ui_facts_revision || ui_facts_job!=state {for done in state.waiters {ensure_interface_facts_owned(state.token,done,state.tool_owner)} return}
 ui_facts_object=value ui_facts_object_run=state.token ui_facts_object_revision=state.revision ui_facts_json=encoded ui_facts_cached_revision=state.revision ui_facts_job=nil
 for done in state.waiters {done(value)}
}
