    NavMeta{text:context_settings_status}
    NavSecondary{text:"授权设备位置" width:Fill on_click:||context_request_location()}
    NavSecondary{text:"授权系统日历" width:Fill on_click:||context_calendar_permission(context_settings_result)}
    NavSecondary{text:"选择读取的日历" width:Fill on_click:||context_calendar_choices(context_settings_result)}
    if context_calendar_choices_cache.len()>0 {ScrollYView{width:Fill height:160 flow:Down spacing:8
      // 父on_render已执行；直接构造条目，不能等待新ScrollYView未被调用的on_render。
      for calendar in context_calendar_choices_cache {let id=calendar.id
        NavSecondary{text:calendar.name width:Fill on_click:||context_calendar_select(id,context_settings_result)}
      }
    }}
    }
    return true
  }}
  trip_rows := ScrollYView{width:Fill height:Fill flow:Down spacing:8 on_render:||{
    for trip in trip_records {let id=trip.id
      let meta=shell_short_time(trip.updated_at)
      if id==trip_selected_id {meta="当前 · "+meta}
      let status=if trip.goal!=nil {if trip.goal.state=="active" {"已确认目标"} else {"已结束"}} else {if trip.status=="draft" {"草稿"} else {"规划记录"}}
      meta+=" · "+status
      View{width:Fill height:136 flow:Overlay
        ButtonFlat{width:Fill height:Fill margin:0 text:"" draw_bg +:{color:if id==trip_selected_id {#xe5f0ec} else {#xf7f9f8} color_hover:#xe5f0ec border_size:0 border_radius:8} on_click:||trip_select(id)}
        View{width:Fill height:Fill flow:Down padding:12 spacing:6
          Label{width:Fill height:Fit max_lines:2 text:shell_trip_name(trip) draw_text +:{text_style:NavRegular{font_size:16} color:ink}}
          NavMeta{text:meta}
        }
      }
    }
  }}
  trip_management := View{width:Fill height:Fit flow:Down spacing:8 on_render:||{
    trip_manage_button := NavSecondary{text:if trip_manage_open {"收起管理"} else {"管理当前出行"} width:Fill enabled:trip_selected_id!=nil on_click:||{trip_manage_open=!trip_manage_open trip_refresh_shell()}}
    if trip_manage_open && shell_delete_target==nil {trip_delete_button := NavSecondary{text:"删除整条出行" width:Fill on_click:||shell_delete_request("trip")}}
    if shell_delete_target!=nil {let target=trip_by_id(shell_delete_target)
      NavMeta{text:"确认删除"+if shell_delete_kind=="goal" {"此目标？出行与历史详情保留。"} else {"整条出行？目标和历史详情一并删除。"}+if target!=nil {"\n"+target.title} else {""}}
      View{width:Fill height:Fit flow:Right spacing:8
        trip_delete_cancel := NavSecondary{text:"取消" width:Fill on_click:||{shell_delete_target=nil shell_delete_kind="" trip_refresh_shell()}}
        trip_delete_confirm := NavSecondary{text:"确认删除" width:Fill draw_text.color:#xa23832 on_click:||shell_delete_confirm()}
      }
    }
  return true
  }}
}
trace_overlay := View{width:1 height:1 flow:Overlay
trace_identity := Label{visible:trace_enabled width:1 height:1 padding:0 text:trace_identity_json() draw_text +: {color:#x0000 text_style:NavRegular{font_size:0.5}}}
}
}
start_timeout(0.1, || { ui.trip_sidebar.set_visible(false) ui.trip_scrim.set_visible(false) trace_initialize() if trace_enabled {try {ui.trace_identity.set_text(trace_identity_json())} {}} trace_marker() if native_ui_available {ui_viewport = ui.content.rect()} render_content() if native_ui_available {poll_generated()} trip_load(||trip_restore()) })
