fn generated_context(){
    return native_ui_style_source()+"let NavRegular = theme.font_regular{font_size:16 font_family: FontFamily{latin := FontMember{res: http_resource(\"{{assets}}/assets/fonts/NavigationSans-Regular.otf\") asc: 0.0 desc: 0.0}}}\n// Navigation局部字体适配；canonical SDK与其它应用主题保持原样。\nlet MaterialTitle = MaterialTitle{draw_text +:{text_style:NavRegular{font_size:22}}}\nlet MaterialBody = MaterialBody{draw_text +:{text_style:NavRegular{font_size:16}}}\nlet MaterialMeta = MaterialMeta{draw_text +:{text_style:NavRegular{font_size:14}}}\nlet MaterialAction = MaterialAction{draw_text +:{text_style:NavRegular{font_size:16}}}\nlet MaterialSecondaryAction = MaterialSecondaryAction{draw_text +:{text_style:NavRegular{font_size:14}}}\n// 通用内容样式；不读取、排序或选择业务路线。\nlet NavSurface = MaterialSurface{draw_bg +:{color:#xf8fbfa border_radius:16}}\nlet NavCard = MaterialCard{draw_bg +:{color:#xf0f5f3 border_radius:12}}\nlet NavTitle = MaterialTitle{draw_text +:{text_style:NavRegular{font_size:22} color:#x162e35}}\nlet NavBody = MaterialBody{draw_text +:{text_style:NavRegular{font_size:16} color:#x162e35}}\nlet NavMeta = MaterialMeta{draw_text +:{text_style:NavRegular{font_size:14} color:#x50666c}}\nlet NavAction = MaterialAction{draw_text +:{text_style:NavRegular{font_size:16} color:#xffffff color_hover:#xffffff color_down:#xffffff color_focus:#xffffff color_disabled:#x52615d} draw_bg +:{color:#x28786f color_hover:#x216b63 color_down:#x195d56 color_focus:#x195d56 color_disabled:#xdbe4e0 border_size:0 border_radius:12}}\nlet NavSecondaryAction = MaterialSecondaryAction{draw_text +:{text_style:NavRegular{font_size:14} color:#x162e35 color_hover:#x162e35 color_down:#x162e35 color_focus:#x162e35 color_disabled:#x52615d} draw_bg +:{color:#xe4eeea color_hover:#xd7e6df color_down:#xc5dbd1 color_focus:#xc5dbd1 color_disabled:#xdbe4e0 border_size:0 border_radius:12}}\n\nlet Label = Label{width: Fill height: Fit flow: Flow.Right{wrap:true} draw_text.text_style: NavRegular}\nlet Button = Button{draw_text.text_style: NavRegular}\nlet ButtonFlat = ButtonFlat{draw_text.text_style: NavRegular}\nlet TextInput = TextInput{draw_text.text_style: NavRegular}\nfn snapshot(){return ui.fact_state.text().parse_json()}\nlet mailbox_buffer = \"\"\nfn emit(event){event.block_id=source_block_id event.block_revision=source_block_revision mailbox_buffer += event.to_json() + \"\\n\" ui.mailbox.set_text(mailbox_buffer)}\nfn show_block(target_id){emit({action:\"show_block\" block:target_id visible:true})}\nfn hide_self(){emit({action:\"show_block\" block:source_block_id visible:false})}\nlet last_facts = \"\"\nlet on_facts_changed = nil\nfn refresh(initial){let value = ui.fact_revision.text() if initial || value != last_facts {last_facts = value if on_facts_changed != nil {on_facts_changed(snapshot())}} if initial {emit({action:\"rendered\"})} start_timeout(0.1, || refresh(false))}\nstart_timeout(0.02, || {ui.body.render() start_timeout(0.01, || refresh(true))})\n"
}
fn facts_json(){
 if ui_facts_cached_revision!=ui_facts_revision {let value=interface_facts() render_probe_mark("serialize_entered") ui_facts_json=value.to_json() render_probe_mark("serialize_returned") ui_facts_cached_revision=ui_facts_revision}
 return ui_facts_json
}
fn block_source(block,body){
 let finite=block.overlay || block.document || block.height!=nil
 let context="let source_block_id="+block.id.to_json()+"\nlet source_block_revision="+block.revision+"\n"+generated_context()
 let height_text=if finite {"Fill"} else {"Fit"}
 let head=context+"\nView{width:Fill height:"+height_text+" flow:Down\nmailbox := Label{visible:false text:\"\"}\nfact_state := Label{visible:false text:"+facts_json().to_json()+"}\nfact_revision := Label{visible:false text:"+(""+ui_facts_revision).to_json()+"}\n"
 if finite {head+="scroll := ScrollYView{width:Fill height:Fill flow:Down clip_x:true clip_y:true\n"}
 let tail=if finite {"}\n}"} else {"}"}
 return head+"body := View{width:Fill height:"+block_content_height(block)+" flow:Down on_render:||{let facts=snapshot()\n"+body+"\n}}\n"+tail
}
// 只校验呈现工具已声明的参数边界；内部恢复调用保持原格式。
fn render_parameters_error(name,p){
 if !p.is_object() {return "render参数必须为对象"}
 let properties=nil
 for spec in agent_tools(){if spec.function.name==name {properties=spec.function.parameters.properties}}
 if properties==nil {return "未知render工具"}
 for key value in p {let field=""+key if route_get(properties,field)==nil {return "未声明render参数 "+field+"；其内容未安装。render_ui接受source或blocks（二者互斥），命名工具接受source/id/overlay/height/content_sizing；请按实际工具schema提交"}}
 if name=="render_ui" {
  if route_get(p,"source")!=nil && route_get(p,"blocks")!=nil {return "render_ui的source与blocks互斥；本次未安装。source替换整稿，blocks按id更新并保留其它块"}
  let blocks=route_get(p,"blocks")
  if blocks!=nil {
   if !blocks.is_array() {return "render_ui.blocks必须为包含id/source的对象数组；本次未安装"}
   let fields=properties.blocks.items.properties
   for block in blocks {
    if !block.is_object() {return "render_ui.blocks元素必须为包含id/source的对象；本次未安装"}
    for key value in block {let field=""+key if route_get(fields,field)==nil {return "未声明render_ui.blocks参数 "+field+"；本次未安装，请按实际blocks schema提交"}}
    if !route_get(block,"id").is_string() || !route_get(block,"source").is_string() {return "render_ui.blocks元素必须提供String id/source；本次未安装"}
   }
  }
 }
 return ""
}
fn render_current_blocks(){
 let current=[]
 for block in ui_blocks {
  let maps=[] for key slot in map_slots {if route_get(slot,"block_id")==block.id {maps.push({widget:slot.widget target:slot.target state:slot.state status:slot.status http_requested:route_get(slot,"http_requested")==true path_indices:route_get(slot,"path_indices")})}}
  current.push({id:block.id revision:block.revision installed:block.installed notified:block.notified complete:block.complete visible:block_actual_visible(block) overlay:block.overlay document:block.document map_bindings:maps})
 }
 return current
}
// 完整facts序列化和源码安装分别进入VM，安装不继承事实投影已消耗的入口预算。
fn prepare_render_tool(name,p,token,call,revision){
 let owner=agent_tool_job
 if !current_task(token) || active_tool!=call || revision!=interface_revision {return}
 let error=render_parameters_error(name,p)
 if error!="" {agent_tool_result({success:false error:error current_blocks:render_current_blocks()}) return}
 ensure_interface_facts_owned(token,fn(facts){
  if facts==nil || !current_task(token) || active_tool!=call || revision!=interface_revision {return}
  tool_timeout(0.01,owner,"render_mount",||{
   if !current_task(token) || active_tool!=call || revision!=interface_revision {return}
   if ui_facts_cached_revision!=ui_facts_revision || ui_facts_object_run!=token {
    prepare_render_tool(name,p,token,call,revision) return
   }
   let changed=mount_ui_blocks(render_tool_params(name,p),token,revision)
   render_probe_mark("mount_returned") if render_probe!=nil {render_probe.active=false}
   if changed==nil {agent_tool_result({success:false error:interface_error}) return}
   tool_timeout(0.05,owner,"render_feedback",||render_tool_wait(changed,token,call,time_now()))
  })
 },owner)
}
fn render_tool_wait(changed,token,call,started){
 if !current_task(token) || active_tool!=call {return}
 let pending=false
 for block in changed {
  if block.installed {let diagnostic=block_current_handle(block).diagnostics() if diagnostic!="" {block.error=diagnostic}}
  if block.error=="" && (!block.installed || !block.notified) {pending=true}
 }
 if pending && time_now()-started<2 {tool_timeout(0.05,agent_tool_job,"render_feedback",||render_tool_wait(changed,token,call,started)) return}
 let result=render_ui_result(changed) let finished_at=time_now() let geometry=render_diagnostic_geometry(changed)
 agent_tool_result(result)
 start_timeout(0.01,||trace_emit_run("render_result",{blocks:result.blocks geometry:geometry occurred_at:finished_at},call.id,token))
 start_timeout(0.01,||{if token==run_id {render_content()}})
}
fn render_ui_result(changed){
 let results=[] let success=true let initialized=true
 for block in changed {
  let diagnostic="区块尚未安装"
  if block.installed {diagnostic=block_current_handle(block).diagnostics() if diagnostic=="" && block.error!="" {diagnostic=block.error}}
  if diagnostic=="" && block.notified {block.complete=true}
  block.error=diagnostic
  if diagnostic!="" || !block.notified {success=false}
  if !block.notified {initialized=false}
  let container_rect=nil let body_rect=nil
  try {let handle=block_current_handle(block) container_rect=block.container.rect() body_rect=handle.find("body").rect()} {}
  block.render_geometry={container_rect:container_rect body_rect:body_rect}
  results.push({id:block.id revision:block.revision diagnostics:diagnostic installed:block.installed status:if diagnostic!="" {"error"} elif block.complete {"rendered"} else {"initialization_unconfirmed"} error:if diagnostic=="" && !block.notified {"源码已安装，但本次首次事实绑定未收到完成通知"} else {nil} notified:block.notified complete:block.complete visible:block_actual_visible(block)})
 }
 sync_block_state()
 let unresolved=[]
 for block in ui_blocks {if block.error!="" || !block.installed || !block.notified {unresolved.push({id:block.id revision:block.revision diagnostics:block.error installed:block.installed notified:block.notified complete:block.complete repair:"render_ui的blocks可按此id更新源码，保留其它区块；__document也可这样修正，不需使用source整稿替换"})}}
 return {success:success changed_blocks_success:success interface_success:unresolved.len()==0 unresolved_blocks:unresolved current_blocks:render_current_blocks() blocks:results diagnostics:interface_error notified:initialized viewport:ui_viewport meaning:"success/changed_blocks_success仅表示本次修改区块初始化成功；interface_success与unresolved_blocks说明其它当前区块是否仍有失败或未确认，不可把局部成功称为全界面成功。current_blocks仅为当前实际库存和地图事件绑定，不证明详情内容已写好或地图像素可见。installed仅确认源码安装；rendered仅确认执行与通知，不证明可见布局或可点击。initialization_unconfirmed表示源码已安装，但本次首次事实绑定在等待期限内未确认，success:false；不是语法诊断。rendered也不保证未来交互无错误；实际语法与运行错误见diagnostics。"}
}
fn render_diagnostic_geometry(changed){
 let geometry=[]
 for block in changed {geometry.push({id:block.id revision:block.revision rects:route_get(block,"render_geometry")})}
 return geometry
}
fn fragment_tool_error(block_id,diagnostic){
 let message=block_id+": "+diagnostic
 if diagnostic.search("unexpected escaped quote outside string")>=0 {
  message+="；source是已解码的Splash源码，不要再次按JSON转义；字符串外直接写show_block(\"route_detail\")，字符串内部的合法转义不变。"
 }
 return message
}
fn mount_interface(body,token,revision){return mount_ui_blocks({source:body},token,revision)}
fn mount_ui_blocks(params,token,revision){
 render_probe_mark("mount_entered")
 if token!=run_id || revision!=interface_revision {return []}
 let submissions=route_get(params,"blocks") let document=route_get(params,"source")!=nil
 if document {submissions=[{id:"__document" source:params.source content_sizing:route_get(params,"content_sizing")}]}
 if !submissions.is_array() {interface_error="render_ui需要source或blocks" return nil}
 render_probe_mark("fragment_check_entered")
 // Diagnose fragments before changing existing blocks; the wrapper must not repair their structure.
 for input in submissions {
  let existing=block_by_id(input.id)
  let overlay=if route_get(input,"overlay")!=nil {input.overlay==true} elif existing!=nil {existing.overlay} else {false}
  let height=if route_get(input,"height")!=nil {input.height} elif existing!=nil {existing.height} else {nil}
  let sizing=if route_get(input,"content_sizing")!=nil {input.content_sizing} elif existing!=nil {route_get(existing,"content_sizing")} elif route_get(params,"legacy_content_sizing")==true {nil} else {"natural"}
  if sizing!=nil && sizing!="natural" && sizing!="viewport" {interface_error=input.id+": content_sizing仅支持natural或viewport" return nil}
  if (sizing=="natural" || (sizing==nil && height==nil)) && regex("^[ \t\r\n]*([A-Za-z_][A-Za-z0-9_]*[ \t\r\n]*:=[ \t\r\n]*)?ScrollYView[ \t\r\n]*[{][^{}]*height[ \t\r\n]*:[ \t\r\n]*Fill","").test(input.source) {interface_error=input.id+": 当前content_sizing使父body为Fit，顶层ScrollYView height:Fill缺少有限内容高度；height只约束外视口，overlay与整稿也相同；请使用自然Fit内容，或显式content_sizing:viewport由源码管理有限视口；父容器可承担自然内容的滚动。" return nil}
  let diagnostic=ui.validate_fragment(input.source)
  if diagnostic!="" {interface_error=fragment_tool_error(input.id,diagnostic) return nil}
 }
 render_probe_mark("fragment_check_returned")
 if document {
  let cached_object=ui_facts_object let cached_run=ui_facts_object_run let cached_revision=ui_facts_object_revision let cached_json=ui_facts_json let cached_json_revision=ui_facts_cached_revision
  clear_generated()
  ui_facts_object=cached_object ui_facts_object_run=cached_run ui_facts_object_revision=cached_revision ui_facts_json=cached_json ui_facts_cached_revision=cached_json_revision
 }
 let changed=[] interface_run=token interface_inflight=false
 for input in submissions {let existing=block_by_id(input.id) if existing!=nil && route_get(input,"overlay")!=nil && existing.overlay!=(input.overlay==true) {interface_error="已存在区块的overlay位置不变；请使用新id" return nil}}
 for input in submissions {
  let block=block_by_id(input.id)
  let overlay=route_get(input,"overlay")==true
  if block==nil {
   block={id:input.id revision:0 body:"" handle:nil overlay:overlay document:document visible:if route_get(input,"visible")!=nil {input.visible} else {!overlay} height:route_get(input,"height") content_sizing:if route_get(input,"content_sizing")!=nil {input.content_sizing} elif route_get(params,"legacy_content_sizing")==true {nil} else {"natural"} installed:false notified:false complete:false error:"" mailbox_seen:"" mailbox_lines:0 written_revision:-1}
   if overlay {block.index=overlay_blocks.len() overlay_blocks.push(block)} else {block.index=inline_blocks.len() inline_blocks.push(block)}
   ui_blocks.push(block)
  } else {
   if route_get(input,"visible")!=nil {block.visible=input.visible}
   if route_get(input,"height")!=nil {block.height=input.height}
   if route_get(input,"content_sizing")!=nil {block.content_sizing=input.content_sizing}
   try {block_current_handle(block).set_text("")} {}
   let kept={} for key slot in map_slots {if route_get(slot,"block_id")!=block.id {kept[key]=slot}} map_slots=kept
  }
  block.revision+=1 block.notified=false block.complete=false block.error="" block.mailbox_seen="" block.mailbox_lines=0 block.installed=false
  if route_get(input,"route_detail")!=nil {block.route_detail=input.route_detail}
  block.raw_source=input.source
  block.source=block_source(block,input.source) block.source_revision=ui_facts_revision changed.push(block)
 }
 sync_block_state()
 // ScriptReapply retains the unmodified child WidgetRefs and their Splash VMs.
 ui.generated_area.render_style() ui.block_overlay.render_style()
 let render_call_id=if active_tool!=nil {active_tool.id} else {nil}
 for block in changed {install_block_later(block,token,block.revision,render_call_id)}
 render_content()
 return changed
}
fn install_block_later(block,token,revision,call_id){
 start_timeout(0.05,||{
  if token!=run_id || block_by_id(block.id)!=block || revision!=block.revision {return}
  let handle=block_current_handle(block)
  handle.diagnostics()
  block.body=block.source
  try {handle.set_text(block.source) block.installed=true block.written_revision=block.source_revision set_block_visibility(block)}
  {block.error="生成区块执行失败"}
  trace_emit_run("render_source",{block_id:block.id revision:revision source:block.source},call_id,token)
 })
}
fn refresh_generated_facts(){
 if !generated_active {return true}
 let pending=false for block in ui_blocks {if block.installed && block.written_revision!=ui_facts_revision {pending=true}}
 if !pending {return true}
 let token=run_id
 ensure_interface_facts(token,fn(facts){
  if facts==nil || token!=run_id || !generated_active {return}
  let value=ui_facts_json
  for block in ui_blocks {if block.installed && block.written_revision!=ui_facts_revision {
   try {let handle=block_current_handle(block) handle.find("fact_state").set_text(value) handle.find("fact_revision").set_text(""+ui_facts_revision) block.written_revision=ui_facts_revision}
   {block.error="生成区块事实更新失败"}
  }}
  ui_facts_written_revision=ui_facts_revision
 })
 return true
}
fn generated_rendered(){return block_rendered(block_by_id("__document"))}
fn block_rendered(block){
 if block==nil || !generated_active || interface_run!=run_id {return true}
 block.notified=true let diagnostic=block_current_handle(block).diagnostics()
 if diagnostic=="" {block.complete=true block.error=""} else {block.error=diagnostic}
 sync_block_state()
 if !agent_active && !trip_replay && trip_pending_commit==nil && trip_capture_pending==nil {
  // 迟到的显示通知只补存界面，不把已完成或已确认的出行状态改成UI phase。
  let trip=trip_by_id(trip_selected_id)
  trip_save_current(if trip!=nil && trip.status!="running" {trip.status} else {phase})
 }
 trace_emit("render_notification",{block_id:block.id diagnostics:diagnostic rendered:block.complete revision:block.revision},nil)
 render_content()
 for key slot in map_slots {if route_get(slot,"block_id")==block.id {update_map_widget(slot)}}
 return true
}
fn generated_error(message){return block_error(block_by_id("__document"),message)}
fn block_error(block,message){
 if block==nil {return true}
 let diagnostic=block_current_handle(block).diagnostics() if diagnostic!="" {message=diagnostic}
 if message!=block.error {trace_emit("render_diagnostic",{block_id:block.id diagnostics:message rendered:block.complete},nil)}
 block.error=message sync_block_state() render_content() return true
}
fn block_map_key(block_id,widget){if block_id==nil || block_id=="__document" {return widget} return [block_id widget].to_json()}
fn map_widget(slot){let block=block_by_id(route_get(slot,"block_id")) if block==nil {return nil} return block_current_handle(block).find(slot.widget)}
fn ui_dispatch_action(action){
 let block_id=route_get(action,"block_id") if block_id==nil {block_id="__document"}
 let block=block_by_id(block_id)
 if block!=nil && route_get(action,"block_revision")!=nil && action.block_revision!=block.revision {return true}
 if trip_replay && action.action!="rendered" && action.action!="map" && action.action!="map_camera" && action.action!="map_fit" && action.action!="show_block" && action.action!="view_route" && action.action!="runtime_error" {return true}
 trace_emit("local_event",{trip_id:trip_selected_id historical:trip_replay event:action.to_json()},nil)
 let name=route_get(action,"action") let id=route_get(action,"id")
 if name=="rendered" {block_rendered(block)}
 elif name=="map" {register_map_block(action.widget,action.target,route_get(action,"status_widget"),route_get(action,"interactive"),route_get(action,"path_indices"),block_id)}
 elif name=="map_camera" {action.widget=block_map_key(block_id,action.widget) map_camera_changed(action)}
 elif name=="map_fit" {let slot=map_slots[block_map_key(block_id,action.widget)] if slot!=nil && slot.interactive {let route=map_candidate(slot.target) if route!=nil {fit_map_slot(slot,route)}}}
 elif name=="show_block" {let target=block_by_id(action.block) if target!=nil {let opening=action.visible!=false
  // 本地事件支持先打开再选路线；无有效选择时不能露出上一详情。
 if route_get(target,"route_detail")==true {target.detail_open_pending=opening && ui_route("viewed")==nil target.visible=opening && !target.detail_open_pending}
  else {target.visible=opening}
  set_block_visibility(target) render_content()} else {block_error(block,"show_block目标区块不存在："+action.block)}}
 elif name=="view_route" {view_route(id)}
 elif name=="runtime_error" {block_error(block,route_get(action,"message"))}
 else {show_status("本地动作未实现："+name)}
 return true
}
fn enqueue_block_line(block,index,line,offset,token,revision){
 if index<offset || line.trim()=="" {return true}
 let action=line.parse_json()
 start_timeout(0.01,||{if token==run_id && block_by_id(block.id)==block && block.revision==revision {ui_dispatch_action(action)}})
 return true
}
fn consume_block_mailbox(block){
 let mailbox=block_current_handle(block).find("mailbox").text()
 if mailbox==block.mailbox_seen {return true}
 block.mailbox_seen=mailbox let lines=mailbox.split("\n") let offset=block.mailbox_lines block.mailbox_lines=lines.len()-1
 for index line in lines {enqueue_block_line(block,index,line,offset,run_id,block.revision)}
 return true
}
fn consume_generated_mailbox(){let block=block_by_id("__document") if block!=nil {consume_block_mailbox(block)} return true}
fn poll_generated(){
 for block in ui_blocks {if block.installed {
  try {let diagnostic=block_current_handle(block).diagnostics() if diagnostic!="" {block_error(block,diagnostic)} consume_block_mailbox(block)}
  {block.error="生成区块事件执行失败" sync_block_state() ui.feedback.render()}
 }}
 start_timeout(0.1,||poll_generated()) return true
}
fn update_map_widget(slot){
    if !generated_active { return }
    try {
        map_widget(slot).set_visible(slot.interactive == true || slot.bytes != nil)
        if slot.status_widget.is_string() && slot.status_widget != "" { block_by_id(slot.block_id).handle.find(slot.status_widget).set_text(slot.caption + "\n" + slot.status) }
        let generation=if block_by_id(slot.block_id)!=nil {block_by_id(slot.block_id).revision} else {ui_render_generation}
        if slot.bytes != nil && (slot.loaded_generation != generation || slot.loaded_request != slot.request) {
            if slot.interactive {
                let installed=map_widget(slot).load_map_image(slot.bytes,slot.camera.request,slot.camera.source_width,slot.camera.source_height)
                trace_emit("map_image_submitted",{widget:slot.id request:slot.request native_request:slot.camera.request accepted:installed},nil)
            } else {map_widget(slot).load_image_from_data_async(slot.bytes)}
            slot.loaded_generation=generation slot.loaded_request=slot.request
        }
    } { interface_error = "此图控件加载失败；其它图和行程保留" ui.feedback.render() }
}
