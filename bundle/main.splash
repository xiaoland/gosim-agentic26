// 纯函数片段：金额用整数分；时间用Unix秒；不包含地点、费用或路线的演示答案。
fn route_get(value, name){
    if !value.is_object() { return nil }
    return value[name]
}

fn route_uint(text){
    if !text.is_string() || !regex("^[0-9]+$", "").test(text) { return nil }
    let number = 0
    for digit in text.split("") {
        if digit != "" {
            let value = digit.to_f64()
            if number > (9007199254740991 - value) / 10 { return nil }
            number = number * 10 + value
        }
    }
    return number
}
fn route_seconds(value){ return route_uint(value) }
fn route_cents(value){
    if !value.is_string() || !regex("^[0-9]+([.][0-9]{1,2})?$", "").test(value) { return nil }
    let parts = value.split(".")
    let fraction = "00"
    if parts.len() == 2 { fraction = parts[1] if fraction.len() == 1 { fraction += "0" } }
    return route_uint(parts[0] + fraction)
}

// 裸max/floor等shader数学函数走f32；现代Unix秒必须保留普通f64比较/算术。
fn route_later(a, b){ if a >= b { return a } return b }

fn route_point(value){
    if !value.is_string() || !regex("^-?[0-9]+([.][0-9]+)?,-?[0-9]+([.][0-9]+)?$", "").test(value) { return nil }
    let parts = value.split(",")
    let lon = parts[0].to_f64()
    let lat = parts[1].to_f64()
    if !(abs(lon) <= 180 && abs(lat) <= 90) { return nil }
    return {lon: lon lat: lat}
}

fn route_terminal(segments){
    if !segments.is_array() || segments.len() == 0 { return nil }
    let last = segments[segments.len() - 1]
    // 最后segment含乘车时，walking是上车前的衔接，不能冒充到达终点。
    if route_get(last, "bus").is_object() || route_get(last, "taxi").is_object() || route_get(last, "railway").is_object() { return nil }
    let walking = route_get(last, "walking")
    if !walking.is_object() { return nil }
    let steps = route_get(walking, "steps")
    if !steps.is_array() || steps.len() == 0 { return nil }
    let step = steps[steps.len() - 1]
    let polyline = route_get(step, "polyline")
    if polyline.is_object() { polyline = route_get(polyline, "polyline") }
    if !polyline.is_string() || polyline == "" { return nil }
    let points = polyline.split(";")
    return points[points.len() - 1]
}

fn route_start(segments){
    if !segments.is_array() || segments.len() == 0 { return nil }
    let first = segments[0]
    let walking = route_get(first, "walking")
    if walking.is_object() {
        let steps = route_get(walking, "steps")
        if !steps.is_array() || steps.len() == 0 { return nil }
        let polyline = route_get(steps[0], "polyline")
        if polyline.is_object() { polyline = route_get(polyline, "polyline") }
        if !polyline.is_string() || polyline == "" { return nil }
        let points = polyline.split(";")
        return points[0]
    }
    // 未有步行时只接受实际出租车上车点；不从回显origin补起点证据。
    return route_get(route_get(first, "taxi"), "startpoint")
}

fn route_endpoint_gap(actual, destination){
    let a = route_point(actual)
    let b = route_point(destination)
    if a == nil || b == nil { return nil }
    // 仅用于相邻终点的25米检查，不用于路线长度或大范围测距。
    let dx = (a.lon - b.lon) * 111320 * cos((a.lat + b.lat) * 0.5 * 0.017453292519943295)
    let dy = (a.lat - b.lat) * 111320
    return sqrt(dx * dx + dy * dy)
}

fn route_reasons(candidate, nowTs, deadlineTs, budgetCents){
    if render_probe!=nil && render_probe.active {render_probe.reasons+=1}
    let reasons = []
    if route_get(candidate,"completion_status")=="incomplete" {reasons.push("路线仅到实际中间终点，后续连接尚未取得")}
    if route_get(candidate,"provider_connection_status")=="unknown" {reasons.push("滴滴上下车与路线连接未知")}
    if !nowTs.is_number() || !deadlineTs.is_number() || !budgetCents.is_number() { return ["约束格式无效"] }
    if !(nowTs >= 0 && nowTs <= 9007199254740991 && deadlineTs >= 0 && deadlineTs <= 9007199254740991 && budgetCents >= 0 && budgetCents <= 9007199254740991 && budgetCents % 1 == 0) { return ["约束格式无效"] }
    if candidate.price_cents == nil { reasons.push("费用未知，无法核实预算") }
    elif candidate.price_cents > budgetCents { reasons.push("超过预算") }
    if candidate.duration_seconds == nil { reasons.push("耗时未知") }
    elif route_later(nowTs, candidate.departure_ts) + candidate.duration_seconds > deadlineTs { reasons.push("超过到达期限") }
    if !candidate.waiting_included { reasons.push("出租车候车时间未知") }
    if !candidate.request_bound { reasons.push("路线尚未绑定本次请求") }
    if !candidate.origin_complete { reasons.push("出发起点未核实") }
    if !candidate.endpoint_complete { reasons.push("目的地末段未核实") }
    if !candidate.source_ts.is_number() { reasons.push("查询时间无效") }
    elif !(candidate.source_ts >= 0 && candidate.source_ts <= nowTs) { reasons.push("查询时间无效") }
    // ponytail: 首轮保守复用5分钟，出现班次/路况变化时在工具边界提前重查。
    elif nowTs - candidate.source_ts > 300 { reasons.push("交通数据已过期") }
    return reasons
}
fn route_reason(candidate, nowTs, deadlineTs, budgetCents){
    let reasons = route_reasons(candidate, nowTs, deadlineTs, budgetCents)
    if reasons.len() == 0 { return "估计满足约束" }
    let text = ""
    for reason in reasons { if text != "" { text += "；" } text += reason }
    return text
}

fn route_candidate(id, kind, duration, price, queryTs, departureTs, endpoint, destination, waiting, segments){
    let gap = route_endpoint_gap(endpoint, destination)
    return {id: id kind: kind duration_seconds: duration price_cents: price currency: "CNY" estimated: true
        source: "高德Web服务v5" source_ts: queryTs expires_at: queryTs + 300 departure_ts: departureTs
        waiting_included: waiting waiting_basis: "provider_total" taxi_wait_verified: false endpoint_complete: gap != nil && gap <= 25
        request_bound: false origin_complete: false actual_origin: route_start(segments)
        endpoint_gap_m: gap actual_endpoint: endpoint destination: destination segments: segments
        feasible: false reason: "尚未检查" warnings: "供应商估计；入口坐标匹配不证明出发区域或楼层、实际费用或到达保证。"}
}

fn route_candidates(transitData, drivingData, queryTs, deadlineTs, budgetCents, nowTs){
    let candidates = []
    let transitRoute = route_get(transitData, "route")
    let transits = route_get(transitRoute, "transits")
    if route_get(transitData, "status") == "1" && transits.is_array() {
        for index option in transits {
            let segments = route_get(option, "segments")
            let kind = "public_transit"
            if segments.is_array() {
                for segmentIndex segment in segments {
                    if route_get(segment, "taxi").is_object() { kind = "mixed" }
                }
            }
            let cost = route_get(option, "cost")
            let candidate = route_candidate("transit-" + index, kind,
                route_seconds(route_get(cost, "duration")), route_cents(route_get(cost, "transit_fee")),
                queryTs, nowTs, route_terminal(segments), route_get(transitRoute, "destination"), true, segments)
            if kind == "mixed" { candidate.warnings = "供应商含等车总估计；出租车等待未单独核实，不保证实际费用或准时抵达。" }
            candidate.distance_m = route_seconds(route_get(option,"distance"))
            candidate.price_basis = "amap-option.cost.transit_fee；供应商完整公共交通方案总价"
            candidate.reason = route_reason(candidate, nowTs, deadlineTs, budgetCents)
            candidate.feasible = candidate.reason == "估计满足约束"
            candidates.push(candidate)
        }
    }
    let drivingRoute = route_get(drivingData, "route")
    let paths = route_get(drivingRoute, "paths")
    if route_get(drivingData, "status") == "1" && paths.is_array() {
        for index path in paths {
            let cost = route_get(path, "cost")
            // route级估价仅在单路径请求时配对；多路径返回不猜每条路径的车价。
            let price = nil
            if paths.len() == 1 { price = route_cents(route_get(drivingRoute, "taxi_cost")) }
            let candidate = route_candidate("taxi-" + index, "taxi", route_seconds(route_get(cost, "duration")),
                price, queryTs, nowTs, route_leg_endpoint(route_get(path,"steps"),false), route_get(drivingRoute, "destination"), false, route_get(path, "steps"))
            candidate.distance_m = route_seconds(route_get(path,"distance"))
            candidate.price_basis = "amap-route.taxi_cost；单路径出租车估价，非滴滴成交价"
            candidate.waiting_basis = "driving_only"
            candidate.warnings = "全程出租车估价；duration仅行驶，候车未知，尚未核实步行登车及终点入口。"
            candidate.reason = route_reason(candidate, nowTs, deadlineTs, budgetCents)
            candidate.feasible = candidate.reason == "估计满足约束"
            candidates.push(candidate)
        }
    }
    return candidates
}

fn route_choose(candidates){
    let selected = nil
    for candidateIndex candidate in candidates {
        if candidate.feasible {
            if selected == nil { selected = candidate }
            else {
                if candidate.price_cents < selected.price_cents ||
                    (candidate.price_cents == selected.price_cents && candidate.duration_seconds < selected.duration_seconds) {
                    selected = candidate
                }
            }
        }
    }
    return selected
}

fn route_recheck(selected, nowTs, deadlineTs, budgetCents){
    if selected == nil { return {passed: false reason: "没有有效候选" estimated_arrival_ts: nil} }
    let reason = route_reason(selected, nowTs, deadlineTs, budgetCents)
    let arrival = nil
    if selected.duration_seconds != nil { arrival = route_later(nowTs, selected.departure_ts) + selected.duration_seconds }
    return {passed: route_reasons(selected, nowTs, deadlineTs, budgetCents).len() == 0 reason: reason estimated_arrival_ts: arrival}
}

// 模型只解释意图并决定下一步；地点、费用与可行性来自工具和确定性检查。
let NavRegular = theme.font_regular{font_family: FontFamily{latin := FontMember{res: http_resource("{{assets}}/assets/fonts/NavigationSans-Regular.otf") asc: 0.0 desc: 0.0}}}
let NavBold = theme.font_bold{font_family: FontFamily{latin := FontMember{res: http_resource("{{assets}}/assets/fonts/NavigationSans-Regular.otf") asc: 0.0 desc: 0.0}}}
let ink = #x162e35
let muted = #x5e747b
let teal = #x06796f
// 已核对的扩展宿主提供此类型；官方原版不具备本应用的区块、布局和地图接口。
let native_ui_available = route_get(mod.widgets, "AutoNaviMapView") != nil
let missing_runtime_message = "当前宿主缺少 Navigation 所需的原生扩展，查询暂不可用。\n需要区块寻址、布局测量、渲染诊断和交互地图接口；请使用 README 中注明的配套宿主。官方原版首屏仅展示兼容说明。"
let run_id = 0
let phase = "idle"
let received_at = 0
let arrive_by = 0
let loop_started_at = 0
let automatic_seconds = 0
let step_count = 0
let protocol_retry_count = 0
let request_text = ""
let observations = []
let model_requests = []
let decisions = []
let source_snapshots = []
let source_records = []
let calendar_events = []
let note_records = []
let position_record = nil
let pending_location = nil
let destination_error = ""
let constraint_error = ""
let constraints = nil
let user_limits = nil
let poi_records = []
let destination_record = nil
let candidates = []
let candidate_sequence = 0
let chosen = nil
let used_tools = []
let transit_count = 0
let transit_completed = 0
let driving_done = false
let driving_completed = false
let task_timer = nil
let progress_text = ""
let answer_text = ""

let viewed_route_id = ""
let expanded_routes = false
let expanded_reason = ""
let picker_open = false
let condition_open = false
let picker_pois = []
let picker_preview_poi = nil
let picker_status = ""
let picker_request = 0
let pending_user_poi = nil
fn viewed_route(){ for candidate in candidates { if candidate.id == viewed_route_id { return candidate } } return nil }
fn representative_routes(){
    if expanded_routes { return candidates }
    let result = [] let fastest = nil let cheapest = nil
    for candidate in candidates {
        if candidate.duration_seconds != nil && (fastest == nil || candidate.duration_seconds < fastest.duration_seconds) { fastest = candidate }
        if candidate.price_cents != nil && (cheapest == nil || candidate.price_cents < cheapest.price_cents) { cheapest = candidate }
    }
    if chosen != nil { result.push(chosen) }
    for candidate in [fastest cheapest viewed_route()] {
        if candidate != nil { let exists = false for item in result { if item.id == candidate.id { exists = true } } if !exists { result.push(candidate) } }
    }
    return result
}
fn map_polyline(value){
    if value.is_object() { value = route_get(value, "polyline") }
    if !value.is_string() { return nil }
    let points = value.split(";")
    if points.len() < 2 { return nil }
    for point in points { if route_point(point) == nil { return nil } }
    return value
}
// 候选几何创建后不再改写；报价和查看状态变化不使折线失效。
fn map_geometry(candidate){
    if candidate==nil {return {paths:[] omitted:0}}
    let owner=route_get(candidate,"geometry_owner_id")
    if owner!=nil {return map_geometry(ui_route(owner))}
    let cached=route_get(candidate,"map_geometry_cache")
    if cached!=nil {return cached}
    let geometry=map_geometry_uncached(candidate)
    candidate.map_geometry_cache=geometry
    return geometry
}
fn map_geometry_uncached(candidate){
    let paths = [] let omitted = 0
    if candidate == nil || !candidate.segments.is_array() { return {paths: paths omitted: omitted} }
    for segment in candidate.segments {
        let geometries = []
        let direct = map_polyline(route_get(segment, "polyline"))
        if direct != nil { geometries.push(direct) } elif route_get(segment, "polyline") != nil { omitted += 1 }
        for part in [route_get(segment, "walking") route_get(segment, "taxi")] {
            let line = map_polyline(route_get(part, "polyline"))
            if line != nil { geometries.push(line) } elif route_get(part, "polyline") != nil { omitted += 1 }
            let steps = route_get(part, "steps")
            if steps.is_array() { for step in steps {
                let line = map_polyline(route_get(step, "polyline"))
                if line != nil { geometries.push(line) } elif route_get(step, "polyline") != nil { omitted += 1 }
            } }
        }
        let lines = route_get(route_get(segment, "bus"), "buslines")
        if lines.is_array() { for line in lines {
            let polyline = map_polyline(route_get(line, "polyline"))
            if polyline != nil { geometries.push(polyline) } elif route_get(line, "polyline") != nil { omitted += 1 }
        } }
        if geometries.len() == 0 { omitted += 1 }
        for line in geometries {
            // 仅去掉相邻分段共有的端点；不跨缺口补线，保留供应商全部折线。
            let points = line.split(";")
            let last = if paths.len() > 0 { paths[paths.len()-1].split(";") } else { [] }
            if last.len() > 0 && last[last.len()-1] == points[0] {
                let tail = [] for index point in points { if index > 0 { tail.push(point) } }
                paths[paths.len()-1] += ";" + text_join(tail, ";")
            } else { paths.push(line) }
        }
    }
    return {paths: paths omitted: omitted}
}
fn text_join(values, separator){ let text = "" for value in values { if text != "" { text += separator } text += value } return text }
// 索引对应最终相接合并后的真实折线，不能拿原segments下标代替。
fn map_geometry_owner(candidate){
 let owner=route_get(candidate,"geometry_owner_id")
 if owner!=nil {return map_geometry_owner(ui_route(owner))}
 return candidate
}
fn route_map_metadata(candidate){
 let owner=map_geometry_owner(candidate) let catalog=route_get(owner,"map_paths_cache")
 return {catalog_status:if catalog==nil {"not_loaded"} else {"ready"} path_count:if catalog==nil {nil} else {catalog.len()} max_paths_per_image:4}
}
fn map_path_catalog(candidate){
 let owner=map_geometry_owner(candidate) let cached=route_get(owner,"map_paths_cache")
 if cached!=nil {return cached}
 let result=[]
 for index line in map_geometry(owner).paths {let points=line.split(";") result.push({index:index point_count:points.len() start:points[0] end:points[points.len()-1]})}
 owner.map_paths_cache=result ui_facts_revision+=1
 return result
}
fn selected_map_geometry(candidate, indices){
 let geometry=map_geometry(candidate)
 map_path_catalog(candidate)
 if indices==nil {return {paths:geometry.paths omitted:geometry.omitted total:geometry.paths.len() selected:false error:nil}}
 if !indices.is_array() {return {paths:[] omitted:geometry.omitted total:geometry.paths.len() selected:true error:"path_indices需要实际折线索引数组"}}
 let paths=[]
 for index in indices {
  if !index.is_number() || index%1!=0 || index<0 || index>=geometry.paths.len() {return {paths:[] omitted:geometry.omitted total:geometry.paths.len() selected:true error:"本次路线不存在所选折线索引；请按当前map_paths目录选择"}}
  paths.push(geometry.paths[index])
 }
 return {paths:paths omitted:geometry.omitted total:geometry.paths.len() selected:true error:nil}
}
fn static_map_params(candidate, camera){return static_map_params_selected(candidate,camera,nil)}
fn static_map_params_selected(candidate, camera, indices){
    let markers = [] let paths = [] let omitted = 0
    if candidate != nil {
        if route_point(route_get(candidate, "requested_origin")) != nil { markers.push(route_get(candidate, "requested_origin")) }
        if route_point(route_get(candidate, "requested_destination")) != nil { markers.push(route_get(candidate, "requested_destination")) }
        let geometry = selected_map_geometry(candidate,indices)
        if geometry.error!=nil {return {params:"" markers:[] paths:[] omitted:geometry.omitted error:geometry.error selected:true total:geometry.total}}
        paths = geometry.paths omitted = geometry.omitted
        if geometry.selected {markers=[] if paths.len()>0 {let first=paths[0].split(";") let last=paths[paths.len()-1].split(";") markers=[first[0] last[last.len()-1]]}}
    }
    let params = "&size=640*320&scale=1"
    if camera != nil {
        params = "&size=" + camera.source_width + "*" + camera.source_height + "&scale=1&location=" + (camera.center_lon + "," + camera.center_lat).url_encode() + "&zoom=" + camera.zoom
    }
    if markers.len() > 0 { let styles = [] for index marker in markers { let label = "A" if index == 1 || indices==nil && route_point(route_get(candidate, "requested_origin")) == nil { label = "B" } styles.push("mid,0x345D4A," + label + ":" + marker) } params += "&markers=" + text_join(styles, "|").url_encode() }
    if paths.len() > 0 { let encoded = [] for path in paths { encoded.push("4,0x345D4A,1,,:" + path) } params += "&paths=" + text_join(encoded, "|").url_encode() }
    return {params: params markers: markers paths: paths omitted: omitted error:nil selected:indices!=nil}
}
// 每幅地图持有独立目标、请求和代际；供应商字节不由模型提供。
let map_slots = {}
let map_generation = 0
let ui_render_generation = 0
fn invalidate_map(){ map_generation += 1 for id slot in map_slots { slot.request += 1 slot.bytes = nil slot.state = "stale" slot.status = "地图数据已过期" trace_map("map_stale",slot) } }
fn map_candidate(target){
    if target == "destination" && destination_record != nil { return {id: "destination:" + destination_record.id segments: [] requested_origin: nil requested_destination: coord_text(destination_record)} }
    if target == "preview" && picker_preview_poi != nil { return {id: "preview:" + picker_preview_poi.id segments: [] requested_origin: nil requested_destination: coord_text(picker_preview_poi)} }
    return ui_route(target)
}
fn map_slot_current(slot, token, request, target_id){
    return token == run_id && slot.generation == map_generation && map_slots[slot.id] == slot && slot.request == request && route_get(map_candidate(slot.target), "id") == target_id
}
fn register_map(widget, target, status_widget, interactive){register_map_paths(widget,target,status_widget,interactive,nil)}
fn register_map_paths(widget,target,status_widget,interactive,indices){register_map_block(widget,target,status_widget,interactive,indices,"__document")}
fn register_map_block(widget,target,status_widget,interactive,indices,block_id){
    let key=block_map_key(block_id,widget)
    let slot = map_slots[key]
    if slot == nil || slot.target != target || slot.interactive != (interactive == true) || route_get(slot,"path_indices").to_json()!=indices.to_json() {
        slot = {id:key widget:widget block_id:block_id target: target path_indices:indices interactive: interactive == true camera: nil generation: map_generation request: 0 state: "new" status: "地图待加载" bytes: nil target_id: "" caption: "" handle: nil handle_generation: -1 loaded_generation: -1 loaded_request: -1 status_widget: status_widget}
        map_slots[key] = slot
    }
    slot.status_widget = status_widget
    trace_map("map_registered",slot)
    load_interface_map()
    update_map_widget(slot)
}
fn load_route_map(candidate){ load_interface_map() }
fn load_interface_map(){
    for id slot in map_slots {
        let candidate = map_candidate(slot.target)
        if candidate == nil { slot.request += 1 slot.bytes = nil slot.target_id = "" slot.state = "stale" slot.status = "地图引用已过期" trace_map("map_stale",slot) }
        elif slot.target_id != candidate.id || slot.generation != map_generation || slot.state == "new" || slot.state == "stale" {
            slot.request += 1 slot.generation = map_generation slot.target_id = candidate.id slot.bytes = nil
            slot.caption = if slot.target == "viewed" { "跟随查看：" } else { "绑定目标：" }
            if slot.path_indices!=nil {slot.caption += "所选折线 " + slot.path_indices.to_json() + "；"}
            slot.caption += if slot.target == "destination" { destination_record.name } elif slot.target == "preview" { picker_preview_poi.name } else { route_kind_label(candidate) + " · " + duration_text(candidate.duration_seconds) + " · " + money_text(candidate.price_cents) }
            slot.state = "loading" slot.status = "地图加载中"
            trace_map("map_loading",slot)
            let current = slot let route = candidate
            start_timeout(0.01, || { if current.interactive {fit_map_slot(current, route)} else {load_map_slot(current, route)} })
        }
    }
}
fn fit_map_slot(slot, candidate){
    if map_slots[slot.id] != slot || slot.generation != map_generation || slot.target_id != candidate.id {return}
    let points = []
    let geometry=selected_map_geometry(candidate,slot.path_indices)
    if geometry.error!=nil {map_slot_fail(slot,geometry.error) return}
    if !geometry.selected {for value in [route_get(candidate, "requested_origin") route_get(candidate, "requested_destination")] {
        let point = route_point(value) if point != nil {points.push(point)}
    }}
    for line in geometry.paths {for value in line.split(";") {let point=route_point(value) if point!=nil {points.push(point)}}}
    if points.len()==0 {map_slot_fail(slot,"没有可核实几何或端点；此图不可用") return}
    let bounds={west:points[0].lon east:points[0].lon south:points[0].lat north:points[0].lat}
    for point in points {
        if point.lon<bounds.west {bounds.west=point.lon} if point.lon>bounds.east {bounds.east=point.lon}
        if point.lat<bounds.south {bounds.south=point.lat} if point.lat>bounds.north {bounds.north=point.lat}
    }
    try {map_widget(slot).set_visible(true) map_widget(slot).fit_bounds(bounds.west,bounds.south,bounds.east,bounds.north)}
    {map_slot_fail(slot,"交互地图控件初始化失败")}
}
fn map_camera_changed(event){
    let slot=map_slots[event.widget]
    if slot==nil || !slot.interactive {return}
    let candidate=map_candidate(slot.target) if candidate==nil {return}
    // camera/request由原生控件产生；父应用只绑定本次路线与网络响应。
    if slot.camera!=nil && event.request<=slot.camera.request {return}
    let width=event.width let height=event.height
    let scale=1.0 if width>1024 {scale=1024/width} if height*scale>1024 {scale=1024/height}
    let camera={center_lon:event.center_lon center_lat:event.center_lat zoom:event.zoom width:width height:height source_width:floor(width*scale) source_height:floor(height*scale) request:event.request}
    slot.camera=camera slot.request+=1 slot.bytes=nil slot.state="loading" slot.status="地图视口更新中"
    trace_map("map_camera",slot)
    update_map_widget(slot)
    let current=slot let route=candidate let request=slot.request
    start_timeout(0.01,||{if current.request==request {load_map_slot(current,route)}})
}
fn map_slot_fail(slot, text){ slot.state = "error" slot.status = text slot.bytes = nil trace_map("map_error",slot) update_map_widget(slot) }
fn load_map_slot(slot, candidate){
    let token = run_id let request = slot.request let target_id = candidate.id
    if !map_slot_current(slot, token, request, target_id) { return }
    let geometry = static_map_params_selected(candidate, slot.camera,slot.path_indices)
    if geometry.error!=nil {map_slot_fail(slot,geometry.error) return}
    if geometry.markers.len() == 0 { map_slot_fail(slot, "没有可核实端点；此图不可用") return }
    let detail = if geometry.selected {"本图分段端点，非全行程起终点；仅所选真实折线，缺口不补直线"} else {"路线概览；缺失几何不补直线"}
    if geometry.paths.len() == 0 { detail = "仅端点：供应商未提供可展示几何" }
    elif geometry.omitted > 0 { detail += "；供应商另有缺失几何未展示" }
    let private = nil try { let config = read_text("private-config.json") if config != nil { private = config.parse_json() } } { map_slot_fail(slot, "地图配置无效") return }
    let key = route_get(private, "amap_api_key")
    if !key.is_string() || key.trim() == "" { map_slot_fail(slot, "尚未配置地图服务") return }
    trace_emit("map_request",{widget:slot.id target_id:target_id request:request params:geometry.params},nil)
    let waiting = {settled: false}
    try {
        net.http_request(net.HttpRequest{url: "https://restapi.amap.com/v3/staticmap?key=" + key.url_encode() + geometry.params method: net.HttpMethod.GET}) do net.HttpEvents{
            on_response: |res| {
                if waiting.settled { return } waiting.settled = true
                if !map_slot_current(slot, token, request, target_id) { return }
                if res.status_code != 200 { map_slot_fail(slot, "此图服务HTTP " + res.status_code + "；其它图和行程保留") return }
                let bytes = res.body
                trace_emit("map_response",{widget:slot.id request:request status:res.status_code bytes:bytes.len()},nil)
                start_timeout(0.01, || accept_map_slot(slot, bytes, token, request, target_id, detail))
            }
            on_error: |err| { if waiting.settled { return } waiting.settled = true  if map_slot_current(slot, token, request, target_id) { map_slot_fail(slot, "此图网络失败；其它图和行程保留") } }
        }
    } { waiting.settled = true  if map_slot_current(slot, token, request, target_id) { map_slot_fail(slot, "此图派发未完成；其它图和行程保留") } }
}
fn accept_map_slot(slot, bytes, token, request, target_id, detail){
    if !map_slot_current(slot, token, request, target_id) { return false }
    // 静态地图也会以 HTTP 200 返回业务错误 JSON，不能把它标为图片成功。
    let error = nil try { error = bytes.to_string().parse_json() } {}
    if error != nil && route_get(error, "status") != nil {
        map_slot_fail(slot, "地图服务未返回图片（" + route_get(error, "infocode") + "）：" + route_get(error, "info")) return false
    }
    slot.bytes = bytes slot.state = "ready" slot.status = "高德地图 © AutoNavi；" + detail trace_map("map_ready",slot) update_map_widget(slot)
    return true
}


fn view_route(id){
    for candidate in candidates { if candidate.id == id { map_path_catalog(candidate) viewed_route_id = id ui_facts_revision+=1 load_interface_map() render_content() return } }
}

fn open_destination_picker(){
    if user_limits == nil { show_status("请先提供行程分钟数与预算") return }
    picker_preview_poi = nil
    picker_open = true picker_status = "输入地点名称；可跨城市搜索" picker_pois = []
    render_content()
}
fn close_destination_picker(){ picker_request += 1 picker_open = false picker_preview_poi = nil load_route_map(viewed_route()) render_content() }
fn preview_user_place(id){
    for poi in picker_pois { if poi.id == id { picker_preview_poi = poi load_route_map({id: "preview:" + poi.id segments: [] requested_origin: nil requested_destination: coord_text(poi)}) render_content() return } }
}
fn search_user_places(){ search_places_text(ui.place_query.text()) }
fn search_places_text(text){
    if !text.is_string() { picker_status = "地点查询需要文字" render_content() return }
    let query = text.trim()
    if query == "" { picker_status = "请输入地点名称" render_content() return }
    picker_request += 1 let request = picker_request let token = run_id let at = time_now()
    picker_status = "正在搜索地点" picker_pois = [] picker_preview_poi = nil invalidate_map() render_content()
    let city = ""
    if position_record != nil && route_get(position_record, "citycode").is_string() { city = "&city=" + position_record.citycode.url_encode() }
    // 用户搜索独立于自动机场发现，不删150104业务校验。
    user_place_request("&citylimit=false&extensions=all&children=1" + city + "&keywords=" + query.url_encode(), token, request, fn(data){
        if token != run_id || request != picker_request || !picker_open { return }
        picker_pois = parse_pois(data, at, false)
        picker_status = "请选择名称、地址与城市吻合的地点；航站楼入口仍需核验"
        if picker_pois.len() == 0 { picker_status = "没有可核实的地点结果，请换关键词" }
        render_content()
    })
}
fn user_place_request(params, token, request, done){
    let config = read_text("private-config.json") let private = nil
    try { if config != nil { private = config.parse_json() } } { picker_status = "本机地图配置无效" render_content() return }
    let key = route_get(private, "amap_api_key")
    if !key.is_string() || key.trim() == "" { picker_status = "本机尚未配置地点服务" render_content() return }
    let settled = {value: false}
    start_timeout(0.01, || {
        if token != run_id || request != picker_request {  return }
        try {
            net.http_request(net.HttpRequest{url: "https://restapi.amap.com/v3/place/text?key=" + key.url_encode() + params method: net.HttpMethod.GET}) do net.HttpEvents{
                on_response: |res| {
                    if settled.value { return } settled.value = true
                    if token != run_id || request != picker_request { return }
                    try { if res.status_code != 200 { picker_status = "地点服务暂不可用" render_content() return } let data = res.body.to_string().parse_json() if "" + route_get(data, "status") != "1" { picker_status = "地点服务未返回有效结果" render_content() return } done(data) } { picker_status = "地点响应无效，行程未改动" render_content() }
                }
                on_error: |err| { settled.value = true  if token == run_id && request == picker_request { picker_status = "地点网络失败，行程未改动" render_content() } }
            }
        } { settled.value = true  picker_status = "地点请求未能启动" render_content() }
    })
}
fn apply_user_poi(){
    if pending_user_poi == nil || !position_current(position_record) { return false }
    let poi = pending_user_poi
    if time_now() - poi.queried_at > 300 || poi.city_metadata == nil || position_record.currency != "CNY" { fail_task("所选地点已过期或城市计价依据不足，请重新选择") return true }
    if user_limits == nil || (user_limits.currency != "unspecified" && user_limits.currency != "CNY") { fail_task("用户预算币种尚未核实为人民币") return true }
    poi.city = poi.city_metadata.city poi.citycode = poi.city_metadata.citycode poi.adcode = poi.city_metadata.adcode poi.currency = poi.city_metadata.currency
    if !(user_limits.minutes >= 1 && user_limits.minutes <= (9007199254740991 - received_at) / 60 && user_limits.minutes % 1 == 0 && user_limits.budget_cents >= 0 && user_limits.budget_cents <= 9007199254740991 && user_limits.budget_cents % 1 == 0) { fail_task("用户时限或预算无法安全计算，未采用地点") return true }
    arrive_by = received_at + user_limits.minutes * 60
    constraints = {airport: poi.name terminal: "" minutes: user_limits.minutes budget_cents: user_limits.budget_cents currency: "CNY" destination_query: poi.name objective: "min_cost" departure_scene: "" inferred: false user_selected: true currency_basis: "起终点城市已核实，按高德人民币计价"}
    destination_record = poi
    source_records.push({id: "user-poi-" + poi.id kind: "user" source: "user-poi-selection" mock: false raw: poi.to_json() source_time: "" + poi.queried_at read_at: time_now()})
    observe("user_destination", {destination: poi source: "explicit-user-poi" terminal_verified: false})
    return true
}


// Maps取消未改变业务对象；新渲染事件使用当前标识，旧已排队事件仍被拒绝。





fn destination_label(){
    if destination_record == nil { return "选择或纠正目的地" }
    let basis = "根据来源核实"
    if route_get(constraints, "user_selected") == true { basis = "你选择的地点；航站楼未核实" }
    elif route_get(constraints, "inferred") == true { basis = "根据位置推断；航站楼未知" }
    return destination_record.name + " · " + basis
}



fn candidate_text(candidate){
    let selected = "查看"
    if candidate.id == viewed_route_id { selected = "当前查看" }
    return selected + " · " + route_kind_label(candidate) + " · " + money_text(candidate.price_cents) + " · " + duration_text(candidate.duration_seconds)
}
fn candidate_details(candidate){
    let check = route_recheck(candidate, time_now(), arrive_by, route_get(constraints, "budget_cents"))
    let text = check.reason + "。"
    if candidate.duration_seconds != nil { text += "预计到达 " + beijing_clock(check.estimated_arrival_ts) + "。" }
    text += route_description(candidate)
    return text
}

fn field_present(obj, key){
    for k v in obj { if "" + k == key { return true } }
    return false
}
fn note_value(raw, key){
    let prefix = key + ": "
    for line in raw.split("\n") { if line.search(prefix) == 0 { return line.strip_prefix(prefix).trim() } }
    return ""
}
fn show_status(text){ if runtime_status!=text {ui_facts_revision+=1} runtime_status = text render_content() }

fn remember_source(path, raw){
    source_snapshots.push({path: path raw: raw kind: "file"})
}
fn sources_current(){
    // 来源工具负责读取与校验；UI投影使用本轮已取得资料，不后台重读文件。
    return position_current(position_record)
}
fn render_content(){
    ui.feedback.render() ui.control.render() ui.answer_area.render()
    if !generated_area_ready {ui.generated_area.render() generated_area_ready = true}
    ui.generated_area.set_visible(generated_active && (answer_text == "" || generated_render_complete))
    let overlay_open=false for block in overlay_blocks {if block_actual_visible(block) && block.installed {overlay_open=true}}
    ui.content.set_visible(!overlay_open)
    for block in ui_blocks {set_block_visibility(block)}
    start_timeout(0.01, || {refresh_generated_facts() return true})
    return true
}
fn fail_task(text){
 show_status(text)
 if active_tool != nil { agent_tool_result({success:false error:text}) }
 else { agent_active = false phase = "failed" render_content() }
}
fn observe(tool, data){
    ui_facts_revision+=1
    observations.push({tool: tool observed_at: time_now() data: data})
}
fn mark_tool_used(name){
    for item in used_tools { if item == name { return true } }
    used_tools.push(name)
    return true
}

fn current_task(token){ return token == run_id && agent_active }
fn read_text(path){
 let started=time_now() let value=read_text_unmeasured(path)
 if render_probe!=nil && render_probe.active {render_probe.reads+=1 render_probe.read_seconds+=time_now()-started}
 return value
}
fn read_text_unmeasured(path){
    if !fs.exists(path) { return nil }
    let text = fs.read(path)
    if !text.is_string() { return nil }
    return text
}
fn leap_year(year){ return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0) }
fn calendar_epoch(line){
    let value = ""
    let offset = 0
    if line.search("DTSTART;TZID=Asia/Shanghai:") == 0 {
        value = line.strip_prefix("DTSTART;TZID=Asia/Shanghai:") offset = 28800
        if regex("Z$", "").test(value) { return nil }
        value += "Z"
    } elif line.search("DTSTART:") == 0 {
        value = line.strip_prefix("DTSTART:")
        if !regex("Z$", "").test(value) { return nil }
    } else { return nil }
    let matched = regex("^([0-9]{4})([0-9]{2})([0-9]{2})T([0-9]{2})([0-9]{2})([0-9]{2})Z$", "").exec(value)
    if matched == nil { return nil }
    let c = matched.captures
    let year = c[1].to_f64() let month = c[2].to_f64() let day = c[3].to_f64()
    let hour = c[4].to_f64() let minute = c[5].to_f64() let second = c[6].to_f64()
    if !(year >= 1970 && year <= 2100 && month >= 1 && month <= 12 && hour <= 23 && minute <= 59 && second <= 59) { return nil }
    let month_days = [31 28 31 30 31 30 31 31 30 31 30 31]
    if leap_year(year) { month_days[1] = 29 }
    if !(day >= 1 && day <= month_days[month - 1]) { return nil }
    let days = day - 1
    for i in year - 1970 { if leap_year(1970 + i) { days += 366 } else { days += 365 } }
    for i in month - 1 { days += month_days[i] }
    return days * 86400 + hour * 3600 + minute * 60 + second - offset
}
fn calendar_tool(){
    let raw = read_text("demo/calendar.ics")
    if raw == nil { return false }
    remember_source("demo/calendar.ics", raw)
    calendar_events = []
    let event = nil
    let normalized = raw.replace(regex("\r", "g"), "").replace(regex("\n[ \t]", "g"), "")
    for line in normalized.split("\n") {
        if line == "BEGIN:VEVENT" { event = {id: "" starts_at: "" starts_at_unix: 0 updated_at: "" summary: "" location: "" raw: "" mock: true source: "simulated-calendar"} }
        if event != nil {
            event.raw += line + "\n"
            if line.search("UID:") == 0 { event.id = line.strip_prefix("UID:") }
            if line.search("DTSTART") == 0 { event.starts_at = line event.starts_at_unix = calendar_epoch(line) }
            if line.search("DTSTAMP:") == 0 { event.updated_at = line.strip_prefix("DTSTAMP:") }
            if line.search("SUMMARY:") == 0 { event.summary = line.strip_prefix("SUMMARY:") }
            if line.search("LOCATION:") == 0 { event.location = line.strip_prefix("LOCATION:") }
            if line == "END:VEVENT" {
                if event.id == "" || event.starts_at == "" || !event.starts_at_unix.is_number() { return false }
                calendar_events.push(event)
                source_records.push({id: event.id kind: "calendar" source: event.source mock: true source_time: event.updated_at raw: event.raw read_at: time_now()})
                event = nil
            }
        }
    }
    if calendar_events.len() == 0 || event != nil { return false }
    observe("read_calendar", calendar_events)
    return true
}
fn notes_tool(){
    if !fs.exists("demo/notes") { return false }
    note_records = []
    let names = fs.list("demo/notes")
    if !names.is_array() { return false }
    source_snapshots.push({path: "demo/notes" raw: names.to_json() kind: "directory"})
    for name in names {
        if regex("[.]md$", "").test(name) {
            let raw = read_text("demo/notes/" + name)
            if raw == nil { return false }
            remember_source("demo/notes/" + name, raw)
            let entry = {id: note_value(raw, "id") event_id: note_value(raw, "event_id") source: note_value(raw, "source") record_status: note_value(raw, "record_status") updated_at: note_value(raw, "updated_at") updated_at_unix: note_value(raw, "updated_at_unix").to_f64() airport: note_value(raw, "airport") terminal: note_value(raw, "terminal") raw: raw mock: true}
            if entry.id == "" || entry.updated_at == "" { return false }
            note_records.push(entry)
            source_records.push({id: entry.id kind: "note" source: entry.source mock: true source_time: entry.updated_at raw: raw read_at: time_now()})
        }
    }
    if note_records.len() == 0 { return false }
    observe("read_notes", note_records)
    return true
}
fn position_tool(){
    let raw = read_text("demo/location.json")
    if raw == nil { return false }
    let v = raw.parse_json()
    if !v.is_object() || !v.id.is_string() || !v.source.is_string() || v.mock != true || v.coordinate_system != "GCJ-02" { return false }
    if !(v.latitude >= -90 && v.latitude <= 90 && v.longitude >= -180 && v.longitude <= 180) { return false }
    if !(v.sampled_at_unix <= time_now() + 30 && time_now() - v.sampled_at_unix <= 900) { return false }
    remember_source("demo/location.json", raw)
    position_record = {id: v.id source: v.source mock: true sampled_at: v.sampled_at sampled_at_unix: v.sampled_at_unix name: v.name longitude: v.longitude latitude: v.latitude coordinate_system: v.coordinate_system}
    source_records.push({id: v.id kind: "location" source: v.source mock: true source_time: v.sampled_at raw: raw read_at: time_now()})
    return true
}
fn position_current(position){
    if position == nil || !position.sampled_at_unix.is_number() { return false }
    let max_age = 60
    if position.mock == true { max_age = 900 }
    elif position.mock != false || !position.accuracy_m.is_number() || !(position.accuracy_m > 0 && position.accuracy_m <= 100) { return false }
    return position.sampled_at_unix <= time_now() + 30 && time_now() - position.sampled_at_unix <= max_age
}
fn location_mode(){
    let config = read_text("private-config.json")
    if config == nil { return "live" }
    let private = config.parse_json()
    if !private.is_object() { return "invalid" }
    let mode = route_get(private, "location_mode")
    if mode == nil { return "live" }
    if mode == "live" || mode == "demo" { return mode }
    return "invalid"
}
// 高德只接收最多六位小数；保留来源的原始坐标，避免shader的f32舍入。
fn coordinate_six(value){
    let sign = ""
    if value < 0 { sign = "-" value = -value }
    let scaled = value * 1000000 + 0.5
    scaled -= scaled % 1
    let fraction = scaled % 1000000
    let whole = (scaled - fraction) / 1000000
    let fraction_text = "" + fraction
    while fraction_text.len() < 6 { fraction_text = "0" + fraction_text }
    return sign + whole + "." + fraction_text
}
fn location_failure(code){
    if code == "permission_denied" { return "定位权限被拒绝，请在系统设置中允许宿主使用位置后重新规划" }
    if code == "timeout" { return "设备定位超时，请稍后重新规划" }
    if code == "accuracy_insufficient" { return "定位精度不足，需要100米以内的设备定位" }
    if code == "stale_fix" { return "设备位置采样已过期，请重新规划获取位置" }
    if code == "background_not_allowed" { return "请在前台窗口中发起定位" }
    if code == "busy" { return "宿主正在定位，请稍后重新规划" }
    return "设备定位不可用，请检查系统定位服务和宿主授权"
}
fn location_dispatch(args, done){ return host.request("location.get", args, done) }
fn location_cancel_dispatch(args){ host.request("location.cancel", args, fn(r){}) }
fn cancel_pending_location(){
    if pending_location == nil { return }
    let waiting = pending_location
    pending_location = nil waiting.settled = true
    if waiting.timer != nil { stop_timer(waiting.timer) }
    if waiting.request_id.is_number() {
        try { location_cancel_dispatch({request_id: waiting.request_id}) } {}
    }
}
fn live_position(token, done){
    show_status("正在获取设备位置；位置会发送给高德核对坐标与城市")
    let waiting = {settled: false request_id: nil timer: nil}
    pending_location = waiting
    try {
        waiting.request_id = location_dispatch({max_age_seconds: 60 max_accuracy_m: 100}, fn(r){
            if waiting.settled { return }
            waiting.settled = true
            pending_location = nil
            if !current_task(token) { return }
            try {
                if !r.is_ok { fail_task("宿主未允许定位请求，请检查定位授权") return }
                let fix = r.data
                if !fix.is_object() || route_get(fix, "success") != true {
                    fail_task(location_failure(route_get(fix, "code"))) return
                }
                let lat = route_get(fix, "lat") let lon = route_get(fix, "lon")
                let sampled_at = route_get(fix, "sampled_at") let accuracy = route_get(fix, "accuracy_m")
                if route_get(fix, "coordinate_system") != "WGS84" || route_get(fix, "source") != "corelocation" || !lat.is_number() || !lon.is_number() || !(lat >= -90 && lat <= 90 && lon >= -180 && lon <= 180) { fail_task("宿主定位数据格式无效") return }
                let record = {id: "device-location-live" source: "corelocation" mock: false sampled_at: "" + sampled_at sampled_at_unix: sampled_at accuracy_m: accuracy
                    original_longitude: lon original_latitude: lat original_coordinate_system: "WGS84" coordinate_system: "GCJ-02" conversion_source: "amap-coordinate-convert"}
                if !position_current(record) { fail_task("设备位置已过期或定位精度不足，请重新规划") return }
                let input = coordinate_six(lon) + "," + coordinate_six(lat)
                amap_request("/v3/assistant/coordinate/convert", "&locations=" + input + "&coordsys=gps&output=JSON", token, fn(data){
                    let point = route_point(route_get(data, "locations"))
                    if point == nil { fail_task("位置坐标转换失败，不能查询交通路线") return }
                    record.longitude = point.lon record.latitude = point.lat record.converted_at = time_now()
                    verify_position_city(record, token, done)
                })
            } { fail_task("宿主定位响应缺少必要字段") }
        })
    } {
        waiting.settled = true
        pending_location = nil
        if current_task(token) { fail_task("宿主定位请求未能启动，请检查定位能力授权") }
    }
}
// 高德大陆服务使用人民币；行政区元数据不证明供应商一定返回可行路线。
fn amap_city(city, code, adcode, province){
    let metadata = nil
    if code.is_string() && regex("^[0-9]{3,4}$", "").test(code) && adcode.is_string() && regex("^(11|12|13|14|15|21|22|23|31|32|33|34|35|36|37|41|42|43|44|45|46|50|51|52|53|54|61|62|63|64|65)[0-9]{4}$", "").test(adcode) {
        if city.is_string() && city.trim() != "" { metadata = {city: city citycode: code adcode: adcode currency: "CNY"} }
        elif province == "北京市" || province == "上海市" || province == "天津市" || province == "重庆市" { metadata = {city: province citycode: code adcode: adcode currency: "CNY"} }
    }
    return metadata
}
fn verify_position_city(record, token, done){
    amap_request("/v3/geocode/regeo", "&location=" + coordinate_six(record.longitude) + "," + coordinate_six(record.latitude) + "&extensions=base&radius=0&output=JSON", token, fn(city_data){
        let address = route_get(route_get(city_data, "regeocode"), "addressComponent")
        let city = amap_city(route_get(address, "city"), route_get(address, "citycode"), route_get(address, "adcode"), route_get(address, "province"))
        if route_get(address, "country") != "中国" || city == nil { fail_task("位置城市元数据缺失或不在当前高德大陆计价覆盖内，不能确定交通城市与币种") return }
        if !position_current(record) { fail_task("核对城市期间位置已过期，请重新规划") return }
        record.city = city.city record.citycode = city.citycode record.adcode = city.adcode record.currency = city.currency
        record.city_source = "amap-regeo" record.city_checked_at = time_now()
        if record.mock == false { record.name = "设备当前位置（" + city.city + "）" }
        position_record = record
        let raw = record.to_json()
        if record.mock == false { source_snapshots.push({kind: "location" raw: raw}) }
        for source in source_records { if source.kind == "location" && source.id == record.id { source.raw = raw } }
        if record.mock == false { source_records.push({id: record.id kind: "location" source: record.source mock: false source_time: record.sampled_at raw: raw read_at: time_now()}) }
        observe("read_location", record)
        done()
    })
}
fn validate_citations(items){
    if !items.is_array() || items.len() < 2 { return false }
    let calendar_cited = false
    let note_cited = false
    for citation in items {
        if !citation.is_object() || !citation.source_id.is_string() || !citation.quote.is_string() || citation.quote.trim() == "" { return false }
        if citation.quote.search("\n") >= 0 || citation.quote.search("\r") >= 0 || citation.quote.search("\\n") >= 0 || citation.quote.search("\\r") >= 0 { return false }
        let found = false
        for source in source_records {
            if source.id == citation.source_id && source.raw.search(citation.quote) >= 0 {
                found = true
                if source.kind == "calendar" { calendar_cited = true }
                if source.kind == "note" { note_cited = true }
            }
        }
        if !found { return false }
    }
    return calendar_cited && note_cited
}
fn declared_currency(text){
    let value = ""
    let currency_at = text.search("币种") let money_at = text.search("货币")
    let key = "币种"
    if money_at >= 0 && (currency_at < 0 || money_at < currency_at) { key = "货币" }
    let statements = text.split(key)
    if statements.len() >= 2 {
        let tail = statements[1]
        if tail.search("是") == 0 { tail = tail.strip_prefix("是") }
        elif tail.search("为") == 0 { tail = tail.strip_prefix("为") }
        elif tail.search(":") == 0 { tail = tail.strip_prefix(":") }
        elif tail.search("：") == 0 { tail = tail.strip_prefix("：") }
        let ended = false
        for ch in tail.split("") {
            if ch == "，" || ch == "," || ch == "。" || ch == "；" || ch == ";" || ch == "!" || ch == "?" || ch == "！" || ch == "？" { ended = true }
            if !ended { value += ch }
        }
        value = value.trim()
    }
    let settlements = text.split("结算")
    if settlements.len() >= 2 {
        let prefixes = settlements[0].split("用")
        if prefixes.len() >= 2 {
            let settlement = "" let valid = true
            for ch in prefixes[prefixes.len() - 1].split("") {
                if ch == "，" || ch == "," || ch == "。" || ch == "；" || ch == ";" || ch == "!" || ch == "?" || ch == "！" || ch == "？" { valid = false }
                settlement += ch
            }
            if valid && settlement != "" { value = settlement.trim() }
        }
    }
    let currency = "unspecified"
    if value != "" {
        currency = "unsupported"
        if regex("^(人民币|CNY|RMB)$", "i").test(value) { currency = "CNY" }
        if value == "元" || value == "¥" || value == "￥" { currency = "unspecified" }
    }
    return currency
}
// 首轮明确支持数字分钟与“预算”金额，解析不出的硬约束作为本次缺失返回。
fn explicit_limits(text){
    let compact = text.replace(regex("[ \t]", "g"), "")
    let time_parts = compact.split("分钟")
    let budget_parts = compact.split("预算")
    if time_parts.len() != 2 || budget_parts.len() != 2 { return nil }
    let minute_text = ""
    for ch in time_parts[0].split("") {
        if ch != "" { if regex("^[0-9.]$", "").test(ch) { minute_text += ch } else { minute_text = "" } }
    }
    let amount_text = "" let ended = false
    let budget_text = budget_parts[1].strip_prefix("人民币").strip_prefix("CNY").strip_prefix("RMB").strip_prefix("¥").strip_prefix("￥")
    for ch in budget_text.split("") {
        if ch != "" && !ended { if regex("^[0-9.]$", "").test(ch) { amount_text += ch } else { ended = true } }
    }
    let minutes = route_seconds(minute_text)
    let cents = route_cents(amount_text)
    if minutes == nil || cents == nil || minutes < 1 || minutes > 9007199254740991 / 60 { return nil }
    let currency = "unspecified"
    let tail = budget_text.strip_prefix(amount_text)
    let suffix = "" let suffix_ended = false
    for ch in tail.split("") {
        if ch == "，" || ch == "," || ch == "。" || ch == "；" || ch == ";" || ch == "!" || ch == "?" || ch == "！" || ch == "？" { suffix_ended = true }
        if !suffix_ended { suffix += ch }
    }
    if suffix != "" && suffix != "元" && suffix != "块" && suffix != "块钱" && suffix != "以内" && suffix != "以下" && suffix != "元以内" && suffix != "元以下" { currency = "unsupported" }
    if budget_parts[1].search("人民币") == 0 || budget_parts[1].search("CNY") == 0 || budget_parts[1].search("RMB") == 0 || suffix == "人民币" || suffix == "元人民币" || suffix == "CNY" || suffix == "RMB" { currency = "CNY" }
    if currency == "CNY" && suffix != "" && suffix != "元" && suffix != "人民币" && suffix != "元人民币" && suffix != "CNY" && suffix != "RMB" && suffix != "以内" && suffix != "以下" && suffix != "元以内" && suffix != "元以下" { currency = "unsupported" }
    let declaration = declared_currency(text)
    if declaration != "unspecified" { currency = declaration }
    return {minutes: minutes budget_cents: cents currency: currency}
}
fn reject_constraints(reason){ constraint_error = reason + "；尚未查询路线" return false }
fn set_constraints(p){
    constraint_error = ""
    if !p.is_object() { return reject_constraints("模型约束参数格式无效") }
    if !p.event_id.is_string() || !p.note_id.is_string() { return reject_constraints("模型缺少日历事件或机票笔记引用") }
    if !p.minutes.is_number() || !p.budget_cents.is_number() { return reject_constraints("模型的分钟数或预算格式无效，未改动用户原值") }
    if calendar_events.len() == 0 || note_records.len() == 0 || position_record == nil { return reject_constraints("日历、机票笔记或位置来源缺失") }
    if !position_current(position_record) { return reject_constraints("位置来源已过期或无效，请重新规划") }
    if user_limits == nil {
        return reject_constraints("本次缺少明确的数字分钟数与预算，例如：40分钟内到机场，预算50元。")
    }
    if user_limits.currency != "CNY" && user_limits.currency != "unspecified" { return reject_constraints("高德本次提供人民币估价，不能直接与其它币种预算比较。本次缺少明确的人民币预算和分钟数。") }
    if p.minutes != user_limits.minutes || p.budget_cents != user_limits.budget_cents { return reject_constraints("模型的分钟数或预算与用户明确指令不符，未改动用户原值") }
    if !(p.minutes >= 1 && p.minutes <= (9007199254740991 - received_at) / 60 && p.minutes % 1 == 0) { return reject_constraints("分钟数无法安全计算到达期限") }
    if !(p.budget_cents >= 0 && p.budget_cents <= 9007199254740991 && p.budget_cents % 1 == 0) { return reject_constraints("预算必须为可精确表示的非负整数分") }
    if position_record.currency != "CNY" { return reject_constraints("位置尚未核实人民币计价依据，无法确定预算币种。") }
    if p.currency != "CNY" { return reject_constraints("模型预算币种不是人民币，无法与本次报价比较") }
    if !p.destination_query.is_string() || p.destination_query.trim() == "" { return reject_constraints("模型缺少目的地查询文字") }
    if !validate_citations(p.citations) { return reject_constraints("模型来源引用无效：必须使用来源记录ID及同一行原文") }
    let event_cited = false
    let note_cited = false
    for citation in p.citations { if citation.source_id == p.event_id { event_cited = true } if citation.source_id == p.note_id { note_cited = true } }
    if !event_cited || !note_cited { return reject_constraints("模型未引用所选日历事件及机票笔记") }
    let event_found = false
    for event in calendar_events {
        if event.id == p.event_id && event.starts_at_unix >= received_at { event_found = true }
    }
    if !event_found { return reject_constraints("所选日历事件不存在或出发时间已过") }
    let associated = []
    for note in note_records { if note.event_id == p.event_id && note.record_status == "current" { associated.push(note) } }
    if associated.len() == 0 { return reject_constraints("所选日历事件没有有效的关联机票笔记") }
    let selected_note = nil
    for note in associated { if note.id == p.note_id { selected_note = note } }
    if location_mode() != "demo" { return reject_constraints("模拟日历与机票笔记不能确定真实机场，请查询机场候选") }
    if selected_note == nil || selected_note.airport == "" || selected_note.terminal == "" { return reject_constraints("所选有效机票笔记尚未明确机场及航站楼") }
    if p.destination_query.search(selected_note.airport) < 0 || p.destination_query.search(selected_note.terminal) < 0 { return reject_constraints("模型目的地与已引用的机场或航站楼不符") }
    let scene_conflict = false
    let selected_scene = ""
    if selected_note.raw.search("国内出发") >= 0 { selected_scene = "国内出发" }
    if selected_note.raw.search("国际出发") >= 0 { selected_scene = "国际出发" }
    for note in associated {
        if (note.raw.search("国内出发") >= 0) != (selected_note.raw.search("国内出发") >= 0) || (note.raw.search("国际出发") >= 0) != (selected_note.raw.search("国际出发") >= 0) { scene_conflict = true }
    }
    let user_resolution = false
    let resolved_scene = ""
    for citation in p.citations {
        for source in source_records {
            if source.id == citation.source_id && source.kind == "user" && source.source == "explicit-current-input" && !source.mock && source.raw.search(citation.quote) >= 0 && source.raw.search(selected_note.airport) >= 0 && source.raw.search(selected_note.terminal) >= 0 {
                let source_scene = ""
                if source.raw.search("国内出发") >= 0 && source.raw.search("国际出发") < 0 { source_scene = "国内出发" }
                if source.raw.search("国际出发") >= 0 && source.raw.search("国内出发") < 0 { source_scene = "国际出发" }
                let selected_both = selected_note.raw.search("国内出发") >= 0 && selected_note.raw.search("国际出发") >= 0
                if !scene_conflict || (source_scene != "" && source_scene == selected_scene) || (selected_both && source_scene != "") { user_resolution = true }
                if source_scene != "" && (source_scene == selected_scene || selected_both) { resolved_scene = source_scene }
            }
        }
    }
    for note in associated {
        if note.airport == "" || note.terminal == "" { return reject_constraints("关联机票笔记缺少机场或航站楼，尚不能确定目的地") }
        if !user_resolution && (note.airport != selected_note.airport || note.terminal != selected_note.terminal || (note.raw.search("国内出发") >= 0) != (selected_note.raw.search("国内出发") >= 0) || (note.raw.search("国际出发") >= 0) != (selected_note.raw.search("国际出发") >= 0)) {
            return reject_constraints("日历对应的有效机票笔记存在机场、航站楼或出发区域冲突，尚未确定本次出发地点。")
        }
    }
    let departure_scene = ""
    if selected_note.raw.search("国内出发") >= 0 { departure_scene = "国内出发" }
    if selected_note.raw.search("国际出发") >= 0 { if departure_scene != "" { if resolved_scene == "" { return reject_constraints("机票笔记的国内与国际出发场景冲突，尚未确定出发区域。") } departure_scene = resolved_scene } else { departure_scene = "国际出发" } }
    // 出发区域已由引用笔记核实，模型遗漏时由执行器构造完整查询。
    if departure_scene != "国内出发" && p.destination_query.search("国内出发") >= 0 || departure_scene != "国际出发" && p.destination_query.search("国际出发") >= 0 { return reject_constraints("模型出发区域与有效机票来源矛盾") }
    let destination_query = selected_note.airport + " " + selected_note.terminal
    if departure_scene != "" { destination_query += " " + departure_scene }
    let currency_basis = position_record.city + "已核实为大陆城市；高德人民币计价；未明确币种的预算按地域推断为CNY"
    if user_limits.currency == "CNY" { currency_basis = "用户明确人民币预算；" + position_record.city + "已核实为大陆城市；按高德人民币计价比较" }
    constraints = {airport: selected_note.airport terminal: selected_note.terminal note_id: p.note_id minutes: p.minutes budget_cents: p.budget_cents currency: "CNY" destination_query: destination_query event_id: p.event_id citations: p.citations objective: "min_cost" departure_scene: departure_scene currency_basis: currency_basis inferred: false}
    arrive_by = received_at + p.minutes * 60
    observe("set_constraints", {constraints: constraints received_at: received_at arrive_by: arrive_by})
    return true
}
fn amap_request(path, params, token, done){
    if path != "/v3/place/text" && path != "/v5/direction/transit/integrated" && path != "/v5/direction/driving" && path != "/v5/direction/walking" && path != "/v3/assistant/coordinate/convert" && path != "/v3/geocode/regeo" { fail_task("地图工具路径无效") return }
    let config = read_text("private-config.json")
    if config == nil { fail_task("本机尚未配置地图服务") return }
    let private = config.parse_json()
    if !private.is_object() || !private.amap_api_key.is_string() || private.amap_api_key.trim() == "" { fail_task("本机地图配置无效") return }
    let url = "https://restapi.amap.com" + path + "?key=" + private.amap_api_key.url_encode() + params
    let response_state = {settled: false}
    try {
        net.http_request(net.HttpRequest{url: url method: net.HttpMethod.GET}) do net.HttpEvents{
            on_response: |res| {
                if response_state.settled { return }
                response_state.settled = true
                if !current_task(token) { return }
                try {
                    if res.status_code != 200 { fail_task("地图服务暂时不可用") return }
                    let data = res.body.to_string().parse_json()
                    if !data.is_object() || "" + data.status != "1" { fail_task("地图服务未能返回有效结果，请检查本机配置") return }
                    done(data)
                } { fail_task("地图响应缺少必要字段") }
            }
            on_error: |err| {
                if response_state.settled { return }
                response_state.settled = true
                if current_task(token) { fail_task("网络请求失败，请稍后重新规划") }
            }
        }
    } {
        response_state.settled = true
        if current_task(token) { fail_task("地图请求未能启动") }
    }
}
fn parse_pois(data, at, airports_only){
    let result = []
    let pois = route_get(data, "pois")
    if !pois.is_array() { return result }
    for poi in pois {
        let typecode = route_get(poi, "typecode")
        let location = route_get(poi, "location")
        let entrance = route_get(poi, "entr_location")
        let point = nil let coordinate_basis = "location"
        if airports_only { point = route_point(entrance) if point != nil { coordinate_basis = "entr_location" } }
        if point == nil { point = route_point(location) }
        if point != nil && route_get(poi, "id").is_string() && route_get(poi, "name").is_string() && poi.id != "" && poi.name != "" && (!airports_only || typecode == "150104") {
            let city = amap_city(route_get(poi, "cityname"), route_get(poi, "citycode"), route_get(poi, "adcode"), route_get(poi, "pname"))
            result.push({id: poi.id name: poi.name typecode: typecode type: route_get(poi, "type") parent: route_get(poi, "parent") longitude: point.lon latitude: point.lat coordinate_system: "GCJ-02" coordinate_basis: coordinate_basis source: "amap-poi" address: route_get(poi, "address") queried_at: at returned_at: time_now() city_metadata: city})
        }
    }
    return result
}

fn find_destination(token){
    if constraints == nil { fail_task("目的地约束尚未形成") return }
    if route_get(constraints, "inferred") == true { fail_task("推断机场应选择本次机场查询候选") return }
    let at = time_now()
    if position_record == nil || position_record.currency != "CNY" { fail_task("地点查询缺少已核实的出发城市与币种") return }
    amap_request("/v3/place/text", "&city=" + position_record.citycode.url_encode() + "&citylimit=false&extensions=all&keywords=" + constraints.destination_query.url_encode(), token, fn(data){
        poi_records = parse_pois(data, at, false)
        if poi_records.len() == 0 { fail_task("地点服务未返回可选目的地") return }
        observe("find_destination", poi_records)
        finish_tool_from_state(token)
    })
}
fn reject_destination(reason){ destination_error = reason return false }
fn select_destination(p, reason){
    destination_error = ""
    if constraints == nil { return reject_destination("目的地约束尚未形成，不能选择机场") }
    if destination_record != nil { return reject_destination("本次目的地已选定，输入修正信息后才能重新选择") }
    if !p.is_object() || !route_get(p, "poi_id").is_string() { return reject_destination("目的地选择缺少有效POI标识") }
    for poi in poi_records {
        if poi.id == p.poi_id {
            if route_get(constraints, "inferred") == true {
                if route_get(poi, "typecode") != "150104" { return reject_destination("该地点不是机场类别，不能作为机场推断目标") }
                if regex("暂停营业|停止营业|已关闭|停用", "").test(poi.name) { return reject_destination("该机场地点明确标注暂停营业或已关闭，不能作为本次规划目标") }
                if !reason.is_string() || reason.trim() == "" { return reject_destination("机场推断缺少选择理由，不能说明目的地依据") }
                if !position_current(position_record) { fail_task("机场选择时位置已过期，请重新查询") return true }
                if !poi.queried_at.is_number() || time_now() - poi.queried_at > 300 { fail_task("机场查询结果已过期，请重新查询") return true }
            } else {
                if poi.name.search(constraints.airport) < 0 && (!poi.address.is_string() || poi.address.search(constraints.airport) < 0) { fail_task("目的地名称与地址不足以核实机票机场身份，请明确出发地点") return true }
                if regex("停车|酒店|宾馆|货运|到达", "").test(poi.name) { return reject_destination("所选地点是停车、住宿、货运或到达区域，不是所需出发地点") }
                if poi.name.search(constraints.terminal) < 0 { return reject_destination("所选地点航站楼与机票来源不符") }
                if constraints.departure_scene != "" && poi.name.search(constraints.departure_scene) < 0 { return reject_destination("所选地点的国内或国际出发区域与机票来源不符") }
            }
            if poi.city_metadata == nil { fail_task("目的地城市元数据缺失或不在当前高德大陆计价覆盖内，不能查询交通或确定币种") return true }
            poi.city = poi.city_metadata.city poi.citycode = poi.city_metadata.citycode poi.adcode = poi.city_metadata.adcode poi.currency = poi.city_metadata.currency
            constraints.currency_basis += "；终点" + poi.city + "已核实为大陆城市"
            if route_get(constraints, "inferred") == true {
                constraints.airport = poi.name constraints.destination_query = poi.name
                constraints.inference = {kind: "location_and_airport_query" reason: reason location_source: position_record.id location_sampled_at: position_record.sampled_at_unix origin_city: position_record.city poi_id: poi.id poi_source: poi.source poi_queried_at: poi.queried_at terminal_verified: false}
            }
            destination_record = poi observe("select_destination", {destination: poi inferred: route_get(constraints, "inferred") inference: route_get(constraints, "inference")}) return true
        }
    }
    return reject_destination("目的地ID不属于本次可选地点查询结果")
}

fn coord_text(position){ return "" + position.longitude + "," + position.latitude }
fn assign_candidate_ref(candidate){
 candidate_sequence+=1 candidate.id="route_"+run_id+"_"+candidate_sequence candidate.geometry_ref="polyline_"+run_id+"_"+candidate_sequence
}
fn add_candidates(data, driving, at, departure_at, tool){
    let normalized = route_candidates(data, driving, at, arrive_by, constraints.budget_cents, route_later(time_now(), departure_at))
    let response_route = route_get(data, "route")
    if data == nil { response_route = route_get(driving, "route") }
    let requested_origin = coord_text(position_record)
    let requested_destination = coord_text(destination_record)
    let echoed_origin_gap = route_endpoint_gap(route_get(response_route, "origin"), requested_origin)
    let echoed_destination_gap = route_endpoint_gap(route_get(response_route, "destination"), requested_destination)
    let request_bound = echoed_origin_gap != nil && echoed_origin_gap <= 25 && echoed_destination_gap != nil && echoed_destination_gap <= 25
    for candidate in normalized {
        assign_candidate_ref(candidate)
        register_route_stations(candidate.segments)
        candidate.planned_departure_at = departure_at
        candidate.departure_ts = departure_at
        candidate.requested_origin = requested_origin
        candidate.requested_destination = requested_destination
        candidate.request_bound = request_bound
        candidate.actual_origin = route_leg_endpoint(candidate.segments,true)
        candidate.origin_gap_m = route_endpoint_gap(candidate.actual_origin, requested_origin)
        candidate.origin_complete = candidate.origin_gap_m != nil && candidate.origin_gap_m <= 25
        candidate.endpoint_gap_m = route_endpoint_gap(candidate.actual_endpoint, requested_destination)
        candidate.endpoint_complete = candidate.endpoint_gap_m != nil && candidate.endpoint_gap_m <= 25
        let checked = route_recheck(candidate, time_now(), arrive_by, route_get(constraints, "budget_cents"))
        candidate.reason = checked.reason candidate.feasible = checked.passed
        candidates.push(candidate)
        normalize_queried_route(candidate)
    }
    let summarized = []
    // 旧候选已在前次查询观察中；本次只记录新增候选，避免多策略重复放大模型输入。
    for candidate in normalized {
        summarized.push({id: candidate.id kind: candidate.kind duration_seconds: candidate.duration_seconds price_cents: candidate.price_cents currency: candidate.currency feasible: candidate.feasible reason: candidate.reason request_bound: candidate.request_bound origin_complete: candidate.origin_complete endpoint_complete: candidate.endpoint_complete waiting_included: candidate.waiting_included source_ts: candidate.source_ts expires_at: candidate.expires_at waiting_basis: candidate.waiting_basis taxi_wait_verified: candidate.taxi_wait_verified warnings: candidate.warnings})
    }
    observe(tool, summarized)
}
fn minute_boundary(epoch){
    let remaining_seconds = epoch % 60
    if remaining_seconds > 0 { return epoch + 60 - remaining_seconds }
    return epoch
}
// 每条边是一笔完整供应商查询，不截摊原公交票价或全程出租车估价。
fn route_leg_endpoint(segments, first){
    if !segments.is_array() || segments.len()==0 {return nil}
    let segment=if first {segments[0]} else {segments[segments.len()-1]}
    let walking=route_get(segment,"walking")
    let steps=route_get(walking,"steps")
    if !steps.is_array() {steps=[segment]}
    if steps.len()>0 {
        let step=if first {steps[0]} else {steps[steps.len()-1]}
        let line=route_get(step,"polyline") if line.is_object(){line=route_get(line,"polyline")}
        if line.is_string() && line!="" {let points=line.split(";") return if first {points[0]} else {points[points.len()-1]}}
    }
    let lines=route_get(route_get(segment,"bus"),"buslines")
    if lines.is_array() && lines.len()>0 {let line=if first {lines[0]} else {lines[lines.len()-1]} return route_get(route_get(line,if first {"departure_stop"} else {"arrival_stop"}),"location")}
    let taxi=route_get(segment,"taxi")
    return route_get(taxi,if first {"startpoint"} else {"endpoint"})
}
// 一次供应商完整方案是一条可收费leg；steps只展示，不拆摊公交票价。
fn normalize_queried_route(candidate){
    prepare_route_graph()
    let to_ref=if candidate.actual_endpoint!=nil {"destination"} else {nil}
    if !candidate.endpoint_complete && candidate.actual_endpoint!=nil {to_ref="arrival:"+candidate.id register_route_node(to_ref,"供应商路径终点",candidate.actual_endpoint,"amap-route-geometry",nil)}
    let leg={id:"leg:"+candidate.id from_ref:"origin" to_ref:to_ref requested_to_ref:"destination" mode:if candidate.kind=="taxi" {"taxi"} else {"transit"} departure_ts:candidate.departure_ts duration_seconds:candidate.duration_seconds price_cents:candidate.price_cents price_basis:candidate.price_basis waiting_included:candidate.waiting_included source_ts:candidate.source_ts requested_origin:candidate.requested_origin requested_destination:candidate.requested_destination actual_origin:candidate.actual_origin actual_endpoint:candidate.actual_endpoint request_bound:candidate.request_bound origin_complete:candidate.origin_complete endpoint_complete:candidate.actual_endpoint!=nil segments:candidate.segments warnings:candidate.warnings}
    candidate.legs=[leg] candidate.node_ref=to_ref candidate.completion_status=if candidate.actual_endpoint==nil {"unknown"} elif candidate.endpoint_complete {"reached_requested_destination"} else {"incomplete"}
    candidate.known_cost_cents=if candidate.price_cents!=nil {candidate.price_cents} else {0}
    candidate.cost_complete=candidate.price_cents!=nil candidate.duration_complete=candidate.duration_seconds!=nil
    candidate.connection_verified=candidate.origin_complete && candidate.endpoint_complete
    candidate.earliest_arrival_ts=if candidate.duration_seconds!=nil {candidate.departure_ts+candidate.duration_seconds} else {candidate.departure_ts}
}
fn route_as_prefix(candidate){
    return {id:candidate.id node_ref:candidate.node_ref actual_endpoint:candidate.actual_endpoint legs:candidate.legs segments:candidate.segments departure_ts:candidate.departure_ts earliest_arrival_ts:candidate.earliest_arrival_ts known_cost_cents:candidate.known_cost_cents price_cents:candidate.price_cents cost_complete:candidate.cost_complete duration_complete:candidate.duration_complete duration_seconds:candidate.duration_seconds waiting_included:candidate.waiting_included request_bound:candidate.request_bound origin_complete:candidate.origin_complete endpoint_complete:candidate.endpoint_complete connection_verified:route_get(candidate,"connection_verified") source_ts:candidate.source_ts provider_connection_status:route_get(candidate,"provider_connection_status")}
}
fn route_prefix_origin(node, at){
    return {id:"origin" node_ref:node.ref actual_endpoint:coord_text(node) legs:[] segments:[] departure_ts:at earliest_arrival_ts:at known_cost_cents:0 price_cents:0 cost_complete:true duration_complete:true waiting_included:true request_bound:true origin_complete:true endpoint_complete:true source_ts:nil duration_seconds:0 connection_verified:true}
}
fn route_prefix_extend(prefix, leg, id, deadline, budget){
    let gap=route_endpoint_gap(prefix.actual_endpoint,leg.actual_origin)
    if gap==nil || gap>25 || !leg.request_bound || !leg.origin_complete || !leg.endpoint_complete {return {success:false reason:"供应商路段起终点或前后接驳未核实" connection_gap_m:gap leg:leg}}
    let legs=[] let segments=[]
    for item in prefix.legs {legs.push(item)} legs.push(leg)
    for item in prefix.segments {segments.push(item)} for item in leg.segments {segments.push(item)}
    let known=prefix.known_cost_cents if leg.price_cents!=nil {known+=leg.price_cents}
    let complete=prefix.cost_complete && leg.price_cents!=nil
    let duration_complete=prefix.duration_complete && leg.duration_seconds!=nil
    let arrival=leg.departure_ts if leg.duration_seconds!=nil {arrival+=leg.duration_seconds}
    let duration=nil if duration_complete {duration=arrival-prefix.departure_ts}
    let source=leg.source_ts if prefix.source_ts!=nil && prefix.source_ts<source {source=prefix.source_ts}
    let waiting=prefix.waiting_included && leg.waiting_included
    let budget_status=if known>budget {"over_budget"} elif complete {"within_estimate"} else {"unknown"}
    let deadline_status=if arrival>deadline {"over_deadline"} elif !duration_complete || !waiting {"unknown"} else {"within_estimate"}
    return {success:true prefix:{id:id node_ref:leg.to_ref actual_endpoint:leg.actual_endpoint legs:legs segments:segments departure_ts:prefix.departure_ts earliest_arrival_ts:arrival known_cost_cents:known price_cents:if complete {known} else {nil} cost_complete:complete duration_complete:duration_complete duration_seconds:duration waiting_included:waiting request_bound:prefix.request_bound && leg.request_bound origin_complete:prefix.origin_complete endpoint_complete:leg.endpoint_complete connection_verified:true provider_connection_status:if route_get(prefix,"provider_connection_status")=="unknown" || route_get(leg,"provider_connection_status")=="unknown" {"unknown"} else {nil} source_ts:source budget_status:budget_status deadline_status:deadline_status waiting_slack_seconds:deadline-arrival scenario:if waiting && duration_complete {"供应商时刻与耗时估计"} else {"最早到达场景；缺失候车/耗时尚未计入，不能保证后续公交班次"}}}
}
let route_nodes={}
let route_prefixes={}
let route_extension_count=0
fn route_node(ref){return route_nodes[ref]}
fn register_route_node(ref,name,point,source,city){
    let p=route_point(point) if p==nil {return nil}
    let node=route_nodes[ref]
    if node==nil {node={ref:ref name:name longitude:p.lon latitude:p.lat coordinate_system:"GCJ-02" source:source city_metadata:city} route_nodes[ref]=node}
    return node
}
fn register_route_pois(pois){
    for poi in pois {register_route_node("poi:"+poi.id,poi.name,coord_text(poi),poi.source,route_get(poi,"city_metadata"))}
}
fn register_route_stations(segments){
    if !segments.is_array(){return}
    for segment in segments {
        let lines=route_get(route_get(segment,"bus"),"buslines")
        if lines.is_array(){for line in lines {
            let stops=[route_get(line,"departure_stop")]
            let via=route_get(line,"via_stops") if via.is_array(){for stop in via {stops.push(stop)}}
            stops.push(route_get(line,"arrival_stop"))
            for stop in stops {let id=route_get(stop,"id") if id.is_string() && id!="" {register_route_node("stop:"+id,route_get(stop,"name"),route_get(stop,"location"),"amap-transit-stop",nil)}}
        }}
    }
}
fn prepare_route_graph(){
    if position_record==nil || destination_record==nil || constraints==nil {return false}
    let origin=register_route_node("origin",position_record.name,coord_text(position_record),position_record.source,{city:position_record.city citycode:position_record.citycode adcode:position_record.adcode currency:position_record.currency})
    register_route_node("destination",destination_record.name,coord_text(destination_record),destination_record.source,{city:destination_record.city citycode:destination_record.citycode adcode:destination_record.adcode currency:destination_record.currency})
    register_route_pois(poi_records)
    for candidate in candidates {register_route_stations(candidate.segments)}
    if route_prefixes["origin"]==nil {route_prefixes["origin"]=route_prefix_origin(origin,time_now())}
    return true
}
fn route_prefix_facts(prefix){
    let legs=[]
    for leg in prefix.legs {legs.push({id:leg.id from_ref:leg.from_ref to_ref:leg.to_ref mode:leg.mode departure_ts:leg.departure_ts duration_seconds:leg.duration_seconds price_cents:leg.price_cents price_basis:leg.price_basis waiting_included:leg.waiting_included source_ts:leg.source_ts requested_origin:leg.requested_origin requested_destination:leg.requested_destination warnings:leg.warnings quote_ref:route_get(leg,"quote_ref") place_match_basis:route_get(leg,"place_match_basis") provider_connection_status:route_get(leg,"provider_connection_status")})}
    return {id:prefix.id node_ref:prefix.node_ref completion_status:if prefix.node_ref=="destination" {"reached_requested_destination"} else {"incomplete"} requested_destination_ref:"destination" remaining_endpoint_gap_m:if route_nodes["destination"]!=nil {route_endpoint_gap(prefix.actual_endpoint,coord_text(route_nodes["destination"]))} else {nil} full_journey_price_cents:if prefix.node_ref=="destination" {prefix.price_cents} else {nil} incomplete_reason:if prefix.node_ref!="destination" {"仅到真实中间/路径终点；后续连接尚未取得，不能把当前小计当到目的地总价"} else {nil} departure_ts:prefix.departure_ts earliest_arrival_ts:prefix.earliest_arrival_ts known_cost_cents:prefix.known_cost_cents price_cents:prefix.price_cents duration_seconds:prefix.duration_seconds waiting_included:prefix.waiting_included budget_status:route_get(prefix,"budget_status") deadline_status:route_get(prefix,"deadline_status") waiting_slack_seconds:route_get(prefix,"waiting_slack_seconds") scenario:route_get(prefix,"scenario") legs:legs}
}
fn route_graph_facts(){
    let nodes=[] let routes=[]
    for ref node in route_nodes {nodes.push(node)}
    for candidate in candidates {routes.push(query_route_summary(candidate))}
    return {nodes:nodes routes:routes initial_route_id:"origin" coverage:"本次已取得POI/公交停靠站和已查询完整边；Agent选择继续扩展，不代表穷尽现实路线"}
}
fn verify_route_node_city(node,token,done){
    if node.city_metadata!=nil {done() return}
    amap_request("/v3/geocode/regeo","&location="+coord_text(node)+"&extensions=base&radius=0&output=JSON",token,fn(data){
        let a=route_get(route_get(data,"regeocode"),"addressComponent")
        node.city_metadata=amap_city(route_get(a,"city"),route_get(a,"citycode"),route_get(a,"adcode"),route_get(a,"province"))
        if node.city_metadata==nil {fail_task("接驳站城市资料缺失，不能查询公交") return}
        done()
    })
}
fn transit_leg_params(from,to,strategy,departure){
    let china=local_time(departure+28800)
    let hh=""+china.hour let mm=""+china.minute let month=""+china.month let day=""+china.day
    if china.hour<10 {hh="0"+hh} if china.minute<10 {mm="0"+mm} if china.month<10 {month="0"+month} if china.day<10 {day="0"+day}
    return "&origin="+coord_text(from)+"&destination="+coord_text(to)+"&city1="+from.city_metadata.citycode.url_encode()+"&city2="+to.city_metadata.citycode.url_encode()+"&ad1="+from.city_metadata.adcode.url_encode()+"&ad2="+to.city_metadata.adcode.url_encode()+"&strategy="+strategy+"&show_fields=cost,polyline&date="+china.year+"-"+month+"-"+day+"&time="+hh+":"+mm
}
fn extension_legs(data,mode,from,to,at,departure){
    let result=[] let route=route_get(data,"route")
    let options=if mode=="transit" {route_get(route,"transits")} else {route_get(route,"paths")}
    if !options.is_array(){return result}
    let origin_gap=route_endpoint_gap(route_get(route,"origin"),coord_text(from))
    let destination_gap=route_endpoint_gap(route_get(route,"destination"),coord_text(to))
    let bound=origin_gap!=nil && origin_gap<=25 && destination_gap!=nil && destination_gap<=25
    for index option in options {
        let cost=route_get(option,"cost") let segments=route_get(option,if mode=="transit" {"segments"} else {"steps"})
        if !segments.is_array(){segments=[]}
        let price=nil let basis="unknown"
        if mode=="walk" {price=0 basis="步行无交通票价"}
        elif mode=="taxi" && options.len()==1 {price=route_cents(route_get(route,"taxi_cost")) basis="amap-route.taxi_cost；一次完整出租车行程估算，非滴滴实时报价"}
        elif mode=="transit" {
            let has_taxi=false for segment in segments {if route_get(segment,"taxi").is_object(){has_taxi=true}}
            if !has_taxi {price=route_cents(route_get(cost,"transit_fee")) basis="amap-option.cost.transit_fee；本次整段公交报价"}
        }
        let actual_origin=route_leg_endpoint(segments,true) let actual_end=route_leg_endpoint(segments,false)
        let start_gap=route_endpoint_gap(actual_origin,coord_text(from)) let end_gap=route_endpoint_gap(actual_end,coord_text(to))
        let leg_id="leg-"+route_extension_count+"-"+index
        let actual_to_ref=to.ref let pickup_ref=nil
        if actual_origin!=nil {pickup_ref="pickup:"+leg_id register_route_node(pickup_ref,"供应商路径起点（"+from.name+"）",actual_origin,"amap-route-geometry",nil)}
        if actual_end!=nil && (end_gap==nil || end_gap>25) {actual_to_ref="arrival:"+leg_id register_route_node(actual_to_ref,"供应商路径终点（"+to.name+"）",actual_end,"amap-route-geometry",nil)}
        result.push({id:leg_id pickup_ref:pickup_ref requested_to_ref:to.ref requested_endpoint_gap_m:end_gap from_ref:from.ref to_ref:actual_to_ref mode:mode departure_ts:departure source_ts:at requested_origin:coord_text(from) requested_destination:coord_text(to) request_bound:bound actual_origin:actual_origin actual_endpoint:actual_end origin_complete:start_gap!=nil && start_gap<=25 endpoint_complete:actual_end!=nil && (actual_to_ref!=to.ref || end_gap!=nil && end_gap<=25) duration_seconds:route_seconds(route_get(cost,"duration")) price_cents:price price_basis:basis waiting_included:mode!="taxi" segments:segments warnings:if mode=="taxi" {"仅当前交通行驶估计，候车和上下车步行未知；未来出发交通未预测"} else {"按最早场景查询，前序未知等待可能错过本段公交；站点坐标不保证平台/入口衔接"}})
        register_route_stations(segments)
    }
    return result
}
fn register_mixed_candidate(next,to,mode){
    let candidate=route_candidate("mixed-"+next.id,if next.legs.len()>1 {"mixed"} elif mode=="taxi" {"taxi"} elif mode=="walk" {"walking"} else {"public_transit"},next.duration_seconds,next.price_cents,next.source_ts,next.departure_ts,next.actual_endpoint,coord_text(to),next.waiting_included,next.segments)
    candidate.requested_origin=coord_text(route_nodes["origin"]) candidate.requested_destination=coord_text(to) candidate.request_bound=next.request_bound candidate.origin_complete=next.origin_complete
    candidate.node_ref=next.node_ref candidate.completion_status=if next.node_ref=="destination" {"reached_requested_destination"} else {"incomplete"}
    candidate.cost_complete=next.cost_complete candidate.duration_complete=next.duration_complete candidate.earliest_arrival_ts=next.earliest_arrival_ts candidate.connection_verified=next.connection_verified candidate.provider_connection_status=route_get(next,"provider_connection_status")
    candidate.price_basis="逐段完整供应商报价相加"
    candidate.known_cost_cents=next.known_cost_cents candidate.budget_status=next.budget_status candidate.deadline_status=next.deadline_status candidate.waiting_slack_seconds=next.waiting_slack_seconds candidate.legs=next.legs candidate.prefix_id=next.id
    candidate.warnings="逐段完整报价相加；"+next.scenario+"；未知候车不算零，不保证实际费用/准时到达。"
    let check=route_recheck(candidate,time_now(),arrive_by,constraints.budget_cents) candidate.reason=check.reason candidate.feasible=check.passed
    assign_candidate_ref(candidate)
    next.route_id=candidate.id
    candidates.push(candidate) return candidate
}

fn accept_route_extension(prefix,from,to,mode,data,at,departure,token){
    if !current_task(token){return}
    let legs=extension_legs(data,mode,from,to,at,departure)
    let added=[] let routes=[] let rejected=[] let completed=[]
    for leg in legs {
        let joined=route_prefix_extend(prefix,leg,"prefix-"+route_extension_count+"-"+added.len(),arrive_by,constraints.budget_cents)
        if !joined.success {rejected.push({leg_id:leg.id reason:joined.reason connection_gap_m:joined.connection_gap_m pickup_ref:leg.pickup_ref actual_to_ref:leg.to_ref requested_to_ref:leg.requested_to_ref requested_endpoint_gap_m:leg.requested_endpoint_gap_m})}
        else {
            let next=joined.prefix route_prefixes[next.id]=next added.push(route_prefix_facts(next))
            let candidate=register_mixed_candidate(next,route_nodes["destination"],mode)
            routes.push(query_route_summary(candidate))
            if next.node_ref=="destination" {completed.push(candidate.id)}
        }
    }
    trace_emit("route_extension",{from_ref:from.ref to_ref:to.ref mode:mode requested_departure:departure prefixes:added rejected:rejected completed:completed},if active_tool!=nil {active_tool.id} else {nil})
    agent_tool_result({success:true routes:routes completed_candidate_ids:completed rejected:rejected new_nodes:tool_new_nodes()})
}
fn extend_route(p,token){
    if !prepare_route_graph(){fail_task("接驳查询缺少本次起点、目的地或时间预算") return}
    let id=route_get(p,"route_id") let prefix=nil
    if id=="origin" {prefix=route_prefixes["origin"]}
    elif id!=nil {let candidate=ui_route(id) if candidate!=nil {prefix=route_as_prefix(candidate)}}
    else {prefix=route_prefixes[route_get(p,"prefix_id")]}
    let to=route_node(p.to_ref)
    if prefix==nil || to==nil {agent_tool_result({success:false error:"route_id/to_ref不属于本轮真实图；可get_route_graph读取当前节点与前缀"}) return}
    let from=route_node(prefix.node_ref) let mode=p.mode
    if from==nil || prefix.actual_endpoint==nil {agent_tool_result({success:false error:"Route实际终点未知，不能据请求终点继续扩展"}) return}
    if mode!="walk" && mode!="taxi" && mode!="transit" {agent_tool_result({success:false error:"支持walk/taxi/transit完整路段"}) return}
    if from.ref==to.ref {agent_tool_result({success:false error:"起终节点相同，没有新增路段"}) return}
    let strategy=route_get(p,"strategy") if strategy==nil {strategy=0}
    if mode=="transit" {let found=false for value in transit_strategies(){if value==strategy {found=true}} if !found {agent_tool_result({success:false error:"该公交策略需要其它专用输入"}) return}}
    route_extension_count+=1
    let departure=route_later(time_now(),prefix.earliest_arrival_ts) if mode=="transit" {departure=minute_boundary(departure)}
    let at=time_now()
    let query=fn(){
        if !current_task(token){return}
        let params="&origin="+coord_text(from)+"&destination="+coord_text(to)+"&show_fields=cost,polyline"
        let path=if mode=="walk" {"/v5/direction/walking"} elif mode=="taxi" {"/v5/direction/driving"} else {"/v5/direction/transit/integrated"}
        if mode=="taxi" {params+="&strategy=0"} elif mode=="transit" {params=transit_leg_params(from,to,strategy,departure)}
        trace_emit("route_leg_query",{from_ref:from.ref to_ref:to.ref mode:mode departure_at:departure scenario:route_get(prefix,"scenario") path:path params:params},if active_tool!=nil {active_tool.id} else {nil})
        amap_request(path,params,token,fn(data){start_timeout(0.01,||accept_route_extension(prefix,from,to,mode,data,at,departure,token))})
    }
    if mode=="transit" {verify_route_node_city(from,token,fn(){verify_route_node_city(to,token,query)})} else {query()}
}

let didi_places={}
let didi_quotes={}
let didi_record_count=0
fn didi_request(name,arguments,token,done){
    let config=read_text("private-config.json") let key=nil
    if config!=nil {key=route_get(config.parse_json(),"didi_mcp_key")}
    if !key.is_string() || key.trim()=="" {agent_tool_result({success:false error:"滴滴估价服务未配置；其它路线查询仍可继续"}) return}
    let body={jsonrpc:"2.0" id:token method:"tools/call" params:{name:name arguments:arguments}}.to_json()
    trace_emit("didi_request",{name:name body:body},if active_tool!=nil {active_tool.id} else {nil})
    net.http_request(net.HttpRequest{url:"https://mcp.didichuxing.com/mcp-servers?key="+key.url_encode() method:net.HttpMethod.POST headers:{"Content-Type":["application/json; charset=utf-8"] "Accept":["application/json"]} body:body.to_bytes()}) do net.HttpEvents{
        on_response:|res|{
            if !current_task(token){return}
            try {
                if res.status_code!=200 {agent_tool_result({success:false error:"滴滴询价请求失败" http_status:res.status_code}) return}
                let raw=res.body.to_string() trace_emit_run("didi_response",{status:res.status_code body:raw},if active_tool!=nil {active_tool.id} else {nil},token)
                let data=raw.parse_json()
                if route_get(data,"error")!=nil {agent_tool_result({success:false error:"滴滴工具返回错误" code:route_get(data.error,"code")}) return}
                let result=route_get(data,"result")
                if result==nil || route_get(result,"isError")==true {agent_tool_result({success:false error:"滴滴未返回有效工具结果"}) return}
                done(result)
            } {agent_tool_result({success:false error:"滴滴响应格式无法解析"})}
        }
        on_error:|err|{if current_task(token){agent_tool_result({success:false error:"滴滴询价网络请求失败"})}}
    }
}
fn search_didi_places(p,token){
    didi_request("maps_textsearch",{keywords:p.query city:p.city},token,fn(result){
        let content=route_get(result,"content") let records=[]
        if content.is_array() && content.len()>0 {
            let items=content[0].text.parse_json()
            if items.is_array(){for item in items {
                let location=route_get(item,"location")
                if location.is_object() && route_get(location,"lng").is_number() && route_get(location,"lat").is_number() {
                    didi_record_count+=1 let ref="didi-place:"+didi_record_count
                    let record={ref:ref name:route_get(item,"display_name") address:route_get(item,"address_all") city:route_get(item,"city") longitude:location.lng latitude:location.lat coordinate_system:"provider-unspecified" source:"didi-maps_textsearch" queried_at:time_now()}
                    didi_places[ref]=record records.push(record)
                }
            }}
        }
        agent_tool_result({success:true places:records coordinate_warning:"滴滴未声明坐标系；这些点不能冒充高德端点，报价关联须另核连接"})
    })
}
fn quote_didi(p,token){
    let from=didi_places[p.from_ref] let to=didi_places[p.to_ref]
    if from==nil || to==nil {agent_tool_result({success:false error:"起终点必须来自本轮滴滴地点查询ref"}) return}
    let at=time_now()
    didi_request("taxi_estimate",{from_lng:""+from.longitude from_lat:""+from.latitude from_name:from.name to_lng:""+to.longitude to_lat:""+to.latitude to_name:to.name},token,fn(result){
        let structured=route_get(result,"structuredContent") let items=route_get(structured,"items") let quotes=[]
        if items.is_array(){for item in items {
            didi_record_count+=1 let ref="didi-quote:"+didi_record_count let display=route_get(item,"priceText")
            let quote={ref:ref product_name:route_get(item,"productName") product_category:route_get(item,"productCategory") price_text:display price_cents:route_cents(display) discounted_price_text:route_get(item,"priceDiscounted") currency:"CNY" source:"didi-taxi_estimate" quoted_at:at from:from to:to provider_from:route_get(structured,"from") provider_to:route_get(structured,"to") distance_km:route_get(structured,"distanceKm") eta:route_get(structured,"eta") basis:"当前时点估价；不保证未来接驳上车价格；优惠价不默认适用；未下单"}
            didi_quotes[ref]=quote quotes.push(quote)
        }}
        agent_tool_result({success:true quotes:quotes route_attachment:"可attach_quote以明确地点语义对应作为费用估计；不同供应商上下车连接仍未知，不能改写高德几何"})
    })
}

// 派生只替换指定leg的估价；共享的供应商几何不改，原Route保持不变。
fn route_quote_variant(candidate,quote,leg_id,basis){
    let next={} for key value in candidate {next[key]=value}
    let legs=[] let found=false let known=0 let complete=true let waiting=true
    for original in candidate.legs {
        let leg=original
        if original.id==leg_id {
            if original.mode!="taxi" {return {success:false error:"报价只能替换明确taxi leg，不能覆盖公交/步行费用"}}
            found=true leg={} for key value in original {leg[key]=value}
            leg.price_cents=quote.price_cents leg.price_basis="didi-taxi_estimate；指定车型当前估价替换原价，不叠加"
            leg.quote_ref=quote.ref leg.place_match_basis=basis leg.provider_connection_status="unknown" leg.waiting_included=false
            leg.warnings="保留高德几何与耗时；滴滴上下车连接未知；当前价不保证未来接驳价"
        }
        if leg.price_cents==nil {complete=false} else {known+=leg.price_cents}
        waiting=waiting && leg.waiting_included legs.push(leg)
    }
    if !found {return {success:false error:"leg_id不在指定Route中"}}
    assign_candidate_ref(next)
    next.legs=legs next.known_cost_cents=known next.cost_complete=complete next.price_cents=if complete {known} else {nil}
    next.price_basis="逐leg采用当前关联估价；指定滴滴价替换原价" next.waiting_included=waiting next.waiting_basis="driving_only"
    next.derived_from_route_id=candidate.id next.geometry_owner_id=candidate.id next.prefix_id=nil
    next.provider_connection_status="unknown" next.connection_verified=false
    next.warnings=candidate.warnings+"；滴滴价为语义关联估计，上下车连接未知，未下单。"
    next.budget_status=if known>constraints.budget_cents {"over_budget"} elif complete {"within_estimate"} else {"unknown"}
    next.deadline_status=if next.earliest_arrival_ts>arrive_by {"over_deadline"} else {"unknown"}
    let checked=route_recheck(next,time_now(),arrive_by,constraints.budget_cents) next.reason=checked.reason next.feasible=checked.passed
    candidates.push(next)
    return {success:true candidate:next}
}
fn attach_quote(p,token){
    let candidate=ui_route(p.route_id) let quote=didi_quotes[p.quote_ref]
    if candidate==nil || quote==nil {agent_tool_result({success:false error:"route_id/quote_ref必须属于本轮实际记录"}) return}
    if quote.price_cents==nil {agent_tool_result({success:false error:"报价文本无法精确解析为费用，不能当零" quote:quote}) return}
    if !p.place_basis.is_string() || p.place_basis.trim()=="" {agent_tool_result({success:false error:"需要两端名称、城市、地址/入口对应依据；语义关联不是坐标认证"}) return}
    for leg in candidate.legs {if leg.id==p.leg_id {
        let from_node=route_nodes[leg.from_ref] let to_node=route_nodes[leg.to_ref]
        let from_city=route_get(route_get(from_node,"city_metadata"),"city") let to_city=route_get(route_get(to_node,"city_metadata"),"city")
        if from_city!=nil && quote.from.city!=nil && from_city!=quote.from.city || to_city!=nil && quote.to.city!=nil && to_city!=quote.to.city {agent_tool_result({success:false error:"报价与路线节点实际城市不同，不能关联此leg"}) return}
    }}
    let result=route_quote_variant(candidate,quote,p.leg_id,p.place_basis)
    if !result.success {agent_tool_result(result) return}
    let next=result.candidate
    agent_tool_result({success:true route:query_route_summary(next) derived_from_route_id:candidate.id quote_ref:quote.ref original_route_unchanged:true connection_status:"unknown；没有认证滴滴上下车连接"})
}

fn query_route(p,token){
 if p.mode=="transit" {let strategy=route_get(p,"strategy") if strategy==nil {strategy=0} query_transit({strategy:strategy},token)}
 elif p.mode=="taxi" {query_driving(token)}
 else {agent_tool_result({success:false error:"mode支持transit或taxi"})}
}
fn transit_strategies(){ return [0 1 2 3 4 5 7 8] }
fn query_transit(p, token){
    if constraints == nil || position_record == nil || destination_record == nil { fail_task("交通查询缺少起终点") return }
    if !position_current(position_record) { fail_task("出发位置已过期，请重新规划") return }
    if position_record.currency != "CNY" || destination_record.currency != "CNY" || !position_record.citycode.is_string() || !destination_record.citycode.is_string() { fail_task("交通起终点城市或计价依据尚未核实") return }
    let strategy = route_get(p, "strategy")
    if strategy == 6 { fail_task("地铁图模式需要起终点地铁站POI，目前尚未取得") return }
    let valid_strategy = false
    for value in transit_strategies() { if strategy == value { valid_strategy = true } }
    if !strategy.is_number() || !valid_strategy { fail_task("公交策略参数无效，请使用工具列出的普通公交策略") return }
    mark_tool_used("transit:" + strategy)
    transit_count += 1
    let at = time_now()
    // 高德按分钟查询；等待到下一分钟的时间同样计入最初期限。
    let departure_at = minute_boundary(at)
    let china = local_time(departure_at + 28800)
    let hh = "" + china.hour
    let mm = "" + china.minute
    if china.hour < 10 { hh = "0" + hh }
    if china.minute < 10 { mm = "0" + mm }
    let month_text = "" + china.month
    let day_text = "" + china.day
    if china.month < 10 { month_text = "0" + month_text }
    if china.day < 10 { day_text = "0" + day_text }
    let day = "" + china.year + "-" + month_text + "-" + day_text
    let params = "&origin=" + coord_text(position_record) + "&destination=" + coord_text(destination_record) + "&city1=" + position_record.citycode.url_encode() + "&city2=" + destination_record.citycode.url_encode() + "&ad1=" + position_record.adcode.url_encode() + "&ad2=" + destination_record.adcode.url_encode() + "&strategy=" + strategy + "&AlternativeRoute=5&show_fields=cost,polyline&date=" + day + "&time=" + hh + ":" + mm
    amap_request("/v5/direction/transit/integrated", params, token, fn(data){
        add_candidates(data, nil, at, departure_at, "query_transit")
        transit_completed += 1
        finish_tool_from_state(token)
    })
}
fn query_driving(token){
    if constraints == nil || position_record == nil || destination_record == nil { fail_task("驾车查询缺少起终点") return }
    if !position_current(position_record) { fail_task("出发位置已过期，请重新规划") return }
    if position_record.currency != "CNY" || destination_record.currency != "CNY" || !position_record.citycode.is_string() || !destination_record.citycode.is_string() { fail_task("交通起终点城市或计价依据尚未核实") return }
    driving_done = true
    let at = time_now()
    let params = "&origin=" + coord_text(position_record) + "&destination=" + coord_text(destination_record) + "&show_fields=cost,polyline&strategy=0"
    amap_request("/v5/direction/driving", params, token, fn(data){
        add_candidates(nil, data, at, at, "query_driving")
        driving_completed = true
        finish_tool_from_state(token)
    })
}
fn comparison_complete(){ return transit_completed > 0 && transit_completed == transit_count && driving_completed }
fn present_results(reason){
 for candidate in candidates { let check = route_recheck(candidate,time_now(),arrive_by,route_get(constraints,"budget_cents")) candidate.feasible=check.passed candidate.reason=check.reason }
 phase = "proposal" show_status("已计算当前候选；已查范围不代表所有可能路线")
 refresh_generated_facts()
 if active_tool != nil { agent_tool_result({success:true comparison:comparison_summary() routes:model_route_summaries() queried_transit_count:transit_count queried_driving:driving_done}) }
}
fn read_source_tool(name, token, done){
    if (name == "read_calendar" || name == "read_notes") && location_mode() != "demo" { fail_task("当前真实模式未接通日历和笔记来源") return }
    mark_tool_used(name)
    if name == "read_calendar" { if !calendar_tool() { fail_task("日历来源无法读取") return } }
    elif name == "read_notes" { if !notes_tool() { fail_task("笔记来源无法读取") return } }
    elif name == "read_location" {
        let mode = location_mode()
        if mode == "live" { live_position(token, done) return }
        if mode != "demo" { fail_task("定位模式配置无效") return }
        if !position_tool() { fail_task("模拟位置缺失、格式错误或已过期，请重新初始化演示位置") return }
        verify_position_city(position_record, token, done) return
    } else { fail_task("未知来源工具") return }
    done()
}





fn model_protocol(data){
    let count = nil let call_count = nil let choice = nil let message = nil let call = nil
    let choices = route_get(data, "choices")
    if choices.is_array() { count = choices.len() if count > 0 { choice = choices[0] message = route_get(choice, "message") } }
    let calls = route_get(message, "tool_calls")
    if calls.is_array() { call_count = calls.len() if call_count > 0 { call = calls[0] } }
    let function = route_get(call, "function")
    let content = route_get(message, "content")
    let content_bytes = nil
    if content.is_string() { content_bytes = content.len() }
    return {expected_model: route_get(data, "model") == "MiniMax-M3" truncated: route_get(choice, "finish_reason") == "length" choice_count: count tool_count: call_count
        has_content: content.is_string() content_bytes: content_bytes expected_tool: route_get(function, "name").is_string()
        arguments_string: route_get(function, "arguments").is_string()}
}
// 开发记录不进入业务上下文；每个实际入口先固定数据，再在独立入口写文件。
let trace_state = nil

// Development-only first-render evidence: record in memory, export in independent entries.
// Captured objects are references after the attempt, not a frozen pre-render heap.
let render_probe=nil
fn render_probe_mark(stage){if render_probe!=nil && render_probe.active {render_probe.stage=stage render_probe.marks.push({stage:stage at:time_now()})}}
fn render_probe_begin(call,entry_at){
 if trace_state==nil || render_probe!=nil {return}
 let refs=[] let caches=[]
 for candidate in candidates {refs.push(candidate) caches.push({id:candidate.id steps_cached:route_get(candidate,"steps_cache")!=nil geometry_cached:route_get(candidate,"map_geometry_cache")!=nil catalog_cached:route_get(candidate,"map_paths_cache")!=nil})}
 render_probe={active:true run:run_id call_id:call.id entry_at:entry_at stage:"tool_entry" marks:[] candidates:refs cache_before:caches facts_revision:ui_facts_revision cached_revision:ui_facts_cached_revision reads:0 read_seconds:0 reasons:0 current_route:nil dump_complete:false dump_error:false
  context:{origin:position_record destination:destination_record constraints:constraints limits:user_limits received_at:received_at arrive_by:arrive_by source_snapshots:source_snapshots source_records:source_records route_nodes:route_nodes route_prefixes:route_prefixes taxi_quotes:didi_quotes taxi_places:didi_places}}
 let saved=render_probe let directory=trace_state.directory let prefix="first-render-"+run_id
 start_timeout(0.8,||render_probe_export(saved,directory,prefix))
 render_probe_mark("tool_entry")
}
fn render_probe_report(saved){return {run:saved.run call_id:saved.call_id entry_at:saved.entry_at stage:saved.stage marks:saved.marks current_route:saved.current_route reads:saved.reads read_seconds:saved.read_seconds reasons:saved.reasons route_count:saved.candidates.len() cache_before:saved.cache_before facts_revision:saved.facts_revision cached_revision:saved.cached_revision dump_complete:saved.dump_complete dump_error:saved.dump_error heap_basis:"references exported after render attempt; original geometry retained privately" native_budget_age:"not_observed"}}
fn render_probe_export(saved,directory,prefix){
 saved.active=false
 try {fs.write(directory+"/"+prefix+"-stage.json",render_probe_report(saved).to_json())} {saved.dump_error=true}
 start_timeout(0.1,||{
  try {fs.write(directory+"/"+prefix+"-context.json",saved.context.to_json())} {saved.dump_error=true}
  start_timeout(0.1,||render_probe_export_route(saved,directory,prefix,0))
 })
}
fn render_probe_export_route(saved,directory,prefix,index){
 if index>=saved.candidates.len() {saved.dump_complete=!saved.dump_error try {fs.write(directory+"/"+prefix+"-stage.json",render_probe_report(saved).to_json())} {} return}
 try {fs.write(directory+"/"+prefix+"-route-"+index+".json",saved.candidates[index].to_json())} {saved.dump_error=true}
 start_timeout(0.1,||render_probe_export_route(saved,directory,prefix,index+1))
}

let trace_initialized = false
let trace_last_diagnostic = ""
let trace_initialization_error = ""
let trace_enabled = false
let trace_session = ""
fn trace_scrub(text, keys){
    for key in keys {
        if key.is_string() && key != "" {
            let parts = text.split(key) let replaced = ""
            for index part in parts { if index > 0 { replaced += "[REDACTED]" } replaced += part }
            text = replaced
        }
    }
    return text
}
fn trace_status(state){
    return {v:1 format:"jsonl-segments" segments:state.segment session:state.session instance:state.instance run:state.run last_seq:state.written_seq state:if state.incomplete {"incomplete"} else {"recording"} error:if state.incomplete {"记录写入未完成；事件可能缺失"} else {""}}
}
fn trace_identity_json(){
    return {session:trace_session instance:if trace_state!=nil {trace_state.instance} else {nil} run:run_id state:if trace_initialization_error!="" {"incomplete"} elif trace_state!=nil && trace_state.incomplete {"incomplete"} else {"recording"} error:trace_initialization_error}.to_json()
}
fn trace_marker(){
    if !trace_enabled {return}
    try {
        let current=ui.trace_identity.text().parse_json()
        if current.session!=trace_session || current.instance!=if trace_state!=nil {trace_state.instance} else {nil} {return}
        ui.trace_identity.set_text(trace_identity_json())
    } {}
}
fn trace_emit(event, data, call_id){trace_emit_run(event,data,call_id,run_id)}
fn trace_emit_run(event, data, call_id, run){
    if trace_state == nil {return}
    let state = trace_state
    state.seq += 1
    let seq = state.seq
    let envelope = {v:1 session:state.session instance:state.instance run:run seq:seq event:event at:time_now() call_id:call_id data:data.to_json()}.to_json()
    start_timeout(0.01,||{
        try {
            let line=trace_scrub(envelope,state.keys)+"\n"
            let bytes=line.len()
            // 单文件1MiB是实际宿主存储限制；不截断事件或修改宿主配额。
            if bytes>1048576 {state.incomplete=true}
            else {
                if state.segment==0 || state.segment_bytes+bytes>1048576 {state.segment+=1 state.segment_bytes=0}
                let number=""+state.segment while number.len()<6 {number="0"+number}
                fs.append(state.directory+"/segment-"+number+".jsonl",line)
                state.segment_bytes+=bytes
                if seq>state.written_seq {state.written_seq=seq} state.run=run
            }
        } {state.incomplete = true}
        try {fs.write(state.directory + "/status.json",trace_status(state).to_json())} {state.incomplete=true}
        trace_marker()
    })
}
fn trace_initialize(){
    if trace_initialized {return}
    trace_initialized=true
    let config = nil
    try {let text=read_text("private-config.json") if text!=nil {config=text.parse_json()}} {return}
    if route_get(config,"development_trace") != true {return}
    trace_enabled=true
    let session=route_get(config,"development_trace_session")
    if !session.is_string() || session=="" {trace_initialization_error="开发记录会话标识缺失" trace_marker() return}
    trace_session=session
    // 同一宿主UI线程同步分配；旧/新VM各有独立目录，不竞争current文件。
    let counter_path="dev-trace/"+session+"/instance-counter.json"
    let ordinal=nil
    try {let old=read_text(counter_path) if old!=nil {ordinal=old.parse_json().next}} {trace_initialization_error="实例标识读取失败；开发记录不完整" trace_marker() return}
    if !ordinal.is_number() || ordinal<1 || ordinal%1!=0 {trace_initialization_error="实例标识计数缺失或无效；开发记录不完整" trace_marker() return}
    try {fs.write(counter_path,{next:ordinal+1}.to_json())} {trace_initialization_error="实例标识写入失败；开发记录不完整" trace_marker() return}
    let keys=[]
    for name in ["amap_api_key" "didi_mcp_key"] {let key=route_get(config,name) if key.is_string() && key!="" {keys.push(key) keys.push(key.url_encode())}}
    trace_state={session:session instance:"vm-"+ordinal directory:"dev-trace/"+session+"/vm-"+ordinal seq:0 written_seq:0 segment:0 segment_bytes:0 run:run_id incomplete:false keys:keys}
    try {fs.write(trace_state.directory+"/status.json",trace_status(trace_state).to_json())} {trace_state.incomplete=true}
    trace_emit("instance_started",{metadata:route_get(config,"development_trace_metadata")},nil)
}
fn trace_map(event,slot){
    trace_emit(event,{widget:slot.id target:slot.target target_id:slot.target_id state:slot.state status:slot.status request:slot.request generation:slot.generation camera:slot.camera path_indices:route_get(slot,"path_indices")},nil)
}
fn request_finished(record, state){
    record.state = state record.completed_at = time_now()
    record.wall_seconds = record.completed_at - record.started_at
    trace_emit_run("transport_finished",{step:record.step state:state wall_seconds:record.wall_seconds http_status:route_get(record,"http_status")},nil,if route_get(record,"run")!=nil {record.run} else {run_id})
}
fn request_stage(record, stage){
    record.transport_stage = stage record.stage_at = time_now()
    trace_emit_run("transport_stage",{step:record.step stage:stage},nil,if route_get(record,"run")!=nil {record.run} else {run_id})
}
fn minimax_request(task, input, schema, token, record, done){
    request_stage(record, "entry")
    let body = {messages: input tools: schema tool_choice: "auto" thinking: {type: "disabled"}}
    trace_emit_run("model_request",{step:record.step service:"model.chat" body:body.to_json()},nil,token)
    let waiting = {settled: false}
    record.dispatch_started_at = nil record.dispatch_returned_at = nil record.dispatch_returned = false record.http_status = nil
    start_timeout(0.01, || {
        if !request_current(token, record) || waiting.settled { return }
        record.dispatch_started_at = time_now()
        trace_emit_run("model_dispatch",{step:record.step service:"model.chat" started_at:record.dispatch_started_at},nil,token)
        request_stage(record, "before_host")
        try {
            record.host_request_id = host.request("model.chat", body, fn(reply){
                if waiting.settled { return }
                waiting.settled = true
                request_finished(record, if reply.is_ok {"returned"} else {"host_error"})
                // 终止只屏蔽本地迟到结果，不能据此声称远端请求已取消。
                trace_emit_run("model_response",{step:record.step service:"model.chat" is_ok:reply.is_ok body:if reply.is_ok {reply.data.to_json()} else {reply.error} current:request_current(token,record)},nil,token)
                if !request_current(token, record) { return }
                if !reply.is_ok {
                    record.host_error=reply.error
                    let error=if reply.error.is_string() {reply.error} else {""}
                    let message=if error.search("no service answers")>=0 || error.search("there is no model.chat")>=0 {"当前宿主未提供 Navigation 所需的 model.chat 服务"}
                        elif error.search("no_provider:")>=0 {"宿主尚未配置可用的主模型，请在 AI providers 中配置"}
                        elif error.search("rate:")>=0 {"宿主模型调用过于频繁，请稍后重新查询"}
                        elif error.search("budget:")>=0 {"本应用已达到宿主模型额度，请检查宿主配置"}
                        elif error.search("capability:")>=0 {"宿主尚未授权本应用使用模型服务"}
                        else {"宿主模型服务未能完成请求，请稍后重试"}
                    request_failed(record,message) return
                }
                start_timeout(0.01, || {
                    if !request_current(token, record) { return }
                    try {
                        let data=route_get(reply.data,"response")
                        if !data.is_object() {record.state="invalid_response" request_failed(record,"宿主模型响应格式无效，请重新查询") return}
                        let usage=route_get(data,"usage")
                        record.meta={prompt_tokens:route_get(usage,"prompt_tokens") completion_tokens:route_get(usage,"completion_tokens") total_tokens:route_get(usage,"total_tokens")}
                        record.host_meta=route_get(reply.data,"meta") record.protocol=model_protocol(data)
                        request_stage(record,"model_action") done(data)
                    } {record.state="invalid_response" request_failed(record,"宿主模型响应格式无效，请重新查询")}
                })
            })
            record.dispatch_returned = true record.dispatch_returned_at = time_now()
            request_stage(record,"after_host")
        } {
            waiting.settled = true request_finished(record,"request_rejected")
            if request_current(token,record) {request_failed(record,"宿主模型请求未能派发，请重新查询")}
        }
    })
}


fn start_task(){
    render_probe=nil
    agent_tool_schema=nil
    invalidate_interface()
    let text = ui.sentence.text().trim()
    if text == "" { show_status("请用一句话说明行程、时限与预算") return }
    cancel_pending_location()
    run_id += 1 ui_facts_revision+=1
    if task_timer != nil { stop_timer(task_timer) }
    let token = run_id
    received_at = time_now() arrive_by = 0 loop_started_at = received_at automatic_seconds = 0 step_count = 0 protocol_retry_count = 0
    route_nodes={} route_prefixes={} route_extension_count=0 didi_places={} didi_quotes={} didi_record_count=0
    pending_user_poi = nil condition_open = false invalidate_map() picker_request += 1 picker_open = false picker_pois = [] picker_preview_poi = nil picker_status = "" viewed_route_id = "" expanded_routes = false
    request_text = text user_limits = explicit_limits(text) observations = [] model_requests = [] decisions = [] source_snapshots = [] source_records = [] calendar_events = [] note_records = []
    position_record = nil constraints = nil destination_record = nil poi_records = [] candidates = [] candidate_sequence = 0 chosen = nil used_tools = []
    transit_count = 0 transit_completed = 0 driving_done = false driving_completed = false progress_text = "" answer_text = "" phase = "running"
    if user_limits != nil {arrive_by=received_at+user_limits.minutes*60}
    agent_messages=[] agent_calls=[] agent_call_index=0 active_tool=nil tool_node_refs=[] tool_candidate_start=0 agent_active=true
    trace_initialize()
    trace_emit("query_started",{input:text facts:interface_facts().to_json()},nil)
    trace_marker()
    source_records.push({id:"current-input" kind:"user" source:"explicit-current-input" mock:false raw:text read_at:received_at})
    render_content()
    refresh_generated_facts()
    start_timeout(0.01, || agent_begin())
}


fn cancel_task(){
    let stopped_run=run_id let stopped_at=time_now()
    agent_active=false active_tool=nil
    cancelled_input = ui.sentence.text().trim()
    stop_interface()
    cancel_pending_location()
    agent_active=false active_tool=nil run_id += 1 phase = "cancelled" picker_request += 1 invalidate_map()
    if task_timer != nil { stop_timer(task_timer) task_timer = nil }
    start_timeout(0.01,||trace_emit_run("query_stopped",{occurred_at:stopped_at},nil,stopped_run))
    show_status("本次查询已停止；下次查询开始新任务") render_content()
}


fn money_text(cents){ if cents == nil { return "费用未知" } return "¥" + (cents / 100) }
fn duration_text(seconds){ if seconds == nil { return "耗时未知" } let remainder = seconds % 60 let minutes = (seconds - remainder) / 60
    if remainder > 0 { minutes += 1 }
    return "约 " + minutes + " 分钟" }
fn kind_text(kind){
    if kind == "public_transit" { return "公共交通" }
    if kind == "mixed" { return "打车 + 公共交通" }
    if kind == "taxi" { return "全程打车估价" }
    return "" + kind
}
fn route_kind_label(candidate){
    let legs=route_get(candidate,"legs")
    if !legs.is_array() || legs.len()==0 {return kind_text(candidate.kind)}
    let labels=[] let seen={}
    for leg in legs {
        let mode=route_get(leg,"mode")
        let label=if mode=="transit" {"公共交通"} elif mode=="taxi" {"打车"} elif mode=="walk" {"步行"} else {""+mode}
        if seen[label]!=true {seen[label]=true labels.push(label)}
    }
    let text=""
    for label in labels {if text!="" {text+="＋"} text+=label}
    return text
}
fn beijing_clock(epoch){
    let v = local_time(epoch + 28800)
    let hour_text = "" + v.hour let minute_text = "" + v.minute
    if v.hour < 10 { hour_text = "0" + hour_text }
    if v.minute < 10 { minute_text = "0" + minute_text }
    return hour_text + ":" + minute_text + "（北京时间）"
}
fn segment_description(segment){
    let parts = []
    let walking = route_get(segment, "walking")
    if walking.is_object() {
        let distance = route_get(walking, "distance")
        if distance.is_string() && distance != "" { parts.push("步行 " + distance + " 米") }
    }
    let bus = route_get(segment, "bus")
    let lines = route_get(bus, "buslines")
    if lines.is_array() && lines.len() > 0 {
        let line = lines[0]
        let name = route_get(line, "name")
        let departure = route_get(route_get(line, "departure_stop"), "name")
        let arrival = route_get(route_get(line, "arrival_stop"), "name")
        parts.push("" + name + " · " + departure + " → " + arrival)
    }
    if route_get(segment, "taxi").is_object() { parts.push("打车接续（供应商综合估价）") }
    let text = ""
    for part in parts { if text != "" { text += "；" } text += part }
    if text == "" {
        let road = route_get(segment, "road")
        if road.is_string() { return road }
    }
    return text
}
fn route_description(candidate){
    if !candidate.segments.is_array() { return "" }
    let text = ""
    for segment in candidate.segments {
        let description = segment_description(segment)
        if description != "" {
            if text != "" { text += "；" } text += description
        }
    }
    if text != "" { return "主要路段：" + text + "。" }
    return ""
}
fn comparison_summary(){
    let fastest = nil let cheapest = nil let unknown_prices = 0
    for candidate in candidates {
        if route_cost_facts(candidate).coverage!="requested_journey" {continue}
        if candidate.duration_seconds != nil { if fastest == nil || candidate.duration_seconds < fastest.duration_seconds { fastest = candidate } }
        if candidate.price_cents == nil { unknown_prices += 1 }
        elif cheapest == nil || candidate.price_cents < cheapest.price_cents { cheapest = candidate }
    }
    let text = "已取得 " + candidates.len() + " 条候选。"
    if fastest != nil {
        text += "最短已知耗时 " + fastest.duration_seconds + " 秒（" + duration_text(fastest.duration_seconds) + "）。"
        if !fastest.waiting_included { text += "该驾车耗时不含候车与接驳。" }
    }
    if cheapest != nil { text += "最低已知估价 " + money_text(cheapest.price_cents) + "。" }
    if unknown_prices > 0 { text += unknown_prices + " 条候选费用未知。" }
    text += "这些数值可能来自不同方案，不代表存在可用路线。"
    return text
}
fn source_label(){
    let mock_context = false let mock_location = false
    for source in source_records {
        if source.mock == true && (source.kind == "calendar" || source.kind == "note") { mock_context = true }
        if source.mock == true && source.kind == "location" { mock_location = true }
    }
    if position_record != nil && position_record.mock == true { mock_location = true }
    let text = ""
    if mock_context { text = "日历与机票笔记为模拟来源。" }
    if mock_location { text += "出发位置为模拟位置，并非当前设备定位。" }
    return text
}
fn query_task(){ start_task() }


// M3生成原生Splash；业务与网络仍由父应用执行。

// 一个会话保存标准assistant/tool消息；各异步执行入口只完成当前工具。
let agent_messages = []
let agent_active = false
let agent_calls = []
let agent_call_index = 0
let active_tool = nil
let agent_tool_schema = nil
fn tool(name,description,properties,required){return {type:"function" function:{name:name description:description parameters:{type:"object" properties:properties required:required}}}}
fn is_render_tool(name){return name=="render_ui" || name=="render_summary" || name=="render_explanation" || name=="render_routes" || name=="render_suggestions" || name=="render_route_detail"}
fn render_block_tool(name,description){
 let source_description="任意Makepad Splash DSL。"
 if name=="render_route_detail" {source_description="独立详情区块的Splash DSL：父容器初始隐藏，打开父容器时源码内容应正常可见，根不再visible:false。多个候选共用同ID详情时，初始按facts.viewed_route_id、on_facts_changed按传入current.viewed_route_id查同一Route，用该Route的kind_label、price_label、duration_label、reason、segments更新文案和地图target；view_route只改变父事实，不替生成稿更换内容。每候选使用独立静态详情也合法，但须使用不同区块ID，列表按钮打开对应区块。地图按目标Route的map_metadata/map_paths目录选择path_indices；目录未读不表示最多四条，可用get_route取得当前目录。每图最多4条独立paths，可自选多个独立命名地图或本地分段翻页，使所有分图或页面的索引合起来覆盖全部真实折线；布局、张数、分页和分组由你选择，不猜索引或沿用extend前目录。首次打开所选路线后，从本详情区块向自己的命名地图emit map绑定(target为路线id或geometry_ref)；on_camera_changed的map_camera仅处理已绑定地图的后续相机变化。打开用show_block(实际目标区块ID)，关闭/返回用hide_self()，不重建列表。"}
 let default_id=name.strip_prefix("render_")
 return tool(name,description+"；source是任意Splash DSL，不是模板。省略id时实际区块ID为"+default_id+"；show_block(target_id)必须使用要打开的实际ID，hide_self()无参数关闭发起块。id可覆盖默认块名，重复id仅更新此块，其余状态保留；overlay/height可选。",{source:{type:"string" description:source_description} id:{type:"string" description:"实际区块ID；省略时为"+default_id+"，打开按钮调用show_block(此实际ID)；详情返回调用hide_self()，不用猜来源ID。"} overlay:{type:"boolean"} height:{type:"number"}},["source"])
}
fn render_tool_params(name,p){
 if name=="render_ui" {return p}
 let id=route_get(p,"id") if id==nil {id=name.strip_prefix("render_")}
 let block={id:id source:p.source}
 let existing=block_by_id(id)
 if route_get(p,"overlay")!=nil {block.overlay=p.overlay} elif existing==nil {block.overlay=name=="render_route_detail"}
 if existing==nil && name=="render_route_detail" {block.visible=false}
 if route_get(p,"height")!=nil {block.height=p.height}
 return {blocks:[block]}
}
fn agent_tools(){
 if agent_tool_schema!=nil {return agent_tool_schema}
 let mode=location_mode()
 let tools = [
 tool("read_skill","读取技能目录中的技能。省略path读取SKILL.md；path可读取该技能返回的files中的引用资料。",{name:{type:"string"} path:{type:"string"}},["name"])
 tool("read_location",if mode=="demo" {"读取显式模拟出发位置并核实城市。"} else {"读取当前设备定位并核实城市。"},{},[])
 tool("search_places","用真实高德搜索公开地点，返回完整POI和城市；不采用目标。",{query:{type:"string"}},["query"])
 tool("adopt_destination","采用已有poi_id为本任务目标。basis说明来自用户选择或明确推断；不伪造航站楼。",{poi_id:{type:"string"} basis:{type:"string"}},["poi_id" "basis"])
 tool("query_route","查询实际起终点。mode为transit或taxi；transit策略默认0推荐，可1经济/2少换乘/3少步行/4舒适/5无地铁/7地铁优先/8快；taxi用单路径高德驾车路线出租车估价，候车未知。只覆盖本次已查范围，返回新增Route、实际legs、completion_status与assessment；new_nodes是供应商真实中转节点，其ref可直接用于extend_route.to_ref，geometry_ref供地图引用。直达公共交通超期或末段未完成，不证明到中转节点后换打车也不成立；用时数值在期限内不等于已核实准时。",{mode:{type:"string" enum:["transit" "taxi"]} strategy:{type:"number"}},["mode"])
 tool("extend_route","从本轮route_id延长一整段到真实图节点，返回新Route，原Route不变；route_id=origin可从实际出发点查询到中转站；to_ref用query_route.new_nodes或get_route_graph.nodes的真实ref，新Route.id可继续以另一mode接驳。未到目标也能get/view/map；walk/taxi/transit每段采用完整供应商方案，不拆摊原公交票价。后续公交按最早场景查询，未知候车不保证班次。",{route_id:{type:"string"} to_ref:{type:"string"} mode:{type:"string"} strategy:{type:"number"}},["route_id" "to_ref" "mode"])
 tool("search_didi_places","搜索滴滴供应商真实地点，city完整城市名；报价坐标只用本工具ref。",{query:{type:"string"} city:{type:"string"}},["query" "city"])
 tool("attach_quote","以route_id和leg_id将指定车型当前报价替换明确taxi leg费用，返回新Route及新id；原Route不变，展示/地图须选择返回的新id。重算小计，全程金额与完成状态独立；不认证滴滴上下车连接。place_basis保两端名称/城/地址入口对应依据。",{route_id:{type:"string"} leg_id:{type:"string"} quote_ref:{type:"string"} place_basis:{type:"string"}},["route_id" "leg_id" "quote_ref" "place_basis"])
 tool("quote_didi","用本轮滴滴地点ref询价，多车型当前估价；不下单，不自动认作高德leg价格。",{from_ref:{type:"string"} to_ref:{type:"string"}},["from_ref" "to_ref"])
 tool("compare_routes","确定性重算当前Route的时间、费用、原截止与assessment理由，只比较已查范围。根据用户目标与缺口探索真实接驳及可用供应商报价；未查的报价/连接不证明最优，passed=false不能称可行或稳妥；不自动选方案/结束。",{},[])
 tool("get_route","按本轮Route ID读取完整或未完成路线的legs、费用范围、来源、当前校验和该ID真实map_paths目录；首次按需解析并缓存几何，不再查询供应商。map_metadata.catalog_status=not_loaded/path_count=nil不表示最多四条；每张高德图最多4条独立paths，按当前目标目录选择。extend后的新几何不能沿用旧目录；报价派生几何不变可复用同源目录。",{id:{type:"string"}},["id"])
 tool("get_route_graph","读取本轮全部真实接驳节点和统一Route对象，不查询供应商。",{},[])
 render_block_tool("render_summary","呈现本次总结论")
 render_block_tool("render_explanation","呈现结论的简要解释")
 render_block_tool("render_routes","呈现已评估方案列表，用户可点击打开对应候选详情；不成立的候选也可查看")
 render_block_tool("render_suggestions","呈现改进建议")
 render_block_tool("render_route_detail","呈现对应已评估候选的分段、费用、耗时、限制和实际地图，即使不满足条件仍有详情价值；已有块更新保持当前页面状态，可用不同id保留多个详情")
 tool("render_ui","提交任意原生Splash源码。source整稿替换；blocks按id追加或替换指定区块，其余区块状态保留。普通区块自然高度，overlay是可显示/隐藏的有限视口。返回各块真实执行诊断；success不代表内容目标完成。",{source:{type:"string"} blocks:{type:"array" items:{type:"object" properties:{id:{type:"string"} source:{type:"string"} overlay:{type:"boolean"} visible:{type:"boolean"} height:{type:"number"}} required:["id" "source"]}}},[])
 ]
 if mode=="demo" {
tools.push(tool("read_calendar","读取本应用明确标注的模拟日历；返回记录和来源。",{},[]))
tools.push(tool("read_notes","读取本应用模拟机票笔记；返回记录和来源。",{},[]))
tools.push(tool("set_constraints","按实际日历/笔记原文形成行程约束；用户原分钟数和预算不变。",{event_id:{type:"string"} note_id:{type:"string"} minutes:{type:"number"} budget_cents:{type:"number"} currency:{type:"string"} destination_query:{type:"string"} citations:{type:"array" items:{type:"object" properties:{source_id:{type:"string"} quote:{type:"string"}}}}},["event_id" "note_id" "minutes" "budget_cents" "currency" "destination_query" "citations"]))
 }
 agent_tool_schema=tools
 return tools
}
fn agent_skill_catalog(){return read_text("skills/catalog.json").parse_json()}
fn agent_skill_metadata(){
 let result=[] for skill in agent_skill_catalog() {result.push({name:skill.name description:skill.description})} return result
}
fn read_agent_skill(p){
 let name=p.name.replace("_","-")
 let resource=route_get(p,"path")
 let path=if resource==nil {"SKILL.md"} else {resource}
 for skill in agent_skill_catalog() {if skill.name==name {
  for file in skill.files {if file==path {
   let text=read_text("skills/"+name+"/"+path)
   if text==nil {return {success:false error:"技能资源无法读取" name:name path:path}}
   return {success:true name:name path:path content:text files:skill.files}
  }}
  return {success:false error:"技能中没有该资源" name:name path:path files:skill.files}
 }}
 return {success:false error:"技能不在目录中" name:name catalog:agent_skill_metadata()}
}
fn agent_begin(){
 agent_messages=[{role:"system" content:"你是Navigation出行Agent。围绕本次时间、预算和偏好探索步行、公共交通与打车接驳；工具选择和顺序由你决定，时间费用由工具计算。标题与结论取同一Route当前assessment：预算、截止与连接独立判断，unknown不是符合，passed=false不等于每项超限；已查段小计不是全程价格，期限从received_at起算。每次输入是独立查询，不澄清或保存结果。向用户呈现已评估方案及实际依据，包括不成立方案的分段、费用、耗时、限制和地图；未取得的数据或服务失败如实说明。结果面向用户，不使用内部ID/时间戳或已结束的正在处理标题。技能目录（正文及引用资料通过read_skill按需读取）：\n"+agent_skill_metadata().to_json()} {role:"user" content:({request:request_text facts:model_task_context()}).to_json()}]
 agent_active=true agent_pump(run_id)
}

fn agent_pump(token){
 if !current_task(token){return}
 step_count+=1 show_status("Agent正在处理")
 let record={kind:"agent" run:token step:step_count started_at:time_now() state:"pending"}
 model_requests.push(record)
 start_timeout(0.01,||{
 if !current_task(token){return}
 minimax_request("",agent_messages,agent_tools(),token,record,fn(data){
   if !current_task(token){return}
   let choice=route_get(data,"choices")[0] let message=route_get(choice,"message")
   if !message.is_object(){request_failed(record,"模型没有返回消息") return}
   let message_at=time_now()
   agent_messages.push(message)
   start_timeout(0.01,||trace_emit_run("assistant_message",{step:record.step message:message.to_json() occurred_at:message_at},nil,token))
   let calls=route_get(message,"tool_calls")
   if !calls.is_array() || calls.len()==0 {
      let content=route_get(message,"content")
      answer_text=if content.is_string() {content} else {""}
      ui_facts_revision+=1
      runtime_status=if answer_text.trim()=="" && !generated_active {"Agent没有返回可展示内容，请重新查询"} else {""}
      agent_active=false active_tool=nil if phase=="running" {phase="waiting"}
      let ended={content:answer_text generated:generated_active rendered:generated_render_complete occurred_at:time_now()}
      start_timeout(0.01,||trace_emit_run("query_ended",ended,nil,token))
      render_content() return
   }
   agent_calls=calls agent_call_index=0 start_timeout(0.01,||agent_execute_next(token))
 })
 })
}
fn agent_tool_result(result){
 if active_tool==nil {return}
 let call=active_tool let content=result.to_json() let token=run_id let returned_at=time_now()
 // 先提交完整回执，再释放当前工具并派发续轮；诊断/显示不能夹断这一步。
 agent_messages.push({role:"tool" tool_call_id:call.id content:content})
 decisions.push({tool:call.function.name call_id:call.id returned_at:returned_at})
 if call.function.name!="read_skill" && call.function.name!="get_route" && call.function.name!="get_route_graph" && !is_render_tool(call.function.name) {ui_facts_revision+=1}
 agent_call_index+=1 active_tool=nil
 start_timeout(0.01,||agent_execute_next(token))
 agent_result_effects(call,content,token,returned_at)
}
fn agent_result_effects(call,content,token,returned_at){
 start_timeout(0.01,||trace_emit_run("tool_result",{name:call.function.name result:content occurred_at:returned_at},call.id,token))
 start_timeout(0.01,||{if token==run_id {refresh_generated_facts()}})
}
// 原始业务记录只存一份；模型取得本次增量或按ID读取，UI保留自己的当前事实视图。
let tool_candidate_start=0
let tool_node_refs=[]
fn tool_new_nodes(){
 let added=[]
 for ref node in route_nodes {let found=false for existing in tool_node_refs {if ref==existing {found=true}} if !found {added.push(node)}}
 return added
}
// 路段展示资料随Route几何保持不变；只重算当前assessment，不重复解析供应商步骤。
fn route_summary_steps(candidate){
    let cached=route_get(candidate,"steps_cache") if cached!=nil {return cached}
    let steps=[]
    for segment in candidate.segments {steps.push({description:segment_description(segment) distance_m:route_seconds(route_get(segment,"distance")) duration_seconds:route_seconds(route_get(route_get(segment,"cost"),"duration"))})}
    candidate.steps_cache=steps return steps
}
fn query_route_summary(candidate){
    let check=route_recheck(candidate,time_now(),arrive_by,route_get(constraints,"budget_cents"))
    let cost=route_cost_facts(candidate) let completion=route_completion(candidate) let steps=route_summary_steps(candidate) let budget=route_get(constraints,"budget_cents")
    return {id:candidate.id geometry_ref:candidate.geometry_ref derived_from_route_id:route_get(candidate,"derived_from_route_id")
        mode:if candidate.kind=="taxi" {"taxi"} elif candidate.kind=="walking" {"walk"} elif candidate.kind=="mixed" {"mixed"} else {"transit"} kind:candidate.kind
        map_metadata:route_map_metadata(candidate) completion_status:completion node_ref:route_get(candidate,"node_ref") requested_destination_ref:"destination"
        incomplete_reason:if completion!="reached_requested_destination" {"仅包含已取得路段，终点或后续连接尚未取得，小计不是到目的地总价"} else {nil}
        duration_seconds:candidate.duration_seconds duration_label:duration_text(candidate.duration_seconds) distance_m:route_get(candidate,"distance_m")
        price_label:if cost.coverage=="queried_legs_only" {"已查段 "+money_text(candidate.price_cents)} else {money_text(candidate.price_cents)} cost:cost legs:route_leg_facts(candidate) steps:steps
        assessment:{evaluated_at:time_now() passed:check.passed reasons:route_reasons(candidate,time_now(),arrive_by,route_get(constraints,"budget_cents")) waiting_included:candidate.waiting_included waiting_basis:candidate.waiting_basis origin_complete:candidate.origin_complete endpoint_complete:candidate.endpoint_complete connection_status:if route_get(candidate,"provider_connection_status")=="unknown" {"provider_connection_unknown"} elif candidate.origin_complete && candidate.endpoint_complete {"geometry_checked"} else {"unknown"}
            budget_status:if budget==nil {"unknown"} elif cost.known_subtotal_cents>budget {"over_budget"} elif cost.full_journey_amount_cents!=nil {"within_estimate"} else {"unknown"}
            deadline_status:if check.estimated_arrival_ts!=nil && check.estimated_arrival_ts>arrive_by {"over_deadline"} elif candidate.duration_seconds!=nil && candidate.waiting_included && candidate.request_bound && candidate.origin_complete && candidate.endpoint_complete && route_get(candidate,"provider_connection_status")!="unknown" {"within_estimate"} else {"unknown"}}
        source:{provider:candidate.source queried_at:candidate.source_ts expires_at:candidate.expires_at warnings:candidate.warnings}}
}
fn model_route_summary(candidate){return query_route_summary(candidate)}
fn model_route_summaries(){let result=[] for candidate in candidates {result.push(query_route_summary(candidate))} return result}
fn model_task_context(){
 let facts=interface_facts()
 let configured=false let config=read_text("private-config.json")
 if config!=nil {let key=route_get(config.parse_json(),"didi_mcp_key") configured=key.is_string() && key!=""}
 return {limits:user_limits received_at:received_at arrive_by:arrive_by viewport:facts.viewport rendering_environment:facts.rendering_environment providers:{didi:{configured:configured availability:"配置不等于服务可用；未调用或调用失败不能推断未配置"}} origin:position_record destination:destination_record source_label:source_label()}
}
fn finish_tool_from_state(token){
 if !current_task(token) || active_tool==nil {return}
 let name=active_tool.function.name
 prepare_route_graph()
 if name=="read_location" {agent_tool_result({success:true origin:position_record new_nodes:tool_new_nodes()})}
 elif name=="read_calendar" {agent_tool_result({success:true records:calendar_events})}
 elif name=="read_notes" {agent_tool_result({success:true records:note_records})}
 elif name=="query_route" || name=="query_transit" || name=="query_driving" {
    let added=[] for index candidate in candidates {if index>=tool_candidate_start {added.push(query_route_summary(candidate))}}
    agent_tool_result({success:true routes:added new_nodes:tool_new_nodes()})
 } else {agent_tool_result({success:true origin:position_record destination:destination_record constraints:constraints limits:user_limits arrive_by:arrive_by new_nodes:tool_new_nodes()})}
}
fn agent_execute_next(token){
 let render_entry_at=time_now()
 if !current_task(token){return}
 if agent_call_index>=agent_calls.len(){start_timeout(0.01,||agent_pump(token)) return}
 let call=agent_calls[agent_call_index] active_tool=call
 let name=call.function.name let p=nil
 if is_render_tool(name) {render_probe_begin(call,render_entry_at)}
 tool_candidate_start=candidates.len() tool_node_refs=[] for ref node in route_nodes {tool_node_refs.push(ref)}
 let call_at=time_now()
 start_timeout(0.01,||trace_emit_run("tool_call",{name:name arguments:call.function.arguments occurred_at:call_at},call.id,token))
 try {p=call.function.arguments.parse_json()} {agent_tool_result({success:false error:"工具参数JSON无法解析"}) return}
 try {
  if name=="read_skill" {agent_tool_result(read_agent_skill(p))}
  elif name=="read_calendar" || name=="read_notes" || name=="read_location" {read_source_tool(name,token,fn(){finish_tool_from_state(token)})}
  elif name=="set_constraints" {if set_constraints(p){finish_tool_from_state(token)} else {agent_tool_result({success:false error:constraint_error})}}
  elif name=="search_places" {
    let at=time_now() let city="" if position_record!=nil {city="&city="+position_record.citycode.url_encode()}
    amap_request("/v3/place/text","&citylimit=false&extensions=all&children=1"+city+"&keywords="+p.query.url_encode(),token,fn(data){poi_records=parse_pois(data,at,false) register_route_pois(poi_records) picker_pois=poi_records observe("search_places",poi_records) agent_tool_result({success:true places:poi_records})})
  }
  elif name=="adopt_destination" {
    let poi=nil for item in poi_records {if item.id==p.poi_id {poi=item}}
    if poi==nil {agent_tool_result({success:false error:"poi_id不在实际地点结果中"})}
    elif constraints!=nil && route_get(constraints,"user_selected")!=true && route_get(constraints,"inferred")!=true {if select_destination({poi_id:p.poi_id},p.basis){finish_tool_from_state(token)} else {agent_tool_result({success:false error:destination_error})}}
    else {pending_user_poi=poi if !position_current(position_record){agent_tool_result({success:false error:"请取得当前起点后再采用地点"})} elif apply_user_poi(){constraints.inferred=true constraints.user_selected=false constraints.inference={reason:p.basis origin_city:position_record.city poi_source:poi.source} finish_tool_from_state(token)} else {agent_tool_result({success:false error:"缺少可计算的用户时间/预算或真实城市"})}}
  }
  elif name=="query_route" {query_route(p,token)}
  elif name=="extend_route" {extend_route(p,token)}
  elif name=="search_didi_places" {search_didi_places(p,token)}
  elif name=="quote_didi" {quote_didi(p,token)}
  elif name=="attach_quote" {attach_quote(p,token)}
  elif name=="compare_routes" {present_results("")}
  elif name=="get_route" {let candidate=ui_route(p.id) if candidate==nil {agent_tool_result({success:false error:"路线ID不在本轮候选中"})} else {map_path_catalog(candidate) agent_tool_result({success:true route:interface_route_facts(candidate,route_recheck(candidate,time_now(),arrive_by,route_get(constraints,"budget_cents")))})}}
  elif name=="get_route_graph" {prepare_route_graph() agent_tool_result({success:true graph:route_graph_facts()})}
  elif is_render_tool(name) {
    render_probe_mark("before_mount")
    interface_revision+=1 let revision=interface_revision
    let changed=mount_ui_blocks(render_tool_params(name,p),token,revision)
    render_probe_mark("mount_returned") if render_probe!=nil {render_probe.active=false}
    if changed==nil {agent_tool_result({success:false error:interface_error}) return}
    start_timeout(0.25,||{if current_task(token) && active_tool==call {
      let result=render_ui_result(changed)
      let finished_at=time_now()
      agent_tool_result(result)
      start_timeout(0.01,||trace_emit_run("render_result",{blocks:result.blocks occurred_at:finished_at},call.id,token))
      start_timeout(0.01,||{if token==run_id {render_content()}})
    }})
  }
  else {agent_tool_result({success:false error:"未知工具："+name})}
 } {agent_tool_result({success:false error:"工具参数或数据执行错误" status:runtime_status})}
}

let runtime_status = if native_ui_available {""} else {missing_runtime_message}
let generated_source = ""
let ui_blocks=[]
let inline_blocks=[]
let overlay_blocks=[]
let ui_facts_json=""
let ui_facts_cached_revision=-1
let generated_area_ready = false
let generated_active = false
let generated_render_complete = false
let generated_render_notified = false
let cancelled_input = ""
let interface_revision = 0
let interface_run = 0
let interface_inflight = false
let interface_error = ""
let interface_requests = []
let ui_viewport = nil
let ui_overlay_top=0
// UI状态变化才复制大快照；轮询只读小修订号，避免每100ms重新分配整串。
let ui_facts_revision=0
let ui_facts_written_revision=-1
let mailbox_seen = ""
let mailbox_lines = 0
fn request_current(token,record){ return token == run_id && agent_active }
fn request_failed(record,text){
 agent_active=false active_tool=nil phase="failed"
 let token=run_id let failed_at=time_now()
 start_timeout(0.01,||trace_emit_run("transport_error",{step:record.step state:record.state error:text occurred_at:failed_at},nil,token))
 show_status(text)
}
fn block_inner_height(block){if block.height!=nil {return Fill} if block.document {return Fill} return Fit}
fn block_height(block){
 if block.height!=nil {return block.height}
 if block.overlay || block.document {if ui_viewport!=nil {return ui_viewport.height} return Fill}
 return Fit
}
fn block_actual_visible(block){return block.visible && block.complete}
fn set_block_visibility(block){
 if block.handle==nil {return true}
 let visible=block_actual_visible(block) if answer_text!="" && !generated_render_complete {visible=false}
 block.container.set_visible(visible) return true
}
fn block_by_id(id){for block in ui_blocks {if block.id==id {return block}} return nil}
fn sync_block_state(){
 generated_active=ui_blocks.len()>0 generated_render_complete=false generated_render_notified=false interface_error=""
 for block in ui_blocks {
  if block.complete {generated_render_complete=true}
  if block.notified {generated_render_notified=true}
  if block.error!="" {interface_error+=block.id+": "+block.error+"\n"}
 }
}
fn clear_generated(){
 for block in ui_blocks {try {block.handle.set_text("") block.container.set_visible(false)} {}}
 ui_blocks=[] inline_blocks=[] overlay_blocks=[] generated_source=""
 generated_active=false generated_render_complete=false generated_render_notified=false
 ui_render_generation+=1 invalidate_map() map_slots={} mailbox_seen="" mailbox_lines=0
 ui_facts_cached_revision=-1 ui_facts_written_revision=-1
 ui.generated_area.render() ui.block_overlay.render()
}
fn stop_interface(){interface_revision+=1 interface_inflight=false clear_generated() render_content()}
fn invalidate_interface(){ stop_interface() clear_generated() interface_error = "" }
fn shell_busy(){ return agent_active || phase == "picking" }
fn shell_action(){ if !native_ui_available {show_status(missing_runtime_message) return} if shell_busy(){cancel_task()} else {query_task()} }

fn ui_route(ref){ if ref == "viewed" { return viewed_route() } for candidate in candidates { if candidate.id == ref || route_get(candidate,"geometry_ref")==ref { return candidate } } return nil }


fn route_leg_facts(candidate){
    let result=[] let legs=route_get(candidate,"legs")
    if legs.is_array() {for leg in legs {result.push({id:leg.id from_ref:leg.from_ref to_ref:leg.to_ref requested_to_ref:route_get(leg,"requested_to_ref") mode:leg.mode departure_ts:leg.departure_ts duration_seconds:leg.duration_seconds price_cents:leg.price_cents price_basis:leg.price_basis waiting_included:leg.waiting_included source_ts:leg.source_ts warnings:leg.warnings quote_ref:route_get(leg,"quote_ref") place_match_basis:route_get(leg,"place_match_basis") provider_connection_status:route_get(leg,"provider_connection_status")})}}
    return result
}
fn route_completion(candidate){
    let completion=route_get(candidate,"completion_status")
    if completion!=nil {return completion}
    return if candidate.actual_endpoint==nil {"unknown"} elif candidate.endpoint_complete {"reached_requested_destination"} else {"incomplete"}
}
fn route_cost_facts(candidate){
    let known=route_get(candidate,"known_cost_cents") if known==nil {known=if candidate.price_cents!=nil {candidate.price_cents} else {0}}
    let covered=route_completion(candidate)=="reached_requested_destination" && candidate.request_bound && candidate.origin_complete && candidate.endpoint_complete && route_get(candidate,"connection_verified")!=false && route_get(candidate,"provider_connection_status")!="unknown"
    return {amount_cents:candidate.price_cents known_subtotal_cents:known full_journey_amount_cents:if covered {candidate.price_cents} else {nil} complete:candidate.price_cents!=nil coverage:if covered {"requested_journey"} else {"queried_legs_only"} currency:candidate.currency basis:route_get(candidate,"price_basis") estimated:candidate.estimated}
}
fn interface_route_facts(candidate, check){
    let segments = []
    if candidate.segments.is_array() {
        for index segment in candidate.segments {
            let walking = route_get(segment, "walking") let taxi = route_get(segment, "taxi") let buslines = []
            let lines = route_get(route_get(segment, "bus"), "buslines")
            if lines.is_array() { for line in lines {
                buslines.push({name: route_get(line, "name") departure_stop: route_get(route_get(line, "departure_stop"), "name") arrival_stop: route_get(route_get(line, "arrival_stop"), "name") distance_m: route_get(line, "distance") duration_seconds: route_get(route_get(line, "cost"), "duration")})
            } }
            segments.push({index: index walking_distance_m: route_get(walking, "distance") walking_duration_seconds: route_get(route_get(walking, "cost"), "duration") taxi_distance_m: route_get(taxi, "distance") taxi_duration_seconds: route_get(taxi, "drivetime") taxi_price: route_get(taxi, "price") description: segment_description(segment) road: route_get(segment, "road") distance_m: route_get(segment, "distance") duration_seconds: route_get(segment, "duration")
                walking: if walking.is_object() { {distance_m: route_get(walking, "distance") duration_seconds: route_get(route_get(walking, "cost"), "duration")} } else { nil }
                taxi: if taxi.is_object() { {distance_m: route_get(taxi, "distance") duration_seconds: route_get(taxi, "duration") price: route_get(taxi, "price")} } else { nil }
                buslines: buslines})
        }
    }
    let fact=query_route_summary(candidate)
    fact.kind_label=route_kind_label(candidate) fact.price_cents=candidate.price_cents fact.currency=candidate.currency
    fact.known_cost_cents=fact.cost.known_subtotal_cents fact.budget_status=fact.assessment.budget_status fact.deadline_status=fact.assessment.deadline_status
    fact.waiting_slack_seconds=if check.estimated_arrival_ts!=nil {arrive_by-check.estimated_arrival_ts} else {nil}
    fact.departure_ts=candidate.departure_ts fact.estimated_arrival_ts=check.estimated_arrival_ts
    fact.passed=check.passed fact.reason=check.reason fact.reasons=fact.assessment.reasons
    fact.source_ts=candidate.source_ts fact.expires_at=candidate.expires_at fact.estimated=candidate.estimated fact.warnings=candidate.warnings
    fact.waiting_included=candidate.waiting_included fact.waiting_basis=candidate.waiting_basis fact.taxi_wait_verified=candidate.taxi_wait_verified
    fact.request_bound=candidate.request_bound fact.origin_complete=candidate.origin_complete fact.endpoint_complete=candidate.endpoint_complete fact.endpoint_gap_m=candidate.endpoint_gap_m
    fact.map_paths=route_get(map_geometry_owner(candidate),"map_paths_cache") fact.segments=segments
    return fact
}
fn interface_facts(){
    if native_ui_available {let area = ui.content.rect() if area != nil && area.width>0 && area.height>0 {ui_viewport=area ui_overlay_top=area.y-ui.sentence.rect().y+12}}
    render_probe_mark("source_check_entered")
    let routes = [] let source_valid = sources_current() let sources = []
    render_probe_mark("source_check_returned")
    for candidate in candidates {
        if render_probe!=nil && render_probe.active {render_probe.current_route=candidate.id} render_probe_mark("route_entered")
        let check = route_recheck(candidate, time_now(), arrive_by, route_get(constraints, "budget_cents"))
        routes.push(interface_route_facts(candidate, check))
        render_probe_mark("route_returned")
    }
    if render_probe!=nil && render_probe.active {render_probe.current_route=nil} render_probe_mark("facts_remainder_entered")
    for record in source_records { sources.push({id: route_get(record, "id") kind: route_get(record, "kind") source: route_get(record, "source") mock: route_get(record, "mock") source_time: route_get(record, "source_time") read_at: route_get(record, "read_at")}) }
    if position_record!=nil && destination_record!=nil && constraints!=nil {prepare_route_graph()}
    let graph_nodes=[] let route_ids=[]
    for ref node in route_nodes {graph_nodes.push(node)} for candidate in candidates {route_ids.push(candidate.id)}
    let result={route_graph:{nodes:graph_nodes route_ids:route_ids initial_route_id:"origin"} taxi_quotes:didi_quotes taxi_quote_places:didi_places phase: phase status: runtime_status error: interface_error now: time_now() received_at: received_at arrive_by: arrive_by
        origin_available: position_record != nil destination_available: destination_record != nil limits_available: user_limits != nil
        origin: position_record destination: destination_record limits: user_limits source_label: source_label() sources: sources sources_current: source_valid answer: answer_text
        comparison: if candidates.len() > 0 { comparison_summary() } else { "" } routes: routes viewed_route_id: viewed_route_id maps_available: user_limits != nil viewport: ui_viewport rendering_environment: {scroll:"viewport表示可见区域，不是内容高度上限；普通区块按Fit自然增长并在父ScrollYView滚动，overlay和整稿source有独立有限视口" label_default:"宽度Fill、高度Fit、Flow.Right wrap:true；可显式覆盖原生属性"}
        places: picker_pois preview_place: picker_preview_poi place_status: picker_status
        semantics: "点路线只查看；未知金额/等待不等于零。"}
    render_probe_mark("facts_returned")
    return result
}
fn generated_context(){
    return "let NavRegular = theme.font_regular{font_family: FontFamily{latin := FontMember{res: http_resource(\"{{assets}}/assets/fonts/NavigationSans-Regular.otf\") asc: 0.0 desc: 0.0}}}\nlet Label = Label{width: Fill height: Fit flow: Flow.Right{wrap:true} draw_text.text_style: NavRegular}\nlet Button = Button{draw_text.text_style: NavRegular}\nlet ButtonFlat = ButtonFlat{draw_text.text_style: NavRegular}\nlet TextInput = TextInput{draw_text.text_style: NavRegular}\nfn snapshot(){return ui.fact_state.text().parse_json()}\nlet mailbox_buffer = \"\"\nfn emit(event){event.block_id=source_block_id event.block_revision=source_block_revision mailbox_buffer += event.to_json() + \"\\n\" ui.mailbox.set_text(mailbox_buffer)}\nfn show_block(target_id){emit({action:\"show_block\" block:target_id visible:true})}\nfn hide_self(){emit({action:\"show_block\" block:source_block_id visible:false})}\nlet last_facts = \"\"\nlet on_facts_changed = nil\nfn refresh(){let value = ui.fact_revision.text() if value != last_facts {last_facts = value if on_facts_changed != nil {on_facts_changed(snapshot())}} start_timeout(0.1, || refresh())}\nstart_timeout(0.02, || {last_facts = ui.fact_revision.text() ui.body.render() emit({action:\"rendered\"}) start_timeout(0.1, || refresh())})\n"
}
fn facts_json(){
 if ui_facts_cached_revision!=ui_facts_revision {let value=interface_facts() render_probe_mark("serialize_entered") ui_facts_json=value.to_json() render_probe_mark("serialize_returned") ui_facts_cached_revision=ui_facts_revision}
 return ui_facts_json
}
fn block_source(block,body){
 let finite=block.overlay || block.document
 let context="let source_block_id="+block.id.to_json()+"\nlet source_block_revision="+block.revision+"\n"+generated_context()
 let height_text=if finite {"Fill"} else {"Fit"}
 let head=context+"\nView{width:Fill height:"+height_text+" flow:Down\nmailbox := Label{visible:false text:\"\"}\nfact_state := Label{visible:false text:"+facts_json().to_json()+"}\nfact_revision := Label{visible:false text:"+(""+ui_facts_revision).to_json()+"}\n"
 if finite {head+="scroll := ScrollYView{width:Fill height:Fill flow:Down clip_x:true clip_y:true\n"}
 let tail=if finite {"}\n}"} else {"}"}
 return head+"body := View{width:Fill height:Fit flow:Down on_render:||{let facts=snapshot()\n"+body+"\n}}\n"+tail
}
fn render_ui_result(changed){
 let results=[] let success=true
 for block in changed {
  let diagnostic="区块尚未安装"
  if block.installed {diagnostic=block.handle.diagnostics()}
  block.error=diagnostic
  if diagnostic=="" && block.notified {block.complete=true}
  if diagnostic!="" {success=false}
  results.push({id:block.id revision:block.revision diagnostics:diagnostic notified:block.notified complete:block.complete visible:block_actual_visible(block)})
 }
 sync_block_state()
 return {success:success blocks:results diagnostics:interface_error notified:generated_render_notified viewport:ui_viewport}
}
fn mount_interface(body,token,revision){return mount_ui_blocks({source:body},token,revision)}
fn mount_ui_blocks(params,token,revision){
 render_probe_mark("mount_entered")
 if token!=run_id || revision!=interface_revision {return []}
 let submissions=route_get(params,"blocks") let document=route_get(params,"source")!=nil
 if document {submissions=[{id:"__document" source:params.source}]}
 if !submissions.is_array() {interface_error="render_ui需要source或blocks" return nil}
 render_probe_mark("fragment_check_entered")
 // Diagnose fragments before changing existing blocks; the wrapper must not repair their structure.
 for input in submissions {
  let diagnostic=ui.validate_fragment(input.source)
  if diagnostic!="" {interface_error=input.id+": "+diagnostic return nil}
 }
 render_probe_mark("fragment_check_returned")
 if document {clear_generated()}
 let changed=[] interface_run=token interface_inflight=false
 for input in submissions {let existing=block_by_id(input.id) if existing!=nil && route_get(input,"overlay")!=nil && existing.overlay!=(input.overlay==true) {interface_error="已存在区块的overlay位置不变；请使用新id" return nil}}
 for input in submissions {
  let block=block_by_id(input.id)
  let overlay=route_get(input,"overlay")==true
  if block==nil {
   block={id:input.id revision:0 body:"" handle:nil overlay:overlay document:document visible:route_get(input,"visible")!=false height:route_get(input,"height") installed:false notified:false complete:false error:"" mailbox_seen:"" mailbox_lines:0 written_revision:-1}
   if overlay {block.index=overlay_blocks.len() overlay_blocks.push(block)} else {block.index=inline_blocks.len() inline_blocks.push(block)}
   ui_blocks.push(block)
  } else {
   if route_get(input,"visible")!=nil {block.visible=input.visible}
   if route_get(input,"height")!=nil {block.height=input.height}
   try {block.handle.set_text("")} {}
   let kept={} for key slot in map_slots {if route_get(slot,"block_id")!=block.id {kept[key]=slot}} map_slots=kept
  }
  block.revision+=1 block.notified=false block.complete=false block.error="" block.mailbox_seen="" block.mailbox_lines=0 block.installed=false
  block.source=block_source(block,input.source) block.source_revision=ui_facts_revision changed.push(block)
 }
 sync_block_state()
 // ScriptReapply retains the unmodified child WidgetRefs and their Splash VMs.
 ui.generated_area.render_style() ui.block_overlay.render_style()
 let render_call_id=if active_tool!=nil {active_tool.id} else {nil}
 for block in changed {install_block_later(block,token,block.revision,render_call_id)}
 render_content()
 return changed
}
fn install_block_later(block,token,revision,call_id){
 start_timeout(0.05,||{
  if token!=run_id || block_by_id(block.id)!=block || revision!=block.revision {return}
  block.container=if block.overlay {ui.block_overlay.child(block.index)} else {ui.generated_area.child(block.index)}
  block.handle=block.container.child(0)
  block.handle.diagnostics()
  block.body=block.source
  try {block.handle.set_text(block.source) block.installed=true block.written_revision=block.source_revision set_block_visibility(block)}
  {block.error="生成区块执行失败"}
  trace_emit_run("render_source",{block_id:block.id revision:revision source:block.source},call_id,token)
 })
}
fn refresh_generated_facts(){
 if !generated_active {return true}
 let pending=false for block in ui_blocks {if block.installed && block.written_revision!=ui_facts_revision {pending=true}}
 if !pending {return true}
 let value=facts_json()
 for block in ui_blocks {if block.installed && block.written_revision!=ui_facts_revision {
  try {block.handle.find("fact_state").set_text(value) block.handle.find("fact_revision").set_text(""+ui_facts_revision) block.written_revision=ui_facts_revision}
  {block.error="生成区块事实更新失败"}
 }}
 ui_facts_written_revision=ui_facts_revision
 return true
}
fn generated_rendered(){return block_rendered(block_by_id("__document"))}
fn block_rendered(block){
 if block==nil || !generated_active || interface_run!=run_id {return true}
 block.notified=true let diagnostic=block.handle.diagnostics()
 if diagnostic=="" {block.complete=true block.error=""} else {block.error=diagnostic}
 sync_block_state()
 trace_emit("render_notification",{block_id:block.id diagnostics:diagnostic rendered:block.complete revision:block.revision},nil)
 render_content()
 for key slot in map_slots {if route_get(slot,"block_id")==block.id {update_map_widget(slot)}}
 return true
}
fn generated_error(message){return block_error(block_by_id("__document"),message)}
fn block_error(block,message){
 if block==nil {return true}
 let diagnostic=block.handle.diagnostics() if diagnostic!="" {message=diagnostic}
 if message!=block.error {trace_emit("render_diagnostic",{block_id:block.id diagnostics:message rendered:block.complete},nil)}
 block.error=message sync_block_state() render_content() return true
}
fn block_map_key(block_id,widget){if block_id==nil || block_id=="__document" {return widget} return [block_id widget].to_json()}
fn map_widget(slot){let block=block_by_id(route_get(slot,"block_id")) if block==nil {return nil} return block.handle.find(slot.widget)}
fn ui_dispatch_action(action){
 let block_id=route_get(action,"block_id") if block_id==nil {block_id="__document"}
 let block=block_by_id(block_id)
 if block!=nil && route_get(action,"block_revision")!=nil && action.block_revision!=block.revision {return true}
 trace_emit("local_event",{event:action.to_json()},nil)
 let name=route_get(action,"action") let id=route_get(action,"id")
 if name=="rendered" {block_rendered(block)}
 elif name=="map" {register_map_block(action.widget,action.target,route_get(action,"status_widget"),route_get(action,"interactive"),route_get(action,"path_indices"),block_id)}
 elif name=="map_camera" {action.widget=block_map_key(block_id,action.widget) map_camera_changed(action)}
 elif name=="map_fit" {let slot=map_slots[block_map_key(block_id,action.widget)] if slot!=nil && slot.interactive {let route=map_candidate(slot.target) if route!=nil {fit_map_slot(slot,route)}}}
 elif name=="show_block" {let target=block_by_id(action.block) if target!=nil {target.visible=action.visible!=false set_block_visibility(target) render_content()} else {block_error(block,"show_block目标区块不存在："+action.block)}}
 elif name=="view_route" {let route=ui_route(id) if route!=nil {view_route(route.id)} else {show_status("路线已不在本次查询中")}}
 elif name=="runtime_error" {block_error(block,route_get(action,"message"))}
 else {show_status("本地动作未实现："+name)}
 return true
}
fn enqueue_block_line(block,index,line,offset,token,revision){
 if index<offset || line.trim()=="" {return true}
 let action=line.parse_json()
 start_timeout(0.01,||{if token==run_id && block_by_id(block.id)==block && block.revision==revision {ui_dispatch_action(action)}})
 return true
}
fn consume_block_mailbox(block){
 let mailbox=block.handle.find("mailbox").text()
 if mailbox==block.mailbox_seen {return true}
 block.mailbox_seen=mailbox let lines=mailbox.split("\n") let offset=block.mailbox_lines block.mailbox_lines=lines.len()-1
 for index line in lines {enqueue_block_line(block,index,line,offset,run_id,block.revision)}
 return true
}
fn consume_generated_mailbox(){let block=block_by_id("__document") if block!=nil {consume_block_mailbox(block)} return true}
fn poll_generated(){
 for block in ui_blocks {if block.installed {
  try {let diagnostic=block.handle.diagnostics() if diagnostic!="" {block_error(block,diagnostic)} consume_block_mailbox(block)}
  {block.error="生成区块事件执行失败" sync_block_state() ui.feedback.render()}
 }}
 start_timeout(0.1,||poll_generated()) return true
}
fn update_map_widget(slot){
    if !generated_active { return }
    try {
        map_widget(slot).set_visible(slot.interactive == true || slot.bytes != nil)
        if slot.status_widget.is_string() && slot.status_widget != "" { block_by_id(slot.block_id).handle.find(slot.status_widget).set_text(slot.caption + "\n" + slot.status) }
        let generation=if block_by_id(slot.block_id)!=nil {block_by_id(slot.block_id).revision} else {ui_render_generation}
        if slot.bytes != nil && (slot.loaded_generation != generation || slot.loaded_request != slot.request) {
            if slot.interactive {
                let installed=map_widget(slot).load_map_image(slot.bytes,slot.camera.request,slot.camera.source_width,slot.camera.source_height)
                trace_emit("map_image_submitted",{widget:slot.id request:slot.request native_request:slot.camera.request accepted:installed},nil)
            } else {map_widget(slot).load_image_from_data_async(slot.bytes)}
            slot.loaded_generation=generation slot.loaded_request=slot.request
        }
    } { interface_error = "此图控件加载失败；其它图和行程保留" ui.feedback.render() }
}
trace_initialize()
View{width:Fill height:Fill flow:Overlay
SolidView{width: Fill height: Fill flow: Down padding: 12 spacing: 8 draw_bg.color: #xf7f7f7
    sentence := TextInput{width: Fill height: 48 on_return: || shell_action() text: "40 分钟内到机场，预算 50，尽量便宜。" empty_text: "描述本次行程、时限与预算"
        draw_text +: {text_style: NavRegular color: ink color_hover: ink color_focus: ink color_empty: muted}}
    control := View{width: Fill height: Fit on_render: || {
        ButtonFlat{enabled:native_ui_available draw_text +: {text_style: NavRegular color: ink color_hover: ink color_down: ink color_focus: ink} text: if !native_ui_available {"查询（不可用）"} elif shell_busy() { "终止" } else { "查询" } width: 160 height: 36 on_click: || shell_action()}
    }}
    content := ScrollYView{width: Fill height: Fill flow: Down spacing: 8
        feedback := View{width: Fill height: Fit on_render: || {
            Label{draw_text.text_style: NavRegular width: Fill height: Fit flow: Flow.Right{wrap:true} visible: interface_error != "" || interface_inflight || ((!generated_active || phase == "failed") && runtime_status != "")
                text: if phase == "failed" && runtime_status != "" { runtime_status } elif interface_error != "" { if generated_render_complete { "界面操作未能完成；已有结果保留" } elif agent_active { "界面正在修正；可终止本次查询" } else { "生成界面未能正常显示，请重新查询" } } elif interface_inflight { "Agent 正在生成界面；可终止" } else { runtime_status } draw_text.color: ink}
        }}
        generated_area := View{width:Fill height:Fit flow:Down on_render: || {
            for block in inline_blocks {
                View{width:Fill height:block_height(block) visible:block_actual_visible(block) flow:Down
                  generated := Splash{width:Fill height:block_inner_height(block) body:block.body}
                }
            }
        }}
        answer_area := View{width:Fill height:Fit on_render:||{
            final_answer := Label{width:Fill height:Fit visible:answer_text != "" && !generated_render_complete flow:Flow.Right{wrap:true} draw_text.text_style:NavRegular draw_text.color:ink text:answer_text}
        }}
    }
}
block_overlay := View{width:Fill height:Fill flow:Overlay on_render:||{
 for block in overlay_blocks {View{width:Fill height:block_height(block) margin:Inset{top:ui_overlay_top} visible:block_actual_visible(block) flow:Down clip_x:true clip_y:true Splash{width:Fill height:Fill body:block.body}}}
}}
trace_overlay := View{width:1 height:1 flow:Overlay
trace_identity := Label{visible:trace_enabled width:1 height:1 padding:0 text:trace_identity_json() draw_text +: {color:#x0000 text_style:NavRegular{font_size:0.5}}}
}
}
start_timeout(0.1, || { trace_initialize() if trace_enabled {try {ui.trace_identity.set_text(trace_identity_json())} {}} trace_marker() if native_ui_available {ui_viewport = ui.content.rect()} render_content() if native_ui_available {poll_generated()} })
