// 纯函数片段：金额用整数分；时间用Unix秒；不包含地点、费用或路线的演示答案。
fn route_get(value, name){
    if !value.is_object() { return nil }
    return value[name]
}
// 系统日历只通过宿主读取；权限与日历选择由真实用户在宿主面板确认。
let cc_state={busy:false status:"not_checked" permission:nil selection:nil loaded:false last:nil}
fn cc_get(value,key){if value.is_object(){return value[key]} return nil}
fn context_calendar_snapshot(){return {status:cc_state.status busy:cc_state.busy permission:cc_state.permission calendar:cc_get(cc_state.selection,"calendar") last:cc_state.last}}
fn cc_dispatch(method,args,done){return host.request(method,args,done)}
fn cc_begin(done){if cc_state.busy {done({success:false status:"busy" source:"device_calendar" records:[] error:"背景日历正在读取或等待用户确认"}) return false} cc_state.busy=true return true}
fn cc_finish(done,result){cc_state.busy=false cc_state.status=result.status cc_state.last=result done(result)}
fn cc_failure(error){
 let status="unavailable"
 if !error.is_string(){error="宿主日历返回未知错误"}
 if error.search("authorization_required:")==0 {status="authorization_needed"}
 elif error.search("invalid_handle:")==0 || error.search("calendar_missing:")==0 {status="selection_needed"}
 elif error.search("stale_consent:")==0 || error.search("account_changed:")==0 || error.search("account_unavailable:")==0 {status="context_invalidated"}
 elif error.search("cancelled:")==0 {status="cancelled"}
 elif error.search("invalid_arguments:")==0 {status="invalid_arguments"}
 return {success:false status:status source:"device_calendar" records:[] error:error}
}
fn cc_clear_selection(){cc_state.selection=nil cc_state.loaded=true if fs.exists("context-calendar.json"){fs.remove("context-calendar.json")}}
fn cc_fail(done,error){let result=cc_failure(error) if result.status=="selection_needed" || result.status=="context_invalidated" || result.status=="authorization_needed" {cc_clear_selection()} cc_finish(done,result)}
fn cc_calendar_valid(value){return value.is_object() && cc_get(value,"id").is_string() && value.id!="" && cc_get(value,"account").is_string() && value.account!=""}
fn cc_load(done){
 if cc_state.loaded {done(nil) return}
 if !fs.exists("context-calendar.json"){cc_state.loaded=true done(nil) return}
 fs.read_async("context-calendar.json",fn(reply){
  if !reply.success {done("读取已选日历失败："+reply.error) return}
  let value=reply.text.parse_json()
  if !value.is_object() || cc_get(value,"schema")!=1 || !cc_get(value,"handle").is_string() || value.handle=="" || !cc_calendar_valid(cc_get(value,"calendar")) {done("已选日历记录损坏，请重新选择日历") return}
  cc_state.selection=value cc_state.loaded=true done(nil)
 })
}
fn cc_permission_status(done){
 cc_dispatch("device_calendar.permission.status",{},fn(reply){
  if !reply.is_ok {done(nil,reply.error) return}
  let data=reply.data
  if !data.is_object() || !(cc_get(data,"supported")==true || cc_get(data,"supported")==false) || !(cc_get(data,"app_consent")==true || cc_get(data,"app_consent")==false) || !cc_get(data,"os_permission").is_string(){done(nil,"invalid_response: 日历权限状态不完整") return}
  cc_state.permission=data done(data,nil)
 })
}
fn cc_access(data){
 if !data.supported {return "unsupported"}
 if !data.app_consent || data.os_permission!="granted" {return "authorization_needed"}
 return "ready"
}
fn context_calendar_status(done){
 if !cc_begin(done){return}
 cc_permission_status(fn(data,error){
  if error!=nil {cc_fail(done,error) return}
  let status=cc_access(data)
  if status!="ready" {cc_clear_selection() cc_finish(done,{success:true status:status source:"device_calendar" permission:data records:[]}) return}
  cc_load(fn(error){if error!=nil {cc_finish(done,{success:false status:"storage_error" source:"device_calendar" records:[] error:error}) return} cc_finish(done,{success:true status:if cc_state.selection==nil {"selection_needed"} else {"ready"} source:"device_calendar" permission:data calendar:cc_get(cc_state.selection,"calendar") records:[]})})
 })
}
fn context_calendar_permission(done){
 if !cc_begin(done){return}
 // 宿主首次只允许status异步载入consent缓存；用户点击request也须等该初始化完成。
 cc_permission_status(fn(data,error){
  if error!=nil {cc_fail(done,error) return}
  if !data.supported {cc_finish(done,{success:false status:"unsupported" source:"device_calendar" permission:data records:[] error:"当前宿主不支持系统日历"}) return}
  cc_dispatch("device_calendar.permission.request",{},fn(reply){if !reply.is_ok {cc_fail(done,reply.error) return} cc_state.permission=reply.data cc_finish(done,{success:true status:if cc_get(reply.data,"app_consent")==true && cc_get(reply.data,"os_permission")=="granted" {"selection_needed"} else {"authorization_needed"} source:"device_calendar" permission:reply.data records:[]})})
 })
}
fn context_calendar_choices(done){
 if !cc_begin(done){return}
 cc_permission_status(fn(data,error){
  if error!=nil {cc_fail(done,error) return}
  let status=cc_access(data)
  if status!="ready" {cc_clear_selection() cc_finish(done,{success:false status:status source:"device_calendar" permission:data records:[] error:"请先点击授权系统日历；当前状态："+status}) return}
  cc_dispatch("device_calendar.calendars.list",{},fn(reply){
   if !reply.is_ok {cc_fail(done,reply.error) return}
   if !cc_get(reply.data,"calendars").is_array(){cc_fail(done,"invalid_response: 日历列表不完整") return}
   cc_finish(done,{success:true status:"selection_needed" source:"device_calendar" calendars:reply.data.calendars records:[]})
  })
 })
}
fn context_calendar_select(calendar_id,done){
 if !cc_begin(done){return}
 if !calendar_id.is_string() || calendar_id=="" {cc_fail(done,"invalid_arguments: 请选择宿主返回的日历") return}
 cc_permission_status(fn(data,error){
  if error!=nil {cc_fail(done,error) return}
  let status=cc_access(data)
  if status!="ready" {cc_clear_selection() cc_finish(done,{success:false status:status source:"device_calendar" permission:data records:[] error:"请先点击授权系统日历；当前状态："+status}) return}
  cc_dispatch("device_calendar.calendars.select",{calendar_id:calendar_id},fn(reply){
   if !reply.is_ok {cc_fail(done,reply.error) return}
   let selected=reply.data
   if !cc_get(selected,"handle").is_string() || selected.handle=="" || !cc_calendar_valid(cc_get(selected,"calendar")){cc_fail(done,"invalid_response: 宿主未返回已选日历句柄") return}
   let selection={schema:1 handle:selected.handle calendar:selected.calendar selected_at:time_now()}
   try {fs.write("context-calendar.json",selection.to_json())} {cc_finish(done,{success:false status:"storage_error" source:"device_calendar" records:[] error:"已授权日历无法保存，请重新选择"}) return}
   cc_state.selection=selection cc_state.loaded=true
   cc_finish(done,{success:true status:"ready" source:"device_calendar" calendar:selected.calendar records:[]})
  })
 })
}
fn cc_event_record(event,calendar,read_at,range){
 if !event.is_object() || !cc_get(event,"id").is_string() || !cc_get(event,"title").is_string() || !cc_get(event,"start_ms").is_number() || !cc_get(event,"end_ms").is_number() || event.end_ms<=event.start_ms || !cc_get(event,"timezone").is_string() || !(cc_get(event,"all_day")==true || cc_get(event,"all_day")==false) || !cc_get(event,"revision").is_string(){return nil}
 return {id:"device-calendar:"+calendar.id+":"+event.id kind:"calendar" source:"device_calendar" mock:false event_id:event.id calendar:calendar starts_at_unix:event.start_ms/1000 ends_at_unix:event.end_ms/1000 start_ms:event.start_ms end_ms:event.end_ms timezone:event.timezone all_day:event.all_day summary:event.title location:cc_get(event,"location") notes:cc_get(event,"notes") revision:event.revision source_time:nil read_at:read_at range:range original:event raw:event.to_json()}
}
fn context_calendar_read(start_ms,end_ms,limit,done){
 if !cc_begin(done){return}
 if !start_ms.is_number() || !end_ms.is_number() || start_ms%1!=0 || end_ms%1!=0 || start_ms<0 || end_ms>4102444800000 || end_ms<=start_ms || end_ms-start_ms>8035200000 {cc_fail(done,"invalid_arguments: 日历时间窗须为1970至2100内、最多93天的正整数毫秒区间") return}
 if limit==nil {limit=200}
 if !limit.is_number() || limit%1!=0 || limit<1 || limit>200 {cc_fail(done,"invalid_arguments: 日历读取上限须为1至200的整数") return}
 let range={start_ms:start_ms end_ms:end_ms limit:limit}
 cc_permission_status(fn(data,error){
  if error!=nil {cc_fail(done,error) return}
  let status=cc_access(data)
  if status!="ready" {cc_clear_selection() cc_finish(done,{success:false status:status source:"device_calendar" permission:data range:range records:[] error:"日历尚未授权；未读取个人事件"}) return}
  cc_load(fn(error){
   if error!=nil {cc_finish(done,{success:false status:"storage_error" source:"device_calendar" range:range records:[] error:error}) return}
   let selection=cc_state.selection
   if selection==nil {cc_finish(done,{success:false status:"selection_needed" source:"device_calendar" range:range records:[] error:"请先在应用中选择要读取的日历"}) return}
   cc_dispatch("device_calendar.events.list",{handle:selection.handle start_ms:start_ms end_ms:end_ms limit:limit},fn(reply){
    if !reply.is_ok {cc_fail(done,reply.error) return}
    let data=reply.data let read_at=time_now()
    if !cc_get(data,"events").is_array() || data.events.len()>limit || !(cc_get(data,"truncated")==true || cc_get(data,"truncated")==false) {cc_fail(done,"invalid_response: 日历事件或截断状态不完整") return}
    let records=[]
    for event in data.events {let record=cc_event_record(event,selection.calendar,read_at,range) if record==nil {cc_fail(done,"invalid_response: 日历事件身份或时间不完整") return} records.push(record)}
    cc_finish(done,{success:true status:if data.truncated {"truncated"} elif records.len()==0 {"empty"} else {"ready"} source:"device_calendar" mock:false calendar:selection.calendar range:range read_at:read_at records:records truncated:data.truncated original:data})
   })
  })
 })
}

// 本地 shared_tools 扩展调用官方 Notes 只读工具，不读取其它应用的存储。
let cn_sequence=0 let cn_pending={}
fn cn_dispatch(method,args,done){return host.request(method,args,done)}
fn cn_failure(error){
 if !error.is_string(){error="宿主笔记返回未知错误"}
 let status="unavailable"
 if error.search("app_not_running")>=0 {status="app_not_running"}
 elif error.search("permission")>=0 || error.search("grant")>=0 || error.search("consent")>=0 || error.search("not_allowed")>=0 {status="needs_connect"}
 elif error.search("cancelled")>=0 {status="cancelled"}
 return {success:false status:status source:"octosense-notes" transport:"local-shared-tools-extension" records:[] error:error}
}
fn cn_call(tool,args,done){
 cn_sequence+=1
 let stamp=time_now()*1000
 let request_id="notes-"+(stamp-stamp%1)+"-"+cn_sequence
 let pending={id:request_id done:done settled:false} cn_pending[request_id]=pending
 cn_dispatch("shared_tools.call",{request_id:request_id tool:tool args:args},fn(reply){
  if pending.settled {return}
  pending.settled=true delete cn_pending[request_id]
  if !reply.is_ok {done(cn_failure(reply.error)) return}
  let envelope=reply.data let data=cc_get(envelope,"data")
  if !data.is_object() {done(cn_failure("invalid_response: Notes没有返回官方记录数据")) return}
  done({success:true data:data original_reply:envelope read_at:time_now() request_id:request_id})
 })
 return request_id
}
fn context_notes_cancel(request_id){
 let pending=cn_pending[request_id]
 if !pending.is_object() || pending.settled {return}
 pending.settled=true delete cn_pending[request_id]
 cn_dispatch("shared_tools.cancel",{request_id:request_id},fn(reply){})
}
fn context_notes_cancel_all(){let ids=[] for id pending in cn_pending {ids.push(id)} for id in ids {context_notes_cancel(id)}}
fn context_notes_search(query,done){
 if !query.is_string() || query.trim()=="" || query.to_bytes().len()>256 {done(cn_failure("invalid_arguments: 笔记关键词须为非空且不超过256字节")) return nil}
 return cn_call("notes.search",{query:query},fn(reply){
  if !reply.success {done(reply) return}
  let data=reply.data
  if !cc_get(data,"hits").is_array() || !cc_get(data,"total").is_number() || data.total<0 || data.hits.len()>50 || !(cc_get(data,"truncated")==true || cc_get(data,"truncated")==false) {done(cn_failure("invalid_response: Notes搜索结果不完整")) return}
  for hit in data.hits {if !cc_get(hit,"id").is_string() || !cc_get(hit,"title").is_string() || !cc_get(hit,"preview").is_string() || !cc_get(hit,"edited_ms").is_number() {done(cn_failure("invalid_response: Notes摘要缺少来源身份或时间")) return}}
  done({success:true status:if data.truncated {"truncated"} elif data.hits.len()==0 {"empty"} else {"ready"} source:"octosense-notes" transport:"local-shared-tools-extension" query:query hits:data.hits total:data.total truncated:data.truncated read_at:reply.read_at original: data original_reply:reply.original_reply records:[] detail_tool:"read_note"})
 })
}
fn context_notes_read(id,done){
 if !id.is_string() || id=="" {done(cn_failure("invalid_arguments: 请使用Notes搜索返回的id")) return nil}
 return cn_call("notes.read",{id:id},fn(reply){
  if !reply.success {done(reply) return}
  let data=reply.data
  if cc_get(data,"id")!=id || !cc_get(data,"source").is_string() || !cc_get(data,"created_ms").is_number() || !cc_get(data,"edited_ms").is_number() {done(cn_failure("invalid_response: Notes正文身份或修改时间不完整")) return}
  let record={id:"octosense-notes:"+id note_id:id kind:"note" source:"octosense-notes" transport:"local-shared-tools-extension" mock:false summary:cc_get(data,"title") raw:data.source source_time:data.edited_ms/1000 created_ms:data.created_ms edited_ms:data.edited_ms read_at:reply.read_at original:data}
  done({success:true status:"ready" source:"octosense-notes" transport:"local-shared-tools-extension" records:[record] read_at:reply.read_at original_reply:reply.original_reply})
 })
}



fn route_uint(text){
    if !text.is_string() || !regex("^[0-9]+$", "").test(text) { return nil }
    let number = 0
    for digit in text.split("") {
        if digit != "" {
            let value = digit.to_f64()
            if number > (9007199254740991 - value) / 10 { return nil }
            number = number * 10 + value
        }
    }
    return number
}
fn route_seconds(value){ return route_uint(value) }
fn route_cents(value){
    if !value.is_string() || !regex("^[0-9]+([.][0-9]+)?$", "").test(value) { return nil }
    let parts = value.split(".")
    let fraction = "00"
    if parts.len() == 2 {
        fraction = ""
        for index digit in parts[1].split("") {if digit!="" {if fraction.len()<2 {fraction+=digit} elif digit!="0" {return nil}}}
        if fraction.len() == 1 { fraction += "0" }
    }
    return route_uint(parts[0] + fraction)
}

// 裸max/floor等shader数学函数走f32；现代Unix秒必须保留普通f64比较/算术。
fn route_later(a, b){ if a >= b { return a } return b }

fn route_point(value){
    if !value.is_string() || !regex("^-?[0-9]+([.][0-9]+)?,-?[0-9]+([.][0-9]+)?$", "").test(value) { return nil }
    let parts = value.split(",")
    let lon = parts[0].to_f64()
    let lat = parts[1].to_f64()
    if !(abs(lon) <= 180 && abs(lat) <= 90) { return nil }
    return {lon: lon lat: lat}
}

fn route_terminal(segments){
    if !segments.is_array() || segments.len() == 0 { return nil }
    let last = segments[segments.len() - 1]
    // 最后segment含乘车时，walking是上车前的衔接，不能冒充到达终点。
    if route_get(last, "bus").is_object() || route_get(last, "taxi").is_object() || route_get(last, "railway").is_object() { return nil }
    let walking = route_get(last, "walking")
    if !walking.is_object() { return nil }
    let steps = route_get(walking, "steps")
    if !steps.is_array() || steps.len() == 0 { return nil }
    let step = steps[steps.len() - 1]
    let polyline = route_get(step, "polyline")
    if polyline.is_object() { polyline = route_get(polyline, "polyline") }
    if !polyline.is_string() || polyline == "" { return nil }
    let points = polyline.split(";")
    return points[points.len() - 1]
}

fn route_start(segments){
    if !segments.is_array() || segments.len() == 0 { return nil }
    let first = segments[0]
    let walking = route_get(first, "walking")
    if walking.is_object() {
        let steps = route_get(walking, "steps")
        if !steps.is_array() || steps.len() == 0 { return nil }
        let polyline = route_get(steps[0], "polyline")
        if polyline.is_object() { polyline = route_get(polyline, "polyline") }
        if !polyline.is_string() || polyline == "" { return nil }
        let points = polyline.split(";")
        return points[0]
    }
    // 未有步行时只接受实际出租车上车点；不从回显origin补起点证据。
    return route_get(route_get(first, "taxi"), "startpoint")
}

fn route_endpoint_gap(actual, destination){
    let a = route_point(actual)
    let b = route_point(destination)
    if a == nil || b == nil { return nil }
    // 仅用于相邻终点的25米检查，不用于路线长度或大范围测距。
    let dx = (a.lon - b.lon) * 111320 * cos((a.lat + b.lat) * 0.5 * 0.017453292519943295)
    let dy = (a.lat - b.lat) * 111320
    return sqrt(dx * dx + dy * dy)
}

// 固定班次按实际发到时刻核验；迟出发只能失去班次，不能把列车向后平移。
fn route_timing(candidate, nowTs){
    let legs=route_get(candidate,"legs") if !legs.is_array() {legs=route_get(candidate,"selected_legs")}
    let fixed=false if legs.is_array() {for leg in legs {if route_get(leg,"rail_service")!=nil {fixed=true}}}
    if !fixed {return {arrival_ts:if candidate.duration_seconds!=nil {route_later(nowTs,candidate.departure_ts)+candidate.duration_seconds} else {nil} missed:[]}}
    let arrival=route_later(nowTs,candidate.departure_ts) let missed=[]
    for leg in legs {
        let service=route_get(leg,"rail_service")
        if service!=nil {
            if arrival!=nil && arrival>service.departure_ts {missed.push("已错过固定班次 "+service.trip)}
            arrival=service.arrival_ts
        } elif arrival!=nil && leg.duration_seconds!=nil {arrival+=leg.duration_seconds} else {arrival=nil}
    }
    return {arrival_ts:arrival missed:missed}
}

fn route_reasons(candidate, nowTs, deadlineTs, budgetCents){
    if render_probe!=nil && render_probe.active {render_probe.reasons+=1}
    let reasons = []
    if route_get(candidate,"completion_status")=="incomplete" {reasons.push("路线仅到实际中间终点，后续连接尚未取得")}
    if route_get(candidate,"provider_connection_status")=="unknown" {reasons.push("供应商上下车与路线连接未知")}
    if !nowTs.is_number() || !deadlineTs.is_number() || !budgetCents.is_number() { return ["约束格式无效"] }
    if !(nowTs >= 0 && nowTs <= 9007199254740991 && deadlineTs >= 0 && deadlineTs <= 9007199254740991 && budgetCents >= 0 && budgetCents <= 9007199254740991 && budgetCents % 1 == 0) { return ["约束格式无效"] }
    if candidate.price_cents == nil { reasons.push("费用未知，无法核实预算") }
    elif candidate.price_cents > budgetCents { reasons.push("超过预算") }
    if candidate.duration_seconds == nil { reasons.push("耗时未知") }
    elif route_timing(candidate,nowTs).arrival_ts!=nil && route_timing(candidate,nowTs).arrival_ts > deadlineTs { reasons.push("超过到达期限") }
    for reason in route_timing(candidate,nowTs).missed {reasons.push(reason)}
    if !candidate.waiting_included { reasons.push("候车或站内登乘衔接尚未核实") }
    if !candidate.request_bound { reasons.push("路线尚未绑定本次请求") }
    if !candidate.origin_complete { reasons.push("出发起点未核实") }
    if !candidate.endpoint_complete { reasons.push("目的地末段未核实") }
    if route_get(candidate,"destination_access")!=nil {reasons.push("仅规划到高德标注入口；航站楼内部通达、楼层和安检未知")}
    if !candidate.source_ts.is_number() { reasons.push("查询时间无效") }
    elif !(candidate.source_ts >= 0 && candidate.source_ts <= nowTs) { reasons.push("查询时间无效") }
    // ponytail: 首轮保守复用5分钟，出现班次/路况变化时在工具边界提前重查。
    elif nowTs - candidate.source_ts > 300 { reasons.push("交通数据已过期") }
    return reasons
}
fn route_reason(candidate, nowTs, deadlineTs, budgetCents){
    let reasons = route_reasons(candidate, nowTs, deadlineTs, budgetCents)
    if reasons.len() == 0 { return "估计满足约束" }
    let text = ""
    for reason in reasons { if text != "" { text += "；" } text += reason }
    return text
}

fn route_candidate(id, kind, duration, price, queryTs, departureTs, endpoint, destination, waiting, segments){
    let gap = route_endpoint_gap(endpoint, destination)
    return {id: id kind: kind duration_seconds: duration price_cents: price currency: "CNY" estimated: true
        source: "高德Web服务v5" source_ts: queryTs expires_at: queryTs + 300 departure_ts: departureTs
        waiting_included: waiting waiting_basis: "provider_total" taxi_wait_verified: false endpoint_complete: gap != nil && gap <= 25
        request_bound: false origin_complete: false actual_origin: route_start(segments)
        endpoint_gap_m: gap actual_endpoint: endpoint destination: destination segments: segments
        feasible: false reason: "尚未检查" warnings: "供应商估计；入口坐标匹配不证明出发区域或楼层、实际费用或到达保证。"}
}

fn route_candidates(transitData, drivingData, queryTs, deadlineTs, budgetCents, nowTs){
    let candidates = []
    let transitRoute = route_get(transitData, "route")
    let transits = route_get(transitRoute, "transits")
    if route_get(transitData, "status") == "1" && transits.is_array() {
        for index option in transits {
            let segments = route_get(option, "segments")
            let kind = "public_transit"
            if segments.is_array() {
                for segmentIndex segment in segments {
                    if route_get(segment, "taxi").is_object() { kind = "mixed" }
                }
            }
            let cost = route_get(option, "cost")
            let candidate = route_candidate("transit-" + index, kind,
                route_seconds(route_get(cost, "duration")), route_cents(route_get(cost, "transit_fee")),
                queryTs, nowTs, route_terminal(segments), route_get(transitRoute, "destination"), true, segments)
            if kind == "mixed" { candidate.warnings = "供应商含等车总估计；出租车等待未单独核实，不保证实际费用或准时抵达。" }
            candidate.distance_m = route_seconds(route_get(option,"distance"))
            candidate.price_basis = "amap-option.cost.transit_fee；供应商本次查询区间报价；各交通分段票价及包含关系未知，无法据此确认是否包含城际车票；请求全程覆盖以cost.coverage为准"
            candidate.reason = route_reason(candidate, nowTs, deadlineTs, budgetCents)
            candidate.feasible = candidate.reason == "估计满足约束"
            candidates.push(candidate)
        }
    }
    let drivingRoute = route_get(drivingData, "route")
    let paths = route_get(drivingRoute, "paths")
    if route_get(drivingData, "status") == "1" && paths.is_array() {
        for index path in paths {
            let cost = route_get(path, "cost")
            // route级估价仅在单路径请求时配对；多路径返回不猜每条路径的车价。
            let price = nil
            if paths.len() == 1 { price = route_cents(route_get(drivingRoute, "taxi_cost")) }
            let candidate = route_candidate("taxi-" + index, "taxi", route_seconds(route_get(cost, "duration")),
                price, queryTs, nowTs, route_leg_endpoint(route_get(path,"steps"),false), route_get(drivingRoute, "destination"), false, route_get(path, "steps"))
            candidate.distance_m = route_seconds(route_get(path,"distance"))
            candidate.price_basis = "amap-route.taxi_cost；单路径出租车估价，非滴滴成交价"
            candidate.waiting_basis = "driving_only"
            candidate.warnings = "全程出租车估价；duration仅行驶，候车未知，尚未核实步行登车及终点入口。"
            candidate.reason = route_reason(candidate, nowTs, deadlineTs, budgetCents)
            candidate.feasible = candidate.reason == "估计满足约束"
            candidates.push(candidate)
        }
    }
    return candidates
}

fn route_choose(candidates){
    let selected = nil
    for candidateIndex candidate in candidates {
        if candidate.feasible {
            if selected == nil { selected = candidate }
            else {
                if candidate.price_cents < selected.price_cents ||
                    (candidate.price_cents == selected.price_cents && candidate.duration_seconds < selected.duration_seconds) {
                    selected = candidate
                }
            }
        }
    }
    return selected
}

fn route_recheck(selected, nowTs, deadlineTs, budgetCents){
    if selected == nil { return {passed: false reason: "没有有效候选" estimated_arrival_ts: nil} }
    let reason = route_reason(selected, nowTs, deadlineTs, budgetCents)
    let arrival = route_timing(selected,nowTs).arrival_ts
    return {passed: route_reasons(selected, nowTs, deadlineTs, budgetCents).len() == 0 reason: reason estimated_arrival_ts: arrival}
}

// 守护判断与模型分离：已知超限优先，缺证据不能当成立。
fn guardian_assess(candidate, now, deadline, remaining){
 let reasons=[] let invalid=false
 if remaining<0 {invalid=true reasons.push("已确认花费超过总预算")}
 if now>deadline {invalid=true reasons.push("绝对到达期限已过")}
 if candidate==nil {return {status:if invalid {"invalid"} else {"unknown"} reasons:reasons}}
 if candidate.price_cents!=nil && candidate.price_cents>remaining {invalid=true reasons.push("剩余路线估价超过剩余预算")}
 let timing=route_timing(candidate,now) let arrival=timing.arrival_ts
 if arrival!=nil && arrival>deadline {invalid=true reasons.push("预计到达超过绝对期限")}
 if timing.missed.len()>0 {invalid=true}
 let unknown=route_reasons(candidate,now,deadline,if remaining<0 {0} else {remaining})
 for reason in unknown {reasons.push(reason)}
 let arrival_facts=route_arrival_facts(candidate,arrival)
 return {status:if invalid {"invalid"} elif unknown.len()==0 {"valid"} else {"unknown"} reasons:reasons estimated_arrival_ts:arrival_facts.estimated_arrival_ts estimated_arrival_label:arrival_facts.estimated_arrival_label queried_endpoint_arrival_ts:arrival_facts.queried_endpoint_arrival_ts queried_endpoint_arrival_label:arrival_facts.queried_endpoint_arrival_label arrival_scope:arrival_facts.arrival_scope arrival_label:arrival_facts.arrival_label duration:route_duration_facts(candidate) remaining_budget_cents:remaining}
}
// 只评估从当前时刻重走原整程，不据位置推断用户已登乘。
fn guardian_reexecution(goal,now,origin){
 if goal==nil {return nil}
 let route=goal.selected_route let timing=route_timing(route,now)
 let origin_point=if origin.is_string() {origin} else {route_get(origin,"location")}
 if route_point(origin_point)==nil && route_get(origin,"longitude").is_number() && route_get(origin,"latitude").is_number() {origin_point=coord_text(origin)}
 let gap=route_endpoint_gap(origin_point,route.actual_origin)
 let at_origin=gap!=nil && gap<=25
 let comparable=at_origin && goal.progress=="" && goal.spent_cents==0
 return {evidence_scope:"reexecute_original_full_journey" evaluated_at:now evaluated_at_label:guardian_deadline(now) original_route_id:route.id source_ts:route.source_ts source_scope:"saved_snapshot_not_refreshed" original_origin_gap_m:gap origin_matches:at_origin progress_scope:if goal.progress!="" || goal.spent_cents!=0 {"remaining_journey_not_identified"} else {"no_confirmed_progress"} actual_journey_status:"unknown" boarding_status:"unknown" reexecution_status:if !comparable {"unknown"} elif timing.missed.len()>0 {"invalid"} else {"unknown"} missed_fixed_services:timing.missed estimated_reexecution_arrival_ts:timing.arrival_ts deadline_ts:goal.deadline_ts interpretation:"仅从当前时刻重新执行原整程的时刻检查；不证明已登乘、余票、旧报价或当前交通仍有效"}
}
fn guardian_cost_delta(candidate,goal){
 if candidate==nil || goal==nil {return {full_journey_delta_cents:nil queried_legs_subtotal_delta_cents:nil comparison_scope:"not_comparable"}}
 let previous=goal.selected_route let before=route_cost_facts(previous) let after=route_cost_facts(candidate)
 let comparable=goal.progress=="" && goal.spent_cents==0
 let gap=route_endpoint_gap(candidate.actual_origin,previous.actual_origin)
 let end_gap=route_endpoint_gap(candidate.actual_endpoint,previous.actual_endpoint)
 let full=comparable && gap!=nil && gap<=25 && end_gap!=nil && end_gap<=25 && before.full_journey_amount_cents!=nil && after.full_journey_amount_cents!=nil
 return {full_journey_delta_cents:if full {after.full_journey_amount_cents-before.full_journey_amount_cents} else {nil} queried_legs_subtotal_delta_cents:if comparable && before.queried_legs_complete && after.queried_legs_complete {after.queried_legs_amount_cents-before.queried_legs_amount_cents} else {nil} comparison_scope:if !comparable {"remaining_journey_not_comparable"} elif full {"full_journey_estimate"} else {"queried_legs_only"} interpretation:"已查路段小计差不等于整程差；旧报价保留原查询时间，不是本轮报价"}
}
// 同计划以交通方式与公交线路/上下站识别；逐点几何、报价和用时不充当身份。
fn guardian_plan_key(candidate){
 let segments=[]
 for segment in candidate.segments {
   let bus=route_get(segment,"bus") let lines=[]
   if bus!=nil && route_get(bus,"buslines").is_array() {for line in bus.buslines {lines.push({id:route_get(line,"id") name:route_get(line,"name") departure_id:route_get(route_get(line,"departure_stop"),"id") departure_name:route_get(route_get(line,"departure_stop"),"name") arrival_id:route_get(route_get(line,"arrival_stop"),"id") arrival_name:route_get(route_get(line,"arrival_stop"),"name")})}}
   let walking=route_get(segment,"walking") let roads=[]
   if walking!=nil && route_get(walking,"steps").is_array() {for step in walking.steps {roads.push({road:route_get(step,"road")})}}
   segments.push({lines:lines walk:roads road:route_get(segment,"road") taxi:route_get(segment,"taxi")!=nil railway:if route_get(segment,"railway")!=nil {{trip:route_get(segment.railway,"trip") service:if route_get(segment.railway,"service")!=nil {{train_id:segment.railway.service.train_id train_start_date:segment.railway.service.train_start_date boarding_date:segment.railway.service.boarding_date from_station:segment.railway.service.from_station to_station:segment.railway.service.to_station} } else {nil} seat_code:route_get(route_get(segment.railway,"seat"),"code")}} else {nil}})
 }
 return {kind:candidate.kind segments:segments}.to_json()
}
fn guardian_plan_identified(candidate){
 for segment in candidate.segments {
  let lines=route_get(route_get(segment,"bus"),"buslines")
  if lines.is_array() {for line in lines {
   if !route_get(line,"id").is_string() || line.id=="" || !route_get(route_get(line,"departure_stop"),"id").is_string() || line.departure_stop.id=="" || !route_get(route_get(line,"arrival_stop"),"id").is_string() || line.arrival_stop.id=="" {return false}
  }}
 }
 return true
}
fn guardian_materialize_node(node){
 if node==nil {return nil}
 return {ref:route_get(node,"ref") name:route_get(node,"name") location:coord_text(node) city_metadata:route_get(node,"city_metadata") source:route_get(node,"source") coordinate_basis:route_get(node,"coordinate_basis") canonical_poi_ref:route_get(node,"canonical_poi_ref") routing_point:route_get(node,"routing_point") queried_at:route_get(node,"queried_at")}
}
fn guardian_materialize(candidate){
 let legs=[]
 if route_get(candidate,"legs").is_array() {for leg in candidate.legs {
   legs.push({mode:leg.mode from:guardian_materialize_node(route_node(leg.from_ref)) to:guardian_materialize_node(route_node(leg.to_ref)) departure_ts:leg.departure_ts duration_seconds:leg.duration_seconds price_cents:leg.price_cents price_basis:leg.price_basis waiting_included:leg.waiting_included source_ts:leg.source_ts warnings:leg.warnings rail_service:rail_service_labels(route_get(leg,"rail_service")) rail_seat:route_get(leg,"rail_seat") quote:if route_get(leg,"quote_ref")!=nil {didi_quotes[leg.quote_ref]} else {nil} place_match_basis:route_get(leg,"place_match_basis") provider_connection_status:route_get(leg,"provider_connection_status") connection_gap_m:route_get(leg,"connection_gap_m") connection_actual_endpoint:route_get(leg,"connection_actual_endpoint") actual_origin:route_get(leg,"actual_origin") actual_endpoint:route_get(leg,"actual_endpoint") origin_complete:route_get(leg,"origin_complete") endpoint_complete:route_get(leg,"endpoint_complete") request_bound:route_get(leg,"request_bound") station_access_status:route_get(leg,"station_access_status") boarding_status:route_get(leg,"boarding_status") connection_verified:route_get(leg,"connection_verified")})
 }}
 return {id:candidate.id kind:candidate.kind segments:candidate.segments selected_legs:legs destination_access:route_get(candidate,"destination_access") price_cents:candidate.price_cents currency:candidate.currency duration_seconds:candidate.duration_seconds departure_ts:candidate.departure_ts source:candidate.source source_ts:candidate.source_ts expires_at:candidate.expires_at waiting_included:candidate.waiting_included waiting_basis:candidate.waiting_basis requested_origin:route_get(candidate,"requested_origin") requested_destination:route_get(candidate,"requested_destination") price_basis:route_get(candidate,"price_basis") known_cost_cents:route_get(candidate,"known_cost_cents") estimated:true request_bound:candidate.request_bound origin_complete:candidate.origin_complete endpoint_complete:candidate.endpoint_complete actual_origin:candidate.actual_origin actual_endpoint:candidate.actual_endpoint completion_status:route_completion(candidate) connection_verified:route_get(candidate,"connection_verified") provider_connection_status:route_get(candidate,"provider_connection_status") warnings:candidate.warnings plan_key:guardian_plan_key(candidate)}
}
fn guardian_valid_goal(goal){
 if !goal.is_object() {return false}
 let selection_basis=route_get(goal,"selection_basis")
 if !selection_basis.is_string() || selection_basis.trim()=="" {return false}
 if goal.schema!=1 || !goal.version.is_number() || goal.version<1 || goal.version%1!=0 || !goal.confirmed_at.is_number() {return false}
 if !goal.deadline_ts.is_number() || goal.deadline_ts<0 || goal.deadline_ts>9007199254740991 || !goal.total_budget_cents.is_number() || goal.total_budget_cents<0 || goal.total_budget_cents%1!=0 || goal.total_budget_cents>9007199254740991 {return false}
 if !goal.spent_cents.is_number() || goal.spent_cents<0 || goal.spent_cents%1!=0 || goal.spent_cents>9007199254740991 || goal.currency!="CNY" || !goal.preferences.is_string() || !goal.risk_acceptance.is_string() || !goal.progress.is_string() {return false}
 if !goal.destination.is_object() || !goal.destination.name.is_string() || route_point(coord_text(goal.destination))==nil || !goal.selected_route.is_object() || !goal.selected_route.plan_key.is_string() || !goal.confirmations.is_array() {return false}
 let routing=route_get(goal.destination,"routing_point")
 if routing!=nil && (!routing.is_object() || !route_get(goal.destination,"id").is_string() || route_get(routing,"canonical_poi_ref")!="poi:"+goal.destination.id || route_get(routing,"coordinate_basis")!="entr_location" || route_get(routing,"source")!="amap-poi-entrance" || route_point(""+route_get(routing,"longitude")+","+route_get(routing,"latitude"))==nil) {return false}
 let route=goal.selected_route
 if !route.id.is_string() || !route.kind.is_string() || !route.segments.is_array() || !route.departure_ts.is_number() || route.departure_ts<0 || route.departure_ts>9007199254740991 || !route.source_ts.is_number() || route.source_ts<0 || route.source_ts>9007199254740991 {return false}
 if route.price_cents!=nil && (!route.price_cents.is_number() || route.price_cents<0 || route.price_cents%1!=0 || route.price_cents>9007199254740991) {return false}
 if route.duration_seconds!=nil && (!route.duration_seconds.is_number() || route.duration_seconds<0 || route.duration_seconds>9007199254740991) {return false}
 for segment in route.segments {if !segment.is_object() {return false}}
 return goal.state=="active" || goal.state=="ended"
}

// 模型只解释意图并决定下一步；地点、费用与可行性来自工具和确定性检查。
