:mix(mod.theme.color_bg_app, mod.theme.color_text, 0.10) color_hover:mix(mod.theme.color_bg_app, mod.theme.color_text, 0.06) color_down:mix(mod.theme.color_bg_app, mod.theme.color_text, 0.06) color_focus:mix(mod.theme.color_bg_app, mod.theme.color_text, 0.06) color_disabled:mix(mod.theme.color_bg_app, mod.theme.color_text, 0.10) border_size:0 border_radius:12}}\n"}
